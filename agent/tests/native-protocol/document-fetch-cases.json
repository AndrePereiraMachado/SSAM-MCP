{
  "schema": "ssam-agent-document-fetch-cases/1",
  "about": "The protocol cases of the kind document.fetch, run by the Node agent (agent/agent/tests/document-fetch.test.mjs) and by the native core (tests/native-protocol/DocumentFetchTests.cs) against the same local HTTP server built from `routes`. {base} is http://127.0.0.1:<port>, {hostport} 127.0.0.1:<port>. expect: {code} for a refusal, else the answer's fields; requests: how many requests reached the server.",
  "routes": {
    "/svc.wsdl": { "status": 200, "type": "text/xml; charset=utf-8", "body": "<?xml version=\"1.0\"?><definitions xmlns=\"http://schemas.xmlsoap.org/wsdl/\" name=\"Calc\"/>" },
    "/r1": { "status": 302, "location": "/r2" },
    "/r2": { "status": 301, "location": "{base}/svc.wsdl" },
    "/l0": { "status": 302, "location": "/l1" },
    "/l1": { "status": 302, "location": "/l2" },
    "/l2": { "status": 307, "location": "/l3" },
    "/l3": { "status": 308, "location": "/l4" },
    "/l4": { "status": 303, "location": "/l5" },
    "/l5": { "status": 302, "location": "/svc.wsdl" },
    "/to-file": { "status": 302, "location": "file:///C:/Windows/win.ini" },
    "/to-ftp": { "status": 302, "location": "ftp://example.test/svc.wsdl" },
    "/to-userinfo": { "status": 302, "location": "http://user:secret@{hostport}/svc.wsdl" },
    "/no-location": { "status": 302 },
    "/dtd": { "status": 200, "type": "text/xml", "body": "<?xml version=\"1.0\"?>\n<!DOCTYPE definitions SYSTEM \"http://example.test/x.dtd\"><definitions/>" },
    "/entity": { "status": 200, "type": "text/xml", "body": "<?xml version=\"1.0\"?><definitions><!ENTITY x \"y\"></definitions>" },
    "/hello": { "status": 200, "type": "text/plain", "body": "hello" },
    "/api.json": { "status": 200, "type": "application/json", "body": "{\"items\":[1,2,3],\"name\":\"Nager\"}" },
    "/notjson": { "status": 200, "type": "application/json", "body": "{not json" },
    "/big": { "status": 200, "type": "text/xml", "fill": "a", "prefix": "<", "size": 2048 },
    "/big-chunked": { "status": 200, "type": "text/xml", "fill": "a", "prefix": "<", "size": 4096, "chunked": true },
    "/missing": { "status": 404, "type": "text/html", "body": "<html>not here</html>" },
    "/slow": { "status": 200, "type": "text/xml", "delayMs": 3000, "body": "<definitions/>" },
    "/headers": { "status": 200, "type": "application/json", "echoHeaders": true }
  },
  "cases": [
    { "name": "an XML document", "params": { "url": "{base}/svc.wsdl", "accept": "xml" }, "expect": { "status": 200, "finalUrl": "{base}/svc.wsdl", "bodyOf": "/svc.wsdl", "contentType": "text/xml; charset=utf-8" }, "requests": 1 },
    { "name": "redirects followed by the agent", "params": { "url": "{base}/r1", "accept": "xml" }, "expect": { "status": 200, "finalUrl": "{base}/svc.wsdl", "bodyOf": "/svc.wsdl" }, "requests": 3 },
    { "name": "more than 5 redirects", "params": { "url": "{base}/l0", "accept": "xml" }, "expect": { "code": "DOCUMENT_FETCH_REDIRECT_REFUSED" }, "requests": 6 },
    { "name": "a redirect to file:", "params": { "url": "{base}/to-file", "accept": "xml" }, "expect": { "code": "DOCUMENT_FETCH_REDIRECT_REFUSED" }, "requests": 1 },
    { "name": "a redirect to ftp:", "params": { "url": "{base}/to-ftp", "accept": "xml" }, "expect": { "code": "DOCUMENT_FETCH_REDIRECT_REFUSED" }, "requests": 1 },
    { "name": "a redirect carrying a password", "params": { "url": "{base}/to-userinfo", "accept": "xml" }, "expect": { "code": "DOCUMENT_FETCH_REDIRECT_REFUSED" }, "requests": 1 },
    { "name": "a redirect without Location", "params": { "url": "{base}/no-location", "accept": "xml" }, "expect": { "code": "DOCUMENT_FETCH_REDIRECT_REFUSED" }, "requests": 1 },
    { "name": "a DTD", "params": { "url": "{base}/dtd", "accept": "xml" }, "expect": { "code": "DOCUMENT_FETCH_UNSAFE_XML" }, "requests": 1 },
    { "name": "an ENTITY", "params": { "url": "{base}/entity", "accept": "xml" }, "expect": { "code": "DOCUMENT_FETCH_UNSAFE_XML" }, "requests": 1 },
    { "name": "text that is not XML", "params": { "url": "{base}/hello", "accept": "xml" }, "expect": { "code": "DOCUMENT_FETCH_NOT_DOCUMENT" }, "requests": 1 },
    { "name": "a JSON sample", "params": { "url": "{base}/api.json", "accept": "json", "maxBytes": 2097152, "timeoutMs": 10000 }, "expect": { "status": 200, "finalUrl": "{base}/api.json", "bodyOf": "/api.json" }, "requests": 1 },
    { "name": "text that is not JSON", "params": { "url": "{base}/notjson", "accept": "json" }, "expect": { "code": "DOCUMENT_FETCH_NOT_DOCUMENT" }, "requests": 1 },
    { "name": "larger than maxBytes", "params": { "url": "{base}/big", "accept": "xml", "maxBytes": 1024 }, "expect": { "code": "DOCUMENT_FETCH_TOO_LARGE" }, "requests": 1 },
    { "name": "larger than maxBytes without a length", "params": { "url": "{base}/big-chunked", "accept": "xml", "maxBytes": 1024 }, "expect": { "code": "DOCUMENT_FETCH_TOO_LARGE" }, "requests": 1 },
    { "name": "a status that is not 2xx answers no content", "params": { "url": "{base}/missing", "accept": "xml" }, "expect": { "status": 404, "finalUrl": "{base}/missing", "bytes": 0, "contentBase64": "" }, "requests": 1 },
    { "name": "no answer within timeoutMs", "params": { "url": "{base}/slow", "accept": "xml", "timeoutMs": 1000 }, "expect": { "code": "DOCUMENT_FETCH_FAILED" }, "requests": 1 },
    { "name": "no cookie, no credentials, the agent's user-agent", "params": { "url": "{base}/headers", "accept": "json" }, "expect": { "status": 200, "json": { "cookie": null, "authorization": null, "userAgent": "SSAM-Agent document fetch" } }, "requests": 1 },
    { "name": "a file: URL", "params": { "url": "file:///C:/Windows/win.ini", "accept": "xml" }, "expect": { "code": "DOCUMENT_FETCH_URL_REFUSED" }, "requests": 0 },
    { "name": "an ftp: URL", "params": { "url": "ftp://example.test/svc.wsdl", "accept": "xml" }, "expect": { "code": "DOCUMENT_FETCH_URL_REFUSED" }, "requests": 0 },
    { "name": "a URL with a user and password", "params": { "url": "http://user:secret@{hostport}/svc.wsdl", "accept": "xml" }, "expect": { "code": "DOCUMENT_FETCH_URL_REFUSED" }, "requests": 0 },
    { "name": "not a URL", "params": { "url": "svc.wsdl", "accept": "xml" }, "expect": { "code": "DOCUMENT_FETCH_URL_REFUSED" }, "requests": 0 },
    { "name": "accept other than xml or json", "params": { "url": "{base}/svc.wsdl", "accept": "html" }, "expect": { "code": "PARAMS_INVALID" }, "requests": 0 },
    { "name": "maxBytes above 5 MB", "params": { "url": "{base}/svc.wsdl", "accept": "xml", "maxBytes": 5242881 }, "expect": { "code": "PARAMS_INVALID" }, "requests": 0 },
    { "name": "timeoutMs above 30 s", "params": { "url": "{base}/svc.wsdl", "accept": "xml", "timeoutMs": 30001 }, "expect": { "code": "PARAMS_INVALID" }, "requests": 0 },
    { "name": "a header, a method or a body asked by the server", "params": { "url": "{base}/svc.wsdl", "accept": "xml", "headers": { "cookie": "a=b" }, "method": "POST" }, "expect": { "code": "PARAMS_INVALID" }, "requests": 0 }
  ]
}
