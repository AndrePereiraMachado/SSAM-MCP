<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <!-- The agent box builds for the net8 ODC Studios by default; -p:TargetFramework=net10.0 builds the same sources for the net10
         ones (1.7.30 on), against such a Studio (-p:OdcInstall=<its folder>). -->
    <TargetFramework>net8.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <!-- One assembly name per bridge version. A loaded DLL is never replaced: a new version is a new name and a new pipe.
         v108 (agent/r4-v109, the line's U1): the line's v109 sources built for the net8 ODC Studios (up to 1.7.29), the bridge of
         the agent pack; v109, the same sources, for the net10 ones. After a merge both check the changed stylesheets against the
         candidate and refresh their caches, run that verification as a job of its own (reconcile-merge when it did not start),
         and answer a publication ok only when its downloaded revision is before-publish.oml. The names follow the line: the proto
         loaded v100-v105 into a Studio with other code. -->
    <AssemblyName>ODC3.Bridge.v108</AssemblyName>
    <AssemblyName Condition="'$(TargetFramework)' == 'net10.0'">ODC3.Bridge.v109</AssemblyName>
    <!-- IncrementalClean must never treat a prior resident version as an orphan. -->
    <CleanFile>$(MSBuildProjectFile).$(AssemblyName).FileListAbsolute.txt</CleanFile>
    <DefineConstants>$(DefineConstants);QUERY_TEST_ODC</DefineConstants>
    <EnableDefaultCompileItems>false</EnableDefaultCompileItems>
    <!-- Any ODC Studio: ../Directory.Build.targets falls back to the registered one and takes its newer framework copies. -->
    <OdcInstall Condition="'$(OdcInstall)' == ''">$(ProgramFiles)\OutSystems\ODC Studio\ODC Studio</OdcInstall>
  </PropertyGroup>
  <ItemGroup>
    <Reference Include="$(OdcInstall)\OutSystems.Model.dll" Private="false" />
    <Reference Include="$(OdcInstall)\OutSystems.Model.V1.dll" Private="false" />
    <Reference Include="$(OdcInstall)\OutSystems.Model.Versioning.dll" Private="false" />
    <Reference Include="$(OdcInstall)\OutSystems.Model.Implementation.dll" Private="false" />
    <Reference Include="$(OdcInstall)\OutSystems.Model.Concurrency.dll" Private="false" />
    <Reference Include="$(OdcInstall)\OutSystems.Communication.dll" Private="false" />
    <Reference Include="$(OdcInstall)\OutSystems.MetaModel.dll" Private="false" />
    <Reference Include="$(OdcInstall)\OutSystems.Model.DependencyProviders.dll" Private="false" />
    <Reference Include="$(OdcInstall)\OutSystems.FrameworkExtensions.dll" Private="false" />
    <Reference Include="$(OdcInstall)\OutSystems.RuntimeCommon.dll" Private="false" />
    <Reference Include="$(OdcInstall)\ServiceStudio.Framework.dll" Private="false" />
    <Reference Include="$(OdcInstall)\ServiceStudio.Common.dll" Private="false" />
    <Reference Include="$(OdcInstall)\ServiceStudio.Presenter.dll" Private="false" />
    <Reference Include="$(OdcInstall)\ServiceStudio.ServerCommunications.API.dll" Private="false" />
    <Reference Include="$(OdcInstall)\ServiceStudio.ServerCommunications.dll" Private="false" />
    <Reference Include="$(OdcInstall)\ServiceStudio.Identity.dll" Private="false" />
    <Reference Include="$(OdcInstall)\OutSystems.ServiceStudio.Observability.dll" Private="false" />
    <Reference Include="$(OdcInstall)\OutSystems.ServiceStudio.PluginAPI.dll" Private="false" />
    <Reference Include="$(OdcInstall)\OutSystems.Model.Plugin.NRWidgets.dll" Private="false" />
    <Reference Include="$(OdcInstall)\OutSystems.C5.dll" Private="false" />
    <Reference Include="$(OdcInstall)\Avalonia.Base.dll" Private="false" />
    <Reference Include="$(OdcInstall)\Avalonia.Controls.dll" Private="false" />
    <!-- Portal window (portal-session): the Studio's own embedded browser control and engine. -->
    <Reference Include="$(OdcInstall)\WebViewControl.Avalonia.dll" Private="false" />
    <Reference Include="$(OdcInstall)\Xilium.CefGlue.dll" Private="false" />
    <Reference Include="$(OdcInstall)\Xilium.CefGlue.Common.dll" Private="false" />
  </ItemGroup>
  <ItemGroup>
    <Compile Include="StartupHook.cs" />
    <Compile Include="NativePreferForeign.cs" />
    <Compile Include="NativeMergeIntent.cs" />
    <Compile Include="../../../../kernel/src/Anvil.Bridge/PreferForeign.cs" Link="shared/PreferForeign.cs" />

    <Compile Include="AgentDataRoot.cs" />
    <Compile Include="BridgeServe.cs" />
    <Compile Include="BridgeDeadlines.cs" />
    <EmbeddedResource Include="..\..\facade\bridge-deadlines.json" LogicalName="bridge-deadlines.json" />
    <Compile Include="QueryTestCommands.cs" />
    <Compile Include="../../../../kernel/query-test/*.cs" Link="QueryTest/%(Filename)%(Extension)" />
    <Compile Include="DataCommands.cs" />
    <Compile Include="ReferenceCommands.cs" />
    <Compile Include="AppCreationCommands.cs" />
    <Compile Include="TemplateCache.cs" />
    <Compile Include="PublishLogCore.cs" />
    <Compile Include="MergeDiagnostics.cs" />
    <Compile Include="PublishLogCommands.cs" />
    <Compile Include="PortalCore.cs" />
    <Compile Include="PortalCommands.cs" />
    <Compile Include="PortalPrivateHttp.cs" />
    <Compile Include="PortalApiClientSecret.cs" />
