{
  "name": "ssam-agent-app",
  "productName": "SSAM Agent",
  "version": "0.1.0",
  "description": "The SSAM agent as a background desktop app: tray icon, the agent supervised in a child process, updates from the owner's update server.",
  "private": true,
  "type": "module",
  "main": "src/main.mjs",
  "author": "SSAM",
  "license": "UNLICENSED",
  "scripts": {
    "start": "electron .",
    "test": "node --test tests/*.test.mjs",
    "icons": "node scripts/make-icons.mjs",
    "pack:verify": "node scripts/verify-pack.mjs pack",
    "build": "node scripts/build.mjs",
    "dist:win": "node scripts/build.mjs --platform win",
    "dist:mac": "node scripts/build.mjs --platform mac"
  },
  "dependencies": {
    "electron-updater": "6.8.9"
  },
  "devDependencies": {
    "electron": "44.9.2",
    "electron-builder": "26.15.3"
  }
}
