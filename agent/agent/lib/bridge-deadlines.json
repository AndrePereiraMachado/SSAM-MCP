    "create": 180,
    "create-app": 180,
    "template-download": 180,
    "refresh-references": 300,
    "data": 180,
    "data-insert": 180,
    "data-update": 180,
    "data-delete": 180,
    "portal-call": 180,
    "portal-private-call": 180,
    "portal-private-download": 180,
    "portal-session": 180,
    "portal-upload": 780
  },
  "publishWaitSeconds": 1200,
  "queueStartSeconds": 120,
  "turnWaitSeconds": 10,
  "busyAnswerSeconds": 5,
  "commandLineSeconds": 30,
