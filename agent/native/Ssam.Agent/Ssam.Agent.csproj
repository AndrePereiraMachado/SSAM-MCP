<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <PublishAot>true</PublishAot>
    <InvariantGlobalization>true</InvariantGlobalization>
    <StripSymbols>true</StripSymbols>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <AssemblyName>ssam-agent</AssemblyName>
  </PropertyGroup>
  <ItemGroup>
    <EmbeddedResource Include="../../agent/lib/public-cookie-metadata.json" LogicalName="public-cookie-metadata.json" />
    <EmbeddedResource Include="../../agent/lib/cookie-sensitivity.ps1" LogicalName="cookie-sensitivity.ps1" />
    <Compile Include="../../agent/lib/CognitoSrp.cs" Link="CognitoSrp.cs" />
    <EmbeddedResource Include="../../agent/lib/CognitoSrp.cs" LogicalName="CognitoSrp.cs" />
    <InternalsVisibleTo Include="NativeProtocol.Tests" />
    <EmbeddedResource Include="..\..\agent\lib\users-vault.ps1" LogicalName="users-vault.ps1" />
    <EmbeddedResource Include="..\..\agent\lib\private-dialog.ps1" LogicalName="private-dialog.ps1" />
    <EmbeddedResource Include="..\..\agent\lib\private-vault.ps1" LogicalName="private-vault.ps1" />
    <EmbeddedResource Include="..\..\agent\lib\credential-vault.ps1" LogicalName="credential-vault.ps1" />
    <EmbeddedResource Include="..\..\agent\lib\credential-auth.ps1" LogicalName="credential-auth.ps1" />
  </ItemGroup>
  <!-- The owner's Ed25519 public key, the only bridge trust anchor (0.4.14-native): an explicit build input, the base64 of its
       SPKI DER, given as -p:SsamTrustPublicKey=... (scripts/build-native.mjs -trust-public-key <pem>). Empty: no anchor, remote
       bridge installation off and the hello says bridgeOffer false. An environment variable of that name is refused, so an
       ambient value can never become the anchor; the release gate then compares the core's anchor with the build input. -->
  <Target Name="SsamTrustAnchor" BeforeTargets="CoreCompile">
    <Error Condition="'$([System.Environment]::GetEnvironmentVariable(`SsamTrustPublicKey`))' != ''" Text="SsamTrustPublicKey is a build input (-p:SsamTrustPublicKey=...), never an environment variable; clear the variable." />
    <Error Condition="'$(SsamTrustPublicKey)' != '' And !$([System.Text.RegularExpressions.Regex]::IsMatch('$(SsamTrustPublicKey)', '^MCowBQYDK2VwAyEA[A-Za-z0-9+/]{43}=$'))" Text="SsamTrustPublicKey must be the base64 SPKI DER of one Ed25519 public key." />
    <PropertyGroup>
      <SsamTrustAnchorFile>$(IntermediateOutputPath)BridgeTrust.Anchor.g.cs</SsamTrustAnchorFile>
    </PropertyGroup>
    <WriteLinesToFile File="$(SsamTrustAnchorFile)" Overwrite="true" WriteOnlyWhenDifferent="true"
      Lines="namespace Ssam.Agent { internal static partial class BridgeTrust { internal const string ManifestPublicKey = &quot;$(SsamTrustPublicKey)&quot;%3B } }" />
    <ItemGroup>
      <Compile Include="$(SsamTrustAnchorFile)" />
      <FileWrites Include="$(SsamTrustAnchorFile)" />
    </ItemGroup>
  </Target>
</Project>
