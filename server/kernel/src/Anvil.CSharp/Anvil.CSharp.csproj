<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net8.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <Description>Semantic C# frontend for the existing SSAM Hybrid module compiler.</Description>
  </PropertyGroup>
  <ItemGroup>
    <ProjectReference Include="../Anvil.Authoring/Anvil.Authoring.csproj" />
    <PackageReference Include="Microsoft.CodeAnalysis.CSharp" Version="4.8.0" />
    <None Include="../../licenses/Roslyn-4.8.0.txt" Link="licenses/Roslyn-4.8.0.txt" CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest" />
    <None Include="../../licenses/csharp/**/*" Link="licenses/csharp/%(RecursiveDir)%(Filename)%(Extension)" CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest" />
  </ItemGroup>
</Project>
