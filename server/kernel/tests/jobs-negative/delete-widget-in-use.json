{
 "description": "A RECUSA do delete de um WIDGET consumido por outro widget: um Label aponta para o Input Email_Input pela propriedade TargetWidget. Sem force o delete do Input tem de ser recusado E a mensagem tem de nomear o Label (o caminho limpo esta em tests/jobs/delete-interface-consumers.json).",
 "base": "job:screen-form-reactive",
 "expectValid": true,
 "expectError": [
  "delete: refused",
  "IInput 'Email_Input' is used by 1 consumer(s)",
  "ILabel:EmailLabel/CustomProperty:TargetWidget",
  "pass \"force\": true to break them"
 ],
 "ops": [
  {"op": "create", "parent": "IMobileScreen:ContactDetail/#IMobileBlockInstanceWidget/MainContent/ContactForm", "type": "ILabel", "name": "EmailLabel", "as": "$lbl"},
  {"op": "set", "target": "$lbl", "prop": "TargetWidget", "value": "IMobileScreen:ContactDetail/#IMobileBlockInstanceWidget/MainContent/ContactForm/Email_Input"},
  {"op": "set", "target": "$lbl/#ITextWidget", "prop": "Text", "value": "Email"},

  {"op": "usages", "target": "IMobileScreen:ContactDetail/#IMobileBlockInstanceWidget/MainContent/ContactForm/Email_Input"},
  {"op": "delete", "target": "IMobileScreen:ContactDetail/#IMobileBlockInstanceWidget/MainContent/ContactForm/Email_Input"}
 ]
}
