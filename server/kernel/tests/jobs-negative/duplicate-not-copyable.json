{
 "description": "The REFUSAL of `duplicate` of a type that the platform does not copy by itself (O11 lane): an aggregate Sort has CanBeRootOfImport false (the Studio Copy is disabled for it) and only travels inside the aggregate. No destination changes that; the message says why and tells you to duplicate the IAggregateNode or create another Sort.",
 "base": "tests/fixtures/blank-service.oml",
 "expectValid": true,
 "expectError": [
  "duplicate: ISort '' cannot be copied on its own",
  "CanBeRootOfImport is false",
  "duplicate IAggregateNode 'DupQuery' instead"
 ],
 "ops": [
  {"op": "spec", "data": {"entities": [{"name": "DupEntity", "attributes": [{"name": "Title", "type": "Text", "length": 50}]}]}},
  {"op": "create", "parent": "@espace", "type": "IServerAction", "name": "DupFlow", "as": "$flow"},
  {"op": "create", "parent": "$flow", "type": "IStartNode", "as": "$start"},
  {"op": "create", "parent": "$flow", "type": "IEndNode", "as": "$end"},
  {"op": "create", "parent": "$flow", "type": "IAggregateNode", "name": "DupQuery", "as": "$query"},
  {"op": "create", "parent": "$query", "type": "IAliasedSource", "args": {"dataSource": "$DupEntity"}, "as": "$source"},
  {"op": "link", "from": "$start", "to": "$query"},
  {"op": "link", "from": "$query", "to": "$end"},
  {"op": "create", "parent": "$query", "type": "ISort", "as": "$sort"},
  {"op": "set", "target": "$sort", "prop": "Attribute", "value": "DupEntity.Title"},
  {"op": "duplicate", "target": "$sort", "as": "$copy"}
 ]
}
