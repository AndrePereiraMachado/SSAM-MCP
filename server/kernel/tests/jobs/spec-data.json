{
 "description": "Spec compacta de dados -> verbos: static entity com records, entidade publica com FK e defaults, structure; depois uma action normal usa os aliases gerados ($Contact, $Contact.Name)",
 "base": "tests/fixtures/blank-service.oml",
 "expectValid": true,
 "ops": [
  {
   "op": "spec",
   "data": {
    "static": [
     {
      "name": "Status",
      "records": [
       {
        "name": "Active",
        "label": "Active"
       },
       {
        "name": "Inactive",
        "label": "Inactive"
       }
      ]
     }
    ],
    "entities": [
     {
      "name": "Contact",
      "public": true,
      "description": "Contacto",
      "attributes": [
       {
        "name": "Name",
        "type": "Text",
        "mandatory": true,
        "length": 100
       },
       {
        "name": "Email",
        "type": "Email"
       },
       {
        "name": "StatusId",
        "type": "Status Identifier",
        "default": "Entities.Status.Active"
       },
       {
        "name": "CreatedOn",
        "type": "Date Time",
        "default": "CurrDateTime()"
       }
      ]
     }
    ],
    "structures": [
     {
      "name": "ContactSummary",
      "public": true,
      "attributes": [
       {
        "name": "Name",
        "type": "Text"
       },
       {
        "name": "Status",
        "type": "Text"
       }
      ]
     }
    ]
   }
  },
  {
   "op": "set",
   "target": "$Contact.Email",
   "prop": "Description",
   "value": "Email principal"
  },
  {
   "op": "create",
   "parent": "@espace",
   "type": "IServerAction",
   "name": "Contact_CountActive",
   "as": "$act"
  },
  {
   "op": "set",
   "target": "$act",
   "prop": "Public",
   "value": true
  },
  {
   "op": "create",
   "parent": "$act",
   "type": "IOutputParameter",
   "name": "Count",
   "as": "$out"
  },
  {
   "op": "set",
   "target": "$out",
   "prop": "DataType",
   "value": "Long Integer"
  },
  {
   "op": "create",
   "parent": "$act",
   "type": "IStartNode",
   "as": "$s0"
  },
  {
   "op": "create",
   "parent": "$act",
   "type": "IAggregateNode",
   "name": "GetActive",
   "as": "$agg"
  },
  {
   "op": "create",
   "parent": "$agg",
   "type": "IAliasedSource",
   "args": {
    "dataSource": "$Contact"
   }
  },
  {
   "op": "create",
   "parent": "$agg",
   "type": "IFilter",
   "args": {
    "condition": "Contact.StatusId = Entities.Status.Active"
   }
  },
  {
   "op": "create",
   "parent": "$act",
   "type": "IAssignNode",
   "name": "SetCount",
   "as": "$as"
  },
  {
   "op": "set",
   "target": "$as",
   "prop": "Label",
   "value": "SetCount"
  },
  {
   "op": "create",
   "parent": "$as",
   "type": "IAssignment",
   "as": "$a1"
  },
  {
   "op": "set",
   "target": "$a1",
   "prop": "Variable",
   "value": "Count"
  },
  {
   "op": "set",
   "target": "$a1",
   "prop": "Value",
   "value": "GetActive.Count"
  },
  {
   "op": "create",
   "parent": "$act",
   "type": "IEndNode",
   "as": "$s9"
  },
  {
   "op": "link",
   "from": "$s0",
   "to": "$agg"
  },
  {
   "op": "link",
   "from": "$agg",
   "to": "$as"
  },
  {
   "op": "link",
   "from": "$as",
   "to": "$s9"
  },
  {
   "op": "layout",
   "target": "$act"
  }
 ]
}