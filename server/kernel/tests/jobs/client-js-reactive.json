{
 "description": "Client action with a JavaScript node (node inputs/outputs, arguments), module Script required by the screen (RequiredScripts) and a screen action that calls the client action and uses the output",
 "base": "tests/fixtures/reactive-ui.oml",
 "expectValid": true,
 "ops": [
  {
   "op": "create",
   "parent": "@espace",
   "type": "IScript",
   "name": "Formatting",
   "as": "$script"
  },
  {
   "op": "set",
   "target": "$script",
   "prop": "JavaScript",
   "value": "window.Formatting = { slug: function (s) { return String(s || \"\").toLowerCase().trim().replace(/[^a-z0-9]+/g, \"-\"); } };"
  },
  {
   "op": "set",
   "target": "$script",
   "prop": "Description",
   "value": "Helpers de formatacao"
  },
  {
   "op": "create",
   "parent": "@espace",
   "type": "IClientAction",
   "name": "Slugify",
   "as": "$ca"
  },
  {
   "op": "set",
   "target": "$ca",
   "prop": "Function",
   "value": true
  },
  {
   "op": "create",
   "parent": "$ca",
   "type": "IInputParameter",
   "name": "Text",
   "as": "$caIn"
  },
  {
   "op": "set",
   "target": "$caIn",
   "prop": "DataType",
   "value": "Text"
  },
  {
   "op": "create",
   "parent": "$ca",
   "type": "IOutputParameter",
   "name": "Slug",
   "as": "$caOut"
  },
  {
   "op": "set",
   "target": "$caOut",
   "prop": "DataType",
   "value": "Text"
  },
  {
   "op": "create",
   "parent": "$ca",
   "type": "IStartNode",
   "as": "$c0"
  },
  {
   "op": "create",
   "parent": "$ca",
   "type": "IJavaScriptNode",
   "name": "MakeSlug",
   "as": "$js"
  },
  {
   "op": "create",
   "parent": "$js",
   "type": "IInputParameter",
   "name": "Text",
   "as": "$jsIn"
  },
  {
   "op": "set",
   "target": "$jsIn",
   "prop": "DataType",
   "value": "Text"
  },
  {
   "op": "create",
   "parent": "$js",
   "type": "IOutputParameter",
   "name": "Slug",
   "as": "$jsOut"
  },
  {
   "op": "set",
   "target": "$jsOut",
   "prop": "DataType",
   "value": "Text"
  },
  {
   "op": "set",
   "target": "$js",
   "prop": "JavaScript",
   "value": "$parameters.Slug = window.Formatting ? window.Formatting.slug($parameters.Text) : $parameters.Text;"
  },
  {
   "op": "set",
   "target": "$js/arg:Text",
   "prop": "Value",
   "value": "Text"
  },
  {
   "op": "create",
   "parent": "$ca",
   "type": "IAssignNode",
   "name": "SetOutput",
   "as": "$caAs"
  },
  {
   "op": "set",
   "target": "$caAs",
   "prop": "Label",
   "value": "SetOutput"
  },
  {
   "op": "create",
   "parent": "$caAs",
   "type": "IAssignment",
   "as": "$caA1"
  },
  {
   "op": "set",
   "target": "$caA1",
   "prop": "Variable",
   "value": "Slug"
  },
  {
   "op": "set",
   "target": "$caA1",
   "prop": "Value",
   "value": "MakeSlug.Slug"
  },
  {
   "op": "create",
   "parent": "$ca",
   "type": "IEndNode",
   "as": "$c9"
  },
  {
   "op": "link",
   "from": "$c0",
   "to": "$js"
  },
  {
   "op": "link",
   "from": "$js",
   "to": "$caAs"
  },
  {
   "op": "link",
   "from": "$caAs",
   "to": "$c9"
  },
  {
   "op": "layout",
   "target": "$ca"
  },
  {
   "op": "create",
   "parent": "IMobileFlow:MainFlow",
   "type": "IMobileScreen",
   "name": "SlugDemo",
   "as": "$scr"
  },
  {
   "op": "set",
   "target": "$scr/#IMobileBlockInstanceWidget",
   "prop": "SourceBlock",
   "value": "IMobileBlock:LayoutTopMenu"
  },
  {
   "op": "link",
   "from": "$scr",
   "connector": "RequiredScripts",
   "to": "$script"
  },
  {
   "op": "create",
   "parent": "$scr",
   "type": "ILocalVariable",
   "name": "Title",
   "as": "$vT"
  },
  {
   "op": "set",
   "target": "$vT",
   "prop": "DataType",
   "value": "Text"
  },
  {
   "op": "create",
   "parent": "$scr",
   "type": "ILocalVariable",
   "name": "Slug",
   "as": "$vS"
  },
  {
   "op": "set",
   "target": "$vS",
   "prop": "DataType",
   "value": "Text"
  },
  {
   "op": "create",
   "parent": "$scr/#IMobileBlockInstanceWidget/MainContent",
   "type": "IInput",
   "name": "TitleInput",
   "as": "$in"
  },
  {
   "op": "set",
   "target": "$in",
   "prop": "Variable",
   "value": "Title"
  },
  {
   "op": "create",
   "parent": "$scr/#IMobileBlockInstanceWidget/MainContent",
   "type": "IExpression",
   "as": "$out"
  },
  {
   "op": "set",
   "target": "$out",
   "prop": "Value",
   "value": "Slug"
  },
  {
   "op": "create",
   "parent": "$scr/#IMobileBlockInstanceWidget/MainContent",
   "type": "IButton",
   "name": "SlugButton",
   "as": "$btn"
  },
  {
   "op": "set",
   "target": "$btn/#ITextWidget",
   "prop": "Text",
   "value": "Slugify"
  },
  {
   "op": "create",
   "parent": "$scr",
   "type": "IScreenAction",
   "name": "OnSlugify",
   "as": "$sa"
  },
  {
   "op": "create",
   "parent": "$sa",
   "type": "IStartNode",
   "as": "$s0"
  },
  {
   "op": "create",
   "parent": "$sa",
   "type": "IExecuteClientActionNode",
   "name": "Slugify",
   "as": "$call"
  },
  {
   "op": "set",
   "target": "$call",
   "prop": "Action",
   "value": "IClientAction:Slugify"
  },
  {
   "op": "set",
   "target": "$call/Text",
   "prop": "Value",
   "value": "Title"
  },
  {
   "op": "create",
   "parent": "$sa",
   "type": "IAssignNode",
   "name": "SetSlug",
   "as": "$saAs"
  },
  {
   "op": "set",
   "target": "$saAs",
   "prop": "Label",
   "value": "SetSlug"
  },
  {
   "op": "create",
   "parent": "$saAs",
   "type": "IAssignment",
   "as": "$saA1"
  },
  {
   "op": "set",
   "target": "$saA1",
   "prop": "Variable",
   "value": "Slug"
  },
  {
   "op": "set",
   "target": "$saA1",
   "prop": "Value",
   "value": "Slugify.Slug"
  },
  {
   "op": "create",
   "parent": "$sa",
   "type": "IEndNode",
   "as": "$s9"
  },
  {
   "op": "link",
   "from": "$s0",
   "to": "$call"
  },
  {
   "op": "link",
   "from": "$call",
   "to": "$saAs"
  },
  {
   "op": "link",
   "from": "$saAs",
   "to": "$s9"
  },
  {
   "op": "layout",
   "target": "$sa"
  },
  {
   "op": "set",
   "target": "$btn/OnClick",
   "prop": "Destination",
   "value": "$sa"
  }
 ]
}