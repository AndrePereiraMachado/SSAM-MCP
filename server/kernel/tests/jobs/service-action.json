{
 "description": "Service action num modulo Service: Order_GetSummary(OrderId) devolve total e status; consumo remoto por outros modulos sem referencia forte a entidade",
 "base": "tests/fixtures/blank-service.oml",
 "expectValid": true,
 "ops": [
  {
   "op": "spec",
   "data": {
    "static": [
     {
      "name": "OrderStatus",
      "records": [
       {
        "name": "Open"
       },
       {
        "name": "Paid"
       },
       {
        "name": "Cancelled"
       }
      ]
     }
    ],
    "entities": [
     {
      "name": "Order",
      "public": true,
      "attributes": [
       {
        "name": "Customer",
        "type": "Text",
        "mandatory": true,
        "length": 100
       },
       {
        "name": "Total",
        "type": "Currency"
       },
       {
        "name": "StatusId",
        "type": "OrderStatus Identifier",
        "default": "Entities.OrderStatus.Open"
       }
      ]
     }
    ],
    "structures": [
     {
      "name": "OrderSummary",
      "public": true,
      "attributes": [
       {
        "name": "Customer",
        "type": "Text"
       },
       {
        "name": "Total",
        "type": "Currency"
       },
       {
        "name": "Status",
        "type": "Text"
       }
      ]
     }
    ]
   }
  },
  {
   "op": "create",
   "parent": "@espace",
   "type": "IServiceAction",
   "name": "Order_GetSummary",
   "as": "$svc"
  },
  {
   "op": "set",
   "target": "$svc",
   "prop": "Description",
   "value": "Resumo de uma encomenda para consumidores remotos"
  },
  {
   "op": "create",
   "parent": "$svc",
   "type": "IInputParameter",
   "name": "OrderId",
   "as": "$in"
  },
  {
   "op": "set",
   "target": "$in",
   "prop": "DataType",
   "value": "Order Identifier"
  },
  {
   "op": "create",
   "parent": "$svc",
   "type": "IOutputParameter",
   "name": "Summary",
   "as": "$out"
  },
  {
   "op": "set",
   "target": "$out",
   "prop": "DataType",
   "value": "OrderSummary"
  },
  {
   "op": "create",
   "parent": "$svc",
   "type": "IStartNode",
   "as": "$s0"
  },
  {
   "op": "create",
   "parent": "$svc",
   "type": "IAggregateNode",
   "name": "GetOrder",
   "as": "$agg"
  },
  {
   "op": "create",
   "parent": "$agg",
   "type": "IAliasedSource",
   "args": {
    "dataSource": "$Order"
   },
   "as": "$srcO"
  },
  {
   "op": "create",
   "parent": "$agg",
   "type": "IAliasedSource",
   "args": {
    "dataSource": "$OrderStatus"
   },
   "as": "$srcS"
  },
  {
   "op": "create",
   "parent": "$agg",
   "type": "IJoin",
   "as": "$join"
  },
  {
   "op": "set",
   "target": "$join",
   "prop": "LeftSource",
   "value": "$srcO"
  },
  {
   "op": "set",
   "target": "$join",
   "prop": "RightSource",
   "value": "$srcS"
  },
  {
   "op": "set",
   "target": "$join",
   "prop": "JoinType",
   "value": "Inner"
  },
  {
   "op": "set",
   "target": "$join",
   "prop": "Condition",
   "value": "Order.StatusId = OrderStatus.Id"
  },
  {
   "op": "create",
   "parent": "$agg",
   "type": "IFilter",
   "args": {
    "condition": "Order.Id = OrderId"
   }
  },
  {
   "op": "create",
   "parent": "$svc",
   "type": "IIfNode",
   "name": "Found",
   "as": "$if"
  },
  {
   "op": "set",
   "target": "$if",
   "prop": "Label",
   "value": "Found"
  },
  {
   "op": "set",
   "target": "$if",
   "prop": "Condition",
   "value": "not GetOrder.List.Empty"
  },
  {
   "op": "create",
   "parent": "$svc",
   "type": "IAssignNode",
   "name": "SetSummary",
   "as": "$as"
  },
  {
   "op": "set",
   "target": "$as",
   "prop": "Label",
   "value": "SetSummary"
  },
  {
   "op": "create",
   "parent": "$as",
   "type": "IAssignment",
   "as": "$a1"
  },
  {
   "op": "set",
   "target": "$a1",
   "prop": "Variable",
   "value": "Summary.Customer"
  },
  {
   "op": "set",
   "target": "$a1",
   "prop": "Value",
   "value": "GetOrder.List.Current.Order.Customer"
  },
  {
   "op": "create",
   "parent": "$as",
   "type": "IAssignment",
   "as": "$a2"
  },
  {
   "op": "set",
   "target": "$a2",
   "prop": "Variable",
   "value": "Summary.Total"
  },
  {
   "op": "set",
   "target": "$a2",
   "prop": "Value",
   "value": "GetOrder.List.Current.Order.Total"
  },
  {
   "op": "create",
   "parent": "$as",
   "type": "IAssignment",
   "as": "$a3"
  },
  {
   "op": "set",
   "target": "$a3",
   "prop": "Variable",
   "value": "Summary.Status"
  },
  {
   "op": "set",
   "target": "$a3",
   "prop": "Value",
   "value": "GetOrder.List.Current.OrderStatus.Label"
  },
  {
   "op": "create",
   "parent": "@espace",
   "type": "IUserException",
   "name": "OrderNotFound",
   "as": "$ex"
  },
  {
   "op": "create",
   "parent": "$svc",
   "type": "IRaiseExceptionNode",
   "name": "RaiseNotFound",
   "as": "$raise"
  },
  {
   "op": "set",
   "target": "$raise",
   "prop": "Exception",
   "value": "$ex"
  },
  {
   "op": "set",
   "target": "$raise",
   "prop": "ExceptionMessage",
   "value": "\"Order not found\""
  },
  {
   "op": "create",
   "parent": "$svc",
   "type": "IEndNode",
   "as": "$s9"
  },
  {
   "op": "link",
   "from": "$s0",
   "to": "$agg"
  },
  {
   "op": "link",
   "from": "$agg",
   "to": "$if"
  },
  {
   "op": "link",
   "from": "$if",
   "connector": "TrueTarget",
   "to": "$as"
  },
  {
   "op": "link",
   "from": "$if",
   "connector": "FalseTarget",
   "to": "$raise"
  },
  {
   "op": "link",
   "from": "$as",
   "to": "$s9"
  },
  {
   "op": "layout",
   "target": "$svc"
  }
 ]
}