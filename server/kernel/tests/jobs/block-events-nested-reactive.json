{
 "description": "Bloco DENTRO de bloco, com o evento a subir dois andares. ColorPicker (interno) declara OnPick e dispara-o; ColorPanel (externo) INSTANCIA o ColorPicker dentro de si - o consumidor de um evento de bloco nao precisa de ser uma tela - e o handler dessa instancia e uma IScreenAction do PROPRIO bloco externo (ColorPicker1_OnPick), que nao trata o assunto: reembala e dispara o SEU evento OnPicked com um ITriggerNode. So a tela ColorDemo, no topo, e que trata. A prova esta nos dois `usages`: OnPick tem o ITriggerNode no bloco interno e o IEventHandler dentro do BLOCO externo (caminho sem IMobileScreen), e OnPicked tem o ITriggerNode dentro do handler do evento de baixo e o IEventHandler na tela. E assim que se ve a cadeia de propagacao sem abrir o Studio.",
 "base": "tests/fixtures/reactive-ui.oml",
 "expectValid": true,
 "expectedMessages": [],
 "ops": [
  {"op": "create", "parent": "IMobileFlow:MainFlow", "type": "IMobileBlock", "name": "ColorPicker", "as": "$inner", "_why": "1. o bloco de baixo: quem origina o evento"},
  {"op": "create", "parent": "$inner", "type": "IInputParameter", "name": "Palette", "as": "$inPal"},
  {"op": "set", "target": "$inPal", "prop": "DataType", "value": "Text"},
  {"op": "create", "parent": "$inner", "type": "IBlockEvent", "name": "OnPick", "as": "$evIn"},
  {"op": "set", "target": "$evIn", "prop": "Description", "value": "Disparado quando uma cor e escolhida no seletor"},
  {"op": "set", "target": "$evIn", "prop": "IsMandatory", "value": true, "_why": "obrigatorio: quem instancia o seletor TEM de tratar; o bloco externo e que cumpre"},
  {"op": "create", "parent": "$evIn", "type": "IInputParameter", "name": "Color", "as": "$evInColor"},
  {"op": "set", "target": "$evInColor", "prop": "DataType", "value": "Text"},
  {"op": "create", "parent": "$inner", "type": "IButton", "name": "PickButton", "as": "$innerBtn"},
  {"op": "set", "target": "$innerBtn/#ITextWidget", "prop": "Text", "value": "Pick"},
  {"op": "create", "parent": "$inner", "type": "IScreenAction", "name": "Pick", "as": "$innerAct"},
  {"op": "create", "parent": "$innerAct", "type": "IStartNode", "as": "$p0"},
  {"op": "create", "parent": "$innerAct", "type": "ITriggerNode", "name": "RaiseOnPick", "as": "$pTrg"},
  {"op": "set", "target": "$pTrg", "prop": "Event", "value": "$evIn"},
  {"op": "set", "target": "$pTrg/Color", "prop": "Value", "value": "Palette + \"-red\""},
  {"op": "create", "parent": "$innerAct", "type": "IEndNode", "as": "$p9"},
  {"op": "link", "from": "$p0", "to": "$pTrg"},
  {"op": "link", "from": "$pTrg", "to": "$p9"},
  {"op": "layout", "target": "$innerAct"},
  {"op": "set", "target": "$innerBtn/OnClick", "prop": "Destination", "value": "$innerAct"},

  {"op": "create", "parent": "IMobileFlow:MainFlow", "type": "IMobileBlock", "name": "ColorPanel", "as": "$outer", "_why": "2. o bloco do meio: consome o evento de baixo e declara o seu proprio"},
  {"op": "create", "parent": "$outer", "type": "IInputParameter", "name": "PanelName", "as": "$outName"},
  {"op": "set", "target": "$outName", "prop": "DataType", "value": "Text"},
  {"op": "create", "parent": "$outer", "type": "IBlockEvent", "name": "OnPicked", "as": "$evOut"},
  {"op": "set", "target": "$evOut", "prop": "Description", "value": "Repassa a escolha do seletor interno, dizendo de que painel veio"},
  {"op": "set", "target": "$evOut", "prop": "IsMandatory", "value": true},
  {"op": "create", "parent": "$evOut", "type": "IInputParameter", "name": "Color", "as": "$evOutColor"},
  {"op": "set", "target": "$evOutColor", "prop": "DataType", "value": "Text"},
  {"op": "create", "parent": "$evOut", "type": "IInputParameter", "name": "Source", "as": "$evOutSrc", "_why": "o andar do meio ACRESCENTA informacao que o bloco de baixo nao tem"},
  {"op": "set", "target": "$evOutSrc", "prop": "DataType", "value": "Text"},

  {"op": "create", "parent": "$outer", "type": "IScreenAction", "name": "ColorPicker1_OnPick", "as": "$relay", "_why": "3. o repasse: handler do evento de baixo cujo corpo e um ITriggerNode do evento de cima"},
  {"op": "create", "parent": "$relay", "type": "IInputParameter", "name": "Color", "as": "$relayIn"},
  {"op": "set", "target": "$relayIn", "prop": "DataType", "value": "Text"},
  {"op": "create", "parent": "$relay", "type": "IStartNode", "as": "$r0"},
  {"op": "create", "parent": "$relay", "type": "ITriggerNode", "name": "RaiseOnPicked", "as": "$rTrg"},
  {"op": "set", "target": "$rTrg", "prop": "Event", "value": "$evOut"},
  {"op": "set", "target": "$rTrg/Color", "prop": "Value", "value": "Color", "_why": "Color aqui e o INPUT do handler, ja fora do escopo do evento de baixo"},
  {"op": "set", "target": "$rTrg/Source", "prop": "Value", "value": "PanelName"},
  {"op": "create", "parent": "$relay", "type": "IEndNode", "as": "$r9"},
  {"op": "link", "from": "$r0", "to": "$rTrg"},
  {"op": "link", "from": "$rTrg", "to": "$r9"},
  {"op": "layout", "target": "$relay"},

  {"op": "create", "parent": "$outer", "type": "IMobileBlockInstanceWidget", "name": "ColorPicker1", "as": "$innerInst", "source": "IMobileBlock:ColorPicker", "_why": "4. a instancia mora DENTRO de um bloco, nao de uma tela; o handler e uma action do bloco"},
  {"op": "set", "target": "$innerInst/Palette", "prop": "Value", "value": "PanelName"},
  {"op": "set", "target": "$innerInst/OnPick", "prop": "Handler", "value": "$relay"},
  {"op": "set", "target": "$innerInst/OnPick/Color", "prop": "Value", "value": "Color"},

  {"op": "create", "parent": "IMobileFlow:MainFlow", "type": "IMobileScreen", "name": "ColorDemo", "as": "$scr", "_why": "5. o topo: a unica que trata de verdade"},
  {"op": "set", "target": "$scr/#IMobileBlockInstanceWidget", "prop": "SourceBlock", "value": "IMobileBlock:LayoutTopMenu"},
  {"op": "create", "parent": "$scr/#IMobileBlockInstanceWidget/Title", "type": "IExpression", "as": "$title"},
  {"op": "set", "target": "$title", "prop": "Value", "value": "\"Colors\""},
  {"op": "create", "parent": "$scr", "type": "ILocalVariable", "name": "PickedColor", "as": "$v1"},
  {"op": "set", "target": "$v1", "prop": "DataType", "value": "Text"},
  {"op": "create", "parent": "$scr", "type": "ILocalVariable", "name": "PickedSource", "as": "$v2"},
  {"op": "set", "target": "$v2", "prop": "DataType", "value": "Text"},

  {"op": "create", "parent": "$scr", "type": "IScreenAction", "name": "ColorPanel1_OnPicked", "as": "$h"},
  {"op": "create", "parent": "$h", "type": "IInputParameter", "name": "Color", "as": "$hColor"},
  {"op": "set", "target": "$hColor", "prop": "DataType", "value": "Text"},
  {"op": "create", "parent": "$h", "type": "IInputParameter", "name": "Source", "as": "$hSrc"},
  {"op": "set", "target": "$hSrc", "prop": "DataType", "value": "Text"},
  {"op": "create", "parent": "$h", "type": "IStartNode", "as": "$h0"},
  {"op": "create", "parent": "$h", "type": "IAssignNode", "as": "$hAs"},
  {"op": "set", "target": "$hAs", "prop": "Label", "value": "KeepPick"},
  {"op": "create", "parent": "$hAs", "type": "IAssignment", "as": "$hA1"},
  {"op": "set", "target": "$hA1", "prop": "Variable", "value": "PickedColor"},
  {"op": "set", "target": "$hA1", "prop": "Value", "value": "Color"},
  {"op": "create", "parent": "$hAs", "type": "IAssignment", "as": "$hA2"},
  {"op": "set", "target": "$hA2", "prop": "Variable", "value": "PickedSource"},
  {"op": "set", "target": "$hA2", "prop": "Value", "value": "Source"},
  {"op": "create", "parent": "$h", "type": "IEndNode", "as": "$h9"},
  {"op": "link", "from": "$h0", "to": "$hAs"},
  {"op": "link", "from": "$hAs", "to": "$h9"},
  {"op": "layout", "target": "$h"},

  {"op": "create", "parent": "$scr/#IMobileBlockInstanceWidget/MainContent", "type": "IMobileBlockInstanceWidget", "name": "ColorPanel1", "as": "$outerInst", "source": "IMobileBlock:ColorPanel"},
  {"op": "set", "target": "$outerInst/PanelName", "prop": "Value", "value": "\"principal\""},
  {"op": "set", "target": "$outerInst/OnPicked", "prop": "Handler", "value": "$h"},
  {"op": "set", "target": "$outerInst/OnPicked/Color", "prop": "Value", "value": "Color"},
  {"op": "set", "target": "$outerInst/OnPicked/Source", "prop": "Value", "value": "Source"},

  {"op": "create", "parent": "$scr/#IMobileBlockInstanceWidget/MainContent", "type": "IExpression", "as": "$echo"},
  {"op": "set", "target": "$echo", "prop": "Value", "value": "PickedColor + \" via \" + PickedSource"},

  {"op": "usages", "target": "$evIn", "_why": "andar de baixo: o IEventHandler esta dentro de IMobileBlock:ColorPanel, sem nenhum IMobileScreen no caminho"},
  {"op": "usages", "target": "$evOut", "_why": "andar de cima: o ITriggerNode esta DENTRO do handler do evento de baixo - a costura da propagacao"},
  {"op": "usages", "target": "$inner", "_why": "o bloco interno tem um unico consumidor, e e um bloco"},
  {"op": "get", "target": "$innerInst/#IEventHandler"},
  {"op": "dump", "target": "$outer", "depth": 6},
  {"op": "dump", "target": "$scr", "depth": 7}
 ]
}
