{
 "description": "Refatoracao real: uma action nova substitui a antiga em TODOS os chamadores (op replace, que usa o mesmo ReplaceReferences do proprio Studio), e a antiga fica sem consumidores e pode ser apagada. Prova o ciclo criar -> repontar -> apagar sem quebrar a tela que chamava.",
 "base": "job:screen-form-reactive",
 "expectValid": true,
 "ops": [
  {"op": "usages", "target": "IServerAction:Contact_Save", "_why": "quem chama hoje: a screen action Save da tela"},

  {"op": "create", "parent": "@espace", "type": "IServerAction", "name": "Contact_Store", "as": "$new"},
  {"op": "set", "target": "$new", "prop": "Description", "value": "Substitui Contact_Save: mesma assinatura, gravacao com auditoria"},
  {"op": "create", "parent": "$new", "type": "IInputParameter", "name": "Contact", "as": "$newIn"},
  {"op": "set", "target": "$newIn", "prop": "DataType", "value": "Contact"},
  {"op": "create", "parent": "$new", "type": "IStartNode", "as": "$n0"},
  {"op": "create", "parent": "$new", "type": "IExecuteServerActionNode", "name": "CreateOrUpdateContact", "as": "$cu"},
  {"op": "set", "target": "$cu", "prop": "Action", "value": "IActionSignature:CreateOrUpdateContact"},
  {"op": "set", "target": "$cu/Source", "prop": "Value", "value": "Contact"},
  {"op": "create", "parent": "$new", "type": "IEndNode", "as": "$n9"},
  {"op": "link", "from": "$n0", "to": "$cu"},
  {"op": "link", "from": "$cu", "to": "$n9"},
  {"op": "layout", "target": "$new"},

  {"op": "replace", "from": "IServerAction:Contact_Save", "to": "$new"},

  {"op": "usages", "target": "IServerAction:Contact_Save", "_why": "tem de ficar sem consumidores reais"},
  {"op": "usages", "target": "$new", "_why": "os consumidores passaram para ca"},

  {"op": "delete", "target": "IServerAction:Contact_Save", "_why": "sem consumidores, o delete nao precisa de force"},
  {"op": "find", "name": "Contact_Store"}
 ]
}
