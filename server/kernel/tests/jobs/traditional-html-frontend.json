{
  "description": "Traditional frontend through the html document entry: native block, field, server screen action, conditional result and scoped CSS. No DefaultScreen write.",
  "base": "traditional-ui.oml",
  "expectValid": true,
  "ops": [
    {"op":"html","data":{"html":"<block name=\"AuditHeader\"><style>.audit-header { font-size: 28px; font-weight: bold; color: #123456; padding: 16px 0; }</style><div class=\"audit-header\">Traditional frontend</div></block>"}},
    {"op":"html","data":{"html":"<screen name=\"FrontendAudit\" title=\"Traditional frontend\" roles=\"Registered\" actions=\"Confirm\"><var name=\"Name\" type=\"Text\"/><var name=\"Message\" type=\"Text\"/><style>.audit-page { max-width: 720px; margin: 32px auto; padding: 24px; border: 1px solid #ccd6e0; background: #f5f8fb; } .audit-result { padding: 16px; background: #dff5e7; color: #14532d; margin-top: 16px; } .audit-input { width: 100%; margin: 12px 0; } .audit-button { background: #123456; color: white; padding: 10px 18px; }</style><div class=\"audit-page\"><Block name=\"AuditHeader\"/><div>Type a name to test the native event:</div><input id=\"NameInput\" bind=\"Name\" type=\"text\" class=\"audit-input\"/><button id=\"ConfirmButton\" class=\"audit-button\" onclick=\"Confirm\">Confirm</button><div if=\"Message &lt;&gt; &quot;&quot;\" class=\"audit-result\">{{ Message }}</div><div else>The result appears after you confirm.</div></div></screen>"}},
    {"op":"logic","data":{"flow":"action FrontendAudit.Confirm\n  assign Message = \"Hello, \" + Name + \"! The Traditional frontend works.\"\n  end\n"}}
  ]
}
