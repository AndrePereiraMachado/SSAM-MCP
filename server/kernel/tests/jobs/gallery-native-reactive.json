  {"op": "set", "target": "$bga", "prop": "Value", "value": "\"A\""},
  {"op": "create", "parent": "$bga", "type": "IExpression", "as": "$bgat"},
  {"op": "set", "target": "$bgat", "prop": "Value", "value": "\"A\""},
  {"op": "create", "parent": "$bg", "type": "IButtonGroupItem", "name": "ItemB", "as": "$bgb"},
  {"op": "set", "target": "$bgb", "prop": "Value", "value": "\"B\""},
  {"op": "create", "parent": "$bgb", "type": "IExpression", "as": "$bgbt"},
  {"op": "set", "target": "$bgbt", "prop": "Value", "value": "\"B\""},
