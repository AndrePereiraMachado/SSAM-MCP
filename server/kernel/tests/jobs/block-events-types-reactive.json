{
 "description": "O CONTRATO do evento de bloco aguenta o vocabulario inteiro de tipos, nao so Text e Integer: o bloco CartPanel declara OnCheckout com OITO parametros - uma LISTA de estrutura (CartLine List), um REGISTO (CartLine), um identificador de entidade (Product Identifier), Decimal, Integer, Date Time, Boolean e Text. O ITriggerNode manda os oito, o handler CartPanel1_OnCheckout recebe-os com os mesmos tipos e a tela USA os dois compostos: o registo por atributo (LastSummary.Qty) e a lista como Source de uma IList que itera com LastLines.Current.Qty (lista de estrutura nao tem o nivel intermediario do aggregate). Complementa tests/jobs/block-events-reactive.json, que so prova Integer e Text.",
 "base": "tests/fixtures/reactive-ui.oml",
 "expectValid": true,
 "expectedMessages": [],
 "ops": [
  {"op": "create", "parent": "@espace", "type": "IServerEntity", "name": "Product", "as": "$ent", "_why": "1. os tipos compostos precisam de uma entidade e de uma structure reais"},
  {"op": "create", "parent": "$ent", "type": "IEntityAttribute", "name": "Id", "as": "$pid"},
  {"op": "set", "target": "$pid", "prop": "DataType", "value": "Long Integer"},
  {"op": "set", "target": "$pid", "prop": "IsAutoNumber", "value": "Yes"},
  {"op": "set", "target": "$ent", "prop": "IdentifierAttribute", "value": "$pid"},
  {"op": "create", "parent": "$ent", "type": "IEntityAttribute", "name": "Name", "as": "$pname"},
  {"op": "set", "target": "$pname", "prop": "DataType", "value": "Text"},

  {"op": "create", "parent": "@espace", "type": "IStructure", "name": "CartLine", "as": "$st"},
  {"op": "create", "parent": "$st", "type": "IStructureAttribute", "name": "ProductId", "as": "$slp"},
  {"op": "set", "target": "$slp", "prop": "DataType", "value": "Product Identifier"},
  {"op": "create", "parent": "$st", "type": "IStructureAttribute", "name": "Qty", "as": "$slq"},
  {"op": "set", "target": "$slq", "prop": "DataType", "value": "Integer"},
  {"op": "create", "parent": "$st", "type": "IStructureAttribute", "name": "LineTotal", "as": "$slt"},
  {"op": "set", "target": "$slt", "prop": "DataType", "value": "Decimal"},

  {"op": "create", "parent": "IMobileFlow:MainFlow", "type": "IMobileBlock", "name": "CartPanel", "as": "$blk", "_why": "2. o bloco produtor; Lines e Line sao o que vai viajar no evento"},
  {"op": "create", "parent": "$blk", "type": "IInputParameter", "name": "Title", "as": "$blkIn"},
  {"op": "set", "target": "$blkIn", "prop": "DataType", "value": "Text"},
  {"op": "create", "parent": "$blk", "type": "ILocalVariable", "name": "Lines", "as": "$vLines"},
  {"op": "set", "target": "$vLines", "prop": "DataType", "value": "CartLine List"},
  {"op": "create", "parent": "$blk", "type": "ILocalVariable", "name": "Line", "as": "$vLine"},
  {"op": "set", "target": "$vLine", "prop": "DataType", "value": "CartLine"},

  {"op": "create", "parent": "$blk", "type": "IBlockEvent", "name": "OnCheckout", "as": "$ev", "_why": "3. o contrato: um IInputParameter por tipo, do mais simples ao composto"},
  {"op": "set", "target": "$ev", "prop": "Description", "value": "Disparado quando o carrinho fecha; leva as linhas inteiras, nao so o total"},
  {"op": "set", "target": "$ev", "prop": "IsMandatory", "value": false},
  {"op": "create", "parent": "$ev", "type": "IInputParameter", "name": "Lines", "as": "$e1", "_why": "LISTA de estrutura"},
  {"op": "set", "target": "$e1", "prop": "DataType", "value": "CartLine List"},
  {"op": "create", "parent": "$ev", "type": "IInputParameter", "name": "Summary", "as": "$e2", "_why": "REGISTO"},
  {"op": "set", "target": "$e2", "prop": "DataType", "value": "CartLine"},
  {"op": "create", "parent": "$ev", "type": "IInputParameter", "name": "Total", "as": "$e3"},
  {"op": "set", "target": "$e3", "prop": "DataType", "value": "Decimal"},
  {"op": "create", "parent": "$ev", "type": "IInputParameter", "name": "Count", "as": "$e4"},
  {"op": "set", "target": "$e4", "prop": "DataType", "value": "Integer"},
  {"op": "create", "parent": "$ev", "type": "IInputParameter", "name": "PlacedAt", "as": "$e5"},
  {"op": "set", "target": "$e5", "prop": "DataType", "value": "Date Time"},
  {"op": "create", "parent": "$ev", "type": "IInputParameter", "name": "Express", "as": "$e6"},
  {"op": "set", "target": "$e6", "prop": "DataType", "value": "Boolean"},
  {"op": "create", "parent": "$ev", "type": "IInputParameter", "name": "Note", "as": "$e7"},
  {"op": "set", "target": "$e7", "prop": "DataType", "value": "Text"},
  {"op": "create", "parent": "$ev", "type": "IInputParameter", "name": "FirstProductId", "as": "$e8", "_why": "IDENTIFICADOR de entidade"},
  {"op": "set", "target": "$e8", "prop": "DataType", "value": "Product Identifier"},

  {"op": "create", "parent": "$blk", "type": "IContainer", "name": "Body", "as": "$body", "_why": "4. conteudo do bloco e o botao que dispara"},
  {"op": "create", "parent": "$body", "type": "IExpression", "as": "$capt"},
  {"op": "set", "target": "$capt", "prop": "Value", "value": "Title"},
  {"op": "create", "parent": "$body", "type": "IButton", "name": "CheckoutButton", "as": "$btn"},
  {"op": "set", "target": "$btn/#ITextWidget", "prop": "Text", "value": "Checkout"},

  {"op": "create", "parent": "$blk", "type": "IScreenAction", "name": "Checkout", "as": "$act", "_why": "5. disparar: cada argumento e uma expressao no escopo do BLOCO"},
  {"op": "create", "parent": "$act", "type": "IStartNode", "as": "$c0"},
  {"op": "create", "parent": "$act", "type": "IAssignNode", "as": "$cAs"},
  {"op": "set", "target": "$cAs", "prop": "Label", "value": "BuildLine"},
  {"op": "create", "parent": "$cAs", "type": "IAssignment", "as": "$cA1"},
  {"op": "set", "target": "$cA1", "prop": "Variable", "value": "Line.Qty"},
  {"op": "set", "target": "$cA1", "prop": "Value", "value": "1"},
  {"op": "create", "parent": "$cAs", "type": "IAssignment", "as": "$cA2"},
  {"op": "set", "target": "$cA2", "prop": "Variable", "value": "Line.LineTotal"},
  {"op": "set", "target": "$cA2", "prop": "Value", "value": "9.99"},
  {"op": "create", "parent": "$act", "type": "ITriggerNode", "name": "RaiseOnCheckout", "as": "$trg"},
  {"op": "set", "target": "$trg", "prop": "Event", "value": "$ev"},
  {"op": "set", "target": "$trg/Lines", "prop": "Value", "value": "Lines"},
  {"op": "set", "target": "$trg/Summary", "prop": "Value", "value": "Line"},
  {"op": "set", "target": "$trg/Total", "prop": "Value", "value": "Line.LineTotal"},
  {"op": "set", "target": "$trg/Count", "prop": "Value", "value": "Lines.Length"},
  {"op": "set", "target": "$trg/PlacedAt", "prop": "Value", "value": "CurrDateTime()"},
  {"op": "set", "target": "$trg/Express", "prop": "Value", "value": "True"},
  {"op": "set", "target": "$trg/Note", "prop": "Value", "value": "\"pedido de \" + Title"},
  {"op": "set", "target": "$trg/FirstProductId", "prop": "Value", "value": "Line.ProductId"},
  {"op": "create", "parent": "$act", "type": "IEndNode", "as": "$c9"},
  {"op": "link", "from": "$c0", "to": "$cAs"},
  {"op": "link", "from": "$cAs", "to": "$trg"},
  {"op": "link", "from": "$trg", "to": "$c9"},
  {"op": "layout", "target": "$act"},
  {"op": "set", "target": "$btn/OnClick", "prop": "Destination", "value": "$act"},

  {"op": "create", "parent": "IMobileFlow:MainFlow", "type": "IMobileScreen", "name": "CartDemo", "as": "$scr", "_why": "6. a tela consumidora guarda os oito valores em variaveis do mesmo tipo"},
  {"op": "set", "target": "$scr/#IMobileBlockInstanceWidget", "prop": "SourceBlock", "value": "IMobileBlock:LayoutTopMenu"},
  {"op": "create", "parent": "$scr/#IMobileBlockInstanceWidget/Title", "type": "IExpression", "as": "$title"},
  {"op": "set", "target": "$title", "prop": "Value", "value": "\"Cart\""},

  {"op": "create", "parent": "$scr", "type": "ILocalVariable", "name": "LastLines", "as": "$s1"},
  {"op": "set", "target": "$s1", "prop": "DataType", "value": "CartLine List"},
  {"op": "create", "parent": "$scr", "type": "ILocalVariable", "name": "LastSummary", "as": "$s2"},
  {"op": "set", "target": "$s2", "prop": "DataType", "value": "CartLine"},
  {"op": "create", "parent": "$scr", "type": "ILocalVariable", "name": "LastTotal", "as": "$s3"},
  {"op": "set", "target": "$s3", "prop": "DataType", "value": "Decimal"},
  {"op": "create", "parent": "$scr", "type": "ILocalVariable", "name": "LastCount", "as": "$s4"},
  {"op": "set", "target": "$s4", "prop": "DataType", "value": "Integer"},
  {"op": "create", "parent": "$scr", "type": "ILocalVariable", "name": "LastPlacedAt", "as": "$s5"},
  {"op": "set", "target": "$s5", "prop": "DataType", "value": "Date Time"},
  {"op": "create", "parent": "$scr", "type": "ILocalVariable", "name": "LastExpress", "as": "$s6"},
  {"op": "set", "target": "$s6", "prop": "DataType", "value": "Boolean"},
  {"op": "create", "parent": "$scr", "type": "ILocalVariable", "name": "LastNote", "as": "$s7"},
  {"op": "set", "target": "$s7", "prop": "DataType", "value": "Text"},
  {"op": "create", "parent": "$scr", "type": "ILocalVariable", "name": "LastProductId", "as": "$s8"},
  {"op": "set", "target": "$s8", "prop": "DataType", "value": "Product Identifier"},

  {"op": "create", "parent": "$scr", "type": "IScreenAction", "name": "CartPanel1_OnCheckout", "as": "$h", "_why": "7. o handler: um IInputParameter por parametro do evento, com o MESMO tipo"},
  {"op": "create", "parent": "$h", "type": "IInputParameter", "name": "Lines", "as": "$h1"},
  {"op": "set", "target": "$h1", "prop": "DataType", "value": "CartLine List"},
  {"op": "create", "parent": "$h", "type": "IInputParameter", "name": "Summary", "as": "$h2"},
  {"op": "set", "target": "$h2", "prop": "DataType", "value": "CartLine"},
  {"op": "create", "parent": "$h", "type": "IInputParameter", "name": "Total", "as": "$h3"},
  {"op": "set", "target": "$h3", "prop": "DataType", "value": "Decimal"},
  {"op": "create", "parent": "$h", "type": "IInputParameter", "name": "Count", "as": "$h4"},
  {"op": "set", "target": "$h4", "prop": "DataType", "value": "Integer"},
  {"op": "create", "parent": "$h", "type": "IInputParameter", "name": "PlacedAt", "as": "$h5"},
  {"op": "set", "target": "$h5", "prop": "DataType", "value": "Date Time"},
  {"op": "create", "parent": "$h", "type": "IInputParameter", "name": "Express", "as": "$h6"},
  {"op": "set", "target": "$h6", "prop": "DataType", "value": "Boolean"},
  {"op": "create", "parent": "$h", "type": "IInputParameter", "name": "Note", "as": "$h7"},
  {"op": "set", "target": "$h7", "prop": "DataType", "value": "Text"},
  {"op": "create", "parent": "$h", "type": "IInputParameter", "name": "FirstProductId", "as": "$h8"},
  {"op": "set", "target": "$h8", "prop": "DataType", "value": "Product Identifier"},
  {"op": "create", "parent": "$h", "type": "IStartNode", "as": "$h0"},
  {"op": "create", "parent": "$h", "type": "IAssignNode", "as": "$hAs"},
  {"op": "set", "target": "$hAs", "prop": "Label", "value": "KeepAll"},
  {"op": "create", "parent": "$hAs", "type": "IAssignment", "as": "$k1"},
  {"op": "set", "target": "$k1", "prop": "Variable", "value": "LastLines"},
  {"op": "set", "target": "$k1", "prop": "Value", "value": "Lines"},
  {"op": "create", "parent": "$hAs", "type": "IAssignment", "as": "$k2"},
  {"op": "set", "target": "$k2", "prop": "Variable", "value": "LastSummary"},
  {"op": "set", "target": "$k2", "prop": "Value", "value": "Summary"},
  {"op": "create", "parent": "$hAs", "type": "IAssignment", "as": "$k3"},
  {"op": "set", "target": "$k3", "prop": "Variable", "value": "LastTotal"},
  {"op": "set", "target": "$k3", "prop": "Value", "value": "Total"},
  {"op": "create", "parent": "$hAs", "type": "IAssignment", "as": "$k4"},
  {"op": "set", "target": "$k4", "prop": "Variable", "value": "LastCount"},
  {"op": "set", "target": "$k4", "prop": "Value", "value": "Count"},
  {"op": "create", "parent": "$hAs", "type": "IAssignment", "as": "$k5"},
  {"op": "set", "target": "$k5", "prop": "Variable", "value": "LastPlacedAt"},
  {"op": "set", "target": "$k5", "prop": "Value", "value": "PlacedAt"},
  {"op": "create", "parent": "$hAs", "type": "IAssignment", "as": "$k6"},
  {"op": "set", "target": "$k6", "prop": "Variable", "value": "LastExpress"},
  {"op": "set", "target": "$k6", "prop": "Value", "value": "Express"},
  {"op": "create", "parent": "$hAs", "type": "IAssignment", "as": "$k7"},
  {"op": "set", "target": "$k7", "prop": "Variable", "value": "LastNote"},
