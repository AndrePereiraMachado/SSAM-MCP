{
 "description": "Modulo produtor (service): entidade Product publica e server action Product_GetById publica, para ser referenciado por outro modulo",
 "base": "tests/fixtures/blank-service.oml",
 "expectValid": true,
 "ops": [
  {"op": "create", "parent": "@espace", "type": "IServerEntity", "name": "Product", "as": "$ent"},
  {"op": "set", "target": "$ent", "prop": "Public", "value": true},
  {"op": "set", "target": "$ent", "prop": "ExposeReadOnly", "value": true},
  {"op": "create", "parent": "$ent", "type": "IEntityAttribute", "name": "Id", "as": "$id"},
  {"op": "set", "target": "$id", "prop": "DataType", "value": "Long Integer"},
  {"op": "set", "target": "$id", "prop": "IsAutoNumber", "value": "Yes"},
  {"op": "set", "target": "$ent", "prop": "IdentifierAttribute", "value": "$id"},
  {"op": "create", "parent": "$ent", "type": "IEntityAttribute", "name": "Name", "as": "$name"},
  {"op": "set", "target": "$name", "prop": "DataType", "value": "Text"},
  {"op": "set", "target": "$name", "prop": "IsMandatory", "value": true},
  {"op": "create", "parent": "$ent", "type": "IEntityAttribute", "name": "Price", "as": "$price"},
  {"op": "set", "target": "$price", "prop": "DataType", "value": "Currency"},

  {"op": "create", "parent": "@espace", "type": "IStructure", "name": "ProductSummary", "as": "$st"},
  {"op": "set", "target": "$st", "prop": "Public", "value": true},
  {"op": "create", "parent": "$st", "type": "IStructureAttribute", "name": "Name", "as": "$stName"},
  {"op": "set", "target": "$stName", "prop": "DataType", "value": "Text"},
  {"op": "create", "parent": "$st", "type": "IStructureAttribute", "name": "Price", "as": "$stPrice"},
  {"op": "set", "target": "$stPrice", "prop": "DataType", "value": "Currency"},

  {"op": "create", "parent": "@espace", "type": "IServerAction", "name": "Product_GetById", "as": "$act"},
  {"op": "set", "target": "$act", "prop": "Public", "value": true},
  {"op": "create", "parent": "$act", "type": "IInputParameter", "name": "ProductId", "as": "$in"},
  {"op": "set", "target": "$in", "prop": "DataType", "value": "Product Identifier"},
  {"op": "create", "parent": "$act", "type": "IOutputParameter", "name": "Summary", "as": "$out"},
  {"op": "set", "target": "$out", "prop": "DataType", "value": "ProductSummary"},
  {"op": "create", "parent": "$act", "type": "IStartNode", "as": "$s0"},
  {"op": "create", "parent": "$act", "type": "IAggregateNode", "name": "GetProduct", "as": "$agg"},
  {"op": "create", "parent": "$agg", "type": "IAliasedSource", "args": {"dataSource": "IServerEntity:Product"}},
  {"op": "create", "parent": "$agg", "type": "IFilter", "args": {"condition": "Product.Id = ProductId"}},
  {"op": "create", "parent": "$act", "type": "IAssignNode", "name": "SetSummary", "as": "$as"},
  {"op": "set", "target": "$as", "prop": "Label", "value": "SetSummary"},
  {"op": "create", "parent": "$as", "type": "IAssignment", "as": "$a1"},
  {"op": "set", "target": "$a1", "prop": "Variable", "value": "Summary.Name"},
  {"op": "set", "target": "$a1", "prop": "Value", "value": "GetProduct.List.Current.Product.Name"},
  {"op": "create", "parent": "$as", "type": "IAssignment", "as": "$a2"},
  {"op": "set", "target": "$a2", "prop": "Variable", "value": "Summary.Price"},
  {"op": "set", "target": "$a2", "prop": "Value", "value": "GetProduct.List.Current.Product.Price"},
  {"op": "create", "parent": "$act", "type": "IEndNode", "as": "$s9"},
  {"op": "link", "from": "$s0", "to": "$agg"},
  {"op": "link", "from": "$agg", "to": "$as"},
  {"op": "link", "from": "$as", "to": "$s9"},
  {"op": "layout", "target": "$act"}
 ]
}
