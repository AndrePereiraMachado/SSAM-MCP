{
 "description": "REST consumido chamado numa server action (IExecuteServerActionNode com IRestAction) e Assign do output (job da investigacao REST de 2026-09-04)",
 "base": "job:rest-consume-get",
 "expectValid": true,
 "ops": [
  {
   "op": "create",
   "parent": "@espace",
   "type": "IServerAction",
   "name": "Cep_Lookup",
   "as": "$act"
  },
  {
   "op": "set",
   "target": "$act",
   "prop": "Public",
   "value": true
  },
  {
   "op": "create",
   "parent": "$act",
   "type": "IInputParameter",
   "name": "Cep",
   "as": "$pin"
  },
  {
   "op": "set",
   "target": "$pin",
   "prop": "DataType",
   "value": "Text"
  },
  {
   "op": "create",
   "parent": "$act",
   "type": "IOutputParameter",
   "name": "Uf",
   "as": "$pout"
  },
  {
   "op": "set",
   "target": "$pout",
   "prop": "DataType",
   "value": "Text"
  },
  {
   "op": "create",
   "parent": "$act",
   "type": "IStartNode",
   "name": "Start",
   "as": "$start"
  },
  {
   "op": "create",
   "parent": "$act",
   "type": "IExecuteServerActionNode",
   "name": "GetAddressByCep",
   "as": "$call"
  },
  {
   "op": "set",
   "target": "$call",
   "prop": "Action",
   "value": "IRestAction:GetAddressByCep"
  },
  {
   "op": "set",
   "target": "$call/CEP",
   "prop": "Value",
   "value": "Cep"
  },
  {
   "op": "create",
   "parent": "$act",
   "type": "IAssignNode",
   "name": "SetOut",
   "as": "$assign"
  },
  {
   "op": "set",
   "target": "$assign",
   "prop": "Label",
   "value": "SetOut"
  },
  {
   "op": "create",
   "parent": "$assign",
   "type": "IAssignment",
   "as": "$a1"
  },
  {
   "op": "set",
   "target": "$a1",
   "prop": "Variable",
   "value": "Uf"
  },
  {
   "op": "set",
   "target": "$a1",
   "prop": "Value",
   "value": "GetAddressByCep.Response.uf"
  },
  {
   "op": "create",
   "parent": "$act",
   "type": "IEndNode",
   "name": "End",
   "as": "$end"
  },
  {
   "op": "link",
   "from": "$start",
   "to": "$call"
  },
  {
   "op": "link",
   "from": "$call",
   "to": "$assign"
  },
  {
   "op": "link",
   "from": "$assign",
   "to": "$end"
  },
  {
   "op": "layout",
   "target": "$act"
  }
 ]
}