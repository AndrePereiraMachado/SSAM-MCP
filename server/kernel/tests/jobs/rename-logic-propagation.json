{
 "description": "Rename LOGIC and read back the text that was left behind. Script, client action, server action, screen action, JavaScript node parameters and screen variable are renamed one by one; after each rename the job reads with get/dump the JavaScript body (which cites window.Formatting and $parameters.Text), the button caption and the consumers' expressions. What follows by key (Destination, Action, arguments, expressions that cite nodes and variables) and what stays frozen (JavaScript, captions, Description) sit side by side in the same run.",
 "base": "tests/fixtures/reactive-ui.oml",
 "expectValid": true,
 "expectedMessages": [],
 "ops": [
  {"op": "create", "parent": "@espace", "type": "IScript", "name": "Formatting", "as": "$script", "_why": "1. the module script: its name appears INSIDE the JavaScript itself and in the JavaScript of whoever uses it"},
  {"op": "set", "target": "$script", "prop": "JavaScript", "value": "window.Formatting = { slug: function (s) { return String(s || \"\").toLowerCase().trim().replace(/[^a-z0-9]+/g, \"-\"); } };"},
  {"op": "set", "target": "$script", "prop": "Description", "value": "Helpers de formatacao: window.Formatting"},

  {"op": "create", "parent": "@espace", "type": "IClientAction", "name": "Slugify", "as": "$ca", "_why": "2. the client action with a JavaScript node: node parameters cited as $parameters.<Name>"},
  {"op": "set", "target": "$ca", "prop": "Function", "value": true},
  {"op": "create", "parent": "$ca", "type": "IInputParameter", "name": "Text", "as": "$caIn"},
  {"op": "set", "target": "$caIn", "prop": "DataType", "value": "Text"},
  {"op": "create", "parent": "$ca", "type": "IOutputParameter", "name": "Slug", "as": "$caOut"},
  {"op": "set", "target": "$caOut", "prop": "DataType", "value": "Text"},
  {"op": "create", "parent": "$ca", "type": "IStartNode", "as": "$c0"},
  {"op": "create", "parent": "$ca", "type": "IJavaScriptNode", "name": "MakeSlug", "as": "$js"},
  {"op": "create", "parent": "$js", "type": "IInputParameter", "name": "Text", "as": "$jsIn"},
  {"op": "set", "target": "$jsIn", "prop": "DataType", "value": "Text"},
  {"op": "create", "parent": "$js", "type": "IOutputParameter", "name": "Slug", "as": "$jsOut"},
  {"op": "set", "target": "$jsOut", "prop": "DataType", "value": "Text"},
  {"op": "set", "target": "$js", "prop": "JavaScript", "value": "$parameters.Slug = window.Formatting ? window.Formatting.slug($parameters.Text) : $parameters.Text;"},
  {"op": "set", "target": "$js/arg:Text", "prop": "Value", "value": "Text"},
  {"op": "create", "parent": "$ca", "type": "IAssignNode", "as": "$caAs"},
  {"op": "set", "target": "$caAs", "prop": "Label", "value": "SetOutput"},
  {"op": "create", "parent": "$caAs", "type": "IAssignment", "as": "$caA1"},
  {"op": "set", "target": "$caA1", "prop": "Variable", "value": "Slug"},
  {"op": "set", "target": "$caA1", "prop": "Value", "value": "MakeSlug.Slug"},
  {"op": "create", "parent": "$ca", "type": "IEndNode", "as": "$c9"},
  {"op": "link", "from": "$c0", "to": "$js"},
  {"op": "link", "from": "$js", "to": "$caAs"},
  {"op": "link", "from": "$caAs", "to": "$c9"},
  {"op": "layout", "target": "$ca"},

  {"op": "create", "parent": "@espace", "type": "IServerAction", "name": "Slug_Save", "as": "$sv", "_why": "3. a server action for the screen to call: the consumer node inherits the action name"},
  {"op": "create", "parent": "$sv", "type": "IInputParameter", "name": "Slug", "as": "$svIn"},
  {"op": "set", "target": "$svIn", "prop": "DataType", "value": "Text"},
  {"op": "create", "parent": "$sv", "type": "IOutputParameter", "name": "Stored", "as": "$svOut"},
  {"op": "set", "target": "$svOut", "prop": "DataType", "value": "Text"},
  {"op": "create", "parent": "$sv", "type": "IStartNode", "as": "$v0"},
  {"op": "create", "parent": "$sv", "type": "IAssignNode", "as": "$vAs"},
  {"op": "set", "target": "$vAs", "prop": "Label", "value": "SetStored"},
  {"op": "create", "parent": "$vAs", "type": "IAssignment", "as": "$vA1"},
  {"op": "set", "target": "$vA1", "prop": "Variable", "value": "Stored"},
  {"op": "set", "target": "$vA1", "prop": "Value", "value": "\"Slug_Save guardou: \" + Slug"},
  {"op": "create", "parent": "$sv", "type": "IEndNode", "as": "$v9"},
  {"op": "link", "from": "$v0", "to": "$vAs"},
  {"op": "link", "from": "$vAs", "to": "$v9"},
  {"op": "layout", "target": "$sv"},

  {"op": "create", "parent": "IMobileFlow:MainFlow", "type": "IMobileScreen", "name": "SlugDemo", "as": "$scr", "_why": "4. the consumer screen: variables, a button with a text caption and a screen action that calls both actions"},
  {"op": "set", "target": "$scr/#IMobileBlockInstanceWidget", "prop": "SourceBlock", "value": "IMobileBlock:LayoutTopMenu"},
  {"op": "link", "from": "$scr", "connector": "RequiredScripts", "to": "$script"},
  {"op": "create", "parent": "$scr", "type": "ILocalVariable", "name": "Title", "as": "$vT"},
  {"op": "set", "target": "$vT", "prop": "DataType", "value": "Text"},
  {"op": "create", "parent": "$scr", "type": "ILocalVariable", "name": "Slug", "as": "$vS"},
  {"op": "set", "target": "$vS", "prop": "DataType", "value": "Text"},
  {"op": "create", "parent": "$scr/#IMobileBlockInstanceWidget/MainContent", "type": "IInput", "name": "TitleInput", "as": "$in"},
  {"op": "set", "target": "$in", "prop": "Variable", "value": "Title"},
  {"op": "create", "parent": "$scr/#IMobileBlockInstanceWidget/MainContent", "type": "IExpression", "as": "$out"},
  {"op": "set", "target": "$out", "prop": "Value", "value": "\"Title: \" + Title + \" -> \" + Slug"},
  {"op": "create", "parent": "$scr/#IMobileBlockInstanceWidget/MainContent", "type": "IButton", "name": "SlugButton", "as": "$btn"},
  {"op": "set", "target": "$btn/#ITextWidget", "prop": "Text", "value": "Slugify o Title"},

  {"op": "create", "parent": "$scr", "type": "IScreenAction", "name": "OnSlugify", "as": "$sa"},
  {"op": "create", "parent": "$sa", "type": "IStartNode", "as": "$s0"},
  {"op": "create", "parent": "$sa", "type": "IExecuteClientActionNode", "name": "Slugify", "as": "$call"},
  {"op": "set", "target": "$call", "prop": "Action", "value": "IClientAction:Slugify"},
  {"op": "set", "target": "$call/Text", "prop": "Value", "value": "Title"},
  {"op": "create", "parent": "$sa", "type": "IAssignNode", "as": "$saAs"},
  {"op": "set", "target": "$saAs", "prop": "Label", "value": "SetSlug"},
  {"op": "create", "parent": "$saAs", "type": "IAssignment", "as": "$saA1"},
  {"op": "set", "target": "$saA1", "prop": "Variable", "value": "Slug"},
  {"op": "set", "target": "$saA1", "prop": "Value", "value": "Slugify.Slug"},
  {"op": "create", "parent": "$sa", "type": "IExecuteServerActionNode", "name": "Slug_Save", "as": "$svCall"},
  {"op": "set", "target": "$svCall", "prop": "Action", "value": "$sv"},
  {"op": "set", "target": "$svCall/Slug", "prop": "Value", "value": "Slug"},
  {"op": "create", "parent": "$sa", "type": "IEndNode", "as": "$s9"},
  {"op": "link", "from": "$s0", "to": "$call"},
  {"op": "link", "from": "$call", "to": "$saAs"},
  {"op": "link", "from": "$saAs", "to": "$svCall"},
  {"op": "link", "from": "$svCall", "to": "$s9"},
  {"op": "layout", "target": "$sa"},
  {"op": "set", "target": "$btn/OnClick", "prop": "Destination", "value": "$sa"},

  {"op": "usages", "target": "$script", "_why": "5. BEFORE: who uses the script and who uses the client action"},
  {"op": "usages", "target": "$ca"},

  {"op": "rename", "target": "$script", "name": "TextHelpers", "_why": "6. the script: the object name changes (and with it the RuntimePath of the .js file), the JavaScript body does not"},
  {"op": "get", "target": "$script", "_why": "READ BACK: the RuntimePath already says TextHelpers.js, but the body still declares window.Formatting and the Description still cites it"},
  {"op": "get", "target": "$js", "_why": "and the JavaScript of whoever uses it still calls window.Formatting.slug: the global is text inside the body, it does not follow the object name"},
  {"op": "usages", "target": "$script", "_why": "the screen's RequiredScripts link survived by key, even though the text did not change"},
  {"op": "set", "target": "$script", "prop": "JavaScript", "value": "window.TextHelpers = { slug: function (s) { return String(s || \"\").toLowerCase().trim().replace(/[^a-z0-9]+/g, \"-\"); } };", "_why": "I fix the script body by hand; the consumer is fixed further below, in the same set that handles the parameters"},

  {"op": "rename", "target": "$ca", "name": "TextToSlug", "_why": "7. the client action called by the screen. FINDING: the consumer NODE is renamed by the platform (Slugify -> TextToSlug), but the expression that read the output of THAT NODE by the old name is NOT rewritten: it is left pointing to a name that no longer exists"},
  {"op": "get", "target": "$call", "_why": "READ BACK: the consumer node is now named TextToSlug and the Action is still the same key"},
  {"op": "get", "target": "$saA1", "_why": "the expression still says Slugify.Slug -- nobody rewrote it"},

  {"op": "rename", "target": "$caOut", "name": "SlugText", "_why": "8. the output of the client action: the consumer's expression does not follow either"},
  {"op": "get", "target": "$saA1"},
  {"op": "set", "target": "$saA1", "prop": "Value", "value": "TextToSlug.SlugText", "_why": "the fix is BY HAND: this is what the rename does not do on its own"},
  {"op": "get", "target": "$saA1"},

  {"op": "rename", "target": "$jsIn", "name": "Term", "_why": "9. the JavaScript node parameter: FINDING -- the JavaScript BODY itself is rewritten, $parameters.Text becomes $parameters.Term (the platform reads the script, it is not just text)"},
  {"op": "get", "target": "$js"},
  {"op": "rename", "target": "$jsOut", "name": "Handle", "_why": "10. the JavaScript node output: $parameters.Slug also becomes $parameters.Handle; what does NOT follow is the expression MakeSlug.Slug that reads the node output"},
  {"op": "get", "target": "$js"},
  {"op": "get", "target": "$caA1", "_why": "this one still says MakeSlug.Slug"},
  {"op": "set", "target": "$caA1", "prop": "Value", "value": "MakeSlug.Handle", "_why": "conserto a mao da expressao"},
  {"op": "set", "target": "$js", "prop": "JavaScript", "value": "$parameters.Handle = window.TextHelpers ? window.TextHelpers.slug($parameters.Term) : $parameters.Term;", "_why": "I fix by hand what was left in the body: the global window.Formatting, which is the OLD name of the Script and does not follow because it is declared as text inside the script itself"},
  {"op": "get", "target": "$js"},

  {"op": "rename", "target": "$sv", "name": "Slug_Persist", "_why": "11. the server action: the consumer node is the literal that cites the old name inside it"},
  {"op": "get", "target": "$svCall"},
  {"op": "get", "target": "$vA1"},

  {"op": "rename", "target": "$sa", "name": "Slugify_Click", "_why": "12. the screen action: the button's Destination follows, the button caption does not"},
  {"op": "get", "target": "$btn/OnClick"},
  {"op": "get", "target": "$btn/#ITextWidget"},

  {"op": "rename", "target": "$vT", "name": "SourceText", "_why": "13. the screen variable: all the expressions that read it are rewritten"},
  {"op": "get", "target": "$out"},
  {"op": "get", "target": "$in"},

  {"op": "create", "parent": "@espace", "type": "IRestService", "name": "SlugApi", "as": "$api", "_why": "14. the URL case: an exposed REST endpoint, whose public URL is text in the URLPath"},
  {"op": "create", "parent": "@espace", "type": "IStructure", "name": "SlugInfo", "as": "$st"},
  {"op": "create", "parent": "$st", "type": "IStructureAttribute", "name": "Slug", "as": "$st1"},
  {"op": "set", "target": "$st1", "prop": "DataType", "value": "Text"},
  {"op": "create", "parent": "$api", "type": "IRestServiceAction", "name": "GetSlug", "as": "$m"},
  {"op": "set", "target": "$m", "prop": "HTTPMethod", "value": "GET"},
  {"op": "set", "target": "$m", "prop": "URLPath", "value": "/GetSlug/{Text}"},
  {"op": "create", "parent": "$m", "type": "IRestServiceActionInput", "name": "Text", "as": "$mIn"},
  {"op": "set", "target": "$mIn", "prop": "DataType", "value": "Text"},
  {"op": "set", "target": "$mIn", "prop": "ReceiveIn", "value": "URL"},
  {"op": "set", "target": "$mIn", "prop": "IsMandatory", "value": true},
  {"op": "create", "parent": "$m", "type": "IRestServiceActionOutput", "name": "Info", "as": "$mOut"},
  {"op": "set", "target": "$mOut", "prop": "DataType", "value": "SlugInfo"},
  {"op": "set", "target": "$mOut", "prop": "SendIn", "value": "Body"},
  {"op": "create", "parent": "$m", "type": "IAssignNode", "name": "SetOut", "as": "$mAs"},
  {"op": "set", "target": "$mAs", "prop": "Label", "value": "SetOut"},
  {"op": "create", "parent": "$mAs", "type": "IAssignment", "as": "$mA1"},
  {"op": "set", "target": "$mA1", "prop": "Variable", "value": "Info.Slug"},
  {"op": "set", "target": "$mA1", "prop": "Value", "value": "Text"},
  {"op": "link", "from": "$m/#IStartNode", "to": "$mAs"},
  {"op": "link", "from": "$mAs", "to": "$m/#IEndNode"},
  {"op": "layout", "target": "$m"},

  {"op": "rename", "target": "$m", "name": "SlugOf", "_why": "15. rename the exposed REST method. FINDING contrary to what was expected: the URLPath is NOT static text -- the segment with the method name is rewritten and the public URL of the endpoint changes on its own, which breaks whoever consumes it from OUTSIDE the module (and Verify has no way to warn)"},
  {"op": "get", "target": "$m", "_why": "LER DE VOLTA: /GetSlug/{Text} passou a /SlugOf/{Text}"},
  {"op": "rename", "target": "$mIn", "name": "Term", "_why": "16. rename the input that appears INSIDE the URL"},
  {"op": "get", "target": "$m", "_why": "the placeholder followed too: /SlugOf/{Term}"},
  {"op": "get", "target": "$mA1", "_why": "and the expression that reads the input was rewritten, like any parameter"},

  {"op": "dump", "target": "$scr", "depth": 6},
  {"op": "dump", "target": "$ca", "depth": 4}
 ]
}
