{
 "description": "Renomear LOGICA e ler de volta o texto que ficou para tras. Script, client action, server action, screen action, parametros de no JavaScript e variavel de tela sao renomeados um a um; depois de cada rename o job le com get/dump o corpo JavaScript (que cita window.Formatting e $parameters.Text), a legenda do botao e as expressoes dos consumidores. O que segue por chave (Destination, Action, argumentos, expressoes que citam nos e variaveis) e o que fica congelado (JavaScript, legendas, Description) ficam lado a lado na mesma corrida.",
 "base": "tests/fixtures/reactive-ui.oml",
 "expectValid": true,
 "expectedMessages": [],
 "ops": [
  {"op": "create", "parent": "@espace", "type": "IScript", "name": "Formatting", "as": "$script", "_why": "1. o script do modulo: o nome dele aparece DENTRO do proprio JavaScript e no JavaScript de quem o usa"},
  {"op": "set", "target": "$script", "prop": "JavaScript", "value": "window.Formatting = { slug: function (s) { return String(s || \"\").toLowerCase().trim().replace(/[^a-z0-9]+/g, \"-\"); } };"},
  {"op": "set", "target": "$script", "prop": "Description", "value": "Helpers de formatacao: window.Formatting"},

  {"op": "create", "parent": "@espace", "type": "IClientAction", "name": "Slugify", "as": "$ca", "_why": "2. a client action com um no JavaScript: parametros do no citados como $parameters.<Nome>"},
  {"op": "set", "target": "$ca", "prop": "Function", "value": true},
  {"op": "create", "parent": "$ca", "type": "IInputParameter", "name": "Text", "as": "$caIn"},
  {"op": "set", "target": "$caIn", "prop": "DataType", "value": "Text"},
  {"op": "create", "parent": "$ca", "type": "IOutputParameter", "name": "Slug", "as": "$caOut"},
  {"op": "set", "target": "$caOut", "prop": "DataType", "value": "Text"},
  {"op": "create", "parent": "$ca", "type": "IStartNode", "as": "$c0"},
  {"op": "create", "parent": "$ca", "type": "IJavaScriptNode", "name": "MakeSlug", "as": "$js"},
  {"op": "create", "parent": "$js", "type": "IInputParameter", "name": "Text", "as": "$jsIn"},
  {"op": "set", "target": "$jsIn", "prop": "DataType", "value": "Text"},
  {"op": "create", "parent": "$js", "type": "IOutputParameter", "name": "Slug", "as": "$jsOut"},
  {"op": "set", "target": "$jsOut", "prop": "DataType", "value": "Text"},
  {"op": "set", "target": "$js", "prop": "JavaScript", "value": "$parameters.Slug = window.Formatting ? window.Formatting.slug($parameters.Text) : $parameters.Text;"},
  {"op": "set", "target": "$js/arg:Text", "prop": "Value", "value": "Text"},
  {"op": "create", "parent": "$ca", "type": "IAssignNode", "as": "$caAs"},
  {"op": "set", "target": "$caAs", "prop": "Label", "value": "SetOutput"},
  {"op": "create", "parent": "$caAs", "type": "IAssignment", "as": "$caA1"},
  {"op": "set", "target": "$caA1", "prop": "Variable", "value": "Slug"},
  {"op": "set", "target": "$caA1", "prop": "Value", "value": "MakeSlug.Slug"},
  {"op": "create", "parent": "$ca", "type": "IEndNode", "as": "$c9"},
  {"op": "link", "from": "$c0", "to": "$js"},
  {"op": "link", "from": "$js", "to": "$caAs"},
  {"op": "link", "from": "$caAs", "to": "$c9"},
  {"op": "layout", "target": "$ca"},

  {"op": "create", "parent": "@espace", "type": "IServerAction", "name": "Slug_Save", "as": "$sv", "_why": "3. uma server action para a tela chamar: o no consumidor herda o nome da action"},
  {"op": "create", "parent": "$sv", "type": "IInputParameter", "name": "Slug", "as": "$svIn"},
  {"op": "set", "target": "$svIn", "prop": "DataType", "value": "Text"},
  {"op": "create", "parent": "$sv", "type": "IOutputParameter", "name": "Stored", "as": "$svOut"},
  {"op": "set", "target": "$svOut", "prop": "DataType", "value": "Text"},
  {"op": "create", "parent": "$sv", "type": "IStartNode", "as": "$v0"},
  {"op": "create", "parent": "$sv", "type": "IAssignNode", "as": "$vAs"},
  {"op": "set", "target": "$vAs", "prop": "Label", "value": "SetStored"},
  {"op": "create", "parent": "$vAs", "type": "IAssignment", "as": "$vA1"},
  {"op": "set", "target": "$vA1", "prop": "Variable", "value": "Stored"},
  {"op": "set", "target": "$vA1", "prop": "Value", "value": "\"Slug_Save guardou: \" + Slug"},
  {"op": "create", "parent": "$sv", "type": "IEndNode", "as": "$v9"},
  {"op": "link", "from": "$v0", "to": "$vAs"},
  {"op": "link", "from": "$vAs", "to": "$v9"},
  {"op": "layout", "target": "$sv"},

  {"op": "create", "parent": "IMobileFlow:MainFlow", "type": "IMobileScreen", "name": "SlugDemo", "as": "$scr", "_why": "4. a tela consumidora: variaveis, botao com legenda de texto e screen action que chama as duas actions"},
  {"op": "set", "target": "$scr/#IMobileBlockInstanceWidget", "prop": "SourceBlock", "value": "IMobileBlock:LayoutTopMenu"},
  {"op": "link", "from": "$scr", "connector": "RequiredScripts", "to": "$script"},
  {"op": "create", "parent": "$scr", "type": "ILocalVariable", "name": "Title", "as": "$vT"},
  {"op": "set", "target": "$vT", "prop": "DataType", "value": "Text"},
  {"op": "create", "parent": "$scr", "type": "ILocalVariable", "name": "Slug", "as": "$vS"},
  {"op": "set", "target": "$vS", "prop": "DataType", "value": "Text"},
  {"op": "create", "parent": "$scr/#IMobileBlockInstanceWidget/MainContent", "type": "IInput", "name": "TitleInput", "as": "$in"},
  {"op": "set", "target": "$in", "prop": "Variable", "value": "Title"},
  {"op": "create", "parent": "$scr/#IMobileBlockInstanceWidget/MainContent", "type": "IExpression", "as": "$out"},
  {"op": "set", "target": "$out", "prop": "Value", "value": "\"Title: \" + Title + \" -> \" + Slug"},
  {"op": "create", "parent": "$scr/#IMobileBlockInstanceWidget/MainContent", "type": "IButton", "name": "SlugButton", "as": "$btn"},
  {"op": "set", "target": "$btn/#ITextWidget", "prop": "Text", "value": "Slugify o Title"},

  {"op": "create", "parent": "$scr", "type": "IScreenAction", "name": "OnSlugify", "as": "$sa"},
  {"op": "create", "parent": "$sa", "type": "IStartNode", "as": "$s0"},
  {"op": "create", "parent": "$sa", "type": "IExecuteClientActionNode", "name": "Slugify", "as": "$call"},
  {"op": "set", "target": "$call", "prop": "Action", "value": "IClientAction:Slugify"},
  {"op": "set", "target": "$call/Text", "prop": "Value", "value": "Title"},
  {"op": "create", "parent": "$sa", "type": "IAssignNode", "as": "$saAs"},
  {"op": "set", "target": "$saAs", "prop": "Label", "value": "SetSlug"},
  {"op": "create", "parent": "$saAs", "type": "IAssignment", "as": "$saA1"},
  {"op": "set", "target": "$saA1", "prop": "Variable", "value": "Slug"},
  {"op": "set", "target": "$saA1", "prop": "Value", "value": "Slugify.Slug"},
  {"op": "create", "parent": "$sa", "type": "IExecuteServerActionNode", "name": "Slug_Save", "as": "$svCall"},
  {"op": "set", "target": "$svCall", "prop": "Action", "value": "$sv"},
  {"op": "set", "target": "$svCall/Slug", "prop": "Value", "value": "Slug"},
  {"op": "create", "parent": "$sa", "type": "IEndNode", "as": "$s9"},
  {"op": "link", "from": "$s0", "to": "$call"},
  {"op": "link", "from": "$call", "to": "$saAs"},
  {"op": "link", "from": "$saAs", "to": "$svCall"},
  {"op": "link", "from": "$svCall", "to": "$s9"},
  {"op": "layout", "target": "$sa"},
  {"op": "set", "target": "$btn/OnClick", "prop": "Destination", "value": "$sa"},

  {"op": "usages", "target": "$script", "_why": "5. ANTES: quem usa o script e quem usa a client action"},
  {"op": "usages", "target": "$ca"},

  {"op": "rename", "target": "$script", "name": "TextHelpers", "_why": "6. o script: o nome do objeto muda (e com ele o RuntimePath do ficheiro .js), o corpo JavaScript nao"},
  {"op": "get", "target": "$script", "_why": "LER DE VOLTA: o RuntimePath ja diz TextHelpers.js, mas o corpo ainda declara window.Formatting e a Description ainda o cita"},
  {"op": "get", "target": "$js", "_why": "e o JavaScript de quem o usa continua a chamar window.Formatting.slug: o global e texto dentro do corpo, nao acompanha o nome do objeto"},
  {"op": "usages", "target": "$script", "_why": "a ligacao RequiredScripts da tela sobreviveu por chave, apesar de o texto nao ter mudado"},
  {"op": "set", "target": "$script", "prop": "JavaScript", "value": "window.TextHelpers = { slug: function (s) { return String(s || \"\").toLowerCase().trim().replace(/[^a-z0-9]+/g, \"-\"); } };", "_why": "conserto a mao do corpo do script; o consumidor e consertado mais abaixo, no mesmo set que trata os parametros"},

  {"op": "rename", "target": "$ca", "name": "TextToSlug", "_why": "7. a client action chamada pela tela. ACHADO: o NO consumidor e renomeado pela plataforma (Slugify -> TextToSlug), mas a expressao que lia a saida DESSE NO pelo nome antigo NAO e reescrita: fica a apontar para um nome que ja nao existe"},
  {"op": "get", "target": "$call", "_why": "LER DE VOLTA: o no consumidor passou a chamar-se TextToSlug e o Action continua a mesma chave"},
  {"op": "get", "target": "$saA1", "_why": "a expressao ainda diz Slugify.Slug -- ninguem a reescreveu"},

  {"op": "rename", "target": "$caOut", "name": "SlugText", "_why": "8. o output da client action: a expressao do consumidor tambem nao acompanha"},
  {"op": "get", "target": "$saA1"},
  {"op": "set", "target": "$saA1", "prop": "Value", "value": "TextToSlug.SlugText", "_why": "o conserto e A MAO: e isto que o rename nao faz por si"},
  {"op": "get", "target": "$saA1"},

  {"op": "rename", "target": "$jsIn", "name": "Term", "_why": "9. o parametro do no JavaScript: ACHADO -- o proprio CORPO em JavaScript e reescrito, $parameters.Text passa a $parameters.Term (a plataforma le o script, nao e so texto)"},
  {"op": "get", "target": "$js"},
  {"op": "rename", "target": "$jsOut", "name": "Handle", "_why": "10. o output do no JavaScript: $parameters.Slug tambem passa a $parameters.Handle; o que NAO acompanha e a expressao MakeSlug.Slug que le a saida do no"},
  {"op": "get", "target": "$js"},
  {"op": "get", "target": "$caA1", "_why": "esta continua a dizer MakeSlug.Slug"},
  {"op": "set", "target": "$caA1", "prop": "Value", "value": "MakeSlug.Handle", "_why": "conserto a mao da expressao"},
  {"op": "set", "target": "$js", "prop": "JavaScript", "value": "$parameters.Handle = window.TextHelpers ? window.TextHelpers.slug($parameters.Term) : $parameters.Term;", "_why": "conserto a mao do que sobrou no corpo: o global window.Formatting, que e o nome ANTIGO do Script e nao acompanha porque e declarado como texto dentro do proprio script"},
  {"op": "get", "target": "$js"},

  {"op": "rename", "target": "$sv", "name": "Slug_Persist", "_why": "11. a server action: o no consumidor e o literal que cita o nome antigo dentro dela"},
  {"op": "get", "target": "$svCall"},
  {"op": "get", "target": "$vA1"},

  {"op": "rename", "target": "$sa", "name": "Slugify_Click", "_why": "12. a screen action: o Destination do botao segue, a legenda do botao nao"},
  {"op": "get", "target": "$btn/OnClick"},
  {"op": "get", "target": "$btn/#ITextWidget"},

  {"op": "rename", "target": "$vT", "name": "SourceText", "_why": "13. a variavel da tela: todas as expressoes que a leem sao reescritas"},
  {"op": "get", "target": "$out"},
  {"op": "get", "target": "$in"},

  {"op": "create", "parent": "@espace", "type": "IRestService", "name": "SlugApi", "as": "$api", "_why": "14. o caso das URLs: um endpoint REST exposto, cuja URL publica e texto no URLPath"},
  {"op": "create", "parent": "@espace", "type": "IStructure", "name": "SlugInfo", "as": "$st"},
  {"op": "create", "parent": "$st", "type": "IStructureAttribute", "name": "Slug", "as": "$st1"},
  {"op": "set", "target": "$st1", "prop": "DataType", "value": "Text"},
  {"op": "create", "parent": "$api", "type": "IRestServiceAction", "name": "GetSlug", "as": "$m"},
  {"op": "set", "target": "$m", "prop": "HTTPMethod", "value": "GET"},
  {"op": "set", "target": "$m", "prop": "URLPath", "value": "/GetSlug/{Text}"},
  {"op": "create", "parent": "$m", "type": "IRestServiceActionInput", "name": "Text", "as": "$mIn"},
  {"op": "set", "target": "$mIn", "prop": "DataType", "value": "Text"},
  {"op": "set", "target": "$mIn", "prop": "ReceiveIn", "value": "URL"},
  {"op": "set", "target": "$mIn", "prop": "IsMandatory", "value": true},
  {"op": "create", "parent": "$m", "type": "IRestServiceActionOutput", "name": "Info", "as": "$mOut"},
  {"op": "set", "target": "$mOut", "prop": "DataType", "value": "SlugInfo"},
  {"op": "set", "target": "$mOut", "prop": "SendIn", "value": "Body"},
  {"op": "create", "parent": "$m", "type": "IAssignNode", "name": "SetOut", "as": "$mAs"},
  {"op": "set", "target": "$mAs", "prop": "Label", "value": "SetOut"},
  {"op": "create", "parent": "$mAs", "type": "IAssignment", "as": "$mA1"},
  {"op": "set", "target": "$mA1", "prop": "Variable", "value": "Info.Slug"},
  {"op": "set", "target": "$mA1", "prop": "Value", "value": "Text"},
  {"op": "link", "from": "$m/#IStartNode", "to": "$mAs"},
  {"op": "link", "from": "$mAs", "to": "$m/#IEndNode"},
  {"op": "layout", "target": "$m"},

  {"op": "rename", "target": "$m", "name": "SlugOf", "_why": "15. renomear o metodo REST exposto. ACHADO ao contrario do esperado: o URLPath NAO e texto parado -- o segmento com o nome do metodo e reescrito e a URL publica do endpoint muda sozinha, o que quebra quem a consome de FORA do modulo (e o Verify nao tem como avisar)"},
  {"op": "get", "target": "$m", "_why": "LER DE VOLTA: /GetSlug/{Text} passou a /SlugOf/{Text}"},
  {"op": "rename", "target": "$mIn", "name": "Term", "_why": "16. renomear o input que aparece DENTRO da URL"},
  {"op": "get", "target": "$m", "_why": "o placeholder acompanhou tambem: /SlugOf/{Term}"},
  {"op": "get", "target": "$mA1", "_why": "e a expressao que le o input foi reescrita, como qualquer parametro"},

  {"op": "dump", "target": "$scr", "depth": 6},
  {"op": "dump", "target": "$ca", "depth": 4}
 ]
}
