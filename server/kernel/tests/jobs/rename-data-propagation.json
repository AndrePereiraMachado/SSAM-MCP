{
 "description": "Renomear DADOS e ler de volta o que ficou para tras. A entidade Contact vira Person e o atributo Email vira EmailAddress; uma variavel local tambem e renomeada. O que a plataforma reescreve sozinha (expressoes da tela, statement do SQL, DataType dos parametros, atributos do indice) e o que NAO acompanha (Description da entidade e do atributo, nome do indice IX_Contact_Email, literais de texto, nomes de aggregate/widgets/parametros que citam o nome antigo) sao lidos com get/dump DEPOIS do rename, no proprio job.",
 "base": "job:screen-form-reactive",
 "expectValid": true,
 "expectedMessages": [],
 "ops": [
  {"op": "set", "target": "IServerEntity:Contact", "prop": "Public", "value": true, "_why": "1. texto que nao e modelo: descricao da entidade e do atributo citam o nome antigo"},
  {"op": "set", "target": "IServerEntity:Contact", "prop": "Description", "value": "Agenda de contactos. O endereco vive em Contact.Email."},
  {"op": "set", "target": "IServerEntity:Contact/Email", "prop": "Description", "value": "Email do Contact, mostrado no ecra ContactDetail."},
  {"op": "set", "target": "IServerEntity:Contact/Email", "prop": "Label", "value": "Email do Contact"},

  {"op": "create", "parent": "IServerEntity:Contact", "type": "EntityIndex", "name": "IX_Contact_Phone", "args": {"unique": false, "attributes": ["IServerEntity:Contact/Phone"]}, "_why": "2. o indice: a entidade e uma referencia (segue), o NOME do indice e texto (nao segue)"},

  {"op": "create", "parent": "@espace", "type": "IServerAction", "name": "Contact_Report", "as": "$rep", "_why": "3. consumidores de logica: SQL sobre a entidade, literal de texto e variavel local"},
  {"op": "set", "target": "$rep", "prop": "Public", "value": true},
  {"op": "create", "parent": "$rep", "type": "IOutputParameter", "name": "Rows", "as": "$repRows"},
