  {"op": "usages", "target": "IServerEntity:Person", "max": 30, "_why": "os mesmos consumidores, agora sob o nome novo"},

  {"op": "rename", "target": "IServerEntity:Person/Email", "name": "EmailAddress", "_why": "7. o rename do atributo"},

  {"op": "get", "target": "IServerEntity:Person/EmailAddress", "_why": "8. LER DE VOLTA: a Description e o Label do atributo ainda dizem 'Email do Contact'"},
  {"op": "get", "target": "EntityIndex:IX_Contact_Phone"},
  {"op": "get", "target": "$sql", "_why": "o WHERE passou a {Person}.[EmailAddress]"},
  {"op": "usages", "target": "IServerEntity:Person/EmailAddress"},

  {"op": "rename", "target": "$var", "name": "PersonLabel", "_why": "9. o rename da variavel local: a expressao que a le tem de ser reescrita"},
  {"op": "get", "target": "$a3"},
  {"op": "get", "target": "$a2", "_why": "o literal continua a dizer Contact e Email, depois dos tres renames"},

  {"op": "dump", "target": "IMobileScreen:ContactDetail", "depth": 6, "_why": "10. a tela: as expressoes foram reescritas, mas o nome da tela, do aggregate GetContactById, do Form ContactForm e do Email_Input ficaram para tras"},
  {"op": "dump", "target": "$rep", "depth": 4}
 ]
