  {"op": "set", "target": "$sql", "prop": "Statement", "value": "SELECT {Contact}.* FROM {Contact} WHERE {Contact}.[Email] <> @Empty"},
  {"op": "create", "parent": "$sql", "type": "ISQLInputParameter", "name": "Empty", "as": "$sqlIn"},
  {"op": "set", "target": "$sqlIn", "prop": "DataType", "value": "Text"},
  {"op": "create", "parent": "$sql", "type": "ISQLOutput", "name": "List", "args": {"entityOrStructure": "Contact"}, "as": "$sqlOut"},
  {"op": "set", "target": "$sql/arg:Empty", "prop": "Value", "value": "\"\""},
  {"op": "create", "parent": "$rep", "type": "IAssignNode", "as": "$asg"},
  {"op": "set", "target": "$asg", "prop": "Label", "value": "SetOutputs"},
  {"op": "create", "parent": "$asg", "type": "IAssignment", "as": "$a1"},
  {"op": "set", "target": "$a1", "prop": "Variable", "value": "Rows"},
  {"op": "set", "target": "$a1", "prop": "Value", "value": "ReadContacts.List"},
  {"op": "create", "parent": "$asg", "type": "IAssignment", "as": "$a2"},
  {"op": "set", "target": "$a2", "prop": "Variable", "value": "ContactLabel"},
  {"op": "set", "target": "$a2", "prop": "Value", "value": "\"Contact sem Email\""},
  {"op": "create", "parent": "$asg", "type": "IAssignment", "as": "$a3"},
  {"op": "set", "target": "$a3", "prop": "Variable", "value": "Label"},
  {"op": "set", "target": "$a3", "prop": "Value", "value": "ContactLabel"},
  {"op": "create", "parent": "$rep", "type": "IEndNode", "as": "$r9"},
  {"op": "link", "from": "$r0", "to": "$sql"},
  {"op": "link", "from": "$sql", "to": "$asg"},
  {"op": "link", "from": "$asg", "to": "$r9"},
  {"op": "layout", "target": "$rep"},

  {"op": "usages", "target": "IServerEntity:Contact", "max": 30, "_why": "4. quem usa a entidade ANTES do rename"},
