{
 "description": "Sessao fria I: modulo Reactive referencia Product e Product_GetById do produtor (job producer-public); tela Products com aggregate + Table (Name, Price) e link por linha para ProductDetail(ProductId), que mostra Name/Price e tem botao Summary -> screen action que chama Product_GetById e guarda o output numa variavel local (escrito por uma LLM sem contexto na sessao fria I, rodada 2, 2026-09-04)",
 "base": "tests/fixtures/reactive-ui.oml",
 "expectValid": true,
 "ops": [
  {
   "op": "reference",
   "producer": "job:producer-public",
   "elements": [
    "IServerEntity:Product",
    "IServerAction:Product_GetById"
   ],
   "as": "$ref"
  },
  {
   "op": "find",
   "type": "IReference",
   "max": 20
  },
  {
   "op": "create",
   "parent": "IMobileFlow:MainFlow",
   "type": "IMobileScreen",
   "name": "ProductDetail",
   "as": "$det"
  },
  {
   "op": "set",
   "target": "$det/#IMobileBlockInstanceWidget",
   "prop": "SourceBlock",
   "value": "IMobileBlock:LayoutTopMenu"
  },
  {
   "op": "create",
   "parent": "$det",
   "type": "IInputParameter",
   "name": "ProductId",
   "as": "$pid"
  },
  {
   "op": "set",
   "target": "$pid",
   "prop": "DataType",
   "value": "Product Identifier"
  },
  {
   "op": "create",
   "parent": "$det",
   "type": "ILocalVariable",
   "name": "Summary",
   "as": "$var"
  },
  {
   "op": "set",
   "target": "$var",
   "prop": "DataType",
   "value": "ProductSummary"
  },
  {
   "op": "create",
   "parent": "$det",
