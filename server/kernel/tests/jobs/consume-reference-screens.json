   "name": "GetProductById",
   "as": "$dagg"
  },
  {
   "op": "create",
   "parent": "$dagg",
   "type": "IAliasedSource",
   "args": {
    "dataSource": "IEntitySignature:Product"
   }
  },
  {
   "op": "create",
   "parent": "$dagg",
   "type": "IFilter",
   "args": {
    "condition": "Product.Id = ProductId"
   }
  },
  {
   "op": "create",
   "parent": "$det/#IMobileBlockInstanceWidget/Title",
   "type": "IExpression",
   "as": "$dtitle"
  },
  {
   "op": "set",
   "target": "$dtitle",
   "prop": "Value",
   "value": "\"Product\""
  },
  {
   "op": "create",
   "parent": "$det/#IMobileBlockInstanceWidget/MainContent",
   "type": "IContainer",
   "name": "DetailContainer",
   "as": "$dc"
