{
 "description": "Delete DATA with real consumers: the attribute Contact.Email is used by an aggregate filter, by a screen Expression, by an Execute argument and by the Input of the form. The delete only passes after the four leave; the refusal (without force) is in tests/jobs-negative/delete-attribute-in-use.json.",
 "base": "job:screen-form-reactive",
 "expectValid": true,
 "ops": [
  {"op": "usages", "target": "IServerEntity:Contact/Email", "_why": "(1) initial state: only the Input Email_Input really uses the attribute (the rest is derived)"},

  {"op": "create", "parent": "IMobileScreen:ContactDetail/GetContactById", "type": "IFilter", "args": {"condition": "Contact.Email <> \"\""}, "_why": "(2) DATA consumer: aggregate filter"},

  {"op": "create", "parent": "IMobileScreen:ContactDetail/#IMobileBlockInstanceWidget/MainContent", "type": "IExpression", "name": "EmailEcho", "as": "$echo", "_why": "(2) INTERFACE consumer: expression on the screen"},
  {"op": "set", "target": "$echo", "prop": "Value", "value": "GetContactById.List.Current.Contact.Email"},

  {"op": "create", "parent": "@espace", "type": "IServerAction", "name": "Contact_NotifyByEmail", "as": "$notify"},
  {"op": "create", "parent": "$notify", "type": "IInputParameter", "name": "Email", "as": "$notifyIn"},
  {"op": "set", "target": "$notifyIn", "prop": "DataType", "value": "Text"},
  {"op": "create", "parent": "$notify", "type": "IOutputParameter", "name": "Sent", "as": "$notifyOut"},
  {"op": "set", "target": "$notifyOut", "prop": "DataType", "value": "Boolean"},
  {"op": "create", "parent": "$notify", "type": "IStartNode", "as": "$nt0"},
  {"op": "create", "parent": "$notify", "type": "IAssignNode", "as": "$ntAs"},
  {"op": "set", "target": "$ntAs", "prop": "Label", "value": "SetSent"},
  {"op": "create", "parent": "$ntAs", "type": "IAssignment", "as": "$ntA1"},
  {"op": "set", "target": "$ntA1", "prop": "Variable", "value": "Sent"},
  {"op": "set", "target": "$ntA1", "prop": "Value", "value": "Email <> \"\""},
  {"op": "create", "parent": "$notify", "type": "IEndNode", "as": "$nt9"},
  {"op": "link", "from": "$nt0", "to": "$ntAs"},
  {"op": "link", "from": "$ntAs", "to": "$nt9"},
  {"op": "layout", "target": "$notify"},

  {"op": "create", "parent": "IScreenAction:Save", "type": "IExecuteServerActionNode", "name": "NotifyByEmail", "as": "$call", "_why": "(2) LOGIC consumer: argument of an Execute"},
  {"op": "set", "target": "$call", "prop": "Action", "value": "$notify"},
  {"op": "set", "target": "$call/Email", "prop": "Value", "value": "GetContactById.List.Current.Contact.Email"},
  {"op": "link", "from": "IScreenAction:Save/Contact_Save", "to": "$call"},
  {"op": "link", "from": "$call", "to": "IScreenAction:Save/#IEndNode[1]"},
  {"op": "layout", "target": "IScreenAction:Save"},

  {"op": "usages", "target": "IServerEntity:Contact/Email", "_why": "(3) quatro consumidores reais: filtro, expressao, argumento e Input"},

  {"op": "delete", "target": "$echo", "_why": "(4a) a expressao e folha: sai primeiro"},
  {"op": "delete", "target": "IMobileScreen:ContactDetail/GetContactById/**IFilter[2]", "_why": "(4b) the filter that cites Contact.Email (the [1] is the filter by Id, which stays)"},

  {"op": "link", "from": "IScreenAction:Save/Contact_Save", "to": "IScreenAction:Save/#IEndNode[1]", "_why": "(4c) relink BEFORE deleting the node: the incoming connector counts as a consumer of the node"},
  {"op": "delete", "target": "$call"},
  {"op": "delete", "target": "$notify", "_why": "(4d) the helper action was left with no callers; deleting avoids an UnusedUserAction"},
  {"op": "layout", "target": "IScreenAction:Save"},

  {"op": "delete", "target": "IMobileScreen:ContactDetail/#IMobileBlockInstanceWidget/MainContent/ContactForm/Email_Input", "_why": "(4e) the last consumer: the Input of the form"},

  {"op": "usages", "target": "IServerEntity:Contact/Email", "_why": "(5) real=0: only the derived usages remain (SampleRecord and the attribute list of the aggregate)"},
  {"op": "delete", "target": "IServerEntity:Contact/Email", "_why": "(6) now the delete passes without force: brokenConsumers=0"},

  {"op": "usages", "target": "IServerEntity:Contact"},
  {"op": "find", "name": "Contact_NotifyByEmail", "_why": "(7) the helper action left too: empty list"},
  {"op": "dump", "target": "IMobileScreen:ContactDetail", "depth": 6}
 ]
}
