{
 "description": "The copy that the Studio makes with Ctrl+D, through the duplicate verb, in the three areas: attribute, whole entity, widget inside a container, screen action with its nodes, and the whole screen. Three things that whoever delivers needs to know and that nothing proved until now: (1) the name gets the suffix that the PLATFORM chooses (Body becomes Body2), not a name that the job chooses -- to give another name, rename afterwards; (2) the copy enters at the END of the sequence of the same parent; (3) the copy is born WITHOUT consumers: whoever used the original keeps using the original, and that is why the copy of an action appears in Verify as UnusedAction. Copying a container, an action or a screen takes everything that is inside it.",
 "base": "tests/fixtures/reactive-ui.oml",
 "expectValid": true,
 "expectedMessages": [
  {
   "id": "UnusedAction",
   "element": "Headless_UI (ESpace) / MainFlow (MobileFlow) / DupScreen (MobileScreen) / Greet2 (ScreenAction)",
   "why": "The copy of a screen action is born without consumers: that is exactly what this job proves, and Verify says the same."
  },
  {
   "id": "UnusedAction",
   "element": "Headless_UI (ESpace) / MainFlow (MobileFlow) / DupScreen2 (MobileScreen) / Greet2 (ScreenAction)",
   "why": "The copied screen takes the two actions, and the copy of the copy still has no consumers."
  }
 ],
 "ops": [
  {"op": "spec", "data": {"entities": [
   {"name": "DupNotice", "attributes": [
    {"name": "Title", "type": "Text", "mandatory": true, "length": 100},
    {"name": "Body", "type": "Text", "length": 500},
    {"name": "Rank", "type": "Integer"}
   ]}
  ]}},

  {"op": "create", "parent": "IMobileFlow:MainFlow", "type": "IMobileScreen", "name": "DupScreen", "as": "$scr"},
  {"op": "set", "target": "$scr/#IMobileBlockInstanceWidget", "prop": "SourceBlock", "value": "IMobileBlock:LayoutTopMenu"},
  {"op": "create", "parent": "$scr/#IMobileBlockInstanceWidget/Title", "type": "IExpression", "as": "$title"},
  {"op": "set", "target": "$title", "prop": "Value", "value": "\"Duplicar\""},

  {"op": "create", "parent": "$scr", "type": "IScreenAggregate", "name": "GetNotices", "as": "$agg"},
  {"op": "create", "parent": "$agg", "type": "IAliasedSource", "args": {"dataSource": "$DupNotice"}},
  {"op": "create", "parent": "$scr/#IMobileBlockInstanceWidget/MainContent", "type": "IContainer", "name": "Box", "as": "$box"},
  {"op": "create", "parent": "$box", "type": "IContainer", "name": "Um", "as": "$c1"},
  {"op": "create", "parent": "$box", "type": "IContainer", "name": "Dois", "as": "$c2"},
  {"op": "create", "parent": "$c2", "type": "IExpression", "as": "$usaBody"},
  {"op": "set", "target": "$usaBody", "prop": "Value", "value": "GetNotices.List.Current.DupNotice.Body"},
  {"op": "create", "parent": "$box", "type": "IContainer", "name": "Tres", "as": "$c3"},

  {"op": "create", "parent": "$scr", "type": "IScreenAction", "name": "Greet", "as": "$act"},
  {"op": "create", "parent": "$act", "type": "IStartNode", "as": "$a0"},
  {"op": "create", "parent": "$act", "type": "IAssignNode", "as": "$a1"},
  {"op": "set", "target": "$a1", "prop": "Label", "value": "Passo"},
  {"op": "create", "parent": "$act", "type": "IEndNode", "as": "$a9"},
  {"op": "link", "from": "$a0", "to": "$a1"},
  {"op": "link", "from": "$a1", "to": "$a9"},
  {"op": "layout", "target": "$act"},
  {"op": "create", "parent": "$c1", "type": "IButton", "name": "Go", "as": "$btn"},
  {"op": "set", "target": "$btn/#ITextWidget", "prop": "Text", "value": "Go"},
  {"op": "set", "target": "$btn/OnClick", "prop": "Destination", "value": "$act", "_why": "the original HAS a consumer; the copy will not"},

  {"op": "usages", "target": "$DupNotice.Body", "_why": "before duplicating: the Expression of Dois uses the attribute"},
  {"op": "duplicate", "target": "$DupNotice.Body", "as": "$bodyCopy"},
  {"op": "get", "target": "$bodyCopy", "_why": "chama-se Body2: o sufixo e da plataforma"},
  {"op": "usages", "target": "$bodyCopy", "_why": "the COPY is born with zero consumers"},
  {"op": "usages", "target": "$DupNotice.Body", "_why": "and the original keeps its own"},
  {"op": "dump", "target": "$DupNotice", "depth": 2, "_why": "Body2 entrou no fim"},

  {"op": "duplicate", "target": "$DupNotice", "as": "$entityCopy"},
  {"op": "get", "target": "$entityCopy"},
  {"op": "dump", "target": "$entityCopy", "depth": 2, "_why": "the copied entity brings its own attributes, entity actions and identifier"},

  {"op": "duplicate", "target": "$c2", "as": "$c2copy"},
  {"op": "dump", "target": "$box", "depth": 2, "_why": "Dois2 entered at the end of the container, with the Expression that was inside it"},

  {"op": "duplicate", "target": "$act", "as": "$actCopy"},
  {"op": "get", "target": "$actCopy"},
  {"op": "dump", "target": "$actCopy", "depth": 2, "_why": "Greet2 takes the three nodes; the button still calls Greet"},
  {"op": "usages", "target": "$act", "_why": "the button's OnClick stays on the original"},

  {"op": "duplicate", "target": "$scr", "as": "$scrCopy"},
  {"op": "get", "target": "$scrCopy"},
  {"op": "dump", "target": "$scrCopy", "depth": 3, "_why": "DupScreen2 leva aggregate, actions, layout e widgets"}
 ]
}
