{
 "description": "Table Reactive com cabecalho e celulas ligadas a aggregate (ordenavel por SortAttribute) e widget If com ramos True/False (SortAttribute do HeaderCell ainda em aberto: o Verify recusa \"User.Name\" e \"Name\"; os modulos reais nao o definem)",
 "base": "tests/fixtures/reactive-ui.oml",
 "expectValid": true,
 "ops": [
  {
   "op": "create",
   "parent": "IMobileFlow:MainFlow",
   "type": "IMobileScreen",
   "name": "UsersTable",
   "as": "$scr"
  },
  {
   "op": "set",
   "target": "$scr/#IMobileBlockInstanceWidget",
   "prop": "SourceBlock",
   "value": "IMobileBlock:LayoutTopMenu"
  },
  {
   "op": "create",
   "parent": "$scr/#IMobileBlockInstanceWidget/Title",
   "type": "IExpression",
   "as": "$title"
  },
  {
   "op": "set",
   "target": "$title",
   "prop": "Value",
   "value": "\"Users\""
  },
  {
   "op": "create",
   "parent": "$scr",
   "type": "ILocalVariable",
   "name": "ShowDetails",
   "as": "$v"
  },
  {
   "op": "set",
   "target": "$v",
   "prop": "DataType",
   "value": "Boolean"
  },
  {
   "op": "create",
   "parent": "$scr",
   "type": "IScreenAggregate",
   "name": "GetUsers",
   "as": "$agg"
  },
  {
   "op": "create",
   "parent": "$agg",
   "type": "IAliasedSource",
   "args": {
    "dataSource": "IEntitySignature:User"
   }
  },
  {
   "op": "create",
   "parent": "$scr/#IMobileBlockInstanceWidget/MainContent",
   "type": "ITableRecords",
   "name": "UserTable",
   "as": "$tbl",
   "empty": true
  },
  {
   "op": "set",
   "target": "$tbl",
   "prop": "Source",
   "value": "GetUsers.List"
  },
  {
   "op": "create",
   "parent": "$tbl/HeaderRow",
   "type": "IHeaderCell",
   "name": "NameHeader",
   "as": "$h1"
  },
  {
   "op": "create",
   "parent": "$h1",
   "type": "IExpression",
   "as": "$h1e"
  },
  {
   "op": "set",
   "target": "$h1e",
   "prop": "Value",
   "value": "\"Name\""
  },
  {
   "op": "create",
   "parent": "$tbl/HeaderRow",
   "type": "IHeaderCell",
   "name": "EmailHeader",
   "as": "$h2"
  },
  {
   "op": "create",
   "parent": "$h2",
   "type": "IExpression",
   "as": "$h2e"
  },
  {
   "op": "set",
   "target": "$h2e",
   "prop": "Value",
   "value": "\"Email\""
  },
  {
   "op": "create",
   "parent": "$tbl/Row",
   "type": "IRowCell",
   "name": "NameCell",
   "as": "$c1"
  },
  {
   "op": "create",
   "parent": "$c1",
   "type": "IExpression",
   "as": "$c1e"
  },
  {
   "op": "set",
   "target": "$c1e",
   "prop": "Value",
   "value": "GetUsers.List.Current.User.Name"
  },
  {
   "op": "create",
   "parent": "$tbl/Row",
   "type": "IRowCell",
   "name": "EmailCell",
   "as": "$c2"
  },
  {
   "op": "create",
   "parent": "$c2",
   "type": "IExpression",
   "as": "$c2e"
  },
  {
   "op": "set",
   "target": "$c2e",
   "prop": "Value",
   "value": "GetUsers.List.Current.User.Email"
  },
  {
   "op": "create",
   "parent": "$scr/#IMobileBlockInstanceWidget/MainContent",
   "type": "IIfWidget",
   "name": "DetailsIf",
   "as": "$if"
  },
  {
   "op": "set",
   "target": "$if",
   "prop": "Condition",
   "value": "ShowDetails"
  },
  {
   "op": "create",
   "parent": "$if/TrueBranch",
   "type": "IExpression",
   "as": "$ifT"
  },
  {
   "op": "set",
   "target": "$ifT",
   "prop": "Value",
   "value": "\"Details shown\""
  },
  {
   "op": "create",
   "parent": "$if/FalseBranch",
   "type": "IExpression",
   "as": "$ifF"
  },
  {
   "op": "set",
   "target": "$ifF",
   "prop": "Value",
   "value": "\"Details hidden\""
  }
 ]
}