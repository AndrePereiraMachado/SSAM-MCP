              "EndDate": "DashboardEndDate",
              "OnlyOpen": "True"
            }
          },
          "metric.resolved": {
            "kind": "text",
            "value": "LoadDashboard.TotalResolvedToday"
          },
          "open.resolved": {
            "kind": "navigate",
            "destination": "IncidentList",
            "args": {
              "StatusId": "Entities.IncidentStatus.Resolved",
              "OnlyResolvedToday": "True"
            }
          },
          "status.bars": {
            "kind": "list",
            "source": "LoadDashboard",
            "output": "IncidentsByStatus"
          },
          "status.label": {
            "kind": "field",
            "field": "Label"
          },
          "status.fill": {
            "kind": "style",
            "value": "\"width:\" + If(StatusMax = 0, \"0\", DecimalToText(LoadDashboard.IncidentsByStatus.Current.Total * 100 / StatusMax)) + \"%\""
          },
          "status.total": {
            "kind": "field",
            "field": "Total"
          },
          "priority.caption": {
