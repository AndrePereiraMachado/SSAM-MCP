{
  "description": "Compila a pagina HTML/CSS autorada tests/html/incidents-dashboard.html (sha256 97bc37134bc9) outra vez sobre a tela ja criada (delta: identidade da tela e variaveis preservadas, sem duplicar); gerado por scripts/gen_html_job.py --target update.",
  "base": "job:html-dashboard-reactive",
  "expectValid": true,
  "expectedMessages": [],
  "ops": [
    {
      "op": "html",
      "data": {
        "screen": "Dashboard",
        "title": "Visão geral",
        "vars": [
          {
            "name": "DashboardStartDate",
            "type": "Date Time",
            "default": "NullDate()"
          },
          {
            "name": "DashboardEndDate",
            "type": "Date Time",
            "default": "NullDate()"
          }
        ],
        "sources": [
          {
            "action": "GetDashboardMetricsForPeriod",
            "as": "LoadDashboard",
            "args": {
              "StartDate": "DashboardStartDate",
              "EndDate": "DashboardEndDate"
            },
            "state": true
          },
          {
            "action": "GetIncidentsNearDue",
            "as": "LoadNearDue",
            "args": {
              "StartDate": "DashboardStartDate",
              "EndDate": "DashboardEndDate"
            },
            "state": true,
            "paging": {
              "offset": "NearDueOffset",
              "size": 10,
              "total": "Total"
            }
          },
          {
            "action": "GetIncidentList",
            "as": "LoadMine",
            "args": {
              "Search": "\"\"",
              "StatusId": "NullIdentifier()",
              "PriorityId": "NullIdentifier()",
              "AssigneeId": "GetUserId()",
              "OnlyMine": "False",
              "OnlyOverdue": "False",
              "StartDate": "DashboardStartDate",
              "EndDate": "DashboardEndDate",
              "OnlyOpen": "True"
            },
            "state": true,
            "paging": {
              "offset": "MineOffset",
              "size": 10,
              "total": "Total"
            }
          },
          {
            "action": "GetIncidentList",
            "as": "LoadRecent",
            "args": {
              "Search": "SearchText",
              "StatusId": "NullIdentifier()",
              "PriorityId": "Filter_PriorityId",
              "AssigneeId": "NullIdentifier()",
              "OnlyMine": "False",
              "OnlyOverdue": "False",
              "StartDate": "DashboardStartDate",
              "EndDate": "DashboardEndDate"
            },
            "state": true,
            "paging": {
              "offset": "RecentOffset",
              "size": 20,
              "total": "Total"
            }
          }
        ],
        "search": {
          "key": "search",
          "label": "Título do chamado"
        },
        "filters": [
          {
            "key": "filter.priority",
            "from": "IncidentPriority",
            "variable": "Filter_PriorityId",
            "label": "Todas as prioridades"
          }
        ],
        "derived": [
          {
            "name": "StatusMax",
            "type": "Integer",
            "source": "LoadDashboard",
            "output": "IncidentsByStatus",
            "max": "Total"
          }
        ],
        "scripts": [
          {
            "name": "SlaCountdown",
            "inputs": [
              {
                "name": "Due",
                "type": "Date Time"
              }
            ],
            "outputs": [
              {
                "name": "Text",
                "type": "Text"
              }
            ],
            "code": "var due = $parameters.Due instanceof Date ? $parameters.Due : new Date($parameters.Due); var minutes = Math.round((due.getTime() - Date.now()) / 60000); $parameters.Text = minutes < 0 ? \"vencido há \" + (-minutes) + \" min\" : \"vence em \" + minutes + \" min\";"
          }
        ],
        "bindings": {
          "nav.incidents": {
            "kind": "navigate",
            "destination": "IncidentList"
          },
          "refresh": {
            "kind": "refresh"
          },
          "new": {
            "kind": "navigate",
            "destination": "IncidentCreate"
          },
          "period.start": {
            "kind": "date",
            "variable": "DashboardStartDate",
            "format": "DD/MM/YYYY"
          },
          "period.end": {
            "kind": "date",
            "variable": "DashboardEndDate",
            "format": "DD/MM/YYYY"
          },
          "metric.open": {
            "kind": "text",
            "value": "LoadDashboard.TotalOpen"
          },
          "metric.mine": {
            "kind": "text",
            "value": "IntegerToText(LoadDashboard.MyOpenIncidents) + \" atribuídos a você\""
          },
          "open.open": {
            "kind": "navigate",
            "destination": "IncidentList",
            "args": {
              "StartDate": "DashboardStartDate",
              "EndDate": "DashboardEndDate",
              "OnlyOpen": "True"
            }
          },
          "metric.overdue": {
            "kind": "text",
            "value": "LoadDashboard.TotalOverdue"
          },
          "open.overdue": {
            "kind": "navigate",
            "destination": "IncidentList",
            "args": {
              "OnlyOverdue": "True",
              "StartDate": "DashboardStartDate",
              "EndDate": "DashboardEndDate"
            }
          },
