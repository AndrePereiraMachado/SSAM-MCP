          },
          "priority.items": {
            "kind": "list",
            "source": "LoadDashboard",
            "output": "IncidentsByPriority"
          },
          "priority.dot": {
            "kind": "style",
            "value": "\"background-color:\" + If(LoadDashboard.IncidentsByPriority.Current.PriorityId = Entities.IncidentPriority.Critical, \"#d87171\", If(LoadDashboard.IncidentsByPriority.Current.PriorityId = Entities.IncidentPriority.High, \"#e7ab62\", If(LoadDashboard.IncidentsByPriority.Current.PriorityId = Entities.IncidentPriority.Medium, \"#7189e8\", \"#6dad93\")))"
          },
          "priority.label": {
            "kind": "field",
            "field": "Label"
          },
          "priority.total": {
            "kind": "field",
            "field": "Total"
          },
          "notice": {
            "kind": "text",
            "value": "If(LoadNearDue.IsDataFetched and LoadNearDue.FetchSucceeded, LongIntegerToText(LoadNearDue.Total) + \" incidentes vencem nos próximos 30 minutos.\", \"\")"
          },
          "recent": {
            "kind": "list",
            "source": "LoadRecent",
            "output": "Incidents"
          },
          "recent.title": {
            "kind": "field",
            "field": "Title"
          },
          "recent.code": {
            "kind": "text",
            "value": "\"INC-\" + LongIntegerToText(LoadRecent.Incidents.Current.Id)"
          },
          "recent.priority": {
            "kind": "text",
            "value": "If(LoadRecent.Incidents.Current.PriorityId = Entities.IncidentPriority.Critical, \"Crítica\", If(LoadRecent.Incidents.Current.PriorityId = Entities.IncidentPriority.High, \"Alta\", If(LoadRecent.Incidents.Current.PriorityId = Entities.IncidentPriority.Medium, \"Média\", \"Baixa\")))"
          },
          "recent.status": {
            "kind": "text",
            "value": "If(LoadRecent.Incidents.Current.StatusId = Entities.IncidentStatus.Resolved, \"Resolvido\", If(LoadRecent.Incidents.Current.StatusId = Entities.IncidentStatus.InProgress, \"Em andamento\", If(LoadRecent.Incidents.Current.StatusId = Entities.IncidentStatus.InAnalysis, \"Em análise\", If(LoadRecent.Incidents.Current.StatusId = Entities.IncidentStatus.Reopened, \"Reaberto\", \"Novo\"))))"
          },
          "recent.owner": {
            "kind": "text",
            "value": "If(LoadRecent.Incidents.Current.AssigneeId = NullIdentifier(), \"Não atribuído\", \"Usuário #\" + LongIntegerToText(LoadRecent.Incidents.Current.AssigneeId))"
          },
          "recent.empty": {
            "kind": "visible",
            "condition": "LoadRecent.Incidents.Empty"
          },
          "recent.count": {
            "kind": "text",
            "value": "IntegerToText(LoadRecent.Total) + \" incidentes\""
          },
          "neardue": {
            "kind": "list",
            "source": "LoadNearDue",
            "output": "Incidents"
          },
          "neardue.title": {
            "kind": "field",
            "field": "Title"
          },
          "neardue.sla": {
            "kind": "text",
            "value": "SlaCountdown(LoadNearDue.Incidents.Current.SlaDueAt)"
          },
          "neardue.status": {
            "kind": "text",
            "value": "If(LoadNearDue.Incidents.Current.StatusId = Entities.IncidentStatus.InProgress, \"Em andamento\", If(LoadNearDue.Incidents.Current.StatusId = Entities.IncidentStatus.InAnalysis, \"Em análise\", If(LoadNearDue.Incidents.Current.StatusId = Entities.IncidentStatus.Reopened, \"Reaberto\", \"Novo\")))"
          },
          "neardue.empty": {
            "kind": "visible",
            "condition": "LoadNearDue.Incidents.Empty"
          },
          "mine": {
            "kind": "list",
            "source": "LoadMine",
            "output": "Incidents"
          },
          "mine.title": {
            "kind": "field",
            "field": "Title"
          },
          "mine.sla": {
            "kind": "field",
            "field": "SlaDueAt"
          },
          "mine.status": {
            "kind": "text",
            "value": "If(LoadMine.Incidents.Current.StatusId = Entities.IncidentStatus.InProgress, \"Em andamento\", If(LoadMine.Incidents.Current.StatusId = Entities.IncidentStatus.InAnalysis, \"Em análise\", If(LoadMine.Incidents.Current.StatusId = Entities.IncidentStatus.Reopened, \"Reaberto\", \"Novo\")))"
          },
          "mine.empty": {
            "kind": "visible",
            "condition": "LoadMine.Incidents.Empty"
          },
          "dashboard.loading": {
            "kind": "visible",
            "condition": "not LoadDashboard.IsDataFetched"
          },
          "dashboard.error": {
