          },
          "recent.error": {
            "kind": "visible",
            "condition": "LoadRecent.IsDataFetched and not LoadRecent.FetchSucceeded"
          },
          "recent.ready": {
            "kind": "visible",
            "condition": "LoadRecent.IsDataFetched and LoadRecent.FetchSucceeded"
          },
          "recent.retry": {
