{
 "description": "Front B (comprehensive catalog), O11 Reactive lane: REPOINT the consumers of one screen to another with the replace verb (ReplaceReferences on each consumer) and DELETE the old one without force; plus what no O11 job measured on screens: moving a screen on the canvas of the flow, reordering expressions, deleting a button with its navigation and renaming a UI flow. The screens CatBAbout and CatBAboutV2 have NO input: on a screen with an input the arguments of the consumers are linked to the input of the old screen, which the screen replace does not map (the delete would be refused). CatBHome is created first because in ODC the first screen created without Studio becomes the DefaultScreen of the module (tests/jobs-odc/delete-screen.json) and would be one more consumer; the same scenario, in the same order, is in tests/jobs-odc/cat-b-screen-replace-delete.json.",
 "base": "tests/fixtures/reactive-ui.oml",
 "expectValid": true,
 "expectedMessages": [],
 "ops": [
  {"op": "create", "parent": "IMobileFlow:MainFlow", "type": "IMobileScreen", "name": "CatBHome", "as": "$home", "_why": "1. the screen of the consumers, created first"},
  {"op": "set", "target": "$home/#IMobileBlockInstanceWidget", "prop": "SourceBlock", "value": "IMobileBlock:LayoutTopMenu"},
  {"op": "create", "parent": "$home/#IMobileBlockInstanceWidget/Title", "type": "IExpression", "as": "$homeTitle"},
  {"op": "set", "target": "$homeTitle", "prop": "Value", "value": "\"Home\""},

  {"op": "create", "parent": "IMobileFlow:MainFlow", "type": "IMobileScreen", "name": "CatBAbout", "as": "$about", "_why": "2. the screen that will leave, without input"},
  {"op": "set", "target": "$about/#IMobileBlockInstanceWidget", "prop": "SourceBlock", "value": "IMobileBlock:LayoutTopMenu"},
  {"op": "create", "parent": "$about/#IMobileBlockInstanceWidget/Title", "type": "IExpression", "as": "$aboutTitle"},
  {"op": "set", "target": "$aboutTitle", "prop": "Value", "value": "\"About\""},
  {"op": "create", "parent": "IMobileFlow:MainFlow", "type": "IMobileScreen", "name": "CatBAboutV2", "as": "$about2", "_why": "the replacement, with the same contract (no input)"},
  {"op": "set", "target": "$about2/#IMobileBlockInstanceWidget", "prop": "SourceBlock", "value": "IMobileBlock:LayoutTopMenu"},
  {"op": "create", "parent": "$about2/#IMobileBlockInstanceWidget/Title", "type": "IExpression", "as": "$about2Title"},
  {"op": "set", "target": "$about2Title", "prop": "Value", "value": "\"About (new)\""},

  {"op": "create", "parent": "$home/#IMobileBlockInstanceWidget/MainContent", "type": "IContainer", "name": "HomeBox", "as": "$box", "_why": "3. conteudo e navegacao da Home"},
  {"op": "create", "parent": "$box", "type": "IExpression", "as": "$first"},
  {"op": "set", "target": "$first", "prop": "Value", "value": "\"First line\""},
  {"op": "create", "parent": "$box", "type": "IExpression", "as": "$second"},
  {"op": "set", "target": "$second", "prop": "Value", "value": "\"Second line\""},
  {"op": "create", "parent": "$box", "type": "IButton", "name": "AboutButton", "as": "$btn"},
  {"op": "set", "target": "$btn/#ITextWidget", "prop": "Text", "value": "About"},
  {"op": "set", "target": "$btn/OnClick", "prop": "Destination", "value": "$about"},
  {"op": "create", "parent": "$box", "type": "ILink", "name": "AboutLink", "as": "$lnk"},
  {"op": "set", "target": "$lnk/#ITextWidget", "prop": "Text", "value": "About (link)"},
  {"op": "set", "target": "$lnk/OnClick", "prop": "Destination", "value": "$about"},
  {"op": "create", "parent": "$box", "type": "IButton", "name": "ObsoleteButton", "as": "$obsolete"},
  {"op": "set", "target": "$obsolete/#ITextWidget", "prop": "Text", "value": "Old shortcut"},
  {"op": "set", "target": "$obsolete/OnClick", "prop": "Destination", "value": "$about2"},

  {"op": "move", "target": "$second", "before": "$first", "_why": "4. reorder expressions inside the same container"},
  {"op": "move", "target": "$about2", "x": 1400, "y": 600, "_why": "move the screen on the canvas of the flow (position of the node)"},
  {"op": "get", "target": "$about2"},

  {"op": "usages", "target": "$about", "_why": "5. BEFORE: 2 consumers (the OnClick of the button and that of the link)"},
  {"op": "replace", "from": "$about", "to": "$about2", "_why": "REPOINT by the ReplaceReferences of each consumer, same type (IMobileScreen), without force"},
  {"op": "usages", "target": "$about", "_why": "zero consumidores"},
  {"op": "usages", "target": "$about2", "_why": "3: os dois repontados e o ObsoleteButton"},
  {"op": "get", "target": "$btn/OnClick", "_why": "LER DE VOLTA: Destination = CatBAboutV2"},
  {"op": "get", "target": "$lnk/OnClick"},

  {"op": "delete", "target": "$obsolete", "_why": "6. delete a button with its navigation"},
  {"op": "delete", "target": "$about", "_why": "7. without consumers the screen leaves without force"},
  {"op": "usages", "target": "$about2", "_why": "2: botao e link"},

  {"op": "create", "parent": "@espace", "type": "IMobileFlow", "name": "CatBAuxFlow", "as": "$flow", "_why": "8. a UI flow of its own, with a screen, renamed"},
  {"op": "create", "parent": "$flow", "type": "IMobileScreen", "name": "CatBHelp", "as": "$help"},
  {"op": "set", "target": "$help/#IMobileBlockInstanceWidget", "prop": "SourceBlock", "value": "IMobileBlock:LayoutTopMenu"},
  {"op": "create", "parent": "$help/#IMobileBlockInstanceWidget/Title", "type": "IExpression", "as": "$helpTitle"},
  {"op": "set", "target": "$helpTitle", "prop": "Value", "value": "\"Help\""},
  {"op": "rename", "target": "$flow", "name": "CatBHelpFlow"},
  {"op": "get", "target": "IMobileFlow:CatBHelpFlow", "_why": "the flow by the new name, with the screen inside"},

  {"op": "dump", "target": "$home", "depth": 6}
 ]
}
