{
 "description": "SQL by verbs: ISQLNode with Statement ({Entity} and @Parameter), ISQLInputParameter with DataType, ISQLOutput into a PUBLIC structure (args.entityOrStructure; a Public action requires a Public structure), argument linked to the input of the action ($sql/arg:Name), output of the action `<Structure> List` filled with SearchProducts.List. The only warning is SQL_Enumeration (suggestion: enumerating all the columns is equivalent to {Product}.*)",
 "base": "tests/fixtures/blank-service.oml",
 "expectValid": true,
 "expectedMessages": [
  {
   "id": "SQL_Enumeration",
   "element": "Product_Search (ServerAction) / SearchProducts (SQLNode)",
   "why": "Intentional explicit enumeration to demonstrate the mapping of the SQL attributes to the output structure."
  }
 ],
 "ops": [
  {"op": "spec", "data": {
   "entities": [{"name": "Product", "attributes": [{"name": "Name", "type": "Text", "mandatory": true, "length": 100}, {"name": "Price", "type": "Decimal"}]}],
   "structures": [{"name": "ProductRow", "public": true, "attributes": [{"name": "Id", "type": "Long Integer"}, {"name": "Name", "type": "Text"}, {"name": "Price", "type": "Decimal"}]}]
  }},
  {"op": "create", "parent": "@espace", "type": "IServerAction", "name": "Product_Search", "as": "$act"},
  {"op": "set", "target": "$act", "prop": "Public", "value": true},
  {"op": "create", "parent": "$act", "type": "IInputParameter", "name": "MinPrice", "as": "$in"},
  {"op": "set", "target": "$in", "prop": "DataType", "value": "Decimal"},
  {"op": "create", "parent": "$act", "type": "IOutputParameter", "name": "Products", "as": "$out"},
  {"op": "set", "target": "$out", "prop": "DataType", "value": "ProductRow List"},
  {"op": "create", "parent": "$act", "type": "IStartNode", "as": "$s0"},
  {"op": "create", "parent": "$act", "type": "ISQLNode", "name": "SearchProducts", "as": "$sql"},
  {"op": "set", "target": "$sql", "prop": "Statement", "value": "SELECT {Product}.[Id], {Product}.[Name], {Product}.[Price] FROM {Product} WHERE {Product}.[Price] >= @MinPrice ORDER BY {Product}.[Name]"},
  {"op": "create", "parent": "$sql", "type": "ISQLInputParameter", "name": "MinPrice", "as": "$p"},
  {"op": "set", "target": "$p", "prop": "DataType", "value": "Decimal"},
  {"op": "create", "parent": "$sql", "type": "ISQLOutput", "name": "List", "args": {"entityOrStructure": "ProductRow"}, "as": "$o"},
  {"op": "set", "target": "$sql/arg:MinPrice", "prop": "Value", "value": "MinPrice"},
  {"op": "create", "parent": "$act", "type": "IAssignNode", "name": "SetOutput", "as": "$asg"},
  {"op": "set", "target": "$asg", "prop": "Label", "value": "SetOutput"},
  {"op": "create", "parent": "$asg", "type": "IAssignment", "as": "$a1"},
  {"op": "set", "target": "$a1", "prop": "Variable", "value": "Products"},
  {"op": "set", "target": "$a1", "prop": "Value", "value": "SearchProducts.List"},
  {"op": "create", "parent": "$act", "type": "IEndNode", "as": "$s9"},
  {"op": "link", "from": "$s0", "to": "$sql"},
  {"op": "link", "from": "$sql", "to": "$asg"},
  {"op": "link", "from": "$asg", "to": "$s9"},
  {"op": "layout", "target": "$act"},
  {"op": "get", "target": "$sql"}
 ]
}
