{
 "description": "Rename INTERFACE and read back the CSS and the URLs that were left behind. Screen, block, block instance, block parameter and screen variable are renamed; after each rename the job reads with get/dump the StyleSheet of the screen itself and of the block itself, the CSS class in the Style property of the containers, the button caption and a variable with a deep link written by hand. Destination, SourceBlock and arguments follow by key; CSS, classes, captions and URLs follow nothing.",
 "base": "tests/fixtures/reactive-ui.oml",
 "expectValid": true,
 "expectedMessages": [],
 "ops": [
  {"op": "create", "parent": "IMobileFlow:MainFlow", "type": "IMobileBlock", "name": "ContactCard", "as": "$blk", "_why": "1. the block: own CSS with the name of the block in the class, and an input cited by an expression"},
  {"op": "set", "target": "$blk", "prop": "StyleSheet", "value": ".contact-card { border: 1px solid #ddd; }\n.contact-card__title { font-weight: 700; }"},
  {"op": "set", "target": "$blk", "prop": "Description", "value": "Cartao de um Contact, estilizado pela classe contact-card"},
  {"op": "create", "parent": "$blk", "type": "IInputParameter", "name": "Caption", "as": "$blkIn"},
  {"op": "set", "target": "$blkIn", "prop": "DataType", "value": "Text"},
  {"op": "create", "parent": "$blk", "type": "IContainer", "name": "CardBody", "as": "$cardBody"},
  {"op": "set", "target": "$cardBody", "prop": "Style", "value": "\"contact-card\""},
  {"op": "create", "parent": "$cardBody", "type": "IExpression", "as": "$cardText"},
  {"op": "set", "target": "$cardText", "prop": "Value", "value": "\"Contact: \" + Caption"},

  {"op": "create", "parent": "IMobileFlow:MainFlow", "type": "IMobileScreen", "name": "ContactDetail", "as": "$det", "_why": "2. o destino da navegacao"},
  {"op": "set", "target": "$det/#IMobileBlockInstanceWidget", "prop": "SourceBlock", "value": "IMobileBlock:LayoutTopMenu"},
  {"op": "create", "parent": "$det", "type": "IInputParameter", "name": "ContactId", "as": "$detIn"},
  {"op": "set", "target": "$detIn", "prop": "DataType", "value": "Integer"},
  {"op": "create", "parent": "$det/#IMobileBlockInstanceWidget/Title", "type": "IExpression", "as": "$detTitle"},
  {"op": "set", "target": "$detTitle", "prop": "Value", "value": "\"Contact \" + IntegerToText(ContactId)"},

  {"op": "create", "parent": "IMobileFlow:MainFlow", "type": "IMobileScreen", "name": "ContactList", "as": "$scr", "_why": "3. the consuming screen: own CSS, class in the container, block instance, deep link written by hand and a button that navigates"},
  {"op": "set", "target": "$scr/#IMobileBlockInstanceWidget", "prop": "SourceBlock", "value": "IMobileBlock:LayoutTopMenu"},
  {"op": "set", "target": "$scr", "prop": "StyleSheet", "value": ".contact-list { padding: 16px; }\n.contact-list .contact-card { margin-bottom: 8px; }"},
  {"op": "create", "parent": "$scr", "type": "ILocalVariable", "name": "DetailUrl", "as": "$url"},
  {"op": "set", "target": "$url", "prop": "DataType", "value": "Text"},
  {"op": "set", "target": "$url", "prop": "DefaultValue", "value": "\"/Headless_UI/ContactDetail?ContactId=1\""},
  {"op": "create", "parent": "$scr/#IMobileBlockInstanceWidget/Title", "type": "IExpression", "as": "$title"},
  {"op": "set", "target": "$title", "prop": "Value", "value": "\"Contactos\""},
  {"op": "create", "parent": "$scr/#IMobileBlockInstanceWidget/MainContent", "type": "IContainer", "name": "ListBody", "as": "$listBody"},
  {"op": "set", "target": "$listBody", "prop": "Style", "value": "\"contact-list\""},
  {"op": "create", "parent": "$listBody", "type": "IMobileBlockInstanceWidget", "name": "ContactCard1", "as": "$inst", "source": "IMobileBlock:ContactCard"},
  {"op": "set", "target": "$inst/Caption", "prop": "Value", "value": "\"Primeiro Contact\""},
  {"op": "create", "parent": "$listBody", "type": "IExpression", "as": "$urlText"},
  {"op": "set", "target": "$urlText", "prop": "Value", "value": "\"Link directo: \" + DetailUrl"},
  {"op": "create", "parent": "$listBody", "type": "IButton", "name": "OpenContactButton", "as": "$btn"},
  {"op": "set", "target": "$btn/#ITextWidget", "prop": "Text", "value": "Abrir o Contact"},
  {"op": "set", "target": "$btn/OnClick", "prop": "Destination", "value": "$det"},
  {"op": "set", "target": "$btn/OnClick/ContactId", "prop": "Value", "value": "1"},

  {"op": "usages", "target": "$det", "_why": "4. BEFORE: who uses the destination screen and who uses the block"},
  {"op": "usages", "target": "$blk"},

  {"op": "rename", "target": "$det", "name": "PersonDetail", "_why": "5. renomear a TELA de destino"},
  {"op": "get", "target": "$btn/OnClick", "_why": "READ BACK: the Destination followed by key"},
  {"op": "get", "target": "$url", "_why": "but the deep link written by hand still points to /Headless_UI/ContactDetail"},
  {"op": "get", "target": "$btn/#ITextWidget", "_why": "and the caption of the button still says 'Abrir o Contact'"},
  {"op": "usages", "target": "$det", "_why": "the same consumer, now under the new name"},

  {"op": "rename", "target": "$blk", "name": "PersonCard", "_why": "6. renomear o BLOCO"},
  {"op": "get", "target": "$inst", "_why": "READ BACK: the platform itself renamed the instance from ContactCard1 to PersonCard1 (the name of the instance is derived from the block) and the SourceBlock followed by key"},
  {"op": "get", "target": "$blk", "_why": "the StyleSheet of the block still defines .contact-card, and the Description did not change either"},
  {"op": "get", "target": "$cardBody", "_why": "the CSS class in the Style property is a literal: it did not change"},

  {"op": "rename", "target": "$blkIn", "name": "Heading", "_why": "7. rename the block PARAMETER: the argument of the instance follows, the expression inside the block is rewritten"},
  {"op": "get", "target": "$inst/Heading"},
  {"op": "get", "target": "$cardText"},

  {"op": "rename", "target": "$url", "name": "PersonDetailUrl", "_why": "8. rename the screen VARIABLE: the expression that reads it is rewritten, the literal inside it is not"},
  {"op": "get", "target": "$urlText"},

  {"op": "rename", "target": "$scr", "name": "PersonList", "_why": "9. rename the consuming SCREEN itself"},
  {"op": "get", "target": "$scr", "_why": "READ BACK: the StyleSheet of the screen still talks about .contact-list and .contact-card"},
  {"op": "get", "target": "$listBody"},

  {"op": "dump", "target": "$scr", "depth": 7},
  {"op": "dump", "target": "$blk", "depth": 5}
 ]
}
