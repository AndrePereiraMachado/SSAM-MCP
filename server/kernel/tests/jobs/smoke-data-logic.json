   "value": "Currency"
  },
  {
   "op": "create",
   "parent": "$act",
   "type": "ILocalVariable",
   "name": "C",
   "as": "$c"
  },
  {
   "op": "set",
   "target": "$c",
   "prop": "DataType",
   "value": "Customer"
  },
  {
   "op": "create",
   "parent": "$act",
   "type": "IStartNode",
   "name": "Start",
   "as": "$start"
  },
  {
   "op": "create",
   "parent": "$act",
   "type": "IEndNode",
   "name": "End",
   "as": "$end"
  },
  {
   "op": "create",
