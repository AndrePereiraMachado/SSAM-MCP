   "value": "Customer Identifier"
  },
  {
   "op": "create",
   "parent": "$act",
   "type": "IInputParameter",
   "name": "Amount",
   "as": "$inAmt"
  },
  {
   "op": "set",
   "target": "$inAmt",
   "prop": "DataType",
   "value": "Currency"
  },
  {
   "op": "create",
   "parent": "$act",
   "type": "IOutputParameter",
   "name": "NewCredit",
