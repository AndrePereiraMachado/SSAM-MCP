   "name": "GetCustomer",
   "as": "$agg"
  },
  {
   "op": "create",
   "parent": "$agg",
   "type": "IAliasedSource",
   "args": {
    "dataSource": "IServerEntity:Customer"
   }
  },
  {
   "op": "create",
   "parent": "$agg",
   "type": "IFilter",
   "args": {
    "condition": "Customer.Id = CustomerId"
   }
  },
  {
   "op": "create",
   "parent": "$act",
