  {
   "op": "set",
   "target": "$credit",
   "prop": "DataType",
   "value": "Currency"
  },
  {
   "op": "set",
   "target": "$credit",
   "prop": "DefaultValue",
   "value": "0"
  },
  {
   "op": "create",
   "parent": "@espace",
   "type": "IServerAction",
   "name": "Customer_AddCredit",
   "as": "$act"
  },
  {
   "op": "set",
   "target": "$act",
