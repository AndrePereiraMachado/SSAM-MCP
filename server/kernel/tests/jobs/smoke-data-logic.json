   "target": "$if",
   "prop": "Condition",
   "value": "not GetCustomer.List.Empty"
  },
  {
   "op": "create",
   "parent": "$act",
   "type": "IAssignNode",
   "name": "AddCredit",
   "as": "$assign"
  },
  {
   "op": "set",
   "target": "$assign",
   "prop": "Label",
   "value": "AddCredit"
