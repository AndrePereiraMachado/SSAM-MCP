  },
  {
   "op": "set",
   "target": "$a1",
   "prop": "Value",
   "value": "GetCustomer.List.Current.Customer"
  },
  {
   "op": "create",
   "parent": "$assign",
   "type": "IAssignment",
   "as": "$a2"
  },
  {
   "op": "set",
   "target": "$a2",
   "prop": "Variable",
   "value": "C.Credit"
  },
  {
   "op": "set",
   "target": "$a2",
   "prop": "Value",
   "value": "C.Credit + Amount"
  },
  {
   "op": "create",
   "parent": "$act",
   "type": "IExecuteServerActionNode",
   "name": "UpdateCustomer",
   "as": "$upd"
  },
  {
   "op": "set",
   "target": "$upd",
   "prop": "Action",
   "value": "IEntityActionSignature:UpdateCustomer"
  },
  {
   "op": "set",
   "target": "$upd/Source",
   "prop": "Value",
   "value": "C"
  },
  {
   "op": "create",
   "parent": "$act",
   "type": "IAssignNode",
   "name": "SetOutput",
   "as": "$setout"
  },
  {
   "op": "set",
   "target": "$setout",
   "prop": "Label",
   "value": "SetOutput"
  },
  {
   "op": "create",
   "parent": "$setout",
   "type": "IAssignment",
   "as": "$a3"
  },
  {
   "op": "set",
   "target": "$a3",
   "prop": "Variable",
   "value": "NewCredit"
  },
  {
   "op": "set",
   "target": "$a3",
   "prop": "Value",
   "value": "C.Credit"
  },
  {
   "op": "create",
   "parent": "@espace",
   "type": "IUserException",
   "name": "CustomerNotFound",
   "as": "$ex"
  },
  {
   "op": "create",
   "parent": "$act",
   "type": "IRaiseExceptionNode",
   "name": "RaiseNotFound",
   "as": "$raise"
  },
  {
   "op": "set",
   "target": "$raise",
   "prop": "Exception",
   "value": "$ex"
  },
  {
   "op": "set",
   "target": "$raise",
   "prop": "ExceptionMessage",
   "value": "\"Customer not found\""
  },
  {
   "op": "link",
   "from": "$start",
   "to": "$agg"
  },
  {
   "op": "link",
   "from": "$agg",
   "to": "$if"
  },
  {
   "op": "link",
   "from": "$if",
   "connector": "TrueTarget",
   "to": "$assign"
  },
  {
   "op": "link",
   "from": "$if",
   "connector": "FalseTarget",
   "to": "$raise"
  },
  {
   "op": "link",
   "from": "$assign",
   "to": "$upd"
  },
  {
   "op": "link",
   "from": "$upd",
   "to": "$setout"
  },
  {
   "op": "link",
   "from": "$setout",
   "to": "$end"
  },
  {
   "op": "layout",
   "target": "$act"
  },
  {
   "op": "find",
   "name": "Customer_AddCredit"
  },
  {
   "op": "get",
   "target": "$act"
  }
 ]
}