{
 "description": "Entidade e server action com aggregate, If, Assign, Execute e Raise.",
 "base": "tests/fixtures/blank-service.oml",
 "expectValid": true,
 "ops": [
  {
   "op": "create",
   "parent": "@espace",
   "type": "IServerEntity",
   "name": "Customer",
   "as": "$cust"
  },
  {
   "op": "set",
   "target": "$cust",
   "prop": "Description",
   "value": "Cliente (job de verbos)"
  },
  {
   "op": "create",
   "parent": "$cust",
   "type": "IEntityAttribute",
   "name": "Id",
   "as": "$id"
  },
  {
   "op": "set",
   "target": "$id",
   "prop": "DataType",
   "value": "Long Integer"
  },
  {
   "op": "set",
   "target": "$id",
   "prop": "IsAutoNumber",
   "value": "Yes"
  },
  {
   "op": "set",
   "target": "$id",
   "prop": "IsMandatory",
   "value": true
  },
  {
   "op": "set",
   "target": "$cust",
   "prop": "IdentifierAttribute",
   "value": "$id"
  },
  {
   "op": "create",
   "parent": "$cust",
   "type": "IEntityAttribute",
   "name": "Name",
   "as": "$name"
  },
  {
   "op": "set",
   "target": "$name",
   "prop": "DataType",
   "value": "Text"
  },
  {
   "op": "set",
   "target": "$name",
   "prop": "Length",
   "value": 100
  },
  {
   "op": "set",
   "target": "$name",
   "prop": "IsMandatory",
   "value": true
  },
  {
   "op": "create",
   "parent": "$cust",
   "type": "IEntityAttribute",
   "name": "Credit",
