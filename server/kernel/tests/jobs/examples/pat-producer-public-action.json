{
 "description": "Producer (a Service module): the public entity Supplier, the public structure SupplierSummary and the public server action Supplier_GetSummary. It is the producer side of pat-consumer-reference-action.",
 "base": "blank-service.oml",
 "expectValid": true,
 "expectedMessages": [],
 "ops": [
  {"op": "spec", "data": {
   "entities": [{"name": "Supplier", "public": true, "attributes": [
    {"name": "Name", "type": "Text", "mandatory": true, "length": 100},
    {"name": "Country", "type": "Text", "length": 50},
    {"name": "Rating", "type": "Integer"}]}],
   "structures": [{"name": "SupplierSummary", "public": true, "attributes": [
    {"name": "Title", "type": "Text"},
    {"name": "IsTopRated", "type": "Boolean"}]}]}},
  {"op": "logic", "data": {"actions": [
   {"name": "Supplier_GetSummary", "kind": "server", "public": true, "description": "Summary of a supplier for other modules",
    "inputs": [{"name": "SupplierId", "type": "Supplier Identifier"}],
    "outputs": [{"name": "Summary", "type": "SupplierSummary"}],
    "steps": [
     {"get": "Supplier", "as": "GetSupplier", "where": "Supplier.Id = SupplierId", "max": 1},
     {"assign": {
      "Summary.Title": "GetSupplier.List.Current.Supplier.Name + \" (\" + GetSupplier.List.Current.Supplier.Country + \")\"",
      "Summary.IsTopRated": "GetSupplier.List.Current.Supplier.Rating >= 4"}, "as": "FillSummary"}]}]}}
 ]
}
