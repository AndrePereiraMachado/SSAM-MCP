{
 "description": "Typical BottomSheet (OutSystemsUI, Interaction); placeholders Content with data of the tasks aggregate; events Initialized, OnToggle handled by screen actions that keep the parameters in variables.",
 "base": "job:ex-base-mobile",
 "expectValid": true,
 "expectedMessages": [],
 "ops": [
  {"op": "create", "parent": "IMobileScreen:Showcase", "type": "ILocalVariable", "name": "LastBottomSheetId", "as": "$vLastBottomSheetId"},
  {"op": "set", "target": "$vLastBottomSheetId", "prop": "DataType", "value": "Text"},
  {"op": "create", "parent": "IMobileScreen:Showcase", "type": "ILocalVariable", "name": "LastIsOpen", "as": "$vLastIsOpen"},
  {"op": "set", "target": "$vLastIsOpen", "prop": "DataType", "value": "Boolean"},
  {"op": "create", "parent": "IMobileScreen:Showcase", "type": "IScreenAggregate", "name": "GetShowcaseTasks", "as": "$tasks"},
  {"op": "create", "parent": "$tasks", "type": "IAliasedSource", "args": {"dataSource": "IServerEntity:Task"}},
  {"op": "logic", "data": {"actions": [{"name": "BottomSheetDemoInitialized", "kind": "screen", "owner": "IMobileScreen:Showcase", "description": "Guarda os parametros de Initialized", "inputs": [{"name": "BottomSheetId", "type": "Text"}],"steps": [{"assign": {"LastBottomSheetId": "BottomSheetId"},"as": "KeepInitialized"}]}, {"name": "BottomSheetDemoOnToggle", "kind": "screen", "owner": "IMobileScreen:Showcase", "description": "Guarda os parametros de OnToggle", "inputs": [{"name": "BottomSheetId", "type": "Text"}, {"name": "IsOpen", "type": "Boolean"}],"steps": [{"assign": {"LastBottomSheetId": "BottomSheetId", "LastIsOpen": "IsOpen"},"as": "KeepOnToggle"}]}]}},
  {"op": "create", "parent": "IMobileScreen:Showcase/#IMobileBlockInstanceWidget/Content", "type": "IMobileBlockInstanceWidget", "name": "BottomSheetDemo", "source": "IMobileBlock:BottomSheet", "as": "$b"},
  {"op": "set", "target": "$b/Initialized", "prop": "Handler", "value": "IScreenAction:BottomSheetDemoInitialized"},
  {"op": "set", "target": "$b/Initialized/BottomSheetId", "prop": "Value", "value": "BottomSheetId"},
  {"op": "set", "target": "$b/OnToggle", "prop": "Handler", "value": "IScreenAction:BottomSheetDemoOnToggle"},
  {"op": "set", "target": "$b/OnToggle/BottomSheetId", "prop": "Value", "value": "BottomSheetId"},
  {"op": "set", "target": "$b/OnToggle/IsOpen", "prop": "Value", "value": "IsOpen"},
  {"op": "create", "parent": "$b/Content", "type": "IExpression", "as": "$ph1"},
  {"op": "set", "target": "$ph1", "prop": "Value", "value": "GetShowcaseTasks.Count + \" task(s)\""}
 ]
}
