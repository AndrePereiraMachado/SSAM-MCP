{
 "description": "A list with a filter and pagination: a paged aggregate (StartIndex/MaxRecords), a text search, a filter by a static in a Dropdown, a Table and the Pagination block with OnNavigate. Changing a filter goes back to the first page.",
 "base": "reactive-ui.oml",
 "expectValid": true,
 "expectedMessages": [],
 "ops": [
  {"op": "spec", "data": {
   "static": [{"name": "TicketStatus", "records": [{"name": "Open"}, {"name": "InProgress", "label": "In progress"}, {"name": "Closed"}]}],
   "entities": [{"name": "Ticket", "attributes": [
    {"name": "Subject", "type": "Text", "mandatory": true, "length": 200},
    {"name": "OpenedOn", "type": "Date"},
    {"name": "StatusId", "type": "TicketStatus Identifier", "mandatory": true}]}]}},
  {"op": "create", "parent": "IMobileFlow:MainFlow", "type": "IMobileScreen", "name": "Tickets", "as": "$scr"},
  {"op": "set", "target": "$scr/#IMobileBlockInstanceWidget", "prop": "SourceBlock", "value": "IMobileBlock:LayoutTopMenu"},
  {"op": "create", "parent": "$scr/#IMobileBlockInstanceWidget/Title", "type": "IExpression", "as": "$title"},
  {"op": "set", "target": "$title", "prop": "Value", "value": "\"Tickets\""},
  {"op": "create", "parent": "$scr", "type": "ILocalVariable", "name": "SearchText", "as": "$vSearch"},
  {"op": "set", "target": "$vSearch", "prop": "DataType", "value": "Text"},
  {"op": "create", "parent": "$scr", "type": "ILocalVariable", "name": "StatusFilter", "as": "$vStatus"},
  {"op": "set", "target": "$vStatus", "prop": "DataType", "value": "TicketStatus Identifier"},
  {"op": "create", "parent": "$scr", "type": "ILocalVariable", "name": "StartIndex", "as": "$vStart"},
  {"op": "set", "target": "$vStart", "prop": "DataType", "value": "Integer"},
  {"op": "set", "target": "$vStart", "prop": "DefaultValue", "value": "0"},
  {"op": "create", "parent": "$scr", "type": "ILocalVariable", "name": "MaxRecords", "as": "$vMax"},
  {"op": "set", "target": "$vMax", "prop": "DataType", "value": "Integer"},
  {"op": "set", "target": "$vMax", "prop": "DefaultValue", "value": "10"},

  {"op": "create", "parent": "$scr", "type": "IScreenAggregate", "name": "GetTicketPage", "as": "$agg"},
  {"op": "create", "parent": "$agg", "type": "IAliasedSource", "args": {"dataSource": "IServerEntity:Ticket"}},
  {"op": "create", "parent": "$agg", "type": "IFilter", "args": {"condition": "Ticket.Subject like \"%\" + SearchText + \"%\""}},
  {"op": "create", "parent": "$agg", "type": "IFilter", "args": {"condition": "StatusFilter = NullIdentifier() or Ticket.StatusId = StatusFilter"}},
  {"op": "create", "parent": "$agg", "type": "ISort", "as": "$sort"},
  {"op": "set", "target": "$sort", "prop": "Attribute", "value": "Ticket.OpenedOn"},
  {"op": "set", "target": "$sort", "prop": "SortDirection", "value": "Descending"},
  {"op": "set", "target": "$agg", "prop": "StartIndex", "value": "StartIndex"},
  {"op": "set", "target": "$agg", "prop": "MaxRecords", "value": "MaxRecords"},
  {"op": "create", "parent": "$scr", "type": "IScreenAggregate", "name": "GetStatusOptions", "as": "$aggStatus"},
  {"op": "create", "parent": "$aggStatus", "type": "IAliasedSource", "args": {"dataSource": "IStaticEntity:TicketStatus"}},

  {"op": "logic", "data": {"actions": [
   {"name": "FiltersChanged", "kind": "screen", "owner": "IMobileScreen:Tickets", "description": "The filter changed: back to the first page and the query again",
    "steps": [
     {"assign": {"StartIndex": "0"}, "as": "FirstPage"},
     {"node": "IRefreshDataNode", "as": "RefreshTickets", "properties": {"DataSource": "IScreenAggregate:GetTicketPage"}}]},
   {"name": "PageChanged", "kind": "screen", "owner": "IMobileScreen:Tickets", "description": "Pagination.OnNavigate: keeps the new start and runs the query again",
    "inputs": [{"name": "NewStartIndex", "type": "Integer"}],
    "steps": [
     {"assign": {"StartIndex": "NewStartIndex"}, "as": "GoToPage"},
     {"node": "IRefreshDataNode", "as": "RefreshPage", "properties": {"DataSource": "IScreenAggregate:GetTicketPage"}}]}]}},

  {"op": "create", "parent": "$scr/#IMobileBlockInstanceWidget/MainContent", "type": "IContainer", "name": "Filters", "as": "$filters"},
  {"op": "create", "parent": "$filters", "type": "IInput", "name": "SearchInput", "as": "$inSearch"},
  {"op": "set", "target": "$inSearch", "prop": "Variable", "value": "SearchText"},
  {"op": "set", "target": "$inSearch", "prop": "Prompt", "value": "\"Search subject\""},
  {"op": "set", "target": "$inSearch/OnChange", "prop": "Destination", "value": "IScreenAction:FiltersChanged"},
  {"op": "create", "parent": "$filters", "type": "IDropdown", "name": "StatusDropdown", "as": "$ddStatus"},
  {"op": "set", "target": "$ddStatus", "prop": "Variable", "value": "StatusFilter"},
  {"op": "set", "target": "$ddStatus", "prop": "List", "value": "GetStatusOptions.List"},
  {"op": "set", "target": "$ddStatus", "prop": "Values", "value": "TicketStatus.Id"},
  {"op": "set", "target": "$ddStatus", "prop": "Labels", "value": "TicketStatus.Label"},
  {"op": "set", "target": "$ddStatus", "prop": "EmptyValue", "value": "\"All statuses\""},
  {"op": "set", "target": "$ddStatus/OnChange", "prop": "Destination", "value": "IScreenAction:FiltersChanged"},

  {"op": "create", "parent": "$scr/#IMobileBlockInstanceWidget/MainContent", "type": "ITableRecords", "name": "TicketTable", "as": "$tbl", "empty": true},
  {"op": "set", "target": "$tbl", "prop": "Source", "value": "GetTicketPage.List"},
  {"op": "create", "parent": "$tbl/HeaderRow", "type": "IHeaderCell", "name": "SubjectHeader", "as": "$h1"},
  {"op": "create", "parent": "$h1", "type": "IExpression", "as": "$h1e"},
  {"op": "set", "target": "$h1e", "prop": "Value", "value": "\"Subject\""},
  {"op": "create", "parent": "$tbl/HeaderRow", "type": "IHeaderCell", "name": "OpenedHeader", "as": "$h2"},
  {"op": "create", "parent": "$h2", "type": "IExpression", "as": "$h2e"},
  {"op": "set", "target": "$h2e", "prop": "Value", "value": "\"Opened on\""},
  {"op": "create", "parent": "$tbl/Row", "type": "IRowCell", "name": "SubjectCell", "as": "$c1"},
  {"op": "create", "parent": "$c1", "type": "IExpression", "as": "$c1e"},
  {"op": "set", "target": "$c1e", "prop": "Value", "value": "GetTicketPage.List.Current.Ticket.Subject"},
  {"op": "create", "parent": "$tbl/Row", "type": "IRowCell", "name": "OpenedCell", "as": "$c2"},
  {"op": "create", "parent": "$c2", "type": "IExpression", "as": "$c2e"},
  {"op": "set", "target": "$c2e", "prop": "Value", "value": "FormatDateTime(GetTicketPage.List.Current.Ticket.OpenedOn, \"yyyy-MM-dd\")"},

  {"op": "create", "parent": "$scr/#IMobileBlockInstanceWidget/MainContent", "type": "IMobileBlockInstanceWidget", "name": "TicketPagination", "source": "IMobileBlock:Pagination", "as": "$pg"},
  {"op": "set", "target": "$pg/StartIndex", "prop": "Value", "value": "StartIndex"},
  {"op": "set", "target": "$pg/MaxRecords", "prop": "Value", "value": "MaxRecords"},
  {"op": "set", "target": "$pg/TotalCount", "prop": "Value", "value": "GetTicketPage.Count"},
  {"op": "set", "target": "$pg/OnNavigate", "prop": "Handler", "value": "IScreenAction:PageChanged"},
  {"op": "set", "target": "$pg/OnNavigate/NewStartIndex", "prop": "Value", "value": "NewStartIndex"}
 ]
}
