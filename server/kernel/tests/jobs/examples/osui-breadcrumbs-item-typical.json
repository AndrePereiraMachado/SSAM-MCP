{
 "description": "BreadcrumbsItem (OutSystemsUI, Navigation) tipico; dentro de um Breadcrumbs vazio (placeholder Content); placeholders Title, Icon com dados do aggregate de tarefas.",
 "base": "job:ex-base",
 "expectValid": true,
 "expectedMessages": [],
 "ops": [
  {"op": "create", "parent": "IMobileScreen:Showcase", "type": "IScreenAggregate", "name": "GetShowcaseTasks", "as": "$tasks"},
  {"op": "create", "parent": "$tasks", "type": "IAliasedSource", "args": {"dataSource": "IServerEntity:Task"}},
  {"op": "create", "parent": "IMobileScreen:Showcase/#IMobileBlockInstanceWidget/MainContent", "type": "IMobileBlockInstanceWidget", "name": "BreadcrumbsDemo", "source": "IMobileBlock:Breadcrumbs", "empty": true,"as": "$parent"},
  {"op": "create", "parent": "$parent/Content", "type": "IMobileBlockInstanceWidget", "name": "BreadcrumbsItemDemo", "source": "IMobileBlock:BreadcrumbsItem", "as": "$b"},
  {"op": "create", "parent": "$b/Title", "type": "IExpression", "as": "$ph1"},
  {"op": "set", "target": "$ph1", "prop": "Value", "value": "\"Tasks\""},
  {"op": "create", "parent": "$b/Icon", "type": "IExpression", "as": "$ph2"},
  {"op": "set", "target": "$ph2", "prop": "Value", "value": "GetShowcaseTasks.Count + \" task(s)\""}
 ]
}
