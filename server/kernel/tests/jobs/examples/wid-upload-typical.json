{
 "description": "Typical Upload: FileContent and FileName bound to screen variables; OnChange saves the file through the server action TaskFile_Create (entity TaskFile with Binary Data) and shows a message.",
 "base": "job:ex-base",
 "expectValid": true,
 "expectedMessages": [],
 "ops": [
  {"op": "spec", "data": {"entities": [{"name": "TaskFile", "attributes": [
   {"name": "FileName", "type": "Text", "mandatory": true, "length": 250},
   {"name": "Content", "type": "Binary Data"}]}]}},
  {"op": "logic", "data": {"actions": [
   {"name": "TaskFile_Create", "kind": "server", "description": "Keeps an uploaded file",
    "inputs": [{"name": "FileName", "type": "Text"}, {"name": "Content", "type": "Binary Data"}],
    "outputs": [{"name": "TaskFileId", "type": "TaskFile Identifier"}],
    "vars": [{"name": "Item", "type": "TaskFile"}],
    "steps": [
     {"assign": {"Item.FileName": "FileName", "Item.Content": "Content"}, "as": "FillTaskFile"},
     {"create": "TaskFile", "record": "Item", "as": "CreateTaskFile"},
     {"assign": {"TaskFileId": "CreateTaskFile.Id"}, "as": "KeepId"}]}]}},
  {"op": "create", "parent": "IMobileScreen:Showcase", "type": "ILocalVariable", "name": "UploadContent", "as": "$vContent"},
  {"op": "set", "target": "$vContent", "prop": "DataType", "value": "Binary Data"},
  {"op": "create", "parent": "IMobileScreen:Showcase", "type": "ILocalVariable", "name": "UploadName", "as": "$vName"},
  {"op": "set", "target": "$vName", "prop": "DataType", "value": "Text"},
  {"op": "logic", "data": {"actions": [
   {"name": "UploadOnChange", "kind": "screen", "owner": "IMobileScreen:Showcase", "description": "Saves the chosen file",
    "steps": [
     {"call": "TaskFile_Create", "as": "SaveTaskFile", "args": {"FileName": "UploadName", "Content": "UploadContent"}},
     {"node": "IMessageNode", "as": "UploadedMessage", "properties": {"Message": "UploadName + \" uploaded\"", "Type": "Success"}}]}]}},
  {"op": "create", "parent": "IMobileScreen:Showcase/#IMobileBlockInstanceWidget/MainContent", "type": "IUpload", "name": "TaskFileUpload", "as": "$up"},
  {"op": "set", "target": "$up", "prop": "FileContent", "value": "UploadContent"},
  {"op": "set", "target": "$up", "prop": "FileName", "value": "UploadName"},
  {"op": "set", "target": "$up/OnChange", "prop": "Destination", "value": "IScreenAction:UploadOnChange"}
 ]
}
