{
 "description": "Typical MouseEvents (OutSystemsUI, Utilities); required inputs WidgetId bound to the Id of a Container of the screen; events Move, End, Start handled by screen actions that keep the parameters in variables.",
 "base": "job:ex-base",
 "expectValid": true,
 "expectedMessages": [],
 "ops": [
  {"op": "create", "parent": "IMobileScreen:Showcase/#IMobileBlockInstanceWidget/MainContent", "type": "IContainer", "name": "MouseEventsTarget", "as": "$target"},
  {"op": "create", "parent": "$target", "type": "IExpression", "as": "$targetText"},
  {"op": "set", "target": "$targetText", "prop": "Value", "value": "GetShowcaseTasks.Count + \" task(s): touch or move here\""},
  {"op": "create", "parent": "IMobileScreen:Showcase", "type": "ILocalVariable", "name": "LastX", "as": "$vLastX"},
  {"op": "set", "target": "$vLastX", "prop": "DataType", "value": "Decimal"},
  {"op": "create", "parent": "IMobileScreen:Showcase", "type": "ILocalVariable", "name": "LastY", "as": "$vLastY"},
  {"op": "set", "target": "$vLastY", "prop": "DataType", "value": "Decimal"},
  {"op": "create", "parent": "IMobileScreen:Showcase", "type": "ILocalVariable", "name": "LastOffsetX", "as": "$vLastOffsetX"},
  {"op": "set", "target": "$vLastOffsetX", "prop": "DataType", "value": "Decimal"},
  {"op": "create", "parent": "IMobileScreen:Showcase", "type": "ILocalVariable", "name": "LastOffsetY", "as": "$vLastOffsetY"},
  {"op": "set", "target": "$vLastOffsetY", "prop": "DataType", "value": "Decimal"},
  {"op": "create", "parent": "IMobileScreen:Showcase", "type": "ILocalVariable", "name": "LastEvt", "as": "$vLastEvt"},
  {"op": "set", "target": "$vLastEvt", "prop": "DataType", "value": "Object"},
  {"op": "create", "parent": "IMobileScreen:Showcase", "type": "ILocalVariable", "name": "LastTimeTaken", "as": "$vLastTimeTaken"},
  {"op": "set", "target": "$vLastTimeTaken", "prop": "DataType", "value": "Decimal"},
  {"op": "create", "parent": "IMobileScreen:Showcase", "type": "IScreenAggregate", "name": "GetShowcaseTasks", "as": "$tasks"},
  {"op": "create", "parent": "$tasks", "type": "IAliasedSource", "args": {"dataSource": "IServerEntity:Task"}},
  {"op": "logic", "data": {"actions": [{"name": "MouseEventsDemoMove", "kind": "screen", "owner": "IMobileScreen:Showcase", "description": "Guarda os parametros de Move", "inputs": [{"name": "X", "type": "Decimal"}, {"name": "Y", "type": "Decimal"}, {"name": "OffsetX", "type": "Decimal"}, {"name": "OffsetY", "type": "Decimal"}, {"name": "Evt", "type": "Object"}],"steps": [{"assign": {"LastX": "X", "LastY": "Y", "LastOffsetX": "OffsetX", "LastOffsetY": "OffsetY", "LastEvt": "Evt"},"as": "KeepMove"}]}, {"name": "MouseEventsDemoEnd", "kind": "screen", "owner": "IMobileScreen:Showcase", "description": "Guarda os parametros de End", "inputs": [{"name": "X", "type": "Decimal"}, {"name": "Y", "type": "Decimal"}, {"name": "OffsetX", "type": "Decimal"}, {"name": "OffsetY", "type": "Decimal"}, {"name": "TimeTaken", "type": "Decimal"}],"steps": [{"assign": {"LastX": "X", "LastY": "Y", "LastOffsetX": "OffsetX", "LastOffsetY": "OffsetY", "LastTimeTaken": "TimeTaken"},"as": "KeepEnd"}]}, {"name": "MouseEventsDemoStart", "kind": "screen", "owner": "IMobileScreen:Showcase", "description": "Guarda os parametros de Start", "inputs": [{"name": "X", "type": "Decimal"}, {"name": "Y", "type": "Decimal"}],"steps": [{"assign": {"LastX": "X", "LastY": "Y"},"as": "KeepStart"}]}]}},
  {"op": "create", "parent": "IMobileScreen:Showcase/#IMobileBlockInstanceWidget/MainContent", "type": "IMobileBlockInstanceWidget", "name": "MouseEventsDemo", "source": "IMobileBlock:MouseEvents", "as": "$b"},
  {"op": "set", "target": "$b/WidgetId", "prop": "Value", "value": "MouseEventsTarget.Id"},
  {"op": "set", "target": "$b/Move", "prop": "Handler", "value": "IScreenAction:MouseEventsDemoMove"},
  {"op": "set", "target": "$b/Move/X", "prop": "Value", "value": "X"},
  {"op": "set", "target": "$b/Move/Y", "prop": "Value", "value": "Y"},
  {"op": "set", "target": "$b/Move/OffsetX", "prop": "Value", "value": "OffsetX"},
  {"op": "set", "target": "$b/Move/OffsetY", "prop": "Value", "value": "OffsetY"},
  {"op": "set", "target": "$b/Move/Evt", "prop": "Value", "value": "Evt"},
  {"op": "set", "target": "$b/End", "prop": "Handler", "value": "IScreenAction:MouseEventsDemoEnd"},
  {"op": "set", "target": "$b/End/X", "prop": "Value", "value": "X"},
  {"op": "set", "target": "$b/End/Y", "prop": "Value", "value": "Y"},
  {"op": "set", "target": "$b/End/OffsetX", "prop": "Value", "value": "OffsetX"},
  {"op": "set", "target": "$b/End/OffsetY", "prop": "Value", "value": "OffsetY"},
  {"op": "set", "target": "$b/End/TimeTaken", "prop": "Value", "value": "TimeTaken"},
  {"op": "set", "target": "$b/Start", "prop": "Handler", "value": "IScreenAction:MouseEventsDemoStart"},
  {"op": "set", "target": "$b/Start/X", "prop": "Value", "value": "X"},
  {"op": "set", "target": "$b/Start/Y", "prop": "Value", "value": "Y"}
 ]
}
