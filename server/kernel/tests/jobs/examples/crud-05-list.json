{
 "description": "Back-office CRUD, part 5 of 5 (list, table first): ProductList with a search, a category filter, a paged table (join with the static for the category name), a Link of the code to ProductEdit, a New button, and delete with a confirmation in a native Popup (Confirm calls Product_Delete and reloads; Cancel closes).",
 "base": "job:crud-04-edit",
 "expectValid": true,
 "expectedMessages": [],
 "ops": [
  {"op": "create", "parent": "IMobileScreen:ProductList", "type": "ILocalVariable", "name": "SearchText", "as": "$vSearch"},
  {"op": "set", "target": "$vSearch", "prop": "DataType", "value": "Text"},
  {"op": "create", "parent": "IMobileScreen:ProductList", "type": "ILocalVariable", "name": "CategoryFilter", "as": "$vCat"},
  {"op": "set", "target": "$vCat", "prop": "DataType", "value": "ProductCategory Identifier"},
  {"op": "create", "parent": "IMobileScreen:ProductList", "type": "ILocalVariable", "name": "StartIndex", "as": "$vStart"},
  {"op": "set", "target": "$vStart", "prop": "DataType", "value": "Integer"},
  {"op": "set", "target": "$vStart", "prop": "DefaultValue", "value": "0"},
  {"op": "create", "parent": "IMobileScreen:ProductList", "type": "ILocalVariable", "name": "MaxRecords", "as": "$vMax"},
  {"op": "set", "target": "$vMax", "prop": "DataType", "value": "Integer"},
  {"op": "set", "target": "$vMax", "prop": "DefaultValue", "value": "20"},
  {"op": "create", "parent": "IMobileScreen:ProductList", "type": "ILocalVariable", "name": "ShowDeleteConfirm", "as": "$vShow"},
  {"op": "set", "target": "$vShow", "prop": "DataType", "value": "Boolean"},
  {"op": "create", "parent": "IMobileScreen:ProductList", "type": "ILocalVariable", "name": "PendingDeleteId", "as": "$vDelId"},
  {"op": "set", "target": "$vDelId", "prop": "DataType", "value": "Product Identifier"},
  {"op": "create", "parent": "IMobileScreen:ProductList", "type": "ILocalVariable", "name": "PendingDeleteName", "as": "$vDelName"},
  {"op": "set", "target": "$vDelName", "prop": "DataType", "value": "Text"},

  {"op": "create", "parent": "IMobileScreen:ProductList", "type": "IScreenAggregate", "name": "GetProductPage", "as": "$agg"},
  {"op": "create", "parent": "$agg", "type": "IAliasedSource", "args": {"dataSource": "IServerEntity:Product"}, "as": "$srcProduct"},
  {"op": "create", "parent": "$agg", "type": "IAliasedSource", "args": {"dataSource": "IStaticEntity:ProductCategory"}, "as": "$srcCategory"},
  {"op": "create", "parent": "$agg", "type": "IJoin", "as": "$join"},
  {"op": "set", "target": "$join", "prop": "LeftSource", "value": "$srcProduct"},
  {"op": "set", "target": "$join", "prop": "RightSource", "value": "$srcCategory"},
  {"op": "set", "target": "$join", "prop": "JoinType", "value": "Inner"},
  {"op": "set", "target": "$join", "prop": "Condition", "value": "Product.CategoryId = ProductCategory.Id"},
  {"op": "create", "parent": "$agg", "type": "IFilter", "args": {"condition": "Product.Code like \"%\" + SearchText + \"%\" or Product.Name like \"%\" + SearchText + \"%\""}},
  {"op": "create", "parent": "$agg", "type": "IFilter", "args": {"condition": "CategoryFilter = NullIdentifier() or Product.CategoryId = CategoryFilter"}},
  {"op": "create", "parent": "$agg", "type": "ISort", "as": "$sort"},
  {"op": "set", "target": "$sort", "prop": "Attribute", "value": "Product.Name"},
  {"op": "set", "target": "$agg", "prop": "StartIndex", "value": "StartIndex"},
  {"op": "set", "target": "$agg", "prop": "MaxRecords", "value": "MaxRecords"},
  {"op": "create", "parent": "IMobileScreen:ProductList", "type": "IScreenAggregate", "name": "GetCategoryFilterList", "as": "$aggCat"},
  {"op": "create", "parent": "$aggCat", "type": "IAliasedSource", "args": {"dataSource": "IStaticEntity:ProductCategory"}},

  {"op": "logic", "data": {"actions": [
   {"name": "FiltersChanged", "kind": "screen", "owner": "IMobileScreen:ProductList", "description": "The filter changed: first page and a new query",
    "steps": [
     {"assign": {"StartIndex": "0"}, "as": "FirstPage"},
     {"node": "IRefreshDataNode", "as": "RefreshProducts", "properties": {"DataSource": "IScreenAggregate:GetProductPage"}}]},
   {"name": "PageChanged", "kind": "screen", "owner": "IMobileScreen:ProductList", "description": "Pagination.OnNavigate",
    "inputs": [{"name": "NewStartIndex", "type": "Integer"}],
    "steps": [
     {"assign": {"StartIndex": "NewStartIndex"}, "as": "GoToPage"},
     {"node": "IRefreshDataNode", "as": "RefreshPage", "properties": {"DataSource": "IScreenAggregate:GetProductPage"}}]},
   {"name": "AskDelete", "kind": "screen", "owner": "IMobileScreen:ProductList", "description": "Guarda o produto e abre a confirmacao",
    "inputs": [{"name": "ProductId", "type": "Product Identifier"}, {"name": "ProductName", "type": "Text"}],
    "steps": [{"assign": {"PendingDeleteId": "ProductId", "PendingDeleteName": "ProductName", "ShowDeleteConfirm": "True"}, "as": "OpenConfirm"}]},
   {"name": "CancelDelete", "kind": "screen", "owner": "IMobileScreen:ProductList", "description": "Closes the confirmation without deleting",
    "steps": [{"assign": {"ShowDeleteConfirm": "False", "PendingDeleteId": "NullIdentifier()"}, "as": "CloseConfirm"}]},
   {"name": "ConfirmDelete", "kind": "screen", "owner": "IMobileScreen:ProductList", "description": "Deletes through the wrapper, closes and reloads",
    "steps": [
     {"call": "Product_Delete", "as": "DeleteProduct", "args": {"ProductId": "PendingDeleteId"}},
     {"assign": {"ShowDeleteConfirm": "False", "PendingDeleteId": "NullIdentifier()"}, "as": "CloseConfirm"},
     {"node": "IRefreshDataNode", "as": "RefreshAfterDelete", "properties": {"DataSource": "IScreenAggregate:GetProductPage"}},
     {"node": "IMessageNode", "as": "DeletedMessage", "properties": {"Message": "\"Product deleted\"", "Type": "Success"}}]}]}},

  {"op": "create", "parent": "IMobileScreen:ProductList/#IMobileBlockInstanceWidget/MainContent", "type": "IContainer", "name": "Toolbar", "as": "$bar"},
  {"op": "create", "parent": "$bar", "type": "IInput", "name": "SearchInput", "as": "$inSearch"},
  {"op": "set", "target": "$inSearch", "prop": "Variable", "value": "SearchText"},
  {"op": "set", "target": "$inSearch", "prop": "Prompt", "value": "\"Code or name\""},
  {"op": "set", "target": "$inSearch/OnChange", "prop": "Destination", "value": "IScreenAction:FiltersChanged"},
  {"op": "create", "parent": "$bar", "type": "IDropdown", "name": "CategoryFilterDropdown", "as": "$ddCat"},
  {"op": "set", "target": "$ddCat", "prop": "Variable", "value": "CategoryFilter"},
  {"op": "set", "target": "$ddCat", "prop": "List", "value": "GetCategoryFilterList.List"},
  {"op": "set", "target": "$ddCat", "prop": "Values", "value": "ProductCategory.Id"},
  {"op": "set", "target": "$ddCat", "prop": "Labels", "value": "ProductCategory.Label"},
  {"op": "set", "target": "$ddCat", "prop": "EmptyValue", "value": "\"All categories\""},
  {"op": "set", "target": "$ddCat/OnChange", "prop": "Destination", "value": "IScreenAction:FiltersChanged"},
  {"op": "create", "parent": "$bar", "type": "IButton", "name": "NewProductButton", "as": "$btnNew"},
  {"op": "set", "target": "$btnNew/#ITextWidget", "prop": "Text", "value": "New product"},
  {"op": "set", "target": "$btnNew/OnClick", "prop": "Destination", "value": "IMobileScreen:ProductEdit"},
  {"op": "set", "target": "$btnNew/OnClick/ProductId", "prop": "Value", "value": "NullIdentifier()"},

  {"op": "create", "parent": "IMobileScreen:ProductList/#IMobileBlockInstanceWidget/MainContent", "type": "ITableRecords", "name": "ProductTable", "as": "$tbl", "empty": true},
  {"op": "set", "target": "$tbl", "prop": "Source", "value": "GetProductPage.List"},
  {"op": "create", "parent": "$tbl/HeaderRow", "type": "IHeaderCell", "name": "CodeHeader", "as": "$hCode"},
  {"op": "create", "parent": "$hCode", "type": "IExpression", "as": "$hCodeT"},
  {"op": "set", "target": "$hCodeT", "prop": "Value", "value": "\"Code\""},
  {"op": "create", "parent": "$tbl/HeaderRow", "type": "IHeaderCell", "name": "NameHeader", "as": "$hName"},
  {"op": "create", "parent": "$hName", "type": "IExpression", "as": "$hNameT"},
  {"op": "set", "target": "$hNameT", "prop": "Value", "value": "\"Name\""},
  {"op": "create", "parent": "$tbl/HeaderRow", "type": "IHeaderCell", "name": "CategoryHeader", "as": "$hCat"},
  {"op": "create", "parent": "$hCat", "type": "IExpression", "as": "$hCatT"},
  {"op": "set", "target": "$hCatT", "prop": "Value", "value": "\"Category\""},
  {"op": "create", "parent": "$tbl/HeaderRow", "type": "IHeaderCell", "name": "PriceHeader", "as": "$hPrice"},
  {"op": "create", "parent": "$hPrice", "type": "IExpression", "as": "$hPriceT"},
  {"op": "set", "target": "$hPriceT", "prop": "Value", "value": "\"Price\""},
  {"op": "create", "parent": "$tbl/HeaderRow", "type": "IHeaderCell", "name": "StockHeader", "as": "$hStock"},
  {"op": "create", "parent": "$hStock", "type": "IExpression", "as": "$hStockT"},
  {"op": "set", "target": "$hStockT", "prop": "Value", "value": "\"Stock\""},
  {"op": "create", "parent": "$tbl/HeaderRow", "type": "IHeaderCell", "name": "ActiveHeader", "as": "$hActive"},
  {"op": "create", "parent": "$hActive", "type": "IExpression", "as": "$hActiveT"},
  {"op": "set", "target": "$hActiveT", "prop": "Value", "value": "\"Active\""},
  {"op": "create", "parent": "$tbl/HeaderRow", "type": "IHeaderCell", "name": "ActionsHeader", "as": "$hActions"},

  {"op": "create", "parent": "$tbl/Row", "type": "IRowCell", "name": "CodeCell", "as": "$cCode"},
  {"op": "create", "parent": "$cCode", "type": "ILink", "name": "EditLink", "as": "$lnkEdit"},
  {"op": "delete", "target": "$lnkEdit/#ITextWidget"},
  {"op": "create", "parent": "$lnkEdit", "type": "IExpression", "as": "$lnkEditT"},
  {"op": "set", "target": "$lnkEditT", "prop": "Value", "value": "GetProductPage.List.Current.Product.Code"},
  {"op": "set", "target": "$lnkEdit/OnClick", "prop": "Destination", "value": "IMobileScreen:ProductEdit"},
  {"op": "set", "target": "$lnkEdit/OnClick/ProductId", "prop": "Value", "value": "GetProductPage.List.Current.Product.Id"},
  {"op": "create", "parent": "$tbl/Row", "type": "IRowCell", "name": "NameCell", "as": "$cName"},
  {"op": "create", "parent": "$cName", "type": "IExpression", "as": "$cNameT"},
  {"op": "set", "target": "$cNameT", "prop": "Value", "value": "GetProductPage.List.Current.Product.Name"},
  {"op": "create", "parent": "$tbl/Row", "type": "IRowCell", "name": "CategoryCell", "as": "$cCat"},
  {"op": "create", "parent": "$cCat", "type": "IExpression", "as": "$cCatT"},
  {"op": "set", "target": "$cCatT", "prop": "Value", "value": "GetProductPage.List.Current.ProductCategory.Label"},
  {"op": "create", "parent": "$tbl/Row", "type": "IRowCell", "name": "PriceCell", "as": "$cPrice"},
  {"op": "create", "parent": "$cPrice", "type": "IExpression", "as": "$cPriceT"},
  {"op": "set", "target": "$cPriceT", "prop": "Value", "value": "FormatDecimal(GetProductPage.List.Current.Product.Price, 2, \".\", \",\")"},
  {"op": "create", "parent": "$tbl/Row", "type": "IRowCell", "name": "StockCell", "as": "$cStock"},
  {"op": "create", "parent": "$cStock", "type": "IExpression", "as": "$cStockT"},
  {"op": "set", "target": "$cStockT", "prop": "Value", "value": "GetProductPage.List.Current.Product.Stock"},
  {"op": "create", "parent": "$tbl/Row", "type": "IRowCell", "name": "ActiveCell", "as": "$cActive"},
  {"op": "create", "parent": "$cActive", "type": "IExpression", "as": "$cActiveT"},
  {"op": "set", "target": "$cActiveT", "prop": "Value", "value": "If(GetProductPage.List.Current.Product.Active, \"Yes\", \"No\")"},
  {"op": "create", "parent": "$tbl/Row", "type": "IRowCell", "name": "ActionsCell", "as": "$cActions"},
  {"op": "create", "parent": "$cActions", "type": "ILink", "name": "DeleteLink", "as": "$lnkDel"},
  {"op": "set", "target": "$lnkDel/#ITextWidget", "prop": "Text", "value": "Delete"},
  {"op": "set", "target": "$lnkDel/OnClick", "prop": "Destination", "value": "IScreenAction:AskDelete"},
  {"op": "set", "target": "$lnkDel/OnClick/ProductId", "prop": "Value", "value": "GetProductPage.List.Current.Product.Id"},
  {"op": "set", "target": "$lnkDel/OnClick/ProductName", "prop": "Value", "value": "GetProductPage.List.Current.Product.Name"},

  {"op": "create", "parent": "IMobileScreen:ProductList/#IMobileBlockInstanceWidget/MainContent", "type": "IMobileBlockInstanceWidget", "name": "ProductPagination", "source": "IMobileBlock:Pagination", "as": "$pg"},
  {"op": "set", "target": "$pg/StartIndex", "prop": "Value", "value": "StartIndex"},
  {"op": "set", "target": "$pg/MaxRecords", "prop": "Value", "value": "MaxRecords"},
  {"op": "set", "target": "$pg/TotalCount", "prop": "Value", "value": "GetProductPage.Count"},
  {"op": "set", "target": "$pg/OnNavigate", "prop": "Handler", "value": "IScreenAction:PageChanged"},
  {"op": "set", "target": "$pg/OnNavigate/NewStartIndex", "prop": "Value", "value": "NewStartIndex"},

  {"op": "create", "parent": "IMobileScreen:ProductList/#IMobileBlockInstanceWidget/MainContent", "type": "IPopup", "name": "DeleteConfirmPopup", "as": "$pop"},
  {"op": "set", "target": "$pop", "prop": "ShowPopup", "value": "ShowDeleteConfirm"},
  {"op": "create", "parent": "$pop", "type": "IExpression", "as": "$popText"},
  {"op": "set", "target": "$popText", "prop": "Value", "value": "\"Delete product \" + PendingDeleteName + \"?\""},
  {"op": "create", "parent": "$pop", "type": "IContainer", "name": "PopupActions", "as": "$popActions"},
  {"op": "create", "parent": "$popActions", "type": "IButton", "name": "ConfirmDeleteButton", "as": "$btnYes"},
  {"op": "set", "target": "$btnYes/#ITextWidget", "prop": "Text", "value": "Delete"},
  {"op": "set", "target": "$btnYes/OnClick", "prop": "Destination", "value": "IScreenAction:ConfirmDelete"},
  {"op": "create", "parent": "$popActions", "type": "IButton", "name": "CancelDeleteButton", "as": "$btnNo"},
  {"op": "set", "target": "$btnNo/#ITextWidget", "prop": "Text", "value": "Cancel"},
  {"op": "set", "target": "$btnNo/OnClick", "prop": "Destination", "value": "IScreenAction:CancelDelete"}
 ]
}
