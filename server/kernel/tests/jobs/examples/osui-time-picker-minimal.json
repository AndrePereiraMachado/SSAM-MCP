  {"op": "set", "target": "$vPickedTime", "prop": "DataType", "value": "Time"},
  {"op": "create", "parent": "IMobileScreen:Showcase", "type": "IScreenAction", "name": "TimePickerDemoOnSelected", "as": "$hTimePickerDemoOnSelected"},
  {"op": "create", "parent": "$hTimePickerDemoOnSelected", "type": "IStartNode", "as": "$hTimePickerDemoOnSelectedS"},
  {"op": "create", "parent": "$hTimePickerDemoOnSelected", "type": "IEndNode", "as": "$hTimePickerDemoOnSelectedE"},
  {"op": "link", "from": "$hTimePickerDemoOnSelectedS", "to": "$hTimePickerDemoOnSelectedE"},
  {"op": "create", "parent": "IMobileScreen:Showcase/#IMobileBlockInstanceWidget/MainContent", "type": "IMobileBlockInstanceWidget", "name": "TimePickerDemo", "source": "IMobileBlock:TimePicker", "as": "$b"},
  {"op": "set", "target": "$b/Timepicker/#IInput", "prop": "Variable", "value": "PickedTime"},
