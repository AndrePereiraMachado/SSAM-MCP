{
 "description": "Typical AnimatedLabel (OutSystemsUI, Interaction); the sample Input bound to a Text variable; events Initialized handled by screen actions that keep the parameters in variables.",
 "base": "job:ex-base",
 "expectValid": true,
 "expectedMessages": [],
 "ops": [
  {"op": "create", "parent": "IMobileScreen:Showcase", "type": "ILocalVariable", "name": "PickedText", "as": "$vPickedText"},
  {"op": "set", "target": "$vPickedText", "prop": "DataType", "value": "Text"},
  {"op": "create", "parent": "IMobileScreen:Showcase", "type": "ILocalVariable", "name": "LastAnimatedLabelId", "as": "$vLastAnimatedLabelId"},
  {"op": "set", "target": "$vLastAnimatedLabelId", "prop": "DataType", "value": "Text"},
  {"op": "logic", "data": {"actions": [{"name": "AnimatedLabelDemoInitialized", "kind": "screen", "owner": "IMobileScreen:Showcase", "description": "Guarda os parametros de Initialized", "inputs": [{"name": "AnimatedLabelId", "type": "Text"}],"steps": [{"assign": {"LastAnimatedLabelId": "AnimatedLabelId"},"as": "KeepInitialized"}]}]}},
  {"op": "create", "parent": "IMobileScreen:Showcase/#IMobileBlockInstanceWidget/MainContent", "type": "IMobileBlockInstanceWidget", "name": "AnimatedLabelDemo", "source": "IMobileBlock:AnimatedLabel", "as": "$b"},
  {"op": "set", "target": "$b/Input/#IInput", "prop": "Variable", "value": "PickedText"},
  {"op": "set", "target": "$b/Initialized", "prop": "Handler", "value": "IScreenAction:AnimatedLabelDemoInitialized"},
  {"op": "set", "target": "$b/Initialized/AnimatedLabelId", "prop": "Value", "value": "AnimatedLabelId"}
 ]
}
