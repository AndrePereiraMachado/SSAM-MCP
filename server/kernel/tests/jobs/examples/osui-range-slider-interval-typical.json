  {"op": "logic", "data": {"actions": [{"name": "RangeSliderIntervalDemoInitialized", "kind": "screen", "owner": "IMobileScreen:Showcase", "description": "Guarda os parametros de Initialized", "inputs": [{"name": "RangeSliderIntervalId", "type": "Text"}],"steps": [{"assign": {"LastRangeSliderIntervalId": "RangeSliderIntervalId"},"as": "KeepInitialized"}]}, {"name": "RangeSliderIntervalDemoOnValueChange", "kind": "screen", "owner": "IMobileScreen:Showcase", "description": "Guarda os parametros de OnValueChange", "inputs": [{"name": "RangeSliderIntervalId", "type": "Text"}, {"name": "IntervalStart", "type": "Decimal"}, {"name": "IntervalEnd", "type": "Decimal"}],"steps": [{"assign": {"LastRangeSliderIntervalId": "RangeSliderIntervalId", "LastIntervalStart": "IntervalStart", "LastIntervalEnd": "IntervalEnd"},"as": "KeepOnValueChange"}]}]}},
  {"op": "create", "parent": "IMobileScreen:Showcase/#IMobileBlockInstanceWidget/MainContent", "type": "IMobileBlockInstanceWidget", "name": "RangeSliderIntervalDemo", "source": "IMobileBlock:RangeSliderInterval", "as": "$b"},
