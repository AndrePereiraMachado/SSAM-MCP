  {"op": "create", "parent": "IMobileScreen:Showcase/#IMobileBlockInstanceWidget/MainContent", "type": "IMobileBlockInstanceWidget", "name": "AccordionDemo", "source": "IMobileBlock:Accordion", "as": "$b"},
  {"op": "set", "target": "$b/Initialized", "prop": "Handler", "value": "IScreenAction:AccordionDemoInitialized"},
