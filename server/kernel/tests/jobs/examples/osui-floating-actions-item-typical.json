{
 "description": "FloatingActionsItem (OutSystemsUI, Interaction) tipico; dentro de um FloatingActions vazio (placeholder Items); placeholders Label, Item com dados do aggregate de tarefas.",
 "base": "job:ex-base",
 "expectValid": true,
 "expectedMessages": [],
 "ops": [
  {"op": "create", "parent": "IMobileScreen:Showcase", "type": "IScreenAggregate", "name": "GetShowcaseTasks", "as": "$tasks"},
  {"op": "create", "parent": "$tasks", "type": "IAliasedSource", "args": {"dataSource": "IServerEntity:Task"}},
  {"op": "create", "parent": "IMobileScreen:Showcase/#IMobileBlockInstanceWidget/MainContent", "type": "IMobileBlockInstanceWidget", "name": "FloatingActionsDemo", "source": "IMobileBlock:FloatingActions", "empty": true,"as": "$parent"},
  {"op": "create", "parent": "$parent/Items", "type": "IMobileBlockInstanceWidget", "name": "FloatingActionsItemDemo", "source": "IMobileBlock:FloatingActionsItem", "as": "$b"},
  {"op": "create", "parent": "$b/Label", "type": "IExpression", "as": "$ph1"},
  {"op": "set", "target": "$ph1", "prop": "Value", "value": "\"Tasks\""},
  {"op": "create", "parent": "$b/Item", "type": "IExpression", "as": "$ph2"},
  {"op": "set", "target": "$ph2", "prop": "Value", "value": "GetShowcaseTasks.Count + \" task(s)\""}
 ]
}
