{
 "description": "Typical FloatingActions (OutSystemsUI, Interaction); events OnToggle handled by screen actions that keep the parameters in variables.",
 "base": "job:ex-base",
 "expectValid": true,
 "expectedMessages": [],
 "ops": [
  {"op": "create", "parent": "IMobileScreen:Showcase", "type": "ILocalVariable", "name": "OnToggleCount", "as": "$vOnToggleCount"},
  {"op": "set", "target": "$vOnToggleCount", "prop": "DataType", "value": "Integer"},
  {"op": "logic", "data": {"actions": [{"name": "FloatingActionsDemoOnToggle", "kind": "screen", "owner": "IMobileScreen:Showcase", "description": "Counts the times OnToggle fired", "inputs": [],"steps": [{"assign": {"OnToggleCount": "OnToggleCount + 1"},"as": "KeepOnToggle"}]}]}},
  {"op": "create", "parent": "IMobileScreen:Showcase/#IMobileBlockInstanceWidget/MainContent", "type": "IMobileBlockInstanceWidget", "name": "FloatingActionsDemo", "source": "IMobileBlock:FloatingActions", "as": "$b"},
  {"op": "set", "target": "$b/OnToggle", "prop": "Handler", "value": "IScreenAction:FloatingActionsDemoOnToggle"}
 ]
}
