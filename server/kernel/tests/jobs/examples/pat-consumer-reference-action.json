{
 "description": "Consumer: the reference op brings the entity and the public action of the producer (here job:pat-producer-public-action; live, producer is the NAME of the module, with ssam_job/o11_job captureProducers:[\"<Module>\"] or --producer <Module>=<snapshot.oml>) and the screen calls the action by its name.",
 "base": "reactive-ui.oml",
 "expectValid": true,
 "expectedMessages": [],
 "ops": [
  {"op": "reference", "producer": "job:pat-producer-public-action", "elements": ["IServerEntity:Supplier", "IServerAction:Supplier_GetSummary"]},
  {"op": "create", "parent": "IMobileFlow:MainFlow", "type": "IMobileScreen", "name": "Suppliers", "as": "$scr"},
  {"op": "set", "target": "$scr/#IMobileBlockInstanceWidget", "prop": "SourceBlock", "value": "IMobileBlock:LayoutTopMenu"},
  {"op": "create", "parent": "$scr/#IMobileBlockInstanceWidget/Title", "type": "IExpression", "as": "$title"},
  {"op": "set", "target": "$title", "prop": "Value", "value": "\"Suppliers\""},
  {"op": "create", "parent": "$scr", "type": "ILocalVariable", "name": "SummaryText", "as": "$vSummary"},
  {"op": "set", "target": "$vSummary", "prop": "DataType", "value": "Text"},
  {"op": "create", "parent": "$scr", "type": "IScreenAggregate", "name": "GetSupplierList", "as": "$agg"},
  {"op": "create", "parent": "$agg", "type": "IAliasedSource", "args": {"dataSource": "IEntitySignature:Supplier"}},
  {"op": "logic", "data": {"actions": [
   {"name": "ShowSummary", "kind": "screen", "owner": "IMobileScreen:Suppliers", "description": "Calls the public action of the producer and shows the result",
    "inputs": [{"name": "SupplierId", "type": "Supplier Identifier"}],
    "steps": [
     {"call": "Supplier_GetSummary", "as": "GetSummary", "args": {"SupplierId": "SupplierId"}},
     {"assign": {"SummaryText": "GetSummary.Summary.Title"}, "as": "KeepSummary"}]}]}},
  {"op": "create", "parent": "$scr/#IMobileBlockInstanceWidget/MainContent", "type": "IList", "name": "SupplierList", "as": "$list"},
  {"op": "set", "target": "$list", "prop": "Source", "value": "GetSupplierList.List"},
  {"op": "create", "parent": "$list", "type": "ILink", "name": "SupplierLink", "as": "$lnk"},
  {"op": "delete", "target": "$lnk/#ITextWidget"},
  {"op": "create", "parent": "$lnk", "type": "IExpression", "as": "$lnkT"},
  {"op": "set", "target": "$lnkT", "prop": "Value", "value": "GetSupplierList.List.Current.Supplier.Name"},
  {"op": "set", "target": "$lnk/OnClick", "prop": "Destination", "value": "IScreenAction:ShowSummary"},
  {"op": "set", "target": "$lnk/OnClick/SupplierId", "prop": "Value", "value": "GetSupplierList.List.Current.Supplier.Id"},
  {"op": "create", "parent": "$scr/#IMobileBlockInstanceWidget/MainContent", "type": "IExpression", "as": "$summary"},
  {"op": "set", "target": "$summary", "prop": "Value", "value": "SummaryText"}
 ]
}
