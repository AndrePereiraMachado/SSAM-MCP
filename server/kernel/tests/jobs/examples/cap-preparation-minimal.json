{
 "description": "Minimal Preparation (Traditional): the Web screen reads the data in the IPreparation (Start, aggregate, End and layout) and the page shows the total read.",
 "base": "traditional-ui.oml",
 "expectValid": true,
 "expectedMessages": [],
 "ops": [
  {"op": "spec", "data": {"entities": [{"name": "Note", "attributes": [{"name": "Text", "type": "Text", "mandatory": true, "length": 200}]}]}},
  {"op": "create", "parent": "IWebFlow:MainFlow", "type": "IWebScreen", "name": "NotesWeb", "as": "$scr"},
  {"op": "create", "parent": "$scr", "type": "IPreparation", "as": "$prep"},
  {"op": "create", "parent": "$prep", "type": "IStartNode", "as": "$p0"},
  {"op": "create", "parent": "$prep", "type": "IAggregateNode", "name": "GetAllNotes", "as": "$agg"},
  {"op": "create", "parent": "$agg", "type": "IAliasedSource", "args": {"dataSource": "IServerEntity:Note"}},
  {"op": "create", "parent": "$prep", "type": "IEndNode", "as": "$p9"},
  {"op": "link", "from": "$p0", "to": "$agg"},
  {"op": "link", "from": "$agg", "to": "$p9"},
  {"op": "layout", "target": "$prep"},
  {"op": "create", "parent": "$scr/#IWebBlockInstanceWidget/MainContent", "type": "IExpressionWidget", "as": "$count"},
  {"op": "set", "target": "$count", "prop": "Value", "value": "GetAllNotes.Count + \" note(s)\""}
 ]
}
