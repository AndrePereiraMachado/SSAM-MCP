{
 "description": "Typical Container: one line per task in a List, aligned to the left, with the CSS class computed from the data (Style with an If on Task.Done), without using Visible.",
 "base": "job:ex-base",
 "expectValid": true,
 "expectedMessages": [],
 "ops": [
  {"op": "create", "parent": "IMobileScreen:Showcase", "type": "IScreenAggregate", "name": "GetTaskCards", "as": "$agg"},
  {"op": "create", "parent": "$agg", "type": "IAliasedSource", "args": {"dataSource": "IServerEntity:Task"}},
  {"op": "create", "parent": "IMobileScreen:Showcase/#IMobileBlockInstanceWidget/MainContent", "type": "IList", "name": "TaskCards", "as": "$list"},
  {"op": "set", "target": "$list", "prop": "Source", "value": "GetTaskCards.List"},
  {"op": "create", "parent": "$list", "type": "IContainer", "name": "TaskCard", "as": "$box"},
  {"op": "set", "target": "$box", "prop": "Align", "value": "Left"},
  {"op": "set", "target": "$box", "prop": "Style", "value": "\"padding-s \" + If(GetTaskCards.List.Current.Task.Done, \"background-neutral-2\", \"background-neutral-0\")"},
  {"op": "create", "parent": "$box", "type": "IExpression", "as": "$boxT"},
  {"op": "set", "target": "$boxT", "prop": "Value", "value": "GetTaskCards.List.Current.Task.Title"}
 ]
}
