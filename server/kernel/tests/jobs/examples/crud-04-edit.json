{
 "description": "Back-office CRUD, part 4 of 5 (form): ProductEdit reads the product by the input, a Form with bound Labels, required Inputs, a Dropdown of the category, a Checkbox; Save validates on the client, calls Product_Save with the record, handles ProductInvalid with a message and goes back to ProductList; Cancel goes back without saving.",
 "base": "job:crud-03-screens",
 "expectValid": true,
 "expectedMessages": [],
 "ops": [
  {"op": "create", "parent": "IMobileScreen:ProductEdit", "type": "IScreenAggregate", "name": "GetProductById", "as": "$agg"},
  {"op": "create", "parent": "$agg", "type": "IAliasedSource", "args": {"dataSource": "IServerEntity:Product"}},
  {"op": "create", "parent": "$agg", "type": "IFilter", "args": {"condition": "Product.Id = ProductId"}},
  {"op": "set", "target": "$agg", "prop": "MaxRecords", "value": "1"},
  {"op": "create", "parent": "IMobileScreen:ProductEdit", "type": "IScreenAggregate", "name": "GetCategoryList", "as": "$aggCat"},
  {"op": "create", "parent": "$aggCat", "type": "IAliasedSource", "args": {"dataSource": "IStaticEntity:ProductCategory"}},
  {"op": "create", "parent": "$aggCat", "type": "ISort", "as": "$sortCat"},
  {"op": "set", "target": "$sortCat", "prop": "Attribute", "value": "ProductCategory.Order"},

  {"op": "create", "parent": "IMobileScreen:ProductEdit/#IMobileBlockInstanceWidget/MainContent", "type": "IForm", "name": "ProductForm", "as": "$form"},
  {"op": "create", "parent": "$form", "type": "ILabel", "name": "CodeLabel", "as": "$lCode"},
  {"op": "create", "parent": "$lCode", "type": "IExpression", "as": "$lCodeT"},
  {"op": "set", "target": "$lCodeT", "prop": "Value", "value": "\"Code\""},
  {"op": "create", "parent": "$form", "type": "IInput", "name": "Code_Input", "as": "$inCode"},
  {"op": "set", "target": "$inCode", "prop": "Variable", "value": "GetProductById.List.Current.Product.Code"},
  {"op": "set", "target": "$inCode", "prop": "Mandatory", "value": "True"},
  {"op": "set", "target": "$lCode", "prop": "TargetWidget", "value": "$inCode"},
  {"op": "create", "parent": "$form", "type": "ILabel", "name": "NameLabel", "as": "$lName"},
  {"op": "create", "parent": "$lName", "type": "IExpression", "as": "$lNameT"},
  {"op": "set", "target": "$lNameT", "prop": "Value", "value": "\"Name\""},
  {"op": "create", "parent": "$form", "type": "IInput", "name": "Name_Input", "as": "$inName"},
  {"op": "set", "target": "$inName", "prop": "Variable", "value": "GetProductById.List.Current.Product.Name"},
  {"op": "set", "target": "$inName", "prop": "Mandatory", "value": "True"},
  {"op": "set", "target": "$lName", "prop": "TargetWidget", "value": "$inName"},
  {"op": "create", "parent": "$form", "type": "ILabel", "name": "CategoryLabel", "as": "$lCat"},
  {"op": "create", "parent": "$lCat", "type": "IExpression", "as": "$lCatT"},
  {"op": "set", "target": "$lCatT", "prop": "Value", "value": "\"Category\""},
  {"op": "create", "parent": "$form", "type": "IDropdown", "name": "Category_Dropdown", "as": "$ddCat"},
  {"op": "set", "target": "$ddCat", "prop": "Variable", "value": "GetProductById.List.Current.Product.CategoryId"},
  {"op": "set", "target": "$ddCat", "prop": "List", "value": "GetCategoryList.List"},
  {"op": "set", "target": "$ddCat", "prop": "Values", "value": "ProductCategory.Id"},
  {"op": "set", "target": "$ddCat", "prop": "Labels", "value": "ProductCategory.Label"},
  {"op": "set", "target": "$ddCat", "prop": "Mandatory", "value": "True"},
  {"op": "set", "target": "$lCat", "prop": "TargetWidget", "value": "$ddCat"},
  {"op": "create", "parent": "$form", "type": "ILabel", "name": "PriceLabel", "as": "$lPrice"},
  {"op": "create", "parent": "$lPrice", "type": "IExpression", "as": "$lPriceT"},
  {"op": "set", "target": "$lPriceT", "prop": "Value", "value": "\"Price\""},
  {"op": "create", "parent": "$form", "type": "IInput", "name": "Price_Input", "as": "$inPrice"},
  {"op": "set", "target": "$inPrice", "prop": "Variable", "value": "GetProductById.List.Current.Product.Price"},
  {"op": "set", "target": "$inPrice", "prop": "InputType", "value": "Number"},
  {"op": "set", "target": "$lPrice", "prop": "TargetWidget", "value": "$inPrice"},
  {"op": "create", "parent": "$form", "type": "ILabel", "name": "StockLabel", "as": "$lStock"},
  {"op": "create", "parent": "$lStock", "type": "IExpression", "as": "$lStockT"},
  {"op": "set", "target": "$lStockT", "prop": "Value", "value": "\"Stock\""},
  {"op": "create", "parent": "$form", "type": "IInput", "name": "Stock_Input", "as": "$inStock"},
  {"op": "set", "target": "$inStock", "prop": "Variable", "value": "GetProductById.List.Current.Product.Stock"},
  {"op": "set", "target": "$inStock", "prop": "InputType", "value": "Number"},
  {"op": "set", "target": "$lStock", "prop": "TargetWidget", "value": "$inStock"},
  {"op": "create", "parent": "$form", "type": "ICheckbox", "name": "Active_Checkbox", "as": "$chkActive"},
  {"op": "set", "target": "$chkActive", "prop": "Variable", "value": "GetProductById.List.Current.Product.Active"},
  {"op": "create", "parent": "$form", "type": "ILabel", "name": "ActiveLabel", "as": "$lActive"},
  {"op": "create", "parent": "$lActive", "type": "IExpression", "as": "$lActiveT"},
  {"op": "set", "target": "$lActiveT", "prop": "Value", "value": "\"Active\""},
  {"op": "set", "target": "$lActive", "prop": "TargetWidget", "value": "$chkActive"},

  {"op": "logic", "data": {"actions": [
   {"name": "SaveOnClick", "kind": "screen", "owner": "IMobileScreen:ProductEdit", "description": "Validates, saves through the wrapper and goes back to the list",
    "steps": [
     {"if": "GetProductById.List.Current.Product.Price < 0", "label": "NegativePrice?",
      "then": [{"assign": {"Price_Input.Valid": "False", "Price_Input.ValidationMessage": "\"Price cannot be negative\""}, "as": "MarkPriceInvalid"}]},
     {"if": "not ProductForm.Valid", "label": "FormInvalid?", "then": [{"return": true}]},
     {"call": "Product_Save", "as": "SaveProduct", "args": {"Item": "GetProductById.List.Current.Product"}},
     {"node": "IMessageNode", "as": "SavedMessage", "properties": {"Message": "\"Product saved\"", "Type": "Success"}},
     {"node": "IDestinationNode", "as": "BackToList", "properties": {"Destination": "IMobileScreen:ProductList"}}],
    "handlers": [
     {"name": "InvalidProduct", "exception": "ProductInvalid", "steps": [
      {"node": "IMessageNode", "as": "ShowInvalid", "properties": {"Message": "InvalidProduct.ExceptionMessage", "Type": "Warning"}}]}]}]}},
  {"op": "create", "parent": "$form", "type": "IContainer", "name": "FormActions", "as": "$actions"},
  {"op": "create", "parent": "$actions", "type": "IButton", "name": "SaveButton", "as": "$btnSave"},
  {"op": "set", "target": "$btnSave/#ITextWidget", "prop": "Text", "value": "Save"},
  {"op": "set", "target": "$btnSave/OnClick", "prop": "Destination", "value": "IScreenAction:SaveOnClick"},
  {"op": "create", "parent": "$actions", "type": "ILink", "name": "CancelLink", "as": "$lnkCancel"},
  {"op": "set", "target": "$lnkCancel/#ITextWidget", "prop": "Text", "value": "Cancel"},
  {"op": "set", "target": "$lnkCancel/OnClick", "prop": "Destination", "value": "IMobileScreen:ProductList"}
 ]
}
