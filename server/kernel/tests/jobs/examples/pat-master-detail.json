{
 "description": "Master-detail on one screen: a table of orders on the left (Columns2), the number is a Link that keeps the chosen order and runs the aggregate of the lines again; a table of lines on the right filtered by the order; an If shows a notice while nothing is chosen.",
 "base": "reactive-ui.oml",
 "expectValid": true,
 "expectedMessages": [],
 "ops": [
  {"op": "spec", "data": {"entities": [
   {"name": "SalesOrder", "attributes": [
    {"name": "Number", "type": "Text", "mandatory": true, "length": 20},
    {"name": "OrderedOn", "type": "Date"}]},
   {"name": "OrderLine", "attributes": [
    {"name": "SalesOrderId", "type": "SalesOrder Identifier", "mandatory": true},
    {"name": "Product", "type": "Text", "length": 100},
    {"name": "Quantity", "type": "Integer"},
    {"name": "UnitPrice", "type": "Currency"}]}]}},
  {"op": "create", "parent": "IMobileFlow:MainFlow", "type": "IMobileScreen", "name": "Orders", "as": "$scr"},
  {"op": "set", "target": "$scr/#IMobileBlockInstanceWidget", "prop": "SourceBlock", "value": "IMobileBlock:LayoutTopMenu"},
  {"op": "create", "parent": "$scr/#IMobileBlockInstanceWidget/Title", "type": "IExpression", "as": "$title"},
  {"op": "set", "target": "$title", "prop": "Value", "value": "\"Orders\""},
  {"op": "create", "parent": "$scr", "type": "ILocalVariable", "name": "SelectedOrderId", "as": "$vSel"},
  {"op": "set", "target": "$vSel", "prop": "DataType", "value": "SalesOrder Identifier"},
  {"op": "create", "parent": "$scr", "type": "IScreenAggregate", "name": "GetOrderList", "as": "$aggOrders"},
  {"op": "create", "parent": "$aggOrders", "type": "IAliasedSource", "args": {"dataSource": "IServerEntity:SalesOrder"}},
  {"op": "create", "parent": "$aggOrders", "type": "ISort", "as": "$sortOrders"},
  {"op": "set", "target": "$sortOrders", "prop": "Attribute", "value": "SalesOrder.OrderedOn"},
  {"op": "set", "target": "$sortOrders", "prop": "SortDirection", "value": "Descending"},
  {"op": "create", "parent": "$scr", "type": "IScreenAggregate", "name": "GetLinesOfOrder", "as": "$aggLines"},
  {"op": "create", "parent": "$aggLines", "type": "IAliasedSource", "args": {"dataSource": "IServerEntity:OrderLine"}},
  {"op": "create", "parent": "$aggLines", "type": "IFilter", "args": {"condition": "OrderLine.SalesOrderId = SelectedOrderId"}},
  {"op": "logic", "data": {"actions": [
   {"name": "SelectOrder", "kind": "screen", "owner": "IMobileScreen:Orders", "description": "Keeps the chosen order and loads its lines",
    "inputs": [{"name": "OrderId", "type": "SalesOrder Identifier"}],
    "steps": [
     {"assign": {"SelectedOrderId": "OrderId"}, "as": "KeepOrder"},
     {"node": "IRefreshDataNode", "as": "RefreshLines", "properties": {"DataSource": "IScreenAggregate:GetLinesOfOrder"}}]}]}},

  {"op": "create", "parent": "$scr/#IMobileBlockInstanceWidget/MainContent", "type": "IMobileBlockInstanceWidget", "name": "MasterDetailColumns", "source": "IMobileBlock:Columns2", "as": "$cols"},
  {"op": "create", "parent": "$cols/Column1", "type": "ITableRecords", "name": "OrderTable", "as": "$tOrders", "empty": true},
  {"op": "set", "target": "$tOrders", "prop": "Source", "value": "GetOrderList.List"},
  {"op": "create", "parent": "$tOrders/HeaderRow", "type": "IHeaderCell", "name": "NumberHeader", "as": "$hNum"},
  {"op": "create", "parent": "$hNum", "type": "IExpression", "as": "$hNumT"},
  {"op": "set", "target": "$hNumT", "prop": "Value", "value": "\"Order\""},
  {"op": "create", "parent": "$tOrders/HeaderRow", "type": "IHeaderCell", "name": "DateHeader", "as": "$hDate"},
  {"op": "create", "parent": "$hDate", "type": "IExpression", "as": "$hDateT"},
  {"op": "set", "target": "$hDateT", "prop": "Value", "value": "\"Date\""},
  {"op": "create", "parent": "$tOrders/Row", "type": "IRowCell", "name": "NumberCell", "as": "$cNum"},
  {"op": "create", "parent": "$cNum", "type": "ILink", "name": "OrderLink", "as": "$lnk"},
  {"op": "delete", "target": "$lnk/#ITextWidget"},
  {"op": "create", "parent": "$lnk", "type": "IExpression", "as": "$lnkT"},
  {"op": "set", "target": "$lnkT", "prop": "Value", "value": "GetOrderList.List.Current.SalesOrder.Number"},
  {"op": "set", "target": "$lnk/OnClick", "prop": "Destination", "value": "IScreenAction:SelectOrder"},
  {"op": "set", "target": "$lnk/OnClick/OrderId", "prop": "Value", "value": "GetOrderList.List.Current.SalesOrder.Id"},
  {"op": "create", "parent": "$tOrders/Row", "type": "IRowCell", "name": "DateCell", "as": "$cDate"},
  {"op": "create", "parent": "$cDate", "type": "IExpression", "as": "$cDateT"},
  {"op": "set", "target": "$cDateT", "prop": "Value", "value": "FormatDateTime(GetOrderList.List.Current.SalesOrder.OrderedOn, \"yyyy-MM-dd\")"},

  {"op": "create", "parent": "$cols/Column2", "type": "IIfWidget", "name": "HasSelection", "as": "$if"},
  {"op": "set", "target": "$if", "prop": "Condition", "value": "SelectedOrderId = NullIdentifier()"},
  {"op": "create", "parent": "$if/TrueBranch", "type": "IExpression", "as": "$hint"},
  {"op": "set", "target": "$hint", "prop": "Value", "value": "\"Select an order to see its lines\""},
  {"op": "create", "parent": "$if/FalseBranch", "type": "ITableRecords", "name": "LineTable", "as": "$tLines", "empty": true},
  {"op": "set", "target": "$tLines", "prop": "Source", "value": "GetLinesOfOrder.List"},
  {"op": "create", "parent": "$tLines/HeaderRow", "type": "IHeaderCell", "name": "ProductHeader", "as": "$hProd"},
  {"op": "create", "parent": "$hProd", "type": "IExpression", "as": "$hProdT"},
  {"op": "set", "target": "$hProdT", "prop": "Value", "value": "\"Product\""},
  {"op": "create", "parent": "$tLines/HeaderRow", "type": "IHeaderCell", "name": "QuantityHeader", "as": "$hQty"},
  {"op": "create", "parent": "$hQty", "type": "IExpression", "as": "$hQtyT"},
  {"op": "set", "target": "$hQtyT", "prop": "Value", "value": "\"Qty\""},
  {"op": "create", "parent": "$tLines/HeaderRow", "type": "IHeaderCell", "name": "TotalHeader", "as": "$hTot"},
  {"op": "create", "parent": "$hTot", "type": "IExpression", "as": "$hTotT"},
  {"op": "set", "target": "$hTotT", "prop": "Value", "value": "\"Total\""},
  {"op": "create", "parent": "$tLines/Row", "type": "IRowCell", "name": "ProductCell", "as": "$cProd"},
  {"op": "create", "parent": "$cProd", "type": "IExpression", "as": "$cProdT"},
  {"op": "set", "target": "$cProdT", "prop": "Value", "value": "GetLinesOfOrder.List.Current.OrderLine.Product"},
  {"op": "create", "parent": "$tLines/Row", "type": "IRowCell", "name": "QuantityCell", "as": "$cQty"},
  {"op": "create", "parent": "$cQty", "type": "IExpression", "as": "$cQtyT"},
  {"op": "set", "target": "$cQtyT", "prop": "Value", "value": "GetLinesOfOrder.List.Current.OrderLine.Quantity"},
  {"op": "create", "parent": "$tLines/Row", "type": "IRowCell", "name": "TotalCell", "as": "$cTot"},
  {"op": "create", "parent": "$cTot", "type": "IExpression", "as": "$cTotT"},
  {"op": "set", "target": "$cTotT", "prop": "Value", "value": "FormatDecimal(GetLinesOfOrder.List.Current.OrderLine.Quantity * GetLinesOfOrder.List.Current.OrderLine.UnitPrice, 2, \".\", \",\")"}
 ]
}
