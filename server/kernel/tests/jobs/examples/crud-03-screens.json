{
 "description": "Back-office CRUD, part 3 of 5 (screens): creates ProductList and ProductEdit (optional input ProductId) before the content, so that the navigations from one to the other exist; both only for the role ProductManager (Roles declared once per screen).",
 "base": "job:crud-02-logic",
 "expectValid": true,
 "expectedMessages": [
  {"id": "UnusedElement", "element": "ProductEdit (MobileScreen) / ProductId (InputParameter)", "why": "The input is read by the aggregate of part 4; in crud-all there is no warning."}
 ],
 "ops": [
  {"op": "create", "parent": "IMobileFlow:MainFlow", "type": "IMobileScreen", "name": "ProductList", "as": "$list"},
  {"op": "set", "target": "$list/#IMobileBlockInstanceWidget", "prop": "SourceBlock", "value": "IMobileBlock:LayoutTopMenu"},
  {"op": "set", "target": "$list", "prop": "Roles", "value": ["IRole:ProductManager"]},
  {"op": "create", "parent": "$list/#IMobileBlockInstanceWidget/Title", "type": "IExpression", "as": "$listTitle"},
  {"op": "set", "target": "$listTitle", "prop": "Value", "value": "\"Products\""},
  {"op": "create", "parent": "IMobileFlow:MainFlow", "type": "IMobileScreen", "name": "ProductEdit", "as": "$edit"},
  {"op": "set", "target": "$edit/#IMobileBlockInstanceWidget", "prop": "SourceBlock", "value": "IMobileBlock:LayoutTopMenu"},
  {"op": "set", "target": "$edit", "prop": "Roles", "value": ["IRole:ProductManager"]},
  {"op": "create", "parent": "$edit/#IMobileBlockInstanceWidget/Title", "type": "IExpression", "as": "$editTitle"},
  {"op": "set", "target": "$editTitle", "prop": "Value", "value": "\"Product\""},
  {"op": "create", "parent": "$edit", "type": "IInputParameter", "name": "ProductId", "as": "$pid"},
  {"op": "set", "target": "$pid", "prop": "DataType", "value": "Product Identifier"},
  {"op": "set", "target": "$pid", "prop": "IsMandatory", "value": false}
 ]
}
