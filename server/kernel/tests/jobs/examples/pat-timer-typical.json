{
 "description": "Typical timer: the server action Reminders_SendDue reads the due reminders (get with where and max), marks each one as sent (foreach + update) and the timer SendDueReminders schedules it every day at 02:00 (Schedule in the text of the Service Studio).",
 "base": "blank-service.oml",
 "expectValid": true,
 "expectedMessages": [],
 "ops": [
  {"op": "spec", "data": {"entities": [{"name": "Reminder", "attributes": [
   {"name": "Message", "type": "Text", "mandatory": true, "length": 200},
   {"name": "DueOn", "type": "Date Time"},
   {"name": "Sent", "type": "Boolean"}]}]}},
  {"op": "logic", "data": {"actions": [
   {"name": "Reminders_SendDue", "kind": "server", "description": "Marks the due reminders as sent (batch of 100)",
    "vars": [{"name": "Due", "type": "Reminder"}],
    "steps": [
     {"get": "Reminder", "as": "GetDueReminders", "where": ["not Reminder.Sent", "Reminder.DueOn <= CurrDateTime()"], "sort": "Reminder.DueOn", "max": 100},
     {"foreach": "GetDueReminders.List", "as": "EachReminder", "do": [
      {"assign": {"Due": "GetDueReminders.List.Current.Reminder", "Due.Sent": "True"}, "as": "MarkSent"},
      {"update": "Reminder", "record": "Due", "as": "UpdateReminder"}]}]}]}},
  {"op": "create", "parent": "@espace", "type": "ITimer", "name": "SendDueReminders", "as": "$timer"},
  {"op": "set", "target": "$timer", "prop": "Action", "value": "IServerAction:Reminders_SendDue"},
  {"op": "set", "target": "$timer", "prop": "Description", "value": "Sends the due reminders once a day"},
  {"op": "set", "target": "$timer", "prop": "Schedule", "value": "02:00"},
  {"op": "get", "target": "$timer"}
 ]
}
