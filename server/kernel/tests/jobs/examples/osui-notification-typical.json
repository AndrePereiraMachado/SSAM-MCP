{
 "description": "Notification (OutSystemsUI, Interaction) tipico; placeholders Content com dados do aggregate de tarefas; eventos Initialized, OnToggle tratados por screen actions que guardam os parametros em variaveis.",
 "base": "job:ex-base",
 "expectValid": true,
 "expectedMessages": [],
 "ops": [
  {"op": "create", "parent": "IMobileScreen:Showcase", "type": "ILocalVariable", "name": "LastNotificationId", "as": "$vLastNotificationId"},
  {"op": "set", "target": "$vLastNotificationId", "prop": "DataType", "value": "Text"},
  {"op": "create", "parent": "IMobileScreen:Showcase", "type": "ILocalVariable", "name": "LastIsOpen", "as": "$vLastIsOpen"},
  {"op": "set", "target": "$vLastIsOpen", "prop": "DataType", "value": "Boolean"},
  {"op": "create", "parent": "IMobileScreen:Showcase", "type": "IScreenAggregate", "name": "GetShowcaseTasks", "as": "$tasks"},
  {"op": "create", "parent": "$tasks", "type": "IAliasedSource", "args": {"dataSource": "IServerEntity:Task"}},
  {"op": "logic", "data": {"actions": [{"name": "NotificationDemoInitialized", "kind": "screen", "owner": "IMobileScreen:Showcase", "description": "Guarda os parametros de Initialized", "inputs": [{"name": "NotificationId", "type": "Text"}],"steps": [{"assign": {"LastNotificationId": "NotificationId"},"as": "KeepInitialized"}]}, {"name": "NotificationDemoOnToggle", "kind": "screen", "owner": "IMobileScreen:Showcase", "description": "Guarda os parametros de OnToggle", "inputs": [{"name": "IsOpen", "type": "Boolean"}],"steps": [{"assign": {"LastIsOpen": "IsOpen"},"as": "KeepOnToggle"}]}]}},
  {"op": "create", "parent": "IMobileScreen:Showcase/#IMobileBlockInstanceWidget/MainContent", "type": "IMobileBlockInstanceWidget", "name": "NotificationDemo", "source": "IMobileBlock:Notification", "as": "$b"},
  {"op": "set", "target": "$b/Initialized", "prop": "Handler", "value": "IScreenAction:NotificationDemoInitialized"},
  {"op": "set", "target": "$b/Initialized/NotificationId", "prop": "Value", "value": "NotificationId"},
  {"op": "set", "target": "$b/OnToggle", "prop": "Handler", "value": "IScreenAction:NotificationDemoOnToggle"},
  {"op": "set", "target": "$b/OnToggle/IsOpen", "prop": "Value", "value": "IsOpen"},
  {"op": "create", "parent": "$b/Content", "type": "IExpression", "as": "$ph1"},
  {"op": "set", "target": "$ph1", "prop": "Value", "value": "GetShowcaseTasks.Count + \" task(s)\""}
 ]
}
