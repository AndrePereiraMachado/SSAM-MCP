{
 "description": "MonthPicker (OutSystemsUI, Interaction) tipico; o Input de exemplo ligado a uma variavel Text; placeholders Placeholder_SSPreview com dados do aggregate de tarefas; eventos OnSelected, Initialized tratados por screen actions que guardam os parametros em variaveis.",
 "base": "job:ex-base",
 "expectValid": true,
 "expectedMessages": [],
 "ops": [
  {"op": "create", "parent": "IMobileScreen:Showcase", "type": "ILocalVariable", "name": "PickedText", "as": "$vPickedText"},
  {"op": "set", "target": "$vPickedText", "prop": "DataType", "value": "Text"},
  {"op": "create", "parent": "IMobileScreen:Showcase", "type": "ILocalVariable", "name": "LastMonthpickerId", "as": "$vLastMonthpickerId"},
  {"op": "set", "target": "$vLastMonthpickerId", "prop": "DataType", "value": "Text"},
  {"op": "create", "parent": "IMobileScreen:Showcase", "type": "ILocalVariable", "name": "LastSelectedMonth", "as": "$vLastSelectedMonth"},
  {"op": "set", "target": "$vLastSelectedMonth", "prop": "DataType", "value": "MonthOrderYear"},
  {"op": "create", "parent": "IMobileScreen:Showcase", "type": "IScreenAggregate", "name": "GetShowcaseTasks", "as": "$tasks"},
  {"op": "create", "parent": "$tasks", "type": "IAliasedSource", "args": {"dataSource": "IServerEntity:Task"}},
  {"op": "logic", "data": {"actions": [{"name": "MonthPickerDemoOnSelected", "kind": "screen", "owner": "IMobileScreen:Showcase", "description": "Guarda os parametros de OnSelected", "inputs": [{"name": "MonthpickerId", "type": "Text"}, {"name": "SelectedMonth", "type": "MonthOrderYear"}],"steps": [{"assign": {"LastMonthpickerId": "MonthpickerId", "LastSelectedMonth": "SelectedMonth"},"as": "KeepOnSelected"}]}, {"name": "MonthPickerDemoInitialized", "kind": "screen", "owner": "IMobileScreen:Showcase", "description": "Guarda os parametros de Initialized", "inputs": [{"name": "MonthpickerId", "type": "Text"}],"steps": [{"assign": {"LastMonthpickerId": "MonthpickerId"},"as": "KeepInitialized"}]}]}},
  {"op": "create", "parent": "IMobileScreen:Showcase/#IMobileBlockInstanceWidget/MainContent", "type": "IMobileBlockInstanceWidget", "name": "MonthPickerDemo", "source": "IMobileBlock:MonthPicker", "as": "$b"},
  {"op": "set", "target": "$b/MonthPicker/#IInput", "prop": "Variable", "value": "PickedText"},
  {"op": "set", "target": "$b/OnSelected", "prop": "Handler", "value": "IScreenAction:MonthPickerDemoOnSelected"},
  {"op": "set", "target": "$b/OnSelected/MonthpickerId", "prop": "Value", "value": "MonthpickerId"},
  {"op": "set", "target": "$b/OnSelected/SelectedMonth", "prop": "Value", "value": "SelectedMonth"},
  {"op": "set", "target": "$b/Initialized", "prop": "Handler", "value": "IScreenAction:MonthPickerDemoInitialized"},
  {"op": "set", "target": "$b/Initialized/MonthpickerId", "prop": "Value", "value": "MonthpickerId"},
  {"op": "create", "parent": "$b/Placeholder_SSPreview", "type": "IExpression", "as": "$ph1"},
  {"op": "set", "target": "$ph1", "prop": "Value", "value": "GetShowcaseTasks.Count + \" task(s)\""}
 ]
}
