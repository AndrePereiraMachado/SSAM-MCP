{
 "description": "Aggregate com agregacoes e coluna calculada: group by CustomerName, IAggregateAttribute Sum/Max/Min/Avg (AggregationType pelo nome), ICalculatedAttribute com Value (expressao), IFilter com input da action, MaxRecords; leitura dos resultados em Assign: com group by/agregacao e `GetX.List.Current.<NomeDaColuna>` (SEM o alias Order.), e `GetX.List.Length`",
 "base": "tests/fixtures/blank-service.oml",
 "expectValid": true,
 "ops": [
  {"op": "spec", "data": {
   "entities": [{"name": "Order", "attributes": [{"name": "CustomerName", "type": "Text", "mandatory": true, "length": 100}, {"name": "Total", "type": "Decimal"}, {"name": "Qty", "type": "Integer"}]}]
  }},
  {"op": "create", "parent": "@espace", "type": "IServerAction", "name": "Orders_Totals", "as": "$act"},
  {"op": "set", "target": "$act", "prop": "Public", "value": true},
  {"op": "create", "parent": "$act", "type": "IInputParameter", "name": "MinTotal", "as": "$in"},
  {"op": "set", "target": "$in", "prop": "DataType", "value": "Decimal"},
  {"op": "create", "parent": "$act", "type": "IOutputParameter", "name": "FirstSum", "as": "$o1"},
  {"op": "set", "target": "$o1", "prop": "DataType", "value": "Decimal"},
  {"op": "create", "parent": "$act", "type": "IOutputParameter", "name": "Groups", "as": "$o2"},
  {"op": "set", "target": "$o2", "prop": "DataType", "value": "Integer"},
  {"op": "create", "parent": "$act", "type": "IStartNode", "as": "$s0"},
  {"op": "create", "parent": "$act", "type": "IAggregateNode", "name": "GetOrderTotals", "as": "$agg"},
  {"op": "create", "parent": "$agg", "type": "IAliasedSource", "args": {"dataSource": "IServerEntity:Order"}, "as": "$src"},
  {"op": "create", "parent": "$agg", "type": "IFilter", "args": {"condition": "Order.Total >= MinTotal"}},
  {"op": "create", "parent": "$agg", "type": "IGroupByAttribute", "name": "CustomerName", "as": "$gb"},
  {"op": "set", "target": "$gb", "prop": "Attribute", "value": "Order.CustomerName"},
  {"op": "create", "parent": "$agg", "type": "IAggregateAttribute", "name": "TotalSum", "as": "$sum"},
  {"op": "set", "target": "$sum", "prop": "Attribute", "value": "Order.Total"},
  {"op": "set", "target": "$sum", "prop": "AggregationType", "value": "Sum"},
  {"op": "create", "parent": "$agg", "type": "IAggregateAttribute", "name": "TotalMax", "as": "$max"},
  {"op": "set", "target": "$max", "prop": "Attribute", "value": "Order.Total"},
  {"op": "set", "target": "$max", "prop": "AggregationType", "value": "Max"},
  {"op": "create", "parent": "$agg", "type": "IAggregateAttribute", "name": "TotalMin", "as": "$min"},
  {"op": "set", "target": "$min", "prop": "Attribute", "value": "Order.Total"},
  {"op": "set", "target": "$min", "prop": "AggregationType", "value": "Min"},
  {"op": "create", "parent": "$agg", "type": "IAggregateAttribute", "name": "QtyAvg", "as": "$avg"},
  {"op": "set", "target": "$avg", "prop": "Attribute", "value": "Order.Qty"},
  {"op": "set", "target": "$avg", "prop": "AggregationType", "value": "Avg"},
  {"op": "create", "parent": "$agg", "type": "ICalculatedAttribute", "name": "TotalWithTax", "as": "$calc"},
  {"op": "set", "target": "$calc", "prop": "Value", "value": "Order.Total * 1.23"},
  {"op": "set", "target": "$agg", "prop": "MaxRecords", "value": "100"},
  {"op": "create", "parent": "$act", "type": "IAssignNode", "name": "SetOutputs", "as": "$asg"},
  {"op": "set", "target": "$asg", "prop": "Label", "value": "SetOutputs"},
  {"op": "create", "parent": "$asg", "type": "IAssignment", "as": "$a1"},
  {"op": "set", "target": "$a1", "prop": "Variable", "value": "FirstSum"},
  {"op": "set", "target": "$a1", "prop": "Value", "value": "GetOrderTotals.List.Current.TotalSum"},
  {"op": "create", "parent": "$asg", "type": "IAssignment", "as": "$a2"},
  {"op": "set", "target": "$a2", "prop": "Variable", "value": "Groups"},
  {"op": "set", "target": "$a2", "prop": "Value", "value": "GetOrderTotals.List.Length"},
  {"op": "create", "parent": "$act", "type": "IEndNode", "as": "$s9"},
  {"op": "link", "from": "$s0", "to": "$agg"},
  {"op": "link", "from": "$agg", "to": "$asg"},
  {"op": "link", "from": "$asg", "to": "$s9"},
  {"op": "layout", "target": "$act"},
  {"op": "dump", "target": "$agg"}
 ]
}
