{
 "description": "O11 timers with native daily HH:mm occurrences and the Mon weekday selector: hourly, midnight and Monday 00:05. Reads the model back; runtime activation and cadence require separate live evidence. Replaces historical prose strings that the generic setter accepted without interpreting their schedule.",
 "base": "tests/fixtures/reactive-ui.oml",
 "expectValid": true,
 "expectedMessages": [],
 "ops": [
  {"op": "create", "parent": "@espace", "type": "IServerAction", "name": "Pets_DecayHourly", "as": "$hourlyAction"},
  {"op": "set", "target": "$hourlyAction", "prop": "Description", "value": "Hourly decay of the pets' needs"},
  {"op": "create", "parent": "$hourlyAction", "type": "IStartNode", "as": "$hourlyStart"},
  {"op": "create", "parent": "$hourlyAction", "type": "IEndNode", "as": "$hourlyEnd"},
  {"op": "link", "from": "$hourlyStart", "to": "$hourlyEnd"},
  {"op": "create", "parent": "@espace", "type": "IServerAction", "name": "Missions_DrawDaily", "as": "$dailyAction"},
  {"op": "set", "target": "$dailyAction", "prop": "Description", "value": "Midnight draw of the day's missions"},
  {"op": "create", "parent": "$dailyAction", "type": "IStartNode", "as": "$dailyStart"},
  {"op": "create", "parent": "$dailyAction", "type": "IEndNode", "as": "$dailyEnd"},
  {"op": "link", "from": "$dailyStart", "to": "$dailyEnd"},
  {"op": "create", "parent": "@espace", "type": "IServerAction", "name": "Ranking_CloseWeekly", "as": "$weeklyAction"},
  {"op": "set", "target": "$weeklyAction", "prop": "Description", "value": "Monday close of the weekly ranking"},
  {"op": "create", "parent": "$weeklyAction", "type": "IStartNode", "as": "$weeklyStart"},
  {"op": "create", "parent": "$weeklyAction", "type": "IEndNode", "as": "$weeklyEnd"},
  {"op": "link", "from": "$weeklyStart", "to": "$weeklyEnd"},
  {"op": "create", "parent": "@espace", "type": "ITimer", "name": "PetDecay", "as": "$hourly"},
  {"op": "set", "target": "$hourly", "prop": "Action", "value": "$hourlyAction"},
  {"op": "set", "target": "$hourly", "prop": "Description", "value": "Runs every hour"},
  {"op": "set", "target": "$hourly", "prop": "Schedule", "value": "00:00 01:00 02:00 03:00 04:00 05:00 06:00 07:00 08:00 09:00 10:00 11:00 12:00 13:00 14:00 15:00 16:00 17:00 18:00 19:00 20:00 21:00 22:00 23:00"},
  {"op": "create", "parent": "@espace", "type": "ITimer", "name": "DailyMissions", "as": "$daily"},
  {"op": "set", "target": "$daily", "prop": "Action", "value": "$dailyAction"},
  {"op": "set", "target": "$daily", "prop": "Description", "value": "Runs every day at midnight"},
  {"op": "set", "target": "$daily", "prop": "Schedule", "value": "00:00"},
  {"op": "create", "parent": "@espace", "type": "ITimer", "name": "WeeklyReset", "as": "$weekly"},
  {"op": "set", "target": "$weekly", "prop": "Action", "value": "$weeklyAction"},
  {"op": "set", "target": "$weekly", "prop": "Description", "value": "Runs every Monday at 00:05"},
  {"op": "set", "target": "$weekly", "prop": "Schedule", "value": "00:05 Mon"},
  {"op": "get", "target": "$hourly"},
  {"op": "get", "target": "$daily"},
  {"op": "get", "target": "$weekly"}
 ]
}
