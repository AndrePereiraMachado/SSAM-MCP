{
 "description": "ODC (WS2, prova viva): bloco WF_PinNotFoundBanner em WrightFloodComponents, o mesmo desenho de lab\\42-pin-banner-v4 do SSAM-Hybrid-ODC: painel de alerta (role=alert) com icone warning-circle e titulo em negrito, tres linhas numeradas, duas entradas (Latitude, Longitude) com placeholders de exemplo e um botao 'Drop pin here' que corre HandleDropPinRequested, que dispara o evento DropPinRequested(Latitude, Longitude). Headless: base = fixture pessoal r8; ao vivo: base = snapshot do modulo aberto (StudioSessionOdc.DeliverJob).",
 "base": "tests/fixtures/odc/wrightflood-personal-r8.oml",
 "expectValid": true,
 "ops": [
  {"op": "create", "parent": "IMobileFlow:WrightFloodComponents", "type": "IMobileBlock", "name": "WF_PinNotFoundBanner", "as": "$blk"},
  {"op": "set", "target": "$blk", "prop": "Description", "value": "Rooftop-not-found alert for the Location screen: instructs the agent to click the map, drag the pin, or enter coordinates directly. Visual reference: Jira OUT-21 (image-20260904-030751.png)."},
  {"op": "create", "parent": "$blk", "type": "ILocalVariable", "name": "Latitude", "as": "$lat"},
  {"op": "set", "target": "$lat", "prop": "DataType", "value": "Text"},
  {"op": "create", "parent": "$blk", "type": "ILocalVariable", "name": "Longitude", "as": "$lon"},
  {"op": "set", "target": "$lon", "prop": "DataType", "value": "Text"},
  {"op": "create", "parent": "$blk", "type": "IBlockEvent", "name": "DropPinRequested", "as": "$evt"},
  {"op": "create", "parent": "$evt", "type": "IInputParameter", "name": "Latitude", "as": "$evLat"},
  {"op": "set", "target": "$evLat", "prop": "DataType", "value": "Text"},
  {"op": "create", "parent": "$evt", "type": "IInputParameter", "name": "Longitude", "as": "$evLon"},
  {"op": "set", "target": "$evLon", "prop": "DataType", "value": "Text"},
  {"op": "create", "parent": "$blk", "type": "IScreenAction", "name": "HandleDropPinRequested", "as": "$act"},
  {"op": "set", "target": "$act", "prop": "Description", "value": "Raises DropPinRequested with the coordinates the agent typed."},
  {"op": "create", "parent": "$act", "type": "IStartNode", "as": "$s0"},
  {"op": "create", "parent": "$act", "type": "ITriggerNode", "name": "DropPinRequested", "as": "$trg"},
  {"op": "set", "target": "$trg", "prop": "Event", "value": "$evt"},
  {"op": "set", "target": "$trg/arg:Latitude", "prop": "Value", "value": "Latitude"},
  {"op": "set", "target": "$trg/arg:Longitude", "prop": "Value", "value": "Longitude"},
  {"op": "create", "parent": "$act", "type": "IEndNode", "as": "$s9"},
  {"op": "link", "from": "$s0", "to": "$trg"},
  {"op": "link", "from": "$trg", "to": "$s9"},
  {"op": "layout", "target": "$act"},
  {"op": "create", "parent": "$blk", "type": "IContainer", "name": "Panel", "as": "$panel"},
  {"op": "set", "target": "$panel", "prop": "Width", "value": "(fill parent)"},
  {"op": "set", "target": "$panel", "prop": "Style", "value": "\"background-error-light border-radius-soft padding-base display-flex flex-direction-column gap-s\""},
  {"op": "create", "parent": "$panel", "type": "IExtendedProperty", "as": "$role"},
  {"op": "set", "target": "$role", "prop": "Property", "value": "role"},
  {"op": "set", "target": "$role", "prop": "Value", "value": "\"alert\""},
  {"op": "create", "parent": "$panel/#IContent", "type": "IContainer", "name": "Header", "as": "$hdr"},
  {"op": "set", "target": "$hdr", "prop": "Width", "value": "(fill parent)"},
  {"op": "set", "target": "$hdr", "prop": "Style", "value": "\"display-flex align-items-center gap-xs\""},
  {"op": "create", "parent": "$hdr/#IContent", "type": "IIcon", "name": "WarningIcon", "as": "$ico"},
  {"op": "set", "target": "$ico", "prop": "Icon", "value": "warning-circle"},
  {"op": "set", "target": "$ico", "prop": "Weight", "value": "regular"},
  {"op": "set", "target": "$ico", "prop": "Style", "value": "\"text-error\""},
  {"op": "create", "parent": "$hdr/#IContent", "type": "IExpression", "name": "Title", "as": "$title"},
  {"op": "set", "target": "$title", "prop": "Value", "value": "\"We couldn't pin the exact building.\""},
  {"op": "set", "target": "$title", "prop": "Style", "value": "\"font-bold text-error\""},
  {"op": "create", "parent": "$panel/#IContent", "type": "IContainer", "name": "Steps", "as": "$steps"},
  {"op": "set", "target": "$steps", "prop": "Width", "value": "(fill parent)"},
  {"op": "set", "target": "$steps", "prop": "Style", "value": "\"display-flex flex-direction-column gap-xs font-size-s text-neutral-8\""},
  {"op": "create", "parent": "$steps/#IContent", "type": "ITextWidget", "name": "Step1", "as": "$t1"},
  {"op": "set", "target": "$t1", "prop": "Text", "value": "1. Click your building on the map below to drop a pin."},
  {"op": "create", "parent": "$steps/#IContent", "type": "ITextWidget", "name": "Step2", "as": "$t2"},
  {"op": "set", "target": "$t2", "prop": "Text", "value": "2. Or enter its latitude & longitude, if you have them."},
  {"op": "create", "parent": "$steps/#IContent", "type": "ITextWidget", "name": "Step3", "as": "$t3"},
  {"op": "set", "target": "$t3", "prop": "Text", "value": "3. Drag the pin to fine-tune the exact location."},
  {"op": "create", "parent": "$panel/#IContent", "type": "IContainer", "name": "Fields", "as": "$row"},
  {"op": "set", "target": "$row", "prop": "Width", "value": "(fill parent)"},
  {"op": "set", "target": "$row", "prop": "Style", "value": "\"display-flex align-items-center gap-s\""},
  {"op": "create", "parent": "$row/#IContent", "type": "IInput", "name": "LatitudeInput", "as": "$inLat"},
  {"op": "set", "target": "$inLat", "prop": "Variable", "value": "Latitude"},
  {"op": "set", "target": "$inLat", "prop": "Prompt", "value": "\"Latitude (e.g. 27.7676)\""},
  {"op": "set", "target": "$inLat", "prop": "Width", "value": "(fill parent)"},
  {"op": "create", "parent": "$row/#IContent", "type": "IInput", "name": "LongitudeInput", "as": "$inLon"},
  {"op": "set", "target": "$inLon", "prop": "Variable", "value": "Longitude"},
  {"op": "set", "target": "$inLon", "prop": "Prompt", "value": "\"Longitude (e.g. -82.6403)\""},
  {"op": "set", "target": "$inLon", "prop": "Width", "value": "(fill parent)"},
  {"op": "create", "parent": "$row/#IContent", "type": "IButton", "name": "DropPinButton", "as": "$btn"},
  {"op": "set", "target": "$btn/#ITextWidget", "prop": "Text", "value": "Drop pin here"},
  {"op": "set", "target": "$btn", "prop": "Style", "value": "\"btn\""},
  {"op": "set", "target": "$btn/OnClick", "prop": "Destination", "value": "$act"},
  {"op": "dump", "target": "$blk", "depth": 7}
 ]
}
