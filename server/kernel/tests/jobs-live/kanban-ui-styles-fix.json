        "html": "<div class=\"shell\"><aside class=\"sidebar\"><p class=\"brand\">Kanban</p><p class=\"nav-item\">Início</p><p class=\"nav-item nav-active\">Produto Digital</p><p class=\"nav-item\">Marketing &amp; Growth</p></aside><main class=\"board-main\"><div class=\"crumbs\"><a data-av=\"board.back\" href=\"#\">Home</a><span>/</span><span>Produto Digital</span><span>/</span><span>Board</span></div><header class=\"toolbar\"><div class=\"board-name\"><span class=\"color\"></span><h1>Board Kanban</h1></div><div class=\"tools\"><span class=\"tool\">Selecionar</span><span class=\"tool\">Arquivados</span><span class=\"tool\">Config.</span><span class=\"tool tool-primary\">+ Card</span></div></header><div class=\"filter\">Filtrar cards, responsáveis ou etiquetas…</div><div class=\"state\" data-av=\"board.loading\">Carregando board…</div><div data-av=\"board.ready\"><div class=\"columns\" data-av=\"board.columns\"><section class=\"column\"><header class=\"column-head\"><h2 data-av=\"board.column.name\">Backlog</h2><a data-av=\"board.column.add\" href=\"#\">+</a></header><div class=\"cards\" data-av=\"board.cards\"><div class=\"card\" data-av=\"board.card.incolumn\"><span class=\"badge\">Card</span><h3 data-av=\"board.card.title\">Título do card</h3><p data-av=\"board.card.description\">Descrição do card.</p><div class=\"card-foot\"><span class=\"due\" data-av=\"board.card.due\">Sem prazo</span><span class=\"initial\">MC</span></div><a data-av=\"board.card.open\" href=\"#\">Abrir card</a></div></div></section></div></div></main></div>",
        "css": ".shell{background:#fff;display:flex;min-height:100vh;color:#18181b;font-family:Inter,Arial,sans-serif}.sidebar{background:#fafafa;border-right:1px solid #e4e4e7;box-sizing:border-box;flex:0 0 220px;padding:20px 12px}.brand{font-size:16px;font-weight:750;margin:0 8px 30px}.nav-item{border-radius:6px;color:#52525b;font-size:13px;margin:1px 0;padding:9px 10px}.nav-active{background:#f4f4f5;color:#18181b;font-weight:650}.board-main{min-width:0;width:100%}.crumbs{align-items:center;border-bottom:1px solid #e4e4e7;display:flex;gap:7px;padding:15px 24px}.crumbs a,.crumbs span{color:#71717a;font-size:12px;text-decoration:none}.toolbar{align-items:center;border-bottom:1px solid #e4e4e7;display:flex;justify-content:space-between;padding:18px 24px}.board-name{align-items:center;display:flex;gap:10px}.color{background:#6366f1;border-radius:5px;height:22px;width:22px}.board-name h1{font-size:18px;margin:0}.tools{align-items:center;display:flex;gap:7px}.tool{border:1px solid #e4e4e7;border-radius:6px;color:#52525b;font-size:12px;padding:7px 10px}.tool-primary{background:#18181b;border-color:#18181b;color:#fff}.filter{border-bottom:1px solid #e4e4e7;color:#71717a;font-size:12px;padding:13px 24px}.columns{display:flex;min-height:calc(100vh - 145px);overflow-x:auto}.column{background:#fafafa;border-right:1px solid #e4e4e7;box-sizing:border-box;flex:0 0 286px;min-height:480px}.column-head{align-items:center;background:#fff;border-bottom:1px solid #e4e4e7;display:flex;justify-content:space-between;padding:12px 13px}.column-head h2{font-size:12px;letter-spacing:.02em;margin:0}.column-head a{color:#71717a;font-size:20px;line-height:18px;text-decoration:none}.cards{display:flex;flex-direction:column;gap:8px;padding:10px}.card{background:#fff;border:1px solid #e4e4e7;border-radius:8px;padding:12px}.badge{background:#eef2ff;border-radius:999px;color:#4f46e5;font-size:10px;font-weight:700;padding:3px 7px}.card h3{font-size:13px;line-height:19px;margin:8px 0 0}.card p{color:#71717a;font-size:12px;line-height:17px;margin:5px 0 0}.card-foot{align-items:center;display:flex;justify-content:space-between;margin-top:12px}.due{color:#a1a1aa;font-size:11px}.initial{align-items:center;background:#6366f1;border:2px solid #fff;border-radius:50%;color:#fff;display:flex;font-size:9px;font-weight:750;height:26px;justify-content:center;width:26px}.card a{color:#4f46e5;font-size:11px;font-weight:700;text-decoration:none}.state{color:#71717a;font-size:13px;padding:24px}",
        "stylesheet": "theme"
      }
