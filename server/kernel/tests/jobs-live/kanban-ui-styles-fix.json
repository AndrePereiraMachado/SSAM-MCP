            "condition": "True"
          }
        },
        "html": "<main class=\"form-screen\"><section class=\"dialog\"><header class=\"dialog-head\"><div><h1>Novo card</h1><p>Adicione um item ao board.</p></div><span>×</span></header><div class=\"field\" data-av=\"form.title.field\"><p class=\"field-label\">Título</p></div><div class=\"field\" data-av=\"form.description.field\"><p class=\"field-label\">Descrição</p></div><div class=\"field\" data-av=\"form.priority.field\"><p class=\"field-label\">Prioridade</p></div><div class=\"field\"><p class=\"field-label\">Prazo</p><input type=\"date\" class=\"form-input\" data-av=\"form.due\"></div><div class=\"field\"><p class=\"field-label\">Responsável</p><p class=\"field-help\">O card será criado por você.</p></div><footer class=\"footer\"><a class=\"cancel\" data-av=\"form.cancel\" href=\"#\">Cancelar</a><div data-av=\"form.save.field\"></div></footer></section></main>",
        "css": ".form-screen{align-items:center;background:#f4f4f5;box-sizing:border-box;display:flex;justify-content:center;min-height:100vh;padding:28px;color:#18181b;font-family:Inter,Arial,sans-serif}.dialog{background:#fff;border:1px solid #e4e4e7;border-radius:12px;box-shadow:0 22px 65px rgba(24,24,27,.16);box-sizing:border-box;max-width:570px;padding:25px;width:100%}.dialog-head{align-items:flex-start;border-bottom:1px solid #e4e4e7;display:flex;justify-content:space-between;margin-bottom:21px;padding-bottom:17px}.dialog h1{font-size:19px;letter-spacing:-.03em;margin:0}.dialog-head p{color:#71717a;font-size:12px;margin:4px 0 0}.field{margin-top:16px}.field-label{color:#3f3f46;font-size:12px;font-weight:700;margin:0 0 7px}.field-help{color:#71717a;font-size:11px;margin:4px 0 0}.form-input,.form-textarea,.form-priority{border:1px solid #d4d4d8;border-radius:7px;box-sizing:border-box;font-size:13px;width:100%}.form-textarea{min-height:86px}.footer{align-items:center;border-top:1px solid #e4e4e7;display:flex;gap:8px;justify-content:flex-end;margin-top:24px;padding-top:17px}.cancel{color:#52525b;font-size:12px;padding:8px 11px;text-decoration:none}.save-card{background:#18181b;border:0;border-radius:6px;color:#fff;font-size:12px;font-weight:700;padding:8px 13px}.DatePicker{width:100%}",
