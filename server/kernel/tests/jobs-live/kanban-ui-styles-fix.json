        "html": "<div class=\"shell\"><aside class=\"sidebar\"><p class=\"brand\">Kanban</p><p class=\"nav-item\">Início</p><p class=\"nav-item nav-active\">Workspaces</p><p class=\"nav-item\">Produto Digital</p><p class=\"nav-item\">Marketing &amp; Growth</p></aside><main class=\"main\"><div class=\"crumbs\"><a data-av=\"workspace.back\" href=\"#\">Home</a><span>/</span><span>Workspace</span></div><div data-av=\"workspace.rows\"><section class=\"workspace-head\"><div class=\"workspace-title\"><span class=\"mark\">P</span><div><h1 data-av=\"workspace.name\">Produto Digital</h1><p data-av=\"workspace.description\">Time responsável pelo produto principal.</p></div></div><nav class=\"tabs\"><span class=\"tab tab-active\">Boards</span><span class=\"tab\">Membros</span><span class=\"tab\">Configurações</span></nav></section></div><div class=\"content\"><div class=\"content-head\"><h2>Boards</h2><span class=\"add-board\">+ Novo board</span></div><div class=\"state\" data-av=\"workspace.loading\">Carregando boards…</div><div data-av=\"workspace.ready\"><div class=\"grid\" data-av=\"workspace.boards\"><article class=\"board\"><span class=\"board-dot\"></span><h3 data-av=\"workspace.board.name\">Roadmap Q3</h3><p data-av=\"workspace.board.description\">Planejamento do próximo ciclo.</p><a data-av=\"workspace.board.open\" href=\"#\">Abrir board</a></article></div></div></div></main></div>",
        "css": ".shell{background:#fff;display:flex;min-height:100vh;color:#18181b;font-family:Inter,Arial,sans-serif}.sidebar{background:#fafafa;border-right:1px solid #e4e4e7;box-sizing:border-box;flex:0 0 220px;padding:20px 12px}.brand{font-size:16px;font-weight:750;margin:0 8px 30px}.nav-item{border-radius:6px;color:#52525b;font-size:13px;margin:1px 0;padding:9px 10px}.nav-active{background:#f4f4f5;color:#18181b;font-weight:650}.main{min-width:0;width:100%}.crumbs{align-items:center;border-bottom:1px solid #e4e4e7;display:flex;gap:7px;padding:17px 32px}.crumbs a{color:#71717a;font-size:12px;text-decoration:none}.crumbs span{color:#a1a1aa;font-size:12px}.workspace-head{border-bottom:1px solid #e4e4e7;padding:30px 32px 0}.workspace-title{align-items:center;display:flex;gap:12px}.mark{align-items:center;background:#eef2ff;border-radius:8px;color:#4f46e5;display:flex;font-size:18px;font-weight:750;height:38px;justify-content:center;width:38px}.workspace-title h1{font-size:22px;letter-spacing:-.03em;margin:0}.workspace-title p{color:#71717a;font-size:13px;margin:3px 0 0}.tabs{display:flex;gap:4px;margin-top:24px}.tab{border-bottom:2px solid transparent;color:#71717a;font-size:13px;padding:11px 13px}.tab-active{border-bottom-color:#6366f1;color:#3730a3;font-weight:700}.content{padding:30px 32px;max-width:1000px}.content-head{align-items:center;display:flex;justify-content:space-between;margin-bottom:16px}.content-head h2{font-size:16px;margin:0}.add-board{background:#18181b;border-radius:6px;color:#fff;font-size:12px;font-weight:650;padding:8px 12px}.grid{display:grid;gap:14px;grid-template-columns:repeat(auto-fit,minmax(230px,1fr))}.board{background:#fff;border:1px solid #e4e4e7;border-radius:9px;display:flex;flex-direction:column;min-height:150px;padding:18px}.board-dot{background:#6366f1;border-radius:6px;height:28px;width:28px}.board h3{font-size:15px;margin:14px 0 3px}.board p{color:#71717a;font-size:12px;line-height:18px;margin:0}.board a{color:#4f46e5;font-size:12px;font-weight:650;margin-top:auto;padding-top:14px;text-decoration:none}.state{color:#71717a;font-size:13px;padding:20px 0}",
