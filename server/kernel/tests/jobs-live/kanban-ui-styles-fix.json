    {
      "op": "html",
      "data": {
        "screen": "CardForm",
        "title": "Novo card",
        "layout": "blank",
        "sources": [
          {
            "action": "Board_GetKanban",
            "as": "LoadFormBoard",
            "args": {
              "BoardId": "BoardId"
            },
            "state": true
          }
        ],
        "vars": [
          {
            "name": "CardTitle",
            "type": "Text"
