        "html": "<div class=\"shell\"><aside class=\"sidebar\"><p class=\"brand\">Kanban</p><p class=\"nav-item\">Início</p><p class=\"nav-item nav-active\">Produto Digital</p></aside><main class=\"detail-main\"><div class=\"crumbs\"><a data-av=\"details.back\" href=\"#\">Home</a><span>/</span><span>Board</span><span>/</span><span>Card</span></div><div class=\"state\" data-av=\"details.loading\">Carregando card…</div><div data-av=\"details.ready\"><div class=\"detail\" data-av=\"details.panel\"><article class=\"article\"><div class=\"topline\"><span class=\"pill\">Prioridade normal</span><button class=\"archive\" data-av=\"details.archive\">Arquivar</button></div><h1 data-av=\"details.title\">Título do card</h1><p class=\"description\" data-av=\"details.description\">Descrição do card.</p><section class=\"section\"><h2>Comentários</h2><div data-av=\"details.comments\"><article class=\"comment\"><strong>Membro do time</strong><p data-av=\"details.comment.body\">Comentário.</p></article></div><div class=\"editor\" data-av=\"details.comment.editor\"><p>Adicionar comentário</p></div></section><section class=\"section\"><h2>Atividade</h2><div data-av=\"details.activities\"><p class=\"activity\" data-av=\"details.activity.text\">Atividade do card.</p></div></section></article><aside class=\"details-panel\"><h2>Detalhes</h2><div class=\"detail-row\"><small>Prazo</small><p data-av=\"details.due\">Sem prazo</p></div><div class=\"detail-row\"><small>Responsáveis</small><p>MC</p></div><div class=\"detail-row\"><small>Etiquetas</small><p>Sem etiquetas</p></div></aside></div></div></main></div>",
        "css": ".shell{background:#fff;display:flex;min-height:100vh;color:#18181b;font-family:Inter,Arial,sans-serif}.sidebar{background:#fafafa;border-right:1px solid #e4e4e7;box-sizing:border-box;flex:0 0 220px;padding:20px 12px}.brand{font-size:16px;font-weight:750;margin:0 8px 30px}.nav-item{border-radius:6px;color:#52525b;font-size:13px;margin:1px 0;padding:9px 10px}.nav-active{background:#f4f4f5;color:#18181b;font-weight:650}.detail-main{min-width:0;width:100%}.crumbs{align-items:center;border-bottom:1px solid #e4e4e7;display:flex;gap:7px;padding:15px 32px}.crumbs a,.crumbs span{color:#71717a;font-size:12px;text-decoration:none}.detail{display:grid;grid-template-columns:minmax(0,1fr) 268px;min-height:calc(100vh - 47px)}.article{padding:34px 42px}.topline{align-items:center;display:flex;justify-content:space-between}.pill{background:#eef2ff;border-radius:999px;color:#4f46e5;font-size:11px;font-weight:700;padding:4px 9px}.archive{background:#fff;border:1px solid #e4e4e7;border-radius:6px;color:#52525b;font-size:12px;padding:7px 10px}.article h1{font-size:26px;letter-spacing:-.04em;line-height:34px;margin:16px 0 8px}.description{color:#52525b;font-size:14px;line-height:22px;margin:0}.section{border-top:1px solid #e4e4e7;margin-top:28px;padding-top:21px}.section h2{font-size:14px;margin:0 0 13px}.comment{border-bottom:1px solid #f0f0f1;padding:12px 0}.comment strong{font-size:12px}.comment p{color:#52525b;font-size:13px;line-height:19px;margin:5px 0 0}.activity{color:#71717a;font-size:12px;padding:7px 0}.editor{background:#fafafa;border:1px solid #e4e4e7;border-radius:8px;margin-top:10px;padding:10px}.details-panel{background:#fafafa;border-left:1px solid #e4e4e7;padding:28px 22px}.details-panel h2{font-size:13px;margin:0 0 20px}.detail-row{border-bottom:1px solid #e4e4e7;padding:12px 0}.detail-row small{color:#a1a1aa;display:block;font-size:10px;font-weight:700;letter-spacing:.06em;text-transform:uppercase}.detail-row p{font-size:12px;margin:6px 0 0}.state{color:#71717a;font-size:13px;padding:24px}.comment-input{margin-top:6px;width:100%}.comment-save{background:#18181b;border:0;border-radius:6px;color:#fff;font-size:12px;font-weight:650;margin-top:8px;padding:7px 11px}",
        "stylesheet": "theme"
      }
