  {"op": "set", "target": "$inst/OnCheckout/Note", "prop": "Value", "value": "Note"},
  {"op": "set", "target": "$inst/OnCheckout/FirstProductId", "prop": "Value", "value": "FirstProductId"},

  {"op": "create", "parent": "$scr/#IMobileBlockInstanceWidget/MainContent", "type": "IList", "name": "LinesList", "as": "$list", "_why": "9. the LIST that arrived through the event is iterable, without an intermediate level in the Current"},
  {"op": "set", "target": "$list", "prop": "Source", "value": "LastLines"},
  {"op": "create", "parent": "$list", "type": "IExpression", "as": "$lex"},
  {"op": "set", "target": "$lex", "prop": "Value", "value": "IntegerToText(LastLines.Current.Qty)"},

  {"op": "create", "parent": "$scr/#IMobileBlockInstanceWidget/MainContent", "type": "IExpression", "as": "$echo", "_why": "10. the other seven, with the RECORD read by attribute"},
  {"op": "set", "target": "$echo", "prop": "Value", "value": "IntegerToText(LastCount) + \" linhas, \" + DecimalToText(LastTotal) + \", \" + LastNote + \", \" + BooleanToText(LastExpress) + \", \" + DateTimeToText(LastPlacedAt) + \", \" + LongIntegerToText(LastProductId) + \", \" + IntegerToText(LastSummary.Qty)"},

  {"op": "get", "target": "$ev", "_why": "InputParameters 8"},
