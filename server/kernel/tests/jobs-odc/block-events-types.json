  {"op": "create", "parent": "$h", "type": "IEndNode", "as": "$h9"},
  {"op": "link", "from": "$h0", "to": "$hAs"},
  {"op": "link", "from": "$hAs", "to": "$h9"},
  {"op": "layout", "target": "$h"},

  {"op": "create", "parent": "$scr/#IMobileBlockInstanceWidget/MainContent", "type": "IMobileBlockInstanceWidget", "name": "WfCartPanel1", "as": "$inst", "source": "IMobileBlock:WfCartPanel", "_why": "8. a instancia e os oito argumentos no escopo do evento"},
  {"op": "set", "target": "$inst/Title", "prop": "Value", "value": "\"Carrinho\""},
