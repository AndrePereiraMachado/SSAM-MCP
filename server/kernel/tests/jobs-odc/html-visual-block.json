{
 "description": "WS4 T7 (ODC): the same job html-visual-block over the InsuranceApp of the personal tenant: block instance (DatePicker from OutSystems UI, referenced by the module) with input and native handler.",
 "base": "tests/fixtures/odc/insurance-reactive-r8.oml",
 "expectValid": true,
 "expectedMessages": [
  {
   "id": "UnusedElement",
   "element": "DateChosen (ScreenAction) / DatePickerId (InputParameter)",
   "why": "DatePickerId is part of the contract of the OnSelected event; this example uses only the selected date."
  }
 ],
 "ops": [
  {"op": "create", "parent": "IMobileFlow:MainFlow", "type": "IMobileScreen", "name": "Booking", "as": "$scr"},
  {"op": "set", "target": "$scr/#IMobileBlockInstanceWidget", "prop": "SourceBlock", "value": "IMobileBlock:LayoutTopMenu"},
  {"op": "create", "parent": "$scr/#IMobileBlockInstanceWidget/Title", "type": "IExpression", "as": "$title"},
  {"op": "set", "target": "$title", "prop": "Value", "value": "\"Booking\""},

  {"op": "create", "parent": "$scr", "type": "ILocalVariable", "name": "SelectedDate", "as": "$vSel"},
  {"op": "set", "target": "$vSel", "prop": "DataType", "value": "Date"},
  {"op": "create", "parent": "$scr", "type": "ILocalVariable", "name": "Confirmed", "as": "$vConf"},
  {"op": "set", "target": "$vConf", "prop": "DataType", "value": "Date"},

  {"op": "create", "parent": "$scr", "type": "IScreenAction", "name": "DateChosen", "as": "$h"},
  {"op": "create", "parent": "$h", "type": "IInputParameter", "name": "DatePickerId", "as": "$hp1"},
  {"op": "set", "target": "$hp1", "prop": "DataType", "value": "Text"},
  {"op": "create", "parent": "$h", "type": "IInputParameter", "name": "SelectedDateTime", "as": "$hp2"},
  {"op": "set", "target": "$hp2", "prop": "DataType", "value": "Date Time"},
  {"op": "create", "parent": "$h", "type": "IStartNode", "as": "$hs"},
  {"op": "create", "parent": "$h", "type": "IAssignNode", "as": "$hAs"},
  {"op": "set", "target": "$hAs", "prop": "Label", "value": "SetConfirmed"},
  {"op": "create", "parent": "$hAs", "type": "IAssignment", "as": "$hA1"},
  {"op": "set", "target": "$hA1", "prop": "Variable", "value": "Confirmed"},
  {"op": "set", "target": "$hA1", "prop": "Value", "value": "DateTimeToDate(SelectedDateTime)"},
  {"op": "create", "parent": "$h", "type": "IEndNode", "as": "$he"},
  {"op": "link", "from": "$hs", "to": "$hAs"},
  {"op": "link", "from": "$hAs", "to": "$he"},
  {"op": "layout", "target": "$h"},

  {"op": "html", "parent": "$scr/#IMobileBlockInstanceWidget/MainContent", "file": "tests/html/visual/block.html"},

  {"op": "set", "target": "$scr/#IMobileBlockInstanceWidget/MainContent/**IMobileBlockInstanceWidget[1]/Datepicker/#IInput", "prop": "Variable", "value": "SelectedDate"},

  {"op": "dump", "target": "$scr", "depth": 9}
 ]
}
