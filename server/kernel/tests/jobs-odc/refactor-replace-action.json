{
 "description": "ODC: the same refactor as the O11 lane (replace op). Three actions: an old one, a new one with the same signature, and one that calls the old one. After the replace, the caller now points to the new one, the old one is left without consumers and is deleted without force.",
 "base": "tests/fixtures/odc/insurance-reactive-r8.oml",
 "expectValid": true,
 "ops": [
  {"op": "create", "parent": "@espace", "type": "IServerAction", "name": "WfProof_Old", "as": "$old"},
  {"op": "create", "parent": "$old", "type": "IInputParameter", "name": "Label", "as": "$oldIn"},
  {"op": "set", "target": "$oldIn", "prop": "DataType", "value": "Text"},
  {"op": "create", "parent": "$old", "type": "IStartNode", "as": "$o0"},
  {"op": "create", "parent": "$old", "type": "IEndNode", "as": "$o9"},
  {"op": "link", "from": "$o0", "to": "$o9"},
  {"op": "layout", "target": "$old"},

  {"op": "create", "parent": "@espace", "type": "IServerAction", "name": "WfProof_New", "as": "$new"},
  {"op": "create", "parent": "$new", "type": "IInputParameter", "name": "Label", "as": "$newIn"},
  {"op": "set", "target": "$newIn", "prop": "DataType", "value": "Text"},
  {"op": "create", "parent": "$new", "type": "IStartNode", "as": "$n0"},
  {"op": "create", "parent": "$new", "type": "IEndNode", "as": "$n9"},
  {"op": "link", "from": "$n0", "to": "$n9"},
  {"op": "layout", "target": "$new"},

  {"op": "create", "parent": "@espace", "type": "IServerAction", "name": "WfProof_Caller", "as": "$caller"},
  {"op": "create", "parent": "$caller", "type": "IStartNode", "as": "$c0"},
  {"op": "create", "parent": "$caller", "type": "IExecuteServerActionNode", "name": "CallOld", "as": "$call"},
  {"op": "set", "target": "$call", "prop": "Action", "value": "$old"},
  {"op": "set", "target": "$call/Label", "prop": "Value", "value": "\"proof\""},
  {"op": "create", "parent": "$caller", "type": "IEndNode", "as": "$c9"},
  {"op": "link", "from": "$c0", "to": "$call"},
  {"op": "link", "from": "$call", "to": "$c9"},
  {"op": "layout", "target": "$caller"},

  {"op": "usages", "target": "$old", "_why": "a real consumer: the node of WfProof_Caller"},
  {"op": "replace", "from": "$old", "to": "$new"},
  {"op": "usages", "target": "$old", "_why": "it has to end at zero"},
  {"op": "usages", "target": "$new", "_why": "the consumer moved here, with the same key"},
  {"op": "delete", "target": "$old", "_why": "without consumers, without force"},
  {"op": "find", "name": "WfProof_New"}
 ],
 "expectedMessages": [
  {
   "id": "UnusedUserAction",
   "element": "InsuranceApp (ESpace) / WfProof_Caller (ServerAction)",
   "why": "the calling action is created only to give a consumer to the replace; nobody calls it, and the ODC Verify warns about actions without use."
  },
  {
   "id": "UnusedElement",
   "element": "InsuranceApp (ESpace) / WfProof_New (ServerAction) / Label (InputParameter)",
   "why": "the new action has the SAME signature as the old one, which is what makes the replace safe, but its body is only Start/End: the parameter exists to match the signature and is not read."
  }
 ]
}
