{
 "description": "ODC (WS1): Reactive screen in the MainFlow of the InsuranceApp (the module's own LayoutTopMenu layout) with a container, an expression, an input bound to a local variable and a button bound to a screen action (assign).",
 "base": "tests/fixtures/odc/insurance-reactive-r8.oml",
 "expectValid": true,
 "ops": [
  {"op": "create", "parent": "IMobileFlow:MainFlow", "type": "IMobileScreen", "name": "WfProofScreen", "as": "$scr"},
  {"op": "set", "target": "$scr/#IMobileBlockInstanceWidget", "prop": "SourceBlock", "value": "IMobileBlock:LayoutTopMenu"},
  {"op": "create", "parent": "$scr/#IMobileBlockInstanceWidget/Title", "type": "IExpression", "as": "$title"},
  {"op": "set", "target": "$title", "prop": "Value", "value": "\"WS1 proof\""},
  {"op": "create", "parent": "$scr", "type": "ILocalVariable", "name": "Name", "as": "$name"},
  {"op": "set", "target": "$name", "prop": "DataType", "value": "Text"},
  {"op": "create", "parent": "$scr", "type": "ILocalVariable", "name": "Greeting", "as": "$greeting"},
  {"op": "set", "target": "$greeting", "prop": "DataType", "value": "Text"},
  {"op": "create", "parent": "$scr/#IMobileBlockInstanceWidget/MainContent", "type": "IContainer", "name": "Box", "as": "$box"},
  {"op": "create", "parent": "$box", "type": "IExpression", "as": "$hello"},
  {"op": "set", "target": "$hello", "prop": "Value", "value": "\"Hello \" + Greeting"},
  {"op": "create", "parent": "$box", "type": "IInput", "name": "NameInput", "as": "$input"},
  {"op": "set", "target": "$input", "prop": "Variable", "value": "Name"},
  {"op": "set", "target": "$input", "prop": "Prompt", "value": "\"Your name\""},
  {"op": "create", "parent": "$box", "type": "IButton", "name": "GreetButton", "as": "$btn"},
  {"op": "set", "target": "$btn/#ITextWidget", "prop": "Text", "value": "Greet"},
  {"op": "create", "parent": "$scr", "type": "IScreenAction", "name": "Greet", "as": "$greet"},
  {"op": "create", "parent": "$greet", "type": "IStartNode", "as": "$s0"},
  {"op": "create", "parent": "$greet", "type": "IAssignNode", "name": "SetGreeting", "as": "$as"},
  {"op": "set", "target": "$as", "prop": "Label", "value": "SetGreeting"},
  {"op": "create", "parent": "$as", "type": "IAssignment", "as": "$a1"},
  {"op": "set", "target": "$a1", "prop": "Variable", "value": "Greeting"},
  {"op": "set", "target": "$a1", "prop": "Value", "value": "Name"},
  {"op": "create", "parent": "$greet", "type": "IEndNode", "as": "$s9"},
  {"op": "link", "from": "$s0", "to": "$as"},
  {"op": "link", "from": "$as", "to": "$s9"},
  {"op": "layout", "target": "$greet"},
  {"op": "set", "target": "$btn/OnClick", "prop": "Destination", "value": "$greet"},
  {"op": "dump", "target": "$scr", "depth": 5}
 ]
}
