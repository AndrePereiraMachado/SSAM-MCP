{
 "description": "ODC: delete LOGIC with real consumers on the InsuranceApp of the personal tenant. The server action WfProof_Save is called by another server action (WfProof_Import) and by a screen action of the screen WfProofScreen. The replace verb re-points both consumers to WfProof_Store and only then does the delete pass without force. The refusal (without force) is in tests/jobs-odc/delete-logic-in-use.json.",
 "base": "tests/fixtures/odc/insurance-reactive-r8.oml",
 "expectValid": true,
 "expectedMessages": [{"id": "UnusedUserAction", "element": "InsuranceApp (ESpace) / WfProof_Import (ServerAction)", "why": "ODC: an app (CrossDevice) does not expose a public server action (the live Studio gives an error); the action stays private and without a consumer in this proof job"}],
 "ops": [
  {"op": "create", "parent": "@espace", "type": "IServerAction", "name": "WfProof_Save", "as": "$old"},
  {"op": "create", "parent": "$old", "type": "IInputParameter", "name": "Title", "as": "$oldIn"},
  {"op": "set", "target": "$oldIn", "prop": "DataType", "value": "Text"},
  {"op": "create", "parent": "$old", "type": "IOutputParameter", "name": "Saved", "as": "$oldOut"},
  {"op": "set", "target": "$oldOut", "prop": "DataType", "value": "Boolean"},
  {"op": "create", "parent": "$old", "type": "IStartNode", "as": "$o0"},
  {"op": "create", "parent": "$old", "type": "IAssignNode", "as": "$oAs"},
  {"op": "set", "target": "$oAs", "prop": "Label", "value": "SetSaved"},
  {"op": "create", "parent": "$oAs", "type": "IAssignment", "as": "$oA1"},
  {"op": "set", "target": "$oA1", "prop": "Variable", "value": "Saved"},
  {"op": "set", "target": "$oA1", "prop": "Value", "value": "Title <> \"\""},
  {"op": "create", "parent": "$old", "type": "IEndNode", "as": "$o9"},
  {"op": "link", "from": "$o0", "to": "$oAs"},
  {"op": "link", "from": "$oAs", "to": "$o9"},
  {"op": "layout", "target": "$old"},

  {"op": "create", "parent": "@espace", "type": "IServerAction", "name": "WfProof_Import", "as": "$imp", "_why": "(1) consumer 1: another server action"},
  {"op": "create", "parent": "$imp", "type": "IInputParameter", "name": "Title", "as": "$impIn"},
  {"op": "set", "target": "$impIn", "prop": "DataType", "value": "Text"},
  {"op": "create", "parent": "$imp", "type": "IStartNode", "as": "$i0"},
  {"op": "create", "parent": "$imp", "type": "IExecuteServerActionNode", "name": "SaveOne", "as": "$iCall"},
  {"op": "set", "target": "$iCall", "prop": "Action", "value": "$old"},
  {"op": "set", "target": "$iCall/Title", "prop": "Value", "value": "Title"},
  {"op": "create", "parent": "$imp", "type": "IEndNode", "as": "$i9"},
  {"op": "link", "from": "$i0", "to": "$iCall"},
  {"op": "link", "from": "$iCall", "to": "$i9"},
  {"op": "layout", "target": "$imp"},

  {"op": "create", "parent": "IMobileFlow:MainFlow", "type": "IMobileScreen", "name": "WfProofScreen", "as": "$scr", "_why": "(2) consumer 2: a screen that calls the same action"},
  {"op": "set", "target": "$scr/#IMobileBlockInstanceWidget", "prop": "SourceBlock", "value": "IMobileBlock:LayoutTopMenu"},
  {"op": "create", "parent": "$scr/#IMobileBlockInstanceWidget/Title", "type": "IExpression", "as": "$title"},
  {"op": "set", "target": "$title", "prop": "Value", "value": "\"Frente A: apagar com consumidores\""},
  {"op": "create", "parent": "$scr", "type": "ILocalVariable", "name": "NoticeTitle", "as": "$var"},
  {"op": "set", "target": "$var", "prop": "DataType", "value": "Text"},
  {"op": "create", "parent": "$scr/#IMobileBlockInstanceWidget/MainContent", "type": "IInput", "name": "TitleInput", "as": "$input"},
  {"op": "set", "target": "$input", "prop": "Variable", "value": "NoticeTitle"},
  {"op": "create", "parent": "$scr/#IMobileBlockInstanceWidget/MainContent", "type": "IButton", "name": "SaveButton", "as": "$btn"},
  {"op": "set", "target": "$btn/#ITextWidget", "prop": "Text", "value": "Save"},
  {"op": "create", "parent": "$scr", "type": "IScreenAction", "name": "SaveIt", "as": "$sa"},
  {"op": "create", "parent": "$sa", "type": "IStartNode", "as": "$a0"},
  {"op": "create", "parent": "$sa", "type": "IExecuteServerActionNode", "name": "SaveFromScreen", "as": "$aCall"},
  {"op": "set", "target": "$aCall", "prop": "Action", "value": "$old"},
  {"op": "set", "target": "$aCall/Title", "prop": "Value", "value": "NoticeTitle"},
  {"op": "create", "parent": "$sa", "type": "IEndNode", "as": "$a9"},
  {"op": "link", "from": "$a0", "to": "$aCall"},
  {"op": "link", "from": "$aCall", "to": "$a9"},
  {"op": "layout", "target": "$sa"},
  {"op": "set", "target": "$btn/OnClick", "prop": "Destination", "value": "$sa"},

  {"op": "usages", "target": "$old", "_why": "(3) dois consumidores reais: o no de WfProof_Import e o no da screen action SaveIt"},

  {"op": "create", "parent": "@espace", "type": "IServerAction", "name": "WfProof_Store", "as": "$new", "_why": "(4) the replacement, with the SAME signature"},
  {"op": "set", "target": "$new", "prop": "Description", "value": "Substitui WfProof_Save: mesma assinatura"},
  {"op": "create", "parent": "$new", "type": "IInputParameter", "name": "Title", "as": "$newIn"},
  {"op": "set", "target": "$newIn", "prop": "DataType", "value": "Text"},
  {"op": "create", "parent": "$new", "type": "IOutputParameter", "name": "Saved", "as": "$newOut"},
  {"op": "set", "target": "$newOut", "prop": "DataType", "value": "Boolean"},
  {"op": "create", "parent": "$new", "type": "IStartNode", "as": "$n0"},
  {"op": "create", "parent": "$new", "type": "IAssignNode", "as": "$nAs"},
  {"op": "set", "target": "$nAs", "prop": "Label", "value": "SetSaved"},
  {"op": "create", "parent": "$nAs", "type": "IAssignment", "as": "$nA1"},
  {"op": "set", "target": "$nA1", "prop": "Variable", "value": "Saved"},
  {"op": "set", "target": "$nA1", "prop": "Value", "value": "Length(Title) > 0"},
  {"op": "create", "parent": "$new", "type": "IEndNode", "as": "$n9"},
  {"op": "link", "from": "$n0", "to": "$nAs"},
  {"op": "link", "from": "$nAs", "to": "$n9"},
  {"op": "layout", "target": "$new"},

  {"op": "replace", "from": "$old", "to": "$new", "_why": "(5) the two consumers move to the new action, with the same key"},

  {"op": "usages", "target": "$old", "_why": "(6) it must stay at zero"},
  {"op": "usages", "target": "$new", "_why": "(6) the two consumers are here"},

  {"op": "delete", "target": "$old", "_why": "(7) without consumers, the delete passes without force: brokenConsumers=0"},

  {"op": "find", "name": "WfProof_Save", "_why": "(8) lista vazia"},
  {"op": "get", "target": "$aCall"},
  {"op": "get", "target": "$iCall"}
 ]
}
