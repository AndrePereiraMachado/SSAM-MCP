{
 "description": "ODC: delete DATA with real consumers over the InsuranceApp of the personal tenant. The attribute WfProofNotice.Body is used by an aggregate filter, by the expression of an Assign and by an Execute argument. One consumer is REPOINTED (to Title), the other two are REMOVED, and only then does the delete pass without force. The refusal (without force) is in tests/jobs-odc/delete-data-in-use.json.",
 "base": "tests/fixtures/odc/insurance-reactive-r8.oml",
 "expectValid": true,
 "expectedMessages": [{"id": "UnusedUserAction", "element": "InsuranceApp (ESpace) / WfProof_Digest (ServerAction)", "why": "ODC: an app (CrossDevice) does not expose a public server action (the live Studio gives an error); the action stays private and without a consumer in this proof job"}],
 "ops": [
  {
   "op": "spec",
   "data": {
    "entities": [
     {
      "name": "WfProofNotice",
      "description": "Prova da frente A: apagar um atributo com consumidores reais no ODC",
      "attributes": [
       {"name": "Title", "type": "Text", "mandatory": true, "length": 100},
       {"name": "Body", "type": "Text", "length": 500}
      ]
     }
    ]
   }
  },

  {"op": "create", "parent": "@espace", "type": "IServerAction", "name": "WfProof_Send", "as": "$send"},
  {"op": "create", "parent": "$send", "type": "IInputParameter", "name": "Body", "as": "$sendIn"},
  {"op": "set", "target": "$sendIn", "prop": "DataType", "value": "Text"},
  {"op": "create", "parent": "$send", "type": "IOutputParameter", "name": "Sent", "as": "$sendOut"},
  {"op": "set", "target": "$sendOut", "prop": "DataType", "value": "Boolean"},
  {"op": "create", "parent": "$send", "type": "IStartNode", "as": "$s0"},
  {"op": "create", "parent": "$send", "type": "IAssignNode", "as": "$sAs"},
  {"op": "set", "target": "$sAs", "prop": "Label", "value": "SetSent"},
  {"op": "create", "parent": "$sAs", "type": "IAssignment", "as": "$sA1"},
  {"op": "set", "target": "$sA1", "prop": "Variable", "value": "Sent"},
  {"op": "set", "target": "$sA1", "prop": "Value", "value": "Body <> \"\""},
  {"op": "create", "parent": "$send", "type": "IEndNode", "as": "$s9"},
  {"op": "link", "from": "$s0", "to": "$sAs"},
  {"op": "link", "from": "$sAs", "to": "$s9"},
  {"op": "layout", "target": "$send"},

  {"op": "create", "parent": "@espace", "type": "IServerAction", "name": "WfProof_Digest", "as": "$dig"},
  {"op": "create", "parent": "$dig", "type": "IOutputParameter", "name": "Summary", "as": "$digOut"},
  {"op": "set", "target": "$digOut", "prop": "DataType", "value": "Text"},
  {"op": "create", "parent": "$dig", "type": "IStartNode", "as": "$d0"},

  {"op": "create", "parent": "$dig", "type": "IAggregateNode", "name": "ReadNotices", "as": "$agg"},
  {"op": "create", "parent": "$agg", "type": "IAliasedSource", "args": {"dataSource": "$WfProofNotice"}},
  {"op": "create", "parent": "$agg", "type": "IFilter", "args": {"condition": "WfProofNotice.Body <> \"\""}, "as": "$flt", "_why": "(1) DATA consumer: the aggregate filter cites the attribute"},

  {"op": "create", "parent": "$dig", "type": "IAssignNode", "as": "$dAs"},
  {"op": "set", "target": "$dAs", "prop": "Label", "value": "SetSummary"},
  {"op": "create", "parent": "$dAs", "type": "IAssignment", "as": "$dA1"},
  {"op": "set", "target": "$dA1", "prop": "Variable", "value": "Summary"},
  {"op": "set", "target": "$dA1", "prop": "Value", "value": "ReadNotices.List.Current.WfProofNotice.Body", "_why": "(2) LOGIC consumer: the expression of the Assign"},

  {"op": "create", "parent": "$dig", "type": "IExecuteServerActionNode", "name": "Send", "as": "$call"},
  {"op": "set", "target": "$call", "prop": "Action", "value": "$send"},
  {"op": "set", "target": "$call/Body", "prop": "Value", "value": "ReadNotices.List.Current.WfProofNotice.Body", "_why": "(3) consumer by ARGUMENT"},

  {"op": "create", "parent": "$dig", "type": "IEndNode", "as": "$d9"},
  {"op": "link", "from": "$d0", "to": "$agg"},
  {"op": "link", "from": "$agg", "to": "$dAs"},
  {"op": "link", "from": "$dAs", "to": "$call"},
  {"op": "link", "from": "$call", "to": "$d9"},
  {"op": "layout", "target": "$dig"},

  {"op": "usages", "target": "$WfProofNotice.Body", "_why": "(4) tres consumidores reais: filtro, Assign e argumento"},

  {"op": "delete", "target": "$flt", "_why": "(5a) REMOVER: o filtro sai"},
  {"op": "set", "target": "$dA1", "prop": "Value", "value": "ReadNotices.List.Current.WfProofNotice.Title", "_why": "(5b) REPOINT: the Assign now reads Title, and the action keeps assigning the output"},
  {"op": "link", "from": "$dAs", "to": "$d9", "_why": "(5c) relink BEFORE deleting the node: the incoming connector counts as a consumer of the node"},
  {"op": "delete", "target": "$call"},
  {"op": "delete", "target": "$send", "_why": "(5d) the called action was left without callers; deleting it avoids an UnusedUserAction"},
  {"op": "layout", "target": "$dig"},

  {"op": "usages", "target": "$WfProofNotice.Body", "_why": "(6) the three authoring consumers are gone; what remains is the value of the sample record of the entity (IRecord/IRecordAttributeValue), which in ODC is NOT classified as derived (in the O11 lane the equivalent is called SampleRecord and is derived) - see the difference in the front A report"},
  {"op": "delete", "target": "$WfProofNotice.Body", "_why": "(7) without force: the three authoring consumers are gone, and the value of the sample record counts as derived use (the Studio cleans it by itself)"},

  {"op": "find", "name": "WfProof_Send", "_why": "(8) lista vazia"},
  {"op": "get", "target": "$WfProofNotice"},
  {"op": "dump", "target": "$dig", "depth": 4}
 ]
}
