{
 "description": "Front B (broad catalog): radio group with radio buttons, records table with header cells and row cells, and upload, in the ODC lane, over job:screen-form (entity WfCovTask). ODC equivalent of the corresponding part of tests/jobs/gallery-native-reactive.json, with the lane difference read in the ODC Model API of the NRWidgets plugin: IRadioGroup, IRadioButton, IHeaderCell and IRowCell keep the children in a Content (in O11 they stay directly in the widget), and HeaderRow/Row of the table are IContent. The `empty: true` of the O11 job is not used here: in ODC the IContent is an IMobileWidget and would be deleted along with the samples. A dump right after creating the radio group and the records table registers with which children they are born in the lane; the radio group is born with sample RadioButton1..3 without Value (measured in probe B-006 phase 1), which the job deletes by name before creating its own.",
 "base": "job:screen-form",
 "expectValid": true,
 "expectedMessages": [],
 "ops": [
  {"op": "create", "parent": "IMobileFlow:MainFlow", "type": "IMobileScreen", "name": "CatBChoiceTable", "as": "$scr", "_why": "1. the screen, the variables and the aggregate"},
  {"op": "set", "target": "$scr/#IMobileBlockInstanceWidget", "prop": "SourceBlock", "value": "IMobileBlock:LayoutTopMenu"},
  {"op": "create", "parent": "$scr/#IMobileBlockInstanceWidget/Title", "type": "IExpression", "as": "$title"},
  {"op": "set", "target": "$title", "prop": "Value", "value": "\"Choice and table\""},
  {"op": "create", "parent": "$scr", "type": "ILocalVariable", "name": "ChoiceVar", "as": "$vChoice"},
  {"op": "set", "target": "$vChoice", "prop": "DataType", "value": "Text"},
  {"op": "create", "parent": "$scr", "type": "ILocalVariable", "name": "FileContent", "as": "$vFile"},
  {"op": "set", "target": "$vFile", "prop": "DataType", "value": "Binary Data"},
  {"op": "create", "parent": "$scr", "type": "ILocalVariable", "name": "FileName", "as": "$vFileName"},
  {"op": "set", "target": "$vFileName", "prop": "DataType", "value": "Text"},
  {"op": "create", "parent": "$scr", "type": "IScreenAggregate", "name": "GetTasks", "as": "$agg"},
  {"op": "create", "parent": "$agg", "type": "IAliasedSource", "args": {"dataSource": "IServerEntity:WfCovTask"}},

  {"op": "create", "parent": "$scr/#IMobileBlockInstanceWidget/MainContent", "type": "IContainer", "name": "Choice", "as": "$c1", "_why": "2. radio group: the variable in the group, the value in each radio"},
  {"op": "set", "target": "$c1", "prop": "Style", "value": "\"padding-m\""},
  {"op": "create", "parent": "$c1", "type": "IRadioGroup", "name": "Choice_RadioGroup", "as": "$rg"},
  {"op": "set", "target": "$rg", "prop": "Variable", "value": "ChoiceVar"},
  {"op": "dump", "target": "$rg", "depth": 3, "_why": "with which children the radio group is born in ODC"},
  {"op": "delete", "target": "$rg/Content/RadioButton1", "_why": "the RadioGroup is born with sample RadioButton1..3 WITHOUT Value (probe B-006 phase 1: 3 RequiredPropertyValue_Property); they go out before those of the job"},
  {"op": "delete", "target": "$rg/Content/RadioButton2"},
  {"op": "delete", "target": "$rg/Content/RadioButton3"},
  {"op": "create", "parent": "$rg/Content", "type": "IRadioButton", "name": "OptionA", "as": "$ra"},
  {"op": "set", "target": "$ra", "prop": "Value", "value": "\"A\""},
  {"op": "create", "parent": "$ra/Content", "type": "IExpression", "as": "$raText"},
  {"op": "set", "target": "$raText", "prop": "Value", "value": "\"Option A\""},
  {"op": "create", "parent": "$rg/Content", "type": "IRadioButton", "name": "OptionB", "as": "$rb"},
  {"op": "set", "target": "$rb", "prop": "Value", "value": "\"B\""},
  {"op": "create", "parent": "$rb/Content", "type": "IExpression", "as": "$rbText"},
  {"op": "set", "target": "$rbText", "prop": "Value", "value": "\"Option B\""},
  {"op": "create", "parent": "$c1", "type": "IExpression", "as": "$echo"},
  {"op": "set", "target": "$echo", "prop": "Value", "value": "\"Chosen: \" + ChoiceVar"},

  {"op": "create", "parent": "$scr/#IMobileBlockInstanceWidget/MainContent", "type": "IContainer", "name": "Records", "as": "$c2", "_why": "3. records table: source, header cell and row cell"},
  {"op": "set", "target": "$c2", "prop": "Style", "value": "\"padding-m\""},
  {"op": "create", "parent": "$c2", "type": "ITableRecords", "name": "Tasks_Table", "as": "$tbl"},
  {"op": "set", "target": "$tbl", "prop": "Source", "value": "GetTasks.List"},
  {"op": "dump", "target": "$tbl", "depth": 3, "_why": "with which children the table is born in ODC"},
  {"op": "create", "parent": "$tbl/HeaderRow", "type": "IHeaderCell", "name": "TitleHeader", "as": "$h1"},
  {"op": "create", "parent": "$h1/Content", "type": "IExpression", "as": "$h1Text"},
  {"op": "set", "target": "$h1Text", "prop": "Value", "value": "\"Title\""},
  {"op": "create", "parent": "$tbl/Row", "type": "IRowCell", "name": "TitleCell", "as": "$r1"},
  {"op": "create", "parent": "$r1/Content", "type": "IExpression", "as": "$r1Text"},
  {"op": "set", "target": "$r1Text", "prop": "Value", "value": "GetTasks.List.Current.WfCovTask.Title"},

  {"op": "create", "parent": "$scr/#IMobileBlockInstanceWidget/MainContent", "type": "IContainer", "name": "Attachment", "as": "$c3", "_why": "4. upload: the content and the file name in two variables"},
  {"op": "set", "target": "$c3", "prop": "Style", "value": "\"padding-m\""},
  {"op": "create", "parent": "$c3", "type": "IUpload", "name": "Attachment_Upload", "as": "$up"},
  {"op": "set", "target": "$up", "prop": "FileContent", "value": "FileContent"},
  {"op": "set", "target": "$up", "prop": "FileName", "value": "FileName"},
  {"op": "create", "parent": "$c3", "type": "IExpression", "as": "$fileEcho"},
  {"op": "set", "target": "$fileEcho", "prop": "Value", "value": "FileName"},

  {"op": "get", "target": "$rg", "_why": "5. LER DE VOLTA"},
  {"op": "get", "target": "$ra"},
  {"op": "get", "target": "$tbl"},
  {"op": "get", "target": "$h1"},
  {"op": "get", "target": "$up"},
  {"op": "dump", "target": "$scr", "depth": 8}
 ]
}
