  {"op": "get", "target": "$script", "_why": "LER DE VOLTA: o corpo ainda declara window.WfRenFormatting"},
  {"op": "get", "target": "$js"},

  {"op": "rename", "target": "$ca", "name": "WfRen_TextToSlug", "_why": "7. a client action: a pergunta central da comparacao entre plataformas"},
  {"op": "get", "target": "$call", "_why": "o no consumidor passou a chamar-se WfRen_TextToSlug, como no O11"},
  {"op": "get", "target": "$saA1", "_why": "DIFERENCA DE PLATAFORMA: aqui a expressao passou a WfRen_TextToSlug.Slug sozinha; na faixa O11 o mesmo rename deixa 'WfRen_Slugify.Slug' e o Verify acusa ExpressionUnknownObject"},

  {"op": "rename", "target": "$caOut", "name": "SlugText", "_why": "8. o output da client action: no ODC vem com consumers 2 e expressionsRewritten 2"},
