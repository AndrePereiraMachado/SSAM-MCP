{
 "description": "ODC: rename LOGIC and read back the text that was left behind, the mirror of tests/jobs/rename-logic-propagation.json. Script, client action, server action, screen action, JavaScript node parameters and screen variable are renamed one by one, with a get after each. It serves to compare the two platforms on the question that matters: when the action is renamed, does the expression that reads the output of the consumer NODE (<Node>.<Output>) follow or not?",
 "base": "tests/fixtures/odc/insurance-reactive-r8.oml",
 "expectValid": true,
 "expectedMessages": [],
 "ops": [
  {"op": "create", "parent": "@espace", "type": "IScript", "name": "WfRenFormatting", "as": "$script", "_why": "1. the script: the global it declares is text inside the body"},
  {"op": "set", "target": "$script", "prop": "JavaScript", "value": "window.WfRenFormatting = { slug: function (s) { return String(s || \"\").toLowerCase().trim().replace(/[^a-z0-9]+/g, \"-\"); } };"},
  {"op": "set", "target": "$script", "prop": "Description", "value": "Helpers do WfRenFormatting"},

  {"op": "create", "parent": "@espace", "type": "IClientAction", "name": "WfRen_Slugify", "as": "$ca", "_why": "2. client action with a JavaScript node"},
  {"op": "set", "target": "$ca", "prop": "Function", "value": true},
  {"op": "create", "parent": "$ca", "type": "IInputParameter", "name": "Text", "as": "$caIn"},
  {"op": "set", "target": "$caIn", "prop": "DataType", "value": "Text"},
  {"op": "create", "parent": "$ca", "type": "IOutputParameter", "name": "Slug", "as": "$caOut"},
  {"op": "set", "target": "$caOut", "prop": "DataType", "value": "Text"},
  {"op": "create", "parent": "$ca", "type": "IStartNode", "as": "$c0"},
  {"op": "create", "parent": "$ca", "type": "IJavaScriptNode", "name": "MakeSlug", "as": "$js"},
  {"op": "create", "parent": "$js", "type": "IInputParameter", "name": "Text", "as": "$jsIn"},
  {"op": "set", "target": "$jsIn", "prop": "DataType", "value": "Text"},
  {"op": "create", "parent": "$js", "type": "IOutputParameter", "name": "Slug", "as": "$jsOut"},
  {"op": "set", "target": "$jsOut", "prop": "DataType", "value": "Text"},
  {"op": "set", "target": "$js", "prop": "JavaScript", "value": "$parameters.Slug = window.WfRenFormatting ? window.WfRenFormatting.slug($parameters.Text) : $parameters.Text;"},
  {"op": "set", "target": "$js/arg:Text", "prop": "Value", "value": "Text"},
  {"op": "create", "parent": "$ca", "type": "IAssignNode", "as": "$caAs"},
  {"op": "set", "target": "$caAs", "prop": "Label", "value": "SetOutput"},
  {"op": "create", "parent": "$caAs", "type": "IAssignment", "as": "$caA1"},
  {"op": "set", "target": "$caA1", "prop": "Variable", "value": "Slug"},
  {"op": "set", "target": "$caA1", "prop": "Value", "value": "MakeSlug.Slug"},
  {"op": "create", "parent": "$ca", "type": "IEndNode", "as": "$c9"},
  {"op": "link", "from": "$c0", "to": "$js"},
  {"op": "link", "from": "$js", "to": "$caAs"},
  {"op": "link", "from": "$caAs", "to": "$c9"},
  {"op": "layout", "target": "$ca"},

  {"op": "create", "parent": "@espace", "type": "IServerAction", "name": "WfRen_Slug_Save", "as": "$sv", "_why": "3. server action called by the screen"},
  {"op": "create", "parent": "$sv", "type": "IInputParameter", "name": "Slug", "as": "$svIn"},
  {"op": "set", "target": "$svIn", "prop": "DataType", "value": "Text"},
  {"op": "create", "parent": "$sv", "type": "IOutputParameter", "name": "Stored", "as": "$svOut"},
  {"op": "set", "target": "$svOut", "prop": "DataType", "value": "Text"},
  {"op": "create", "parent": "$sv", "type": "IStartNode", "as": "$v0"},
  {"op": "create", "parent": "$sv", "type": "IAssignNode", "as": "$vAs"},
  {"op": "set", "target": "$vAs", "prop": "Label", "value": "SetStored"},
  {"op": "create", "parent": "$vAs", "type": "IAssignment", "as": "$vA1"},
  {"op": "set", "target": "$vA1", "prop": "Variable", "value": "Stored"},
  {"op": "set", "target": "$vA1", "prop": "Value", "value": "\"WfRen_Slug_Save guardou: \" + Slug"},
  {"op": "create", "parent": "$sv", "type": "IEndNode", "as": "$v9"},
  {"op": "link", "from": "$v0", "to": "$vAs"},
  {"op": "link", "from": "$vAs", "to": "$v9"},
  {"op": "layout", "target": "$sv"},

  {"op": "create", "parent": "IMobileFlow:MainFlow", "type": "IMobileScreen", "name": "WfRenSlugDemo", "as": "$scr", "_why": "4. the consumer screen"},
  {"op": "set", "target": "$scr/#IMobileBlockInstanceWidget", "prop": "SourceBlock", "value": "IMobileBlock:LayoutTopMenu"},
  {"op": "link", "from": "$scr", "connector": "RequiredScripts", "to": "$script"},
  {"op": "create", "parent": "$scr/#IMobileBlockInstanceWidget/Title", "type": "IExpression", "as": "$title"},
  {"op": "set", "target": "$title", "prop": "Value", "value": "\"Slug demo\""},
  {"op": "create", "parent": "$scr", "type": "ILocalVariable", "name": "Title", "as": "$vT"},
  {"op": "set", "target": "$vT", "prop": "DataType", "value": "Text"},
  {"op": "create", "parent": "$scr", "type": "ILocalVariable", "name": "Slug", "as": "$vS"},
  {"op": "set", "target": "$vS", "prop": "DataType", "value": "Text"},
  {"op": "create", "parent": "$scr/#IMobileBlockInstanceWidget/MainContent", "type": "IInput", "name": "TitleInput", "as": "$in"},
  {"op": "set", "target": "$in", "prop": "Variable", "value": "Title"},
  {"op": "create", "parent": "$scr/#IMobileBlockInstanceWidget/MainContent", "type": "IExpression", "as": "$out"},
  {"op": "set", "target": "$out", "prop": "Value", "value": "\"Title: \" + Title + \" -> \" + Slug"},
  {"op": "create", "parent": "$scr/#IMobileBlockInstanceWidget/MainContent", "type": "IButton", "name": "SlugButton", "as": "$btn"},
  {"op": "set", "target": "$btn/#ITextWidget", "prop": "Text", "value": "Slugify o Title"},

  {"op": "create", "parent": "$scr", "type": "IScreenAction", "name": "OnSlugify", "as": "$sa"},
  {"op": "create", "parent": "$sa", "type": "IStartNode", "as": "$s0"},
  {"op": "create", "parent": "$sa", "type": "IExecuteClientActionNode", "name": "WfRen_Slugify", "as": "$call"},
  {"op": "set", "target": "$call", "prop": "Action", "value": "$ca"},
  {"op": "set", "target": "$call/Text", "prop": "Value", "value": "Title"},
  {"op": "create", "parent": "$sa", "type": "IAssignNode", "as": "$saAs"},
  {"op": "set", "target": "$saAs", "prop": "Label", "value": "SetSlug"},
  {"op": "create", "parent": "$saAs", "type": "IAssignment", "as": "$saA1"},
  {"op": "set", "target": "$saA1", "prop": "Variable", "value": "Slug"},
  {"op": "set", "target": "$saA1", "prop": "Value", "value": "WfRen_Slugify.Slug"},
  {"op": "create", "parent": "$sa", "type": "IExecuteServerActionNode", "name": "WfRen_Slug_Save", "as": "$svCall"},
  {"op": "set", "target": "$svCall", "prop": "Action", "value": "$sv"},
  {"op": "set", "target": "$svCall/Slug", "prop": "Value", "value": "Slug"},
  {"op": "create", "parent": "$sa", "type": "IEndNode", "as": "$s9"},
  {"op": "link", "from": "$s0", "to": "$call"},
  {"op": "link", "from": "$call", "to": "$saAs"},
  {"op": "link", "from": "$saAs", "to": "$svCall"},
  {"op": "link", "from": "$svCall", "to": "$s9"},
  {"op": "layout", "target": "$sa"},
  {"op": "set", "target": "$btn/OnClick", "prop": "Destination", "value": "$sa"},

  {"op": "usages", "target": "$script", "_why": "5. ANTES"},
  {"op": "usages", "target": "$ca"},

  {"op": "rename", "target": "$script", "name": "WfRenTextHelpers", "_why": "6. o script"},
  {"op": "get", "target": "$script", "_why": "READ BACK: the body still declares window.WfRenFormatting"},
  {"op": "get", "target": "$js"},

  {"op": "rename", "target": "$ca", "name": "WfRen_TextToSlug", "_why": "7. the client action: the central question of the comparison between platforms"},
  {"op": "get", "target": "$call", "_why": "the consumer node is now named WfRen_TextToSlug, as in O11"},
  {"op": "get", "target": "$saA1", "_why": "PLATFORM DIFFERENCE: here the expression became WfRen_TextToSlug.Slug on its own; in the O11 lane the same rename leaves 'WfRen_Slugify.Slug' and Verify reports ExpressionUnknownObject"},

  {"op": "rename", "target": "$caOut", "name": "SlugText", "_why": "8. the client action output: in ODC it comes with consumers 2 and expressionsRewritten 2"},
  {"op": "get", "target": "$saA1", "_why": "again with no manual fix: WfRen_TextToSlug.SlugText"},

  {"op": "rename", "target": "$jsIn", "name": "Term", "_why": "9. JavaScript node parameters: the JavaScript body is rewritten ($parameters.Text -> $parameters.Term), same as O11"},
  {"op": "rename", "target": "$jsOut", "name": "Handle"},
  {"op": "get", "target": "$js", "_why": "the body already says $parameters.Handle and $parameters.Term; only the global window.WfRenFormatting (old name of the Script) remained"},
  {"op": "get", "target": "$caA1", "_why": "and here, unlike O11, the expression MakeSlug.Slug has already been rewritten to MakeSlug.Handle"},
  {"op": "set", "target": "$js", "prop": "JavaScript", "value": "$parameters.Handle = window.WfRenTextHelpers ? window.WfRenTextHelpers.slug($parameters.Term) : $parameters.Term;", "_why": "conserto A MAO do unico resto: o global do script"},
  {"op": "set", "target": "$script", "prop": "JavaScript", "value": "window.WfRenTextHelpers = { slug: function (s) { return String(s || \"\").toLowerCase().trim().replace(/[^a-z0-9]+/g, \"-\"); } };"},
  {"op": "get", "target": "$js"},

  {"op": "rename", "target": "$sv", "name": "WfRen_Slug_Persist", "_why": "10. a server action"},
  {"op": "get", "target": "$svCall"},
  {"op": "get", "target": "$vA1"},

  {"op": "rename", "target": "$sa", "name": "WfRen_Slugify_Click", "_why": "11. a screen action"},
  {"op": "get", "target": "$btn/OnClick"},
  {"op": "get", "target": "$btn/#ITextWidget"},

  {"op": "rename", "target": "$vT", "name": "SourceText", "_why": "12. the screen variable"},
  {"op": "get", "target": "$out"},

  {"op": "dump", "target": "$scr", "depth": 6},
  {"op": "dump", "target": "$ca", "depth": 4}
 ]
}
