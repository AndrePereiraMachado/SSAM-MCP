{
 "description": "ODC: TWO instances of the SAME block on the SAME screen, with different handlers, linked through the VISUAL authoring of section 3.5 - two `<Block name=\"WfRatingPicker\" @OnRate=\"...\">` in the same fragment, each with its own handler. It proves the difference between the two ways of linking the same event: in visual authoring the link is by NAME (each event parameter goes into the handler input of the same name, so WfStayRated and WfCleaningRated MUST declare Rating and Comment), whereas in the native `set` the argument is an EXPRESSION and can remap - the third instance, WfRemapPicker, created by hand, sends 'Rating * 10' to an input called Score and 'Comment + \" / \" + StayComment' to one called Label, mixing the event scope with the screen's. The three instances, the same contract: the `usages` of the event closes with 3 IEventHandler + 1 ITriggerNode. ODC equivalent of tests/jobs/block-events-two-instances-reactive.json; the single instance is in tests/jobs-odc/block-events.json.",
 "base": "tests/fixtures/odc/insurance-reactive-r8.oml",
 "expectValid": true,
 "expectedMessages": [],
 "ops": [
  {"op": "create", "parent": "IMobileFlow:MainFlow", "type": "IMobileBlock", "name": "WfRatingPicker", "as": "$blk", "_why": "1. the producer block, a single one for the three instances"},
  {"op": "create", "parent": "$blk", "type": "IInputParameter", "name": "Caption", "as": "$blkIn"},
  {"op": "set", "target": "$blkIn", "prop": "DataType", "value": "Text"},
  {"op": "create", "parent": "$blk", "type": "ILocalVariable", "name": "Score", "as": "$score"},
  {"op": "set", "target": "$score", "prop": "DataType", "value": "Integer"},

  {"op": "create", "parent": "$blk", "type": "IBlockEvent", "name": "OnRate", "as": "$ev", "_why": "2. contract: mandatory, so that each of the three instances has to link a handler"},
  {"op": "set", "target": "$ev", "prop": "Description", "value": "Disparado quando o utilizador escolhe uma nota no bloco"},
  {"op": "set", "target": "$ev", "prop": "IsMandatory", "value": true},
  {"op": "create", "parent": "$ev", "type": "IInputParameter", "name": "Rating", "as": "$evRating"},
  {"op": "set", "target": "$evRating", "prop": "DataType", "value": "Integer"},
  {"op": "create", "parent": "$ev", "type": "IInputParameter", "name": "Comment", "as": "$evComment"},
  {"op": "set", "target": "$evComment", "prop": "DataType", "value": "Text"},

  {"op": "create", "parent": "$blk", "type": "IContainer", "name": "Body", "as": "$body"},
  {"op": "create", "parent": "$body", "type": "IExpression", "as": "$capt"},
  {"op": "set", "target": "$capt", "prop": "Value", "value": "Caption"},
  {"op": "create", "parent": "$body", "type": "IButton", "name": "RateButton", "as": "$btn"},
  {"op": "set", "target": "$btn/#ITextWidget", "prop": "Text", "value": "Rate"},

  {"op": "create", "parent": "$blk", "type": "IScreenAction", "name": "Rate", "as": "$rate", "_why": "3. um unico disparo serve as tres instancias"},
  {"op": "create", "parent": "$rate", "type": "IStartNode", "as": "$r0"},
  {"op": "create", "parent": "$rate", "type": "IAssignNode", "as": "$rAssign"},
  {"op": "set", "target": "$rAssign", "prop": "Label", "value": "BumpScore"},
  {"op": "create", "parent": "$rAssign", "type": "IAssignment", "as": "$rA1"},
  {"op": "set", "target": "$rA1", "prop": "Variable", "value": "Score"},
  {"op": "set", "target": "$rA1", "prop": "Value", "value": "Score + 1"},
  {"op": "create", "parent": "$rate", "type": "ITriggerNode", "name": "RaiseOnRate", "as": "$trg"},
  {"op": "set", "target": "$trg", "prop": "Event", "value": "$ev"},
  {"op": "set", "target": "$trg/Rating", "prop": "Value", "value": "Score"},
  {"op": "set", "target": "$trg/Comment", "prop": "Value", "value": "\"nota dada em \" + Caption"},
  {"op": "create", "parent": "$rate", "type": "IEndNode", "as": "$r9"},
  {"op": "link", "from": "$r0", "to": "$rAssign"},
  {"op": "link", "from": "$rAssign", "to": "$trg"},
  {"op": "link", "from": "$trg", "to": "$r9"},
  {"op": "layout", "target": "$rate"},
  {"op": "set", "target": "$btn/OnClick", "prop": "Destination", "value": "$rate"},

  {"op": "create", "parent": "IMobileFlow:MainFlow", "type": "IMobileScreen", "name": "WfRatingBoard", "as": "$scr", "_why": "4. the screen that instantiates the block three times"},
  {"op": "set", "target": "$scr/#IMobileBlockInstanceWidget", "prop": "SourceBlock", "value": "IMobileBlock:LayoutTopMenu"},
  {"op": "create", "parent": "$scr/#IMobileBlockInstanceWidget/Title", "type": "IExpression", "as": "$title"},
  {"op": "set", "target": "$title", "prop": "Value", "value": "\"Avaliacoes\""},

  {"op": "create", "parent": "$scr", "type": "ILocalVariable", "name": "StayRating", "as": "$v1"},
  {"op": "set", "target": "$v1", "prop": "DataType", "value": "Integer"},
  {"op": "create", "parent": "$scr", "type": "ILocalVariable", "name": "StayComment", "as": "$v2"},
  {"op": "set", "target": "$v2", "prop": "DataType", "value": "Text"},
  {"op": "create", "parent": "$scr", "type": "ILocalVariable", "name": "CleaningRating", "as": "$v3"},
  {"op": "set", "target": "$v3", "prop": "DataType", "value": "Integer"},
  {"op": "create", "parent": "$scr", "type": "ILocalVariable", "name": "CleaningComment", "as": "$v4"},
  {"op": "set", "target": "$v4", "prop": "DataType", "value": "Text"},
  {"op": "create", "parent": "$scr", "type": "ILocalVariable", "name": "RemapLabel", "as": "$v5"},
  {"op": "set", "target": "$v5", "prop": "DataType", "value": "Text"},
  {"op": "create", "parent": "$scr", "type": "ILocalVariable", "name": "RemapScore", "as": "$v6"},
  {"op": "set", "target": "$v6", "prop": "DataType", "value": "Integer"},

  {"op": "create", "parent": "$scr", "type": "IScreenAction", "name": "WfStayRated", "as": "$hA", "_why": "5. handler of the FIRST instance; in visual authoring the inputs MUST be called Rating and Comment"},
  {"op": "create", "parent": "$hA", "type": "IInputParameter", "name": "Rating", "as": "$hA1"},
  {"op": "set", "target": "$hA1", "prop": "DataType", "value": "Integer"},
  {"op": "create", "parent": "$hA", "type": "IInputParameter", "name": "Comment", "as": "$hA2"},
  {"op": "set", "target": "$hA2", "prop": "DataType", "value": "Text"},
  {"op": "create", "parent": "$hA", "type": "IStartNode", "as": "$hA0"},
  {"op": "create", "parent": "$hA", "type": "IAssignNode", "as": "$hAAs"},
  {"op": "set", "target": "$hAAs", "prop": "Label", "value": "KeepStay"},
  {"op": "create", "parent": "$hAAs", "type": "IAssignment", "as": "$hAa1"},
  {"op": "set", "target": "$hAa1", "prop": "Variable", "value": "StayRating"},
  {"op": "set", "target": "$hAa1", "prop": "Value", "value": "Rating"},
  {"op": "create", "parent": "$hAAs", "type": "IAssignment", "as": "$hAa2"},
  {"op": "set", "target": "$hAa2", "prop": "Variable", "value": "StayComment"},
  {"op": "set", "target": "$hAa2", "prop": "Value", "value": "Comment"},
  {"op": "create", "parent": "$hA", "type": "IEndNode", "as": "$hA9"},
  {"op": "link", "from": "$hA0", "to": "$hAAs"},
  {"op": "link", "from": "$hAAs", "to": "$hA9"},
  {"op": "layout", "target": "$hA"},

  {"op": "create", "parent": "$scr", "type": "IScreenAction", "name": "WfCleaningRated", "as": "$hB", "_why": "6. DIFFERENT handler for the SECOND instance of the same block"},
  {"op": "create", "parent": "$hB", "type": "IInputParameter", "name": "Rating", "as": "$hB1"},
  {"op": "set", "target": "$hB1", "prop": "DataType", "value": "Integer"},
  {"op": "create", "parent": "$hB", "type": "IInputParameter", "name": "Comment", "as": "$hB2"},
  {"op": "set", "target": "$hB2", "prop": "DataType", "value": "Text"},
  {"op": "create", "parent": "$hB", "type": "IStartNode", "as": "$hB0"},
  {"op": "create", "parent": "$hB", "type": "IAssignNode", "as": "$hBAs"},
  {"op": "set", "target": "$hBAs", "prop": "Label", "value": "KeepCleaning"},
  {"op": "create", "parent": "$hBAs", "type": "IAssignment", "as": "$hBa1"},
  {"op": "set", "target": "$hBa1", "prop": "Variable", "value": "CleaningRating"},
  {"op": "set", "target": "$hBa1", "prop": "Value", "value": "Rating"},
  {"op": "create", "parent": "$hBAs", "type": "IAssignment", "as": "$hBa2"},
  {"op": "set", "target": "$hBa2", "prop": "Variable", "value": "CleaningComment"},
  {"op": "set", "target": "$hBa2", "prop": "Value", "value": "Comment"},
  {"op": "create", "parent": "$hB", "type": "IEndNode", "as": "$hB9"},
  {"op": "link", "from": "$hB0", "to": "$hBAs"},
  {"op": "link", "from": "$hBAs", "to": "$hB9"},
  {"op": "layout", "target": "$hB"},

  {"op": "create", "parent": "$scr", "type": "IScreenAction", "name": "WfRemapRated", "as": "$hC", "_why": "7. handler of the THIRD instance, with names OUTSIDE the contract: only the native form can link it"},
  {"op": "create", "parent": "$hC", "type": "IInputParameter", "name": "Score", "as": "$hC1"},
  {"op": "set", "target": "$hC1", "prop": "DataType", "value": "Integer"},
  {"op": "create", "parent": "$hC", "type": "IInputParameter", "name": "Label", "as": "$hC2"},
  {"op": "set", "target": "$hC2", "prop": "DataType", "value": "Text"},
  {"op": "create", "parent": "$hC", "type": "IStartNode", "as": "$hC0"},
  {"op": "create", "parent": "$hC", "type": "IAssignNode", "as": "$hCAs"},
  {"op": "set", "target": "$hCAs", "prop": "Label", "value": "KeepRemap"},
  {"op": "create", "parent": "$hCAs", "type": "IAssignment", "as": "$hCa1"},
  {"op": "set", "target": "$hCa1", "prop": "Variable", "value": "RemapScore"},
  {"op": "set", "target": "$hCa1", "prop": "Value", "value": "Score"},
  {"op": "create", "parent": "$hCAs", "type": "IAssignment", "as": "$hCa2"},
  {"op": "set", "target": "$hCa2", "prop": "Variable", "value": "RemapLabel"},
  {"op": "set", "target": "$hCa2", "prop": "Value", "value": "Label"},
  {"op": "create", "parent": "$hC", "type": "IEndNode", "as": "$hC9"},
  {"op": "link", "from": "$hC0", "to": "$hCAs"},
  {"op": "link", "from": "$hCAs", "to": "$hC9"},
  {"op": "layout", "target": "$hC"},

  {"op": "html", "parent": "$scr/#IMobileBlockInstanceWidget/MainContent", "file": "tests/html/visual/block-event-two.html", "_why": "8. the FIRST TWO instances in a single fragment: same `name`, different `@OnRate` in each"},

  {"op": "create", "parent": "$scr/#IMobileBlockInstanceWidget/MainContent", "type": "IMobileBlockInstanceWidget", "name": "WfRemapPicker", "as": "$i3", "source": "IMobileBlock:WfRatingPicker", "_why": "9. the third, by hand, to show what the fragment does not express"},
  {"op": "set", "target": "$i3/Caption", "prop": "Value", "value": "\"E o pequeno-almoco?\""},
  {"op": "set", "target": "$i3/OnRate", "prop": "Handler", "value": "$hC"},
  {"op": "set", "target": "$i3/OnRate/Score", "prop": "Value", "value": "Rating * 10", "_why": "the argument is an EXPRESSION, not a name: the event's Rating parameter goes into an input called Score"},
  {"op": "set", "target": "$i3/OnRate/Label", "prop": "Value", "value": "Comment + \" / \" + StayComment", "_why": "the scope adds up: Comment is the event's, StayComment is the screen's"},

  {"op": "create", "parent": "$scr/#IMobileBlockInstanceWidget/MainContent", "type": "IExpression", "as": "$echo3"},
  {"op": "set", "target": "$echo3", "prop": "Value", "value": "\"Pequeno-almoco: \" + IntegerToText(RemapScore) + \" (\" + RemapLabel + \")\""},

  {"op": "get", "target": "$ev"},
  {"op": "get", "target": "$scr/#IMobileBlockInstanceWidget/MainContent/RatingBoard/**IMobileBlockInstanceWidget[1]", "_why": "the instance StayPicker was born from the fragment with the name from the id (the `**` searches breadth-first: without the RatingBoard it would fall on the native instance, which is a direct child)"},
  {"op": "get", "target": "$scr/#IMobileBlockInstanceWidget/MainContent/RatingBoard/**IEventHandler[1]", "_why": "handler da 1a instancia do fragmento"},
  {"op": "get", "target": "$scr/#IMobileBlockInstanceWidget/MainContent/RatingBoard/**IEventHandler[2]", "_why": "handler of the 2nd: ANOTHER Handler key, same Event"},
  {"op": "get", "target": "$i3/#IEventHandler", "_why": "the native handler, with the third action"},
  {"op": "usages", "target": "$ev", "_why": "3 IEventHandler (dois do fragmento, um nativo) + 1 ITriggerNode"},
  {"op": "usages", "target": "$hA", "_why": "each handler serves ONE instance"},
  {"op": "usages", "target": "$hB"},
  {"op": "usages", "target": "$hC"},
  {"op": "dump", "target": "$scr", "depth": 8}
 ]
}
