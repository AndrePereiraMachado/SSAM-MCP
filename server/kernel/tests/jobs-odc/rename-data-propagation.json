{
 "description": "ODC: rename DATA and read back what was left behind, the mirror of tests/jobs/rename-data-propagation.json. The entity WfRenNotice becomes WfRenAlert, the attribute Body becomes Message and a local variable is also renamed; the job reads with get/dump, AFTER each rename, the Description and the Label (author text), the index name, the literal of the Assign, the Statement of the SQL and the expressions of the screen. First rename job of the ODC lane.",
 "base": "tests/fixtures/odc/insurance-reactive-r8.oml",
 "expectValid": true,
 "expectedMessages": [{"id": "UnusedUserAction", "element": "InsuranceApp (ESpace) / WfRen_Report (ServerAction)", "why": "ODC: an app (CrossDevice) does not expose a public server action (the live Studio gives an error); the action stays private and without a consumer in this proof job"}],
 "ops": [
  {"op": "spec", "data": {
   "entities": [
    {"name": "WfRenNotice", "public": true, "attributes": [
     {"name": "Title", "type": "Text", "mandatory": true, "length": 100},
     {"name": "Body", "type": "Text", "length": 500}
    ]}
   ]
  }},
  {"op": "set", "target": "$WfRenNotice", "prop": "Description", "value": "Avisos. O texto vive em WfRenNotice.Body.", "_why": "1. author text: description and label cite the old name"},
  {"op": "set", "target": "$WfRenNotice.Body", "prop": "Description", "value": "Corpo do WfRenNotice, mostrado no ecra WfRenNotices."},
  {"op": "set", "target": "$WfRenNotice.Body", "prop": "Label", "value": "Body do Notice"},

  {"op": "create", "parent": "$WfRenNotice", "type": "EntityIndex", "name": "IX_WfRenNotice_Title", "args": {"unique": false, "attributes": ["$WfRenNotice.Title"]}, "_why": "2. the index: the Entity is a reference (follows), the index NAME is text (does not follow)"},

  {"op": "create", "parent": "@espace", "type": "IServerAction", "name": "WfRen_Report", "as": "$rep", "_why": "3. logic consumer: SQL over the entity, text literal and local variable"},
  {"op": "create", "parent": "$rep", "type": "IOutputParameter", "name": "Rows", "as": "$repRows"},
  {"op": "set", "target": "$repRows", "prop": "DataType", "value": "WfRenNotice List"},
  {"op": "create", "parent": "$rep", "type": "IOutputParameter", "name": "Label", "as": "$repLabel"},
  {"op": "set", "target": "$repLabel", "prop": "DataType", "value": "Text"},
  {"op": "create", "parent": "$rep", "type": "ILocalVariable", "name": "NoticeLabel", "as": "$var"},
  {"op": "set", "target": "$var", "prop": "DataType", "value": "Text"},
  {"op": "create", "parent": "$rep", "type": "IStartNode", "as": "$r0"},
  {"op": "create", "parent": "$rep", "type": "ISQLNode", "name": "ReadNotices", "as": "$sql"},
  {"op": "set", "target": "$sql", "prop": "Statement", "value": "SELECT {WfRenNotice}.* FROM {WfRenNotice} WHERE {WfRenNotice}.[Body] <> @Empty"},
  {"op": "create", "parent": "$sql", "type": "ISQLInputParameter", "name": "Empty", "as": "$sqlIn"},
  {"op": "set", "target": "$sqlIn", "prop": "DataType", "value": "Text"},
  {"op": "create", "parent": "$sql", "type": "ISQLOutput", "name": "List", "args": {"entityOrStructure": "WfRenNotice"}, "as": "$sqlOut"},
  {"op": "set", "target": "$sql/arg:Empty", "prop": "Value", "value": "\"\""},
  {"op": "create", "parent": "$rep", "type": "IAssignNode", "as": "$asg"},
  {"op": "set", "target": "$asg", "prop": "Label", "value": "SetOutputs"},
  {"op": "create", "parent": "$asg", "type": "IAssignment", "as": "$a1"},
  {"op": "set", "target": "$a1", "prop": "Variable", "value": "Rows"},
  {"op": "set", "target": "$a1", "prop": "Value", "value": "ReadNotices.List"},
  {"op": "create", "parent": "$asg", "type": "IAssignment", "as": "$a2"},
  {"op": "set", "target": "$a2", "prop": "Variable", "value": "NoticeLabel"},
  {"op": "set", "target": "$a2", "prop": "Value", "value": "\"WfRenNotice sem Body\""},
  {"op": "create", "parent": "$asg", "type": "IAssignment", "as": "$a3"},
  {"op": "set", "target": "$a3", "prop": "Variable", "value": "Label"},
  {"op": "set", "target": "$a3", "prop": "Value", "value": "NoticeLabel"},
  {"op": "create", "parent": "$rep", "type": "IEndNode", "as": "$r9"},
  {"op": "link", "from": "$r0", "to": "$sql"},
  {"op": "link", "from": "$sql", "to": "$asg"},
  {"op": "link", "from": "$asg", "to": "$r9"},
  {"op": "layout", "target": "$rep"},

  {"op": "create", "parent": "IMobileFlow:MainFlow", "type": "IMobileScreen", "name": "WfRenNotices", "as": "$scr", "_why": "4. interface consumer: aggregate and expression that cite entity and attribute"},
  {"op": "set", "target": "$scr/#IMobileBlockInstanceWidget", "prop": "SourceBlock", "value": "IMobileBlock:LayoutTopMenu"},
  {"op": "create", "parent": "$scr/#IMobileBlockInstanceWidget/Title", "type": "IExpression", "as": "$title"},
  {"op": "set", "target": "$title", "prop": "Value", "value": "\"Notices\""},
  {"op": "create", "parent": "$scr", "type": "IScreenAggregate", "name": "GetNoticesForList", "as": "$agg"},
  {"op": "create", "parent": "$agg", "type": "IAliasedSource", "args": {"dataSource": "$WfRenNotice"}},
  {"op": "create", "parent": "$agg", "type": "IFilter", "args": {"condition": "WfRenNotice.Body <> \"\""}},
  {"op": "create", "parent": "$scr/#IMobileBlockInstanceWidget/MainContent", "type": "IExpression", "as": "$ex"},
  {"op": "set", "target": "$ex", "prop": "Value", "value": "GetNoticesForList.List.Current.WfRenNotice.Body"},

  {"op": "usages", "target": "$WfRenNotice", "max": 30, "_why": "5. BEFORE: who uses the entity and the attribute"},
  {"op": "usages", "target": "$WfRenNotice.Body"},

  {"op": "rename", "target": "$WfRenNotice", "name": "WfRenAlert", "_why": "6. the rename of the entity"},
  {"op": "get", "target": "$WfRenNotice", "_why": "READ BACK: the Description still says WfRenNotice.Body"},
  {"op": "get", "target": "EntityIndex:IX_WfRenNotice_Title", "_why": "the index keeps the old name; the Entity followed"},
  {"op": "get", "target": "$sql", "_why": "the Statement of the SQL was regenerated"},
  {"op": "get", "target": "$a2", "_why": "the literal did not change"},
  {"op": "usages", "target": "$WfRenNotice", "max": 30},

  {"op": "rename", "target": "$WfRenNotice.Body", "name": "Message", "_why": "7. o rename do atributo"},
  {"op": "get", "target": "$WfRenNotice.Body", "_why": "LER DE VOLTA: Description e Label do atributo continuam a dizer Body/Notice"},
  {"op": "get", "target": "$sql"},
  {"op": "get", "target": "$ex", "_why": "the expression of the screen was rewritten in both parts"},
  {"op": "usages", "target": "$WfRenNotice.Body"},

  {"op": "rename", "target": "$var", "name": "AlertLabel", "_why": "8. o rename da variavel local"},
  {"op": "get", "target": "$a3"},
  {"op": "get", "target": "$a2"},

  {"op": "dump", "target": "$scr", "depth": 5},
  {"op": "dump", "target": "$rep", "depth": 4}
 ]
}
