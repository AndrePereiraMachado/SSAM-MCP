{
 "description": "DropdownServerSide of OSUI: a search in the balloon bound to SearchText with Refresh Data, one DropdownServerSideItem per row of the List and OnSelected saving the chosen item.",
 "base": "tests/fixtures/odc/insurance-reactive-r8.oml",
 "expectValid": true,
 "expectedMessages": [],
 "ops": [
  {"op": "spec", "data": {"static": [{"name": "Category", "records": [{"name": "Books"}, {"name": "Games"}, {"name": "Music"}]}]}},
  {"op": "create", "parent": "IMobileFlow:MainFlow", "type": "IMobileScreen", "name": "ServerSideCategory", "as": "$scr"},
  {"op": "set", "target": "$scr/#IMobileBlockInstanceWidget", "prop": "SourceBlock", "value": "IMobileBlock:LayoutTopMenu"},
  {"op": "create", "parent": "$scr/#IMobileBlockInstanceWidget/Title", "type": "IExpression", "as": "$title"},
  {"op": "set", "target": "$title", "prop": "Value", "value": "\"Category\""},
  {"op": "create", "parent": "$scr", "type": "ILocalVariable", "name": "SearchText", "as": "$vSearchText"},
  {"op": "set", "target": "$vSearchText", "prop": "DataType", "value": "Text"},
  {"op": "create", "parent": "$scr", "type": "ILocalVariable", "name": "ChosenLabel", "as": "$vChosenLabel"},
  {"op": "set", "target": "$vChosenLabel", "prop": "DataType", "value": "Text"},
  {"op": "create", "parent": "$scr", "type": "IScreenAggregate", "name": "LoadCategories", "as": "$LoadCategories"},
  {"op": "create", "parent": "$LoadCategories", "type": "IAliasedSource", "args": {"dataSource": "IStaticEntity:Category"}},
  {"op": "create", "parent": "$LoadCategories", "type": "IFilter", "args": {"condition": "Category.Label like \"%\" + SearchText + \"%\""}},
  {"op": "logic", "data": {"actions": [{"name": "SearchChanged", "kind": "screen", "owner": "IMobileScreen:ServerSideCategory", "steps": [{"node": "IRefreshDataNode", "as": "Reload", "properties": {"DataSource": "IMobileScreen:ServerSideCategory/LoadCategories"}}]}]}},
  {"op": "logic", "data": {"actions": [{"name": "ItemSelected", "kind": "screen", "owner": "IMobileScreen:ServerSideCategory", "inputs": [{"name": "Label", "type": "Text"}], "steps": [{"assign": {"ChosenLabel": "Label"}, "as": "Keep"}]}]}},
  {"op": "create", "parent": "$scr/#IMobileBlockInstanceWidget/MainContent", "type": "IMobileBlockInstanceWidget", "name": "DropdownServerSide1", "source": "IMobileBlock:DropdownServerSide", "empty": true, "as": "$ds"},
  {"op": "set", "target": "$ds/AllowMultipleSelection", "prop": "Value", "value": "False"},
  {"op": "create", "parent": "$ds/BalloonSearchInput", "type": "IInput", "name": "SearchInput", "as": "$in"},
  {"op": "set", "target": "$in", "prop": "Variable", "value": "SearchText"},
  {"op": "set", "target": "$in/OnChange", "prop": "Destination", "value": "IMobileScreen:ServerSideCategory/SearchChanged"},
  {"op": "create", "parent": "$ds/BalloonContent", "type": "IList", "name": "CategoryList", "as": "$list"},
  {"op": "set", "target": "$list", "prop": "Source", "value": "LoadCategories.List"},
  {"op": "create", "parent": "$list", "type": "IMobileBlockInstanceWidget", "name": "CategoryItem", "source": "IMobileBlock:DropdownServerSideItem", "empty": true, "as": "$item", "_why": "the sample content of the item cites a GetData the app does not have"},
  {"op": "set", "target": "$item/ItemId", "prop": "Value", "value": "IntegerToText(LoadCategories.List.Current.Category.Id)"},
  {"op": "set", "target": "$item/IsSelected", "prop": "Value", "value": "LoadCategories.List.Current.Category.Label = ChosenLabel"},
  {"op": "set", "target": "$item/OnSelected", "prop": "Handler", "value": "IMobileScreen:ServerSideCategory/ItemSelected"},
  {"op": "set", "target": "$item/OnSelected/Label", "prop": "Value", "value": "LoadCategories.List.Current.Category.Label"},
  {"op": "create", "parent": "$item/DropdownItemContent", "type": "IExpression", "as": "$expr1"},
  {"op": "set", "target": "$expr1", "prop": "Value", "value": "LoadCategories.List.Current.Category.Label"},
  {"op": "create", "parent": "$ds/SelectedValues", "type": "IExpression", "as": "$expr2"},
  {"op": "set", "target": "$expr2", "prop": "Value", "value": "If(ChosenLabel = \"\", \"Pick a category\", ChosenLabel)"}
 ]
}
