{
 "description": "Tabs do OSUI com duas abas: titulo em cada TabsHeaderItem, conteudo ligado a dados em cada TabsContentItem e OnTabChange guardando a aba ativa.",
 "base": "tests/fixtures/odc/insurance-reactive-r8.oml",
 "expectValid": true,
 "expectedMessages": [],
 "ops": [
  {"op": "spec", "data": {"entities": [{"name": "Product", "attributes": [{"name": "Name", "type": "Text", "length": 100, "mandatory": true}, {"name": "Price", "type": "Currency"}, {"name": "ImageUrl", "type": "Text", "length": 500}]}]}},
  {"op": "create", "parent": "IMobileFlow:MainFlow", "type": "IMobileScreen", "name": "ProductTabs", "as": "$scr"},
  {"op": "set", "target": "$scr/#IMobileBlockInstanceWidget", "prop": "SourceBlock", "value": "IMobileBlock:LayoutTopMenu"},
  {"op": "create", "parent": "$scr/#IMobileBlockInstanceWidget/Title", "type": "IExpression", "as": "$title"},
  {"op": "set", "target": "$title", "prop": "Value", "value": "\"Product\""},
  {"op": "create", "parent": "$scr", "type": "IScreenAggregate", "name": "GetProducts", "as": "$GetProducts"},
  {"op": "create", "parent": "$GetProducts", "type": "IAliasedSource", "args": {"dataSource": "IServerEntity:Product"}},
  {"op": "create", "parent": "$scr", "type": "ILocalVariable", "name": "ActiveTab", "as": "$vActiveTab"},
  {"op": "set", "target": "$vActiveTab", "prop": "DataType", "value": "Integer"},
  {"op": "set", "target": "$vActiveTab", "prop": "DefaultValue", "value": "0"},
  {"op": "logic", "data": {"actions": [{"name": "TabChanged", "kind": "screen", "owner": "IMobileScreen:ProductTabs", "inputs": [{"name": "NewTab", "type": "Integer"}], "steps": [{"assign": {"ActiveTab": "NewTab"}, "as": "Remember"}]}]}},
  {"op": "create", "parent": "$scr/#IMobileBlockInstanceWidget/MainContent", "type": "IMobileBlockInstanceWidget", "name": "Tabs1", "source": "IMobileBlock:Tabs", "empty": true, "as": "$tabs", "_why": "empty tira as tres abas de exemplo; o job cria as suas"},
  {"op": "set", "target": "$tabs/StartingTab", "prop": "Value", "value": "ActiveTab"},
  {"op": "create", "parent": "$tabs/Header", "type": "IMobileBlockInstanceWidget", "name": "OverviewHeader", "source": "IMobileBlock:TabsHeaderItem", "as": "$h1"},
  {"op": "create", "parent": "$h1/Title", "type": "ITextWidget", "as": "$text1"},
  {"op": "set", "target": "$text1", "prop": "Text", "value": "Overview"},
  {"op": "create", "parent": "$tabs/Header", "type": "IMobileBlockInstanceWidget", "name": "PricesHeader", "source": "IMobileBlock:TabsHeaderItem", "as": "$h2"},
  {"op": "create", "parent": "$h2/Title", "type": "ITextWidget", "as": "$text2"},
  {"op": "set", "target": "$text2", "prop": "Text", "value": "Prices"},
  {"op": "create", "parent": "$tabs/Content", "type": "IMobileBlockInstanceWidget", "name": "OverviewContent", "source": "IMobileBlock:TabsContentItem", "as": "$c1"},
  {"op": "create", "parent": "$c1/Content", "type": "IExpression", "as": "$expr1"},
  {"op": "set", "target": "$expr1", "prop": "Value", "value": "\"Products: \" + GetProducts.Count"},
  {"op": "create", "parent": "$tabs/Content", "type": "IMobileBlockInstanceWidget", "name": "PricesContent", "source": "IMobileBlock:TabsContentItem", "as": "$c2"},
  {"op": "create", "parent": "$c2/Content", "type": "IExpression", "as": "$expr2"},
  {"op": "set", "target": "$expr2", "prop": "Value", "value": "If(GetProducts.List.Empty, \"\", FormatCurrency(GetProducts.List[0].Product.Price, \"$\", 2, \".\", \",\"))"},
  {"op": "set", "target": "$tabs/OnTabChange", "prop": "Handler", "value": "IMobileScreen:ProductTabs/TabChanged", "_why": "o input do handler (NewTab) recebe o parametro ActiveTab do evento"},
  {"op": "set", "target": "$tabs/OnTabChange/NewTab", "prop": "Value", "value": "ActiveTab"}
 ]
}
