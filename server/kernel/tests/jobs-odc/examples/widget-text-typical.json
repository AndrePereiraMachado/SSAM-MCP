{
 "description": "Captions: the text of a Button, a Link and a Label lives in the child ITextWidget of each (#ITextWidget); changing the caption is a set of Text on it.",
 "base": "tests/fixtures/odc/insurance-reactive-r8.oml",
 "expectValid": true,
 "expectedMessages": [],
 "ops": [
  {"op": "create", "parent": "IMobileFlow:MainFlow", "type": "IMobileScreen", "name": "CaptionDemo", "as": "$scr"},
  {"op": "set", "target": "$scr/#IMobileBlockInstanceWidget", "prop": "SourceBlock", "value": "IMobileBlock:LayoutTopMenu"},
  {"op": "create", "parent": "$scr", "type": "ILocalVariable", "name": "Email", "as": "$email"},
  {"op": "set", "target": "$email", "prop": "DataType", "value": "Email"},
  {"op": "create", "parent": "$scr/#IMobileBlockInstanceWidget/MainContent", "type": "ILabel", "name": "EmailLabel", "as": "$lbl"},
  {"op": "set", "target": "$lbl/#ITextWidget", "prop": "Text", "value": "E-mail", "_why": "the Label is born with 'label': the caption is the ITextWidget inside it"},
  {"op": "create", "parent": "$scr/#IMobileBlockInstanceWidget/MainContent", "type": "IInput", "name": "EmailInput", "as": "$in"},
  {"op": "set", "target": "$in", "prop": "Variable", "value": "Email"},
  {"op": "set", "target": "$in", "prop": "InputType", "value": "Email"},
  {"op": "set", "target": "$lbl", "prop": "TargetWidget", "value": "$in"},
  {"op": "create", "parent": "$scr/#IMobileBlockInstanceWidget/MainContent", "type": "IButton", "name": "ProfileButton", "as": "$btn"},
  {"op": "set", "target": "$btn/#ITextWidget", "prop": "Text", "value": "Open profile"},
  {"op": "set", "target": "$btn/OnClick", "prop": "Destination", "value": "IMobileScreen:UserProfile"},
  {"op": "create", "parent": "$scr/#IMobileBlockInstanceWidget/MainContent", "type": "ILink", "name": "HelpLink", "as": "$lnk"},
  {"op": "set", "target": "$lnk/#ITextWidget", "prop": "Text", "value": "Need help?"},
  {"op": "set", "target": "$lnk/OnClick", "prop": "Destination", "value": "IMobileScreen:InvalidPermissions"},
  {"op": "get", "target": "$btn/#ITextWidget"}
 ]
}
