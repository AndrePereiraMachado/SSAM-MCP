  {"op": "set", "target": "$in", "prop": "Variable", "value": "Coupon"},
  {"op": "set", "target": "$lbl", "prop": "TargetWidget", "value": "$in", "_why": "a click on the Label focuses the Input; the Input gets the Label as a consumer"}
 ]
