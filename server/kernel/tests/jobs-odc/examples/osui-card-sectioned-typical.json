{
 "description": "CardSectioned do OSUI por linha: foto externa no Image, nome no Title, preco no Content e um botao no Footer que abre o detalhe com o Id.",
 "base": "tests/fixtures/odc/insurance-reactive-r8.oml",
 "expectValid": true,
 "expectedMessages": [],
 "ops": [
  {"op": "spec", "data": {"entities": [{"name": "Product", "attributes": [{"name": "Name", "type": "Text", "length": 100, "mandatory": true}, {"name": "Price", "type": "Currency"}, {"name": "ImageUrl", "type": "Text", "length": 500}]}]}},
  {"op": "create", "parent": "IMobileFlow:MainFlow", "type": "IMobileScreen", "name": "ProductSections", "as": "$scr"},
  {"op": "set", "target": "$scr/#IMobileBlockInstanceWidget", "prop": "SourceBlock", "value": "IMobileBlock:LayoutTopMenu"},
  {"op": "create", "parent": "$scr/#IMobileBlockInstanceWidget/Title", "type": "IExpression", "as": "$title"},
  {"op": "set", "target": "$title", "prop": "Value", "value": "\"Products\""},
  {"op": "create", "parent": "$scr", "type": "IScreenAggregate", "name": "GetProducts", "as": "$GetProducts"},
  {"op": "create", "parent": "$GetProducts", "type": "IAliasedSource", "args": {"dataSource": "IServerEntity:Product"}},
  {"op": "create", "parent": "IMobileFlow:MainFlow", "type": "IMobileScreen", "name": "ProductDetail", "as": "$detail"},
  {"op": "set", "target": "$detail/#IMobileBlockInstanceWidget", "prop": "SourceBlock", "value": "IMobileBlock:LayoutTopMenu"},
  {"op": "create", "parent": "$detail", "type": "IInputParameter", "name": "ProductId", "as": "$pid"},
  {"op": "set", "target": "$pid", "prop": "DataType", "value": "Product Identifier"},
  {"op": "create", "parent": "$detail/#IMobileBlockInstanceWidget/Title", "type": "IExpression", "as": "$expr1"},
  {"op": "set", "target": "$expr1", "prop": "Value", "value": "If(ProductId = NullIdentifier(), \"Product\", \"Product details\")"},
  {"op": "create", "parent": "$scr/#IMobileBlockInstanceWidget/MainContent", "type": "IList", "name": "ProductList", "as": "$list"},
  {"op": "set", "target": "$list", "prop": "Source", "value": "GetProducts.List"},
  {"op": "create", "parent": "$list", "type": "IMobileBlockInstanceWidget", "name": "ProductCard", "source": "IMobileBlock:CardSectioned", "as": "$cs"},
  {"op": "set", "target": "$cs/IsVertical", "prop": "Value", "value": "True"},
  {"op": "create", "parent": "$cs/Image", "type": "IImage", "name": "Photo", "as": "$img"},
  {"op": "set", "target": "$img", "prop": "Type", "value": "External"},
  {"op": "set", "target": "$img", "prop": "Url", "value": "GetProducts.List.Current.Product.ImageUrl"},
  {"op": "create", "parent": "$cs/Title", "type": "IExpression", "as": "$expr2"},
  {"op": "set", "target": "$expr2", "prop": "Value", "value": "GetProducts.List.Current.Product.Name"},
  {"op": "create", "parent": "$cs/Content", "type": "IExpression", "as": "$expr3"},
  {"op": "set", "target": "$expr3", "prop": "Value", "value": "FormatCurrency(GetProducts.List.Current.Product.Price, \"$\", 2, \".\", \",\")"},
  {"op": "create", "parent": "$cs/Footer", "type": "IButton", "name": "DetailsButton", "as": "$bDetailsButton"},
  {"op": "set", "target": "$bDetailsButton/#ITextWidget", "prop": "Text", "value": "Details"},
  {"op": "set", "target": "$bDetailsButton/OnClick", "prop": "Destination", "value": "IMobileScreen:ProductDetail"},
  {"op": "set", "target": "$bDetailsButton/OnClick/ProductId", "prop": "Value", "value": "GetProducts.List.Current.Product.Id"}
 ]
}
