{
 "description": "Navigation with an input parameter: the target screen declares the input Code and the button of the other screen navigates to it passing the value.",
 "base": "tests/fixtures/odc/insurance-reactive-r8.oml",
 "expectValid": true,
 "expectedMessages": [],
 "ops": [
  {"op": "create", "parent": "IMobileFlow:MainFlow", "type": "IMobileScreen", "name": "OrderStatus", "as": "$target"},
  {"op": "set", "target": "$target/#IMobileBlockInstanceWidget", "prop": "SourceBlock", "value": "IMobileBlock:LayoutTopMenu"},
  {"op": "create", "parent": "$target", "type": "IInputParameter", "name": "Code", "as": "$code"},
  {"op": "set", "target": "$code", "prop": "DataType", "value": "Text"},
  {"op": "create", "parent": "$target/#IMobileBlockInstanceWidget/MainContent", "type": "IExpression", "as": "$show", "_why": "the input has to be read by someone, otherwise the UnusedElement warning is born"},
  {"op": "set", "target": "$show", "prop": "Value", "value": "\"Order \" + Code"},

  {"op": "create", "parent": "IMobileFlow:MainFlow", "type": "IMobileScreen", "name": "OrderLookup", "as": "$scr"},
  {"op": "set", "target": "$scr/#IMobileBlockInstanceWidget", "prop": "SourceBlock", "value": "IMobileBlock:LayoutTopMenu"},
  {"op": "create", "parent": "$scr/#IMobileBlockInstanceWidget/MainContent", "type": "IButton", "name": "OpenButton", "as": "$btn"},
  {"op": "set", "target": "$btn/#ITextWidget", "prop": "Text", "value": "Open order A-100"},
  {"op": "set", "target": "$btn/OnClick", "prop": "Destination", "value": "IMobileScreen:OrderStatus"},
  {"op": "set", "target": "$btn/OnClick/Code", "prop": "Value", "value": "\"A-100\"", "_why": "the argument is addressed by the name of the input of the target screen"}
 ]
}
