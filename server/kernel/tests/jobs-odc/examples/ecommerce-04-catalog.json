{
 "description": "Store (part 4 of 4): the Catalog screen - a category filter (Dropdown) and a search by name, an OSUI Gallery grid of cards bound to a data action, a clickable card that opens ProductDetail, and a link with an icon to the cart.",
 "base": "job:ecommerce-03-detail",
 "expectValid": true,
 "expectedMessages": [],
 "ops": [
  {"op": "create", "parent": "IMobileFlow:MainFlow", "type": "IMobileScreen", "name": "Catalog", "as": "$scr"},
  {"op": "set", "target": "$scr/#IMobileBlockInstanceWidget", "prop": "SourceBlock", "value": "IMobileBlock:LayoutTopMenu"},
  {"op": "create", "parent": "$scr/#IMobileBlockInstanceWidget/Title", "type": "IExpression", "as": "$title"},
  {"op": "set", "target": "$title", "prop": "Value", "value": "\"Catalog\""},
  {"op": "create", "parent": "$scr", "type": "ILocalVariable", "name": "CategoryFilter", "as": "$cat"},
  {"op": "set", "target": "$cat", "prop": "DataType", "value": "Category Identifier"},
  {"op": "create", "parent": "$scr", "type": "ILocalVariable", "name": "SearchText", "as": "$search"},
  {"op": "set", "target": "$search", "prop": "DataType", "value": "Text"},

  {"op": "create", "parent": "$scr", "type": "IScreenAggregate", "name": "GetCategories", "as": "$cats", "_why": "1. as opcoes do filtro: a static entity Category"},
  {"op": "create", "parent": "$cats", "type": "IAliasedSource", "args": {"dataSource": "IStaticEntity:Category"}},
  {"op": "create", "parent": "$cats", "type": "ISort", "as": "$catSort"},
  {"op": "set", "target": "$catSort", "prop": "Attribute", "value": "Category.Order"},

  {"op": "logic", "_why": "2. the data action reads the screen variables in its filter; the events of the filters only ask for its Refresh Data; the card calls OpenProduct", "data": {"actions": [
   {"name": "GetCatalog", "kind": "data", "owner": "IMobileScreen:Catalog", "fetch": "AtStart",
    "outputs": [{"name": "Products", "type": "Product List"}],
    "steps": [
     {"get": "Product", "as": "ReadProducts", "sort": "Product.Name",
      "where": ["CategoryFilter = NullIdentifier() or Product.CategoryId = CategoryFilter", "SearchText = \"\" or Product.Name like \"%\" + SearchText + \"%\""]},
     {"assign": {"Products": "ReadProducts.List"}, "as": "SetProducts"}]},
   {"name": "RefreshCatalog", "kind": "screen", "owner": "IMobileScreen:Catalog",
    "steps": [{"node": "IRefreshDataNode", "as": "Reload", "properties": {"DataSource": "IMobileScreen:Catalog/GetCatalog"}}]},
   {"name": "OpenProduct", "kind": "screen", "owner": "IMobileScreen:Catalog",
    "inputs": [{"name": "ProductId", "type": "Product Identifier"}],
    "steps": [{"node": "IDestinationNode", "as": "GoToDetail", "properties": {"Destination": "IMobileScreen:ProductDetail"}, "args": {"ProductId": "ProductId"}}]}]}},

  {"op": "create", "parent": "$scr/#IMobileBlockInstanceWidget/Actions", "type": "ILink", "name": "CartLink", "as": "$cartLink", "_why": "3. top: a link with an icon and a text to the cart"},
  {"op": "delete", "target": "$cartLink/#ITextWidget"},
  {"op": "create", "parent": "$cartLink", "type": "IIcon", "name": "CartIcon", "as": "$cartIcon"},
  {"op": "set", "target": "$cartIcon", "prop": "Icon", "value": "shopping-cart"},
  {"op": "set", "target": "$cartIcon", "prop": "Weight", "value": "regular"},
  {"op": "create", "parent": "$cartLink", "type": "IExpression", "as": "$cartText"},
  {"op": "set", "target": "$cartText", "prop": "Value", "value": "\" Cart\""},
  {"op": "set", "target": "$cartLink/OnClick", "prop": "Destination", "value": "IMobileScreen:Cart"},

  {"op": "create", "parent": "$scr/#IMobileBlockInstanceWidget/MainContent", "type": "IContainer", "name": "Filters", "as": "$filters", "_why": "4. barra de filtros"},
  {"op": "set", "target": "$filters", "prop": "Style", "value": "\"display-flex\""},
  {"op": "create", "parent": "$filters", "type": "IDropdown", "name": "CategoryDropdown", "as": "$dd"},
  {"op": "set", "target": "$dd", "prop": "Variable", "value": "CategoryFilter"},
  {"op": "set", "target": "$dd", "prop": "List", "value": "GetCategories.List"},
  {"op": "set", "target": "$dd", "prop": "Values", "value": "Category.Id"},
  {"op": "set", "target": "$dd", "prop": "Labels", "value": "Category.Label"},
  {"op": "set", "target": "$dd/OnChange", "prop": "Destination", "value": "IMobileScreen:Catalog/RefreshCatalog"},
  {"op": "create", "parent": "$filters", "type": "IInput", "name": "SearchInput", "as": "$in"},
  {"op": "set", "target": "$in", "prop": "Variable", "value": "SearchText"},
  {"op": "set", "target": "$in", "prop": "Prompt", "value": "\"Search products\""},
  {"op": "set", "target": "$in/OnChange", "prop": "Destination", "value": "IMobileScreen:Catalog/RefreshCatalog"},

  {"op": "create", "parent": "$scr/#IMobileBlockInstanceWidget/MainContent", "type": "IMobileBlockInstanceWidget", "name": "ProductGallery", "source": "IMobileBlock:Gallery", "empty": true, "as": "$gal", "_why": "5. the grid: a Gallery without the sample List, with the List of the data action"},
  {"op": "set", "target": "$gal/RowItemsDesktop", "prop": "Value", "value": "4"},
  {"op": "create", "parent": "$gal/Content", "type": "IList", "name": "ProductList", "as": "$list"},
  {"op": "set", "target": "$list", "prop": "Source", "value": "GetCatalog.Products"},
  {"op": "create", "parent": "$list", "type": "IContainer", "name": "ProductCard", "as": "$card"},
  {"op": "set", "target": "$card", "prop": "Style", "value": "\"card\""},
  {"op": "create", "parent": "$card", "type": "IImage", "name": "ProductPhoto", "as": "$img"},
  {"op": "set", "target": "$img", "prop": "Type", "value": "External"},
  {"op": "set", "target": "$img", "prop": "Url", "value": "GetCatalog.Products.Current.ImageUrl"},
  {"op": "create", "parent": "$card", "type": "IExpression", "as": "$name"},
  {"op": "set", "target": "$name", "prop": "Value", "value": "GetCatalog.Products.Current.Name"},
  {"op": "create", "parent": "$card", "type": "IExpression", "as": "$price"},
  {"op": "set", "target": "$price", "prop": "Value", "value": "FormatCurrency(GetCatalog.Products.Current.Price, \"$\", 2, \".\", \",\")"},
  {"op": "create", "parent": "$card", "type": "IEvent", "as": "$click"},
  {"op": "set", "target": "$click", "prop": "Event", "value": "onclick"},
  {"op": "set", "target": "$click", "prop": "Handler", "value": "IMobileScreen:Catalog/OpenProduct"},
  {"op": "set", "target": "$click/ProductId", "prop": "Value", "value": "GetCatalog.Products.Current.Id"}
 ]
}
