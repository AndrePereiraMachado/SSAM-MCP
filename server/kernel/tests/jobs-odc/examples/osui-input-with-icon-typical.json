{
 "description": "InputWithIcon of OSUI as a search: a magnifier icon in Icon, an Input bound to SearchText and OnChange with a Refresh Data of the filtered list.",
 "base": "tests/fixtures/odc/insurance-reactive-r8.oml",
 "expectValid": true,
 "expectedMessages": [],
 "ops": [
  {"op": "spec", "data": {"entities": [{"name": "Product", "attributes": [{"name": "Name", "type": "Text", "length": 100, "mandatory": true}, {"name": "Price", "type": "Currency"}, {"name": "ImageUrl", "type": "Text", "length": 500}]}]}},
  {"op": "create", "parent": "IMobileFlow:MainFlow", "type": "IMobileScreen", "name": "ProductSearchBox", "as": "$scr"},
  {"op": "set", "target": "$scr/#IMobileBlockInstanceWidget", "prop": "SourceBlock", "value": "IMobileBlock:LayoutTopMenu"},
  {"op": "create", "parent": "$scr/#IMobileBlockInstanceWidget/Title", "type": "IExpression", "as": "$title"},
  {"op": "set", "target": "$title", "prop": "Value", "value": "\"Search\""},
  {"op": "create", "parent": "$scr", "type": "ILocalVariable", "name": "SearchText", "as": "$vSearchText"},
  {"op": "set", "target": "$vSearchText", "prop": "DataType", "value": "Text"},
  {"op": "create", "parent": "$scr", "type": "IScreenAggregate", "name": "LoadProducts", "as": "$LoadProducts"},
  {"op": "create", "parent": "$LoadProducts", "type": "IAliasedSource", "args": {"dataSource": "IServerEntity:Product"}},
  {"op": "create", "parent": "$LoadProducts", "type": "IFilter", "args": {"condition": "Product.Name like \"%\" + SearchText + \"%\""}},
  {"op": "logic", "data": {"actions": [{"name": "SearchChanged", "kind": "screen", "owner": "IMobileScreen:ProductSearchBox", "steps": [{"node": "IRefreshDataNode", "as": "Reload", "properties": {"DataSource": "IMobileScreen:ProductSearchBox/LoadProducts"}}]}]}},
  {"op": "create", "parent": "$scr/#IMobileBlockInstanceWidget/MainContent", "type": "IMobileBlockInstanceWidget", "name": "InputWithIcon1", "source": "IMobileBlock:InputWithIcon", "as": "$iw"},
  {"op": "set", "target": "$iw/AlignIconRight", "prop": "Value", "value": "True"},
  {"op": "set", "target": "$iw/Input/#IInput", "prop": "Variable", "value": "SearchText"},
  {"op": "set", "target": "$iw/Input/#IInput", "prop": "Prompt", "value": "\"Search products\""},
  {"op": "set", "target": "$iw/Input/#IInput/OnChange", "prop": "Destination", "value": "IMobileScreen:ProductSearchBox/SearchChanged"},
  {"op": "create", "parent": "$scr/#IMobileBlockInstanceWidget/MainContent", "type": "IList", "name": "ProductList", "as": "$list"},
  {"op": "set", "target": "$list", "prop": "Source", "value": "LoadProducts.List"},
  {"op": "create", "parent": "$list", "type": "IExpression", "as": "$expr1"},
  {"op": "set", "target": "$expr1", "prop": "Value", "value": "LoadProducts.List.Current.Product.Name"}
 ]
}
