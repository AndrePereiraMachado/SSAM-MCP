{
 "description": "Pagination do OSUI sobre um aggregate: StartIndex/MaxRecords em variaveis, TotalCount do Count do aggregate e OnNavigate com Refresh Data.",
 "base": "tests/fixtures/odc/insurance-reactive-r8.oml",
 "expectValid": true,
 "expectedMessages": [],
 "ops": [
  {"op": "spec", "data": {"entities": [{"name": "Product", "attributes": [{"name": "Name", "type": "Text", "length": 100, "mandatory": true}, {"name": "Price", "type": "Currency"}, {"name": "ImageUrl", "type": "Text", "length": 500}]}]}},
  {"op": "create", "parent": "IMobileFlow:MainFlow", "type": "IMobileScreen", "name": "PagedProducts", "as": "$scr"},
  {"op": "set", "target": "$scr/#IMobileBlockInstanceWidget", "prop": "SourceBlock", "value": "IMobileBlock:LayoutTopMenu"},
  {"op": "create", "parent": "$scr/#IMobileBlockInstanceWidget/Title", "type": "IExpression", "as": "$title"},
  {"op": "set", "target": "$title", "prop": "Value", "value": "\"Products\""},
  {"op": "create", "parent": "$scr", "type": "ILocalVariable", "name": "StartIndex", "as": "$vStartIndex"},
  {"op": "set", "target": "$vStartIndex", "prop": "DataType", "value": "Integer"},
  {"op": "set", "target": "$vStartIndex", "prop": "DefaultValue", "value": "0"},
  {"op": "create", "parent": "$scr", "type": "ILocalVariable", "name": "PageSize", "as": "$vPageSize"},
  {"op": "set", "target": "$vPageSize", "prop": "DataType", "value": "Integer"},
  {"op": "set", "target": "$vPageSize", "prop": "DefaultValue", "value": "10"},
  {"op": "create", "parent": "$scr", "type": "IScreenAggregate", "name": "GetProducts", "as": "$GetProducts"},
  {"op": "create", "parent": "$GetProducts", "type": "IAliasedSource", "args": {"dataSource": "IServerEntity:Product"}},
  {"op": "create", "parent": "$GetProducts", "type": "ISort", "as": "$GetProductsSort"},
  {"op": "set", "target": "$GetProductsSort", "prop": "Attribute", "value": "Product.Name"},
  {"op": "set", "target": "$GetProducts", "prop": "MaxRecords", "value": "PageSize"},
  {"op": "set", "target": "$GetProducts", "prop": "StartIndex", "value": "StartIndex", "_why": "o aggregate pagina pelas variaveis"},
  {"op": "logic", "data": {"actions": [{"name": "PageChanged", "kind": "screen", "owner": "IMobileScreen:PagedProducts", "inputs": [{"name": "NewStartIndex", "type": "Integer"}], "steps": [{"assign": {"StartIndex": "NewStartIndex"}, "as": "Move"}, {"node": "IRefreshDataNode", "as": "Reload", "properties": {"DataSource": "IMobileScreen:PagedProducts/GetProducts"}}]}]}},
  {"op": "create", "parent": "$scr/#IMobileBlockInstanceWidget/MainContent", "type": "IList", "name": "ProductList", "as": "$list"},
  {"op": "set", "target": "$list", "prop": "Source", "value": "GetProducts.List"},
  {"op": "create", "parent": "$list", "type": "IExpression", "as": "$expr1"},
  {"op": "set", "target": "$expr1", "prop": "Value", "value": "GetProducts.List.Current.Product.Name"},
  {"op": "create", "parent": "$scr/#IMobileBlockInstanceWidget/MainContent", "type": "IMobileBlockInstanceWidget", "name": "Pagination1", "source": "IMobileBlock:Pagination", "as": "$pg"},
  {"op": "set", "target": "$pg/StartIndex", "prop": "Value", "value": "StartIndex"},
  {"op": "set", "target": "$pg/MaxRecords", "prop": "Value", "value": "PageSize"},
  {"op": "set", "target": "$pg/TotalCount", "prop": "Value", "value": "GetProducts.Count"},
  {"op": "set", "target": "$pg/OnNavigate", "prop": "Handler", "value": "IMobileScreen:PagedProducts/PageChanged"},
  {"op": "set", "target": "$pg/OnNavigate/NewStartIndex", "prop": "Value", "value": "NewStartIndex"}
 ]
}
