{
 "description": "Container com dados: classe dinamica por expressao, Visible condicionado ao registro e filhos com os campos de cada linha de uma List.",
 "base": "tests/fixtures/odc/insurance-reactive-r8.oml",
 "expectValid": true,
 "expectedMessages": [],
 "ops": [
  {"op": "spec", "data": {"entities": [{"name": "Task", "attributes": [
   {"name": "Title", "type": "Text", "length": 100, "mandatory": true},
   {"name": "IsDone", "type": "Boolean"},
   {"name": "IsArchived", "type": "Boolean"}]}]}},
  {"op": "create", "parent": "IMobileFlow:MainFlow", "type": "IMobileScreen", "name": "TaskBoard", "as": "$scr"},
  {"op": "set", "target": "$scr/#IMobileBlockInstanceWidget", "prop": "SourceBlock", "value": "IMobileBlock:LayoutTopMenu"},
  {"op": "create", "parent": "$scr", "type": "IScreenAggregate", "name": "GetTasks", "as": "$agg"},
  {"op": "create", "parent": "$agg", "type": "IAliasedSource", "args": {"dataSource": "IServerEntity:Task"}},
  {"op": "create", "parent": "$scr/#IMobileBlockInstanceWidget/MainContent", "type": "IList", "name": "TaskList", "as": "$list"},
  {"op": "set", "target": "$list", "prop": "Source", "value": "GetTasks.List"},

  {"op": "create", "parent": "$list", "type": "IContainer", "name": "TaskRow", "as": "$row"},
  {"op": "set", "target": "$row", "prop": "Style", "value": "\"padding-s \" + If(GetTasks.List.Current.Task.IsDone, \"text-neutral-6\", \"text-neutral-10\")", "_why": "classe fixa + classe que depende do registro"},
  {"op": "set", "target": "$row", "prop": "Visible", "value": "not GetTasks.List.Current.Task.IsArchived", "_why": "Visible e expressao do proprio Container"},
  {"op": "create", "parent": "$row", "type": "IExpression", "as": "$title"},
  {"op": "set", "target": "$title", "prop": "Value", "value": "GetTasks.List.Current.Task.Title"},
  {"op": "get", "target": "$row"}
 ]
}
