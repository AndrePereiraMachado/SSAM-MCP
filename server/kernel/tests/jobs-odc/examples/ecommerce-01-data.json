{
 "description": "Loja (parte 1 de 4): modelo de dados e logica de servidor do carrinho - Category, Product, CartItem, o resumo CartSummary e as server actions Cart_Add, Cart_ChangeQuantity e Cart_GetSummary.",
 "base": "tests/fixtures/odc/insurance-reactive-r8.oml",
 "expectValid": true,
 "expectedMessages": [
  {"id": "UnusedUserAction", "element": "Cart_Add (ServerAction)", "why": "a tela de detalhe (ecommerce-03-detail) e quem chama Cart_Add"},
  {"id": "UnusedUserAction", "element": "Cart_ChangeQuantity (ServerAction)", "why": "a tela do carrinho (ecommerce-02-cart) e quem chama Cart_ChangeQuantity"}
 ],
 "ops": [
  {"op": "spec", "data": {
   "static": [{"name": "Category", "records": [{"name": "Books"}, {"name": "Games"}, {"name": "Music"}]}],
   "entities": [
    {"name": "Product", "description": "Produto do catalogo", "attributes": [
     {"name": "Name", "type": "Text", "length": 100, "mandatory": true},
     {"name": "Description", "type": "Text", "length": 1000},
     {"name": "Price", "type": "Currency", "mandatory": true},
     {"name": "ImageUrl", "type": "Text", "length": 500},
     {"name": "CategoryId", "type": "Category Identifier", "mandatory": true}]},
    {"name": "CartItem", "description": "Linha do carrinho", "attributes": [
     {"name": "ProductId", "type": "Product Identifier", "mandatory": true},
     {"name": "Quantity", "type": "Integer", "mandatory": true},
     {"name": "UnitPrice", "type": "Currency", "mandatory": true}]}],
   "structures": [{"name": "CartSummary", "description": "Resumo do carrinho devolvido pelo servidor", "attributes": [
    {"name": "ItemCount", "type": "Integer"},
    {"name": "Total", "type": "Currency"}]}]}},

  {"op": "logic", "data": {"actions": [
   {"name": "Cart_GetSummary", "kind": "server", "description": "Soma as quantidades e o total do carrinho",
    "outputs": [{"name": "Summary", "type": "CartSummary"}],
    "steps": [
     {"get": "CartItem", "as": "ReadLines"},
     {"foreach": "ReadLines.List", "as": "EachLine", "do": [
      {"assign": {"Summary.ItemCount": "Summary.ItemCount + ReadLines.List.Current.CartItem.Quantity",
                  "Summary.Total": "Summary.Total + ReadLines.List.Current.CartItem.Quantity * ReadLines.List.Current.CartItem.UnitPrice"}, "as": "Accumulate"}]}]},
   {"name": "Cart_Add", "kind": "server", "description": "Poe o produto no carrinho: soma a quantidade se a linha ja existe, senao cria a linha com o preco atual",
    "inputs": [{"name": "ProductId", "type": "Product Identifier"}, {"name": "Quantity", "type": "Integer"}],
    "outputs": [{"name": "CartItemId", "type": "CartItem Identifier"}],
    "vars": [{"name": "Line", "type": "CartItem"}],
    "steps": [
     {"get": "Product", "as": "ReadProduct", "where": "Product.Id = ProductId", "max": 1},
     {"get": "CartItem", "as": "ReadExisting", "where": "CartItem.ProductId = ProductId", "max": 1},
     {"if": "ReadExisting.List.Empty", "as": "IsNewLine",
      "then": [{"assign": {"Line.ProductId": "ProductId", "Line.Quantity": "Quantity", "Line.UnitPrice": "ReadProduct.List.Current.Product.Price"}, "as": "NewLine"}],
      "else": [{"assign": {"Line": "ReadExisting.List.Current.CartItem"}, "as": "TakeLine"},
               {"assign": {"Line.Quantity": "Line.Quantity + Quantity"}, "as": "AddQuantity"}]},
     {"save": "CartItem", "record": "Line", "as": "SaveLine"},
     {"assign": {"CartItemId": "SaveLine.Id"}, "as": "SetOutput"}]},
   {"name": "Cart_ChangeQuantity", "kind": "server", "description": "Soma Delta a quantidade da linha (minimo 1) e devolve a quantidade nova e o resumo do carrinho",
    "inputs": [{"name": "CartItemId", "type": "CartItem Identifier"}, {"name": "Delta", "type": "Integer"}],
    "outputs": [{"name": "NewQuantity", "type": "Integer"}, {"name": "Summary", "type": "CartSummary"}],
    "vars": [{"name": "Line", "type": "CartItem"}],
    "steps": [
     {"get": "CartItem", "as": "ReadLine", "where": "CartItem.Id = CartItemId", "max": 1},
     {"assign": {"Line": "ReadLine.List.Current.CartItem"}, "as": "TakeLine"},
     {"assign": {"Line.Quantity": "Max(1, Line.Quantity + Delta)"}, "as": "ApplyDelta"},
     {"update": "CartItem", "record": "Line", "as": "SaveLine"},
     {"call": "Cart_GetSummary", "as": "Recalculate"},
     {"assign": {"NewQuantity": "Line.Quantity", "Summary": "Recalculate.Summary"}, "as": "SetOutputs"}]}]}}
 ]
}
