{
 "description": "MasterDetail do OSUI: lista de produtos no LeftContent, o clique escolhe o produto, o RightContent mostra o escolhido e o DetailClose limpa a escolha.",
 "base": "tests/fixtures/odc/insurance-reactive-r8.oml",
 "expectValid": true,
 "expectedMessages": [],
 "ops": [
  {"op": "spec", "data": {"entities": [{"name": "Product", "attributes": [{"name": "Name", "type": "Text", "length": 100, "mandatory": true}, {"name": "Price", "type": "Currency"}, {"name": "ImageUrl", "type": "Text", "length": 500}]}]}},
  {"op": "create", "parent": "IMobileFlow:MainFlow", "type": "IMobileScreen", "name": "ProductBrowser", "as": "$scr"},
  {"op": "set", "target": "$scr/#IMobileBlockInstanceWidget", "prop": "SourceBlock", "value": "IMobileBlock:LayoutTopMenu"},
  {"op": "create", "parent": "$scr/#IMobileBlockInstanceWidget/Title", "type": "IExpression", "as": "$title"},
  {"op": "set", "target": "$title", "prop": "Value", "value": "\"Products\""},
  {"op": "create", "parent": "$scr", "type": "IScreenAggregate", "name": "GetProducts", "as": "$GetProducts"},
  {"op": "create", "parent": "$GetProducts", "type": "IAliasedSource", "args": {"dataSource": "IServerEntity:Product"}},
  {"op": "create", "parent": "$GetProducts", "type": "ISort", "as": "$GetProductsSort"},
  {"op": "set", "target": "$GetProductsSort", "prop": "Attribute", "value": "Product.Name"},
  {"op": "create", "parent": "$scr", "type": "ILocalVariable", "name": "SelectedName", "as": "$vSelectedName"},
  {"op": "set", "target": "$vSelectedName", "prop": "DataType", "value": "Text"},
  {"op": "create", "parent": "$scr", "type": "ILocalVariable", "name": "SelectedPrice", "as": "$vSelectedPrice"},
  {"op": "set", "target": "$vSelectedPrice", "prop": "DataType", "value": "Currency"},
  {"op": "logic", "data": {"actions": [{"name": "ShowProduct", "kind": "screen", "owner": "IMobileScreen:ProductBrowser", "inputs": [{"name": "RowIndex", "type": "Integer"}], "steps": [{"assign": {"SelectedName": "GetProducts.List[RowIndex].Product.Name", "SelectedPrice": "GetProducts.List[RowIndex].Product.Price"}, "as": "Pick"}]}]}},
  {"op": "logic", "data": {"actions": [{"name": "CloseDetail", "kind": "screen", "owner": "IMobileScreen:ProductBrowser", "steps": [{"assign": {"SelectedName": "\"\""}, "as": "Clear"}]}]}},
  {"op": "create", "parent": "$scr/#IMobileBlockInstanceWidget/MainContent", "type": "IMobileBlockInstanceWidget", "name": "MasterDetail1", "source": "IMobileBlock:MasterDetail", "empty": true, "as": "$md"},
  {"op": "set", "target": "$md/LeftPercentage", "prop": "Value", "value": "40"},
  {"op": "set", "target": "$md/OpenedOnPhone", "prop": "Value", "value": "SelectedName <> \"\"", "_why": "no telefone o detalhe abre quando ha escolha"},
  {"op": "set", "target": "$md/DetailClose", "prop": "Handler", "value": "IMobileScreen:ProductBrowser/CloseDetail"},
  {"op": "create", "parent": "$md/LeftContent", "type": "IList", "name": "ProductList", "as": "$list"},
  {"op": "set", "target": "$list", "prop": "Source", "value": "GetProducts.List"},
  {"op": "create", "parent": "$list", "type": "IExpression", "as": "$expr1"},
  {"op": "set", "target": "$expr1", "prop": "Value", "value": "GetProducts.List.Current.Product.Name"},
  {"op": "create", "parent": "$list", "type": "ILink", "name": "ProductLink", "as": "$lProductLink"},
  {"op": "set", "target": "$lProductLink/#ITextWidget", "prop": "Text", "value": "Open"},
  {"op": "set", "target": "$lProductLink/OnClick", "prop": "Destination", "value": "IMobileScreen:ProductBrowser/ShowProduct"},
  {"op": "set", "target": "$lProductLink/OnClick/RowIndex", "prop": "Value", "value": "GetProducts.List.CurrentRowNumber"},
  {"op": "create", "parent": "$md/RightContent", "type": "IExpression", "as": "$expr2"},
  {"op": "set", "target": "$expr2", "prop": "Value", "value": "If(SelectedName = \"\", \"Pick a product\", SelectedName + \" - \" + FormatCurrency(SelectedPrice, \"$\", 2, \".\", \",\"))"}
 ]
}
