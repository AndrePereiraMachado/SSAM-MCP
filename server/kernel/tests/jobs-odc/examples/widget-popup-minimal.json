{
 "description": "Popup: um IPopup aberto por uma variavel Boolean (ShowPopup) com um texto no Content.",
 "base": "tests/fixtures/odc/insurance-reactive-r8.oml",
 "expectValid": true,
 "expectedMessages": [],
 "ops": [
  {"op": "create", "parent": "IMobileFlow:MainFlow", "type": "IMobileScreen", "name": "PopupDemo", "as": "$scr"},
  {"op": "set", "target": "$scr/#IMobileBlockInstanceWidget", "prop": "SourceBlock", "value": "IMobileBlock:LayoutTopMenu"},
  {"op": "create", "parent": "$scr", "type": "ILocalVariable", "name": "IsPopupOpen", "as": "$open"},
  {"op": "set", "target": "$open", "prop": "DataType", "value": "Boolean"},
  {"op": "create", "parent": "$scr/#IMobileBlockInstanceWidget/MainContent", "type": "IPopup", "name": "InfoPopup", "as": "$pop"},
  {"op": "set", "target": "$pop", "prop": "ShowPopup", "value": "IsPopupOpen", "_why": "ShowPopup e obrigatorio: a expressao que abre o popup"},
  {"op": "create", "parent": "$pop/Content", "type": "IExpression", "as": "$text"},
  {"op": "set", "target": "$text", "prop": "Value", "value": "\"Free shipping on orders over $50\""}
 ]
}
