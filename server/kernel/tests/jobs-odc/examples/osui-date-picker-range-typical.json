{
 "description": "DatePickerRange of OSUI as a filter: OnSelected saves the period and does a Refresh Data of the orders between the two dates.",
 "base": "tests/fixtures/odc/insurance-reactive-r8.oml",
 "expectValid": true,
 "expectedMessages": [],
 "ops": [
  {"op": "spec", "data": {"entities": [{"name": "SalesOrder", "attributes": [{"name": "Code", "type": "Text", "length": 20, "mandatory": true}, {"name": "PlacedOn", "type": "Date"}]}]}},
  {"op": "create", "parent": "IMobileFlow:MainFlow", "type": "IMobileScreen", "name": "OrdersByPeriod", "as": "$scr"},
  {"op": "set", "target": "$scr/#IMobileBlockInstanceWidget", "prop": "SourceBlock", "value": "IMobileBlock:LayoutTopMenu"},
  {"op": "create", "parent": "$scr/#IMobileBlockInstanceWidget/Title", "type": "IExpression", "as": "$title"},
  {"op": "set", "target": "$title", "prop": "Value", "value": "\"Orders by period\""},
  {"op": "create", "parent": "$scr", "type": "ILocalVariable", "name": "RangeText", "as": "$vRangeText"},
  {"op": "set", "target": "$vRangeText", "prop": "DataType", "value": "Text"},
  {"op": "create", "parent": "$scr", "type": "ILocalVariable", "name": "FromDate", "as": "$vFromDate"},
  {"op": "set", "target": "$vFromDate", "prop": "DataType", "value": "Date"},
  {"op": "set", "target": "$vFromDate", "prop": "DefaultValue", "value": "#2026-01-01#"},
  {"op": "create", "parent": "$scr", "type": "ILocalVariable", "name": "ToDate", "as": "$vToDate"},
  {"op": "set", "target": "$vToDate", "prop": "DataType", "value": "Date"},
  {"op": "set", "target": "$vToDate", "prop": "DefaultValue", "value": "#2026-12-31#"},
  {"op": "create", "parent": "$scr", "type": "IScreenAggregate", "name": "LoadOrders", "as": "$LoadOrders"},
  {"op": "create", "parent": "$LoadOrders", "type": "IAliasedSource", "args": {"dataSource": "IServerEntity:SalesOrder"}},
  {"op": "create", "parent": "$LoadOrders", "type": "IFilter", "args": {"condition": "SalesOrder.PlacedOn >= FromDate and SalesOrder.PlacedOn <= ToDate"}},
  {"op": "create", "parent": "$LoadOrders", "type": "ISort", "as": "$LoadOrdersSort"},
  {"op": "set", "target": "$LoadOrdersSort", "prop": "Attribute", "value": "SalesOrder.PlacedOn"},
  {"op": "logic", "data": {"actions": [{"name": "RangePicked", "kind": "screen", "owner": "IMobileScreen:OrdersByPeriod", "inputs": [{"name": "SelectedStartDate", "type": "Date"}, {"name": "SelectedEndDate", "type": "Date"}], "steps": [{"assign": {"FromDate": "SelectedStartDate", "ToDate": "SelectedEndDate"}, "as": "Keep"}, {"node": "IRefreshDataNode", "as": "Reload", "properties": {"DataSource": "IMobileScreen:OrdersByPeriod/LoadOrders"}}]}]}},
  {"op": "create", "parent": "$scr/#IMobileBlockInstanceWidget/MainContent", "type": "IMobileBlockInstanceWidget", "name": "DatePickerRange1", "source": "IMobileBlock:DatePickerRange", "as": "$dr"},
  {"op": "set", "target": "$dr/DateFormat", "prop": "Value", "value": "\"yyyy-MM-dd\""},
  {"op": "set", "target": "$dr/Datepicker/#IInput", "prop": "Variable", "value": "RangeText"},
  {"op": "set", "target": "$dr/OnSelected", "prop": "Handler", "value": "IMobileScreen:OrdersByPeriod/RangePicked"},
  {"op": "set", "target": "$dr/OnSelected/SelectedStartDate", "prop": "Value", "value": "SelectedStartDate"},
  {"op": "set", "target": "$dr/OnSelected/SelectedEndDate", "prop": "Value", "value": "SelectedEndDate"},
  {"op": "create", "parent": "$scr/#IMobileBlockInstanceWidget/MainContent", "type": "IList", "name": "OrderList", "as": "$list"},
  {"op": "set", "target": "$list", "prop": "Source", "value": "LoadOrders.List"},
  {"op": "create", "parent": "$list", "type": "IExpression", "as": "$expr1"},
  {"op": "set", "target": "$expr1", "prop": "Value", "value": "LoadOrders.List.Current.SalesOrder.Code"}
 ]
}
