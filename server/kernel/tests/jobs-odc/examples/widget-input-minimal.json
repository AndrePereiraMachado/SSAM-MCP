{
 "description": "Input: an IInput bound to a Text variable of the screen, with a help text in Prompt.",
 "base": "tests/fixtures/odc/insurance-reactive-r8.oml",
 "expectValid": true,
 "expectedMessages": [],
 "ops": [
  {"op": "create", "parent": "IMobileFlow:MainFlow", "type": "IMobileScreen", "name": "InputDemo", "as": "$scr"},
  {"op": "set", "target": "$scr/#IMobileBlockInstanceWidget", "prop": "SourceBlock", "value": "IMobileBlock:LayoutTopMenu"},
  {"op": "create", "parent": "$scr", "type": "ILocalVariable", "name": "City", "as": "$city"},
  {"op": "set", "target": "$city", "prop": "DataType", "value": "Text"},
  {"op": "create", "parent": "$scr/#IMobileBlockInstanceWidget/MainContent", "type": "IInput", "name": "CityInput", "as": "$in"},
  {"op": "set", "target": "$in", "prop": "Variable", "value": "City", "_why": "without a Variable the Verify gives RequiredPropertyValue"},
  {"op": "set", "target": "$in", "prop": "Prompt", "value": "\"Type your city\""}
 ]
}
