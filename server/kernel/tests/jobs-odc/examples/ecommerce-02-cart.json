{
 "description": "Store (part 2 of 4): the Cart screen as a table - lines with product, price, - quantity + and the line total; the click writes the new quantity to GetCartLines.List[Line] and the summary returned by the server, without reading the table again.",
 "base": "job:ecommerce-01-data",
 "expectValid": true,
 "expectedMessages": [],
 "ops": [
  {"op": "create", "parent": "IMobileFlow:MainFlow", "type": "IMobileScreen", "name": "Cart", "as": "$scr"},
  {"op": "set", "target": "$scr/#IMobileBlockInstanceWidget", "prop": "SourceBlock", "value": "IMobileBlock:LayoutTopMenu"},
  {"op": "create", "parent": "$scr/#IMobileBlockInstanceWidget/Title", "type": "IExpression", "as": "$title"},
  {"op": "set", "target": "$title", "prop": "Value", "value": "\"Cart\""},

  {"op": "create", "parent": "$scr", "type": "IScreenAggregate", "name": "GetCartLines", "as": "$agg", "_why": "1. the lines: CartItem with the Product of the line (join)"},
  {"op": "create", "parent": "$agg", "type": "IAliasedSource", "args": {"dataSource": "IServerEntity:CartItem"}, "as": "$srcLine"},
  {"op": "create", "parent": "$agg", "type": "IAliasedSource", "args": {"dataSource": "IServerEntity:Product"}, "as": "$srcProduct"},
  {"op": "create", "parent": "$agg", "type": "IJoin", "as": "$join"},
  {"op": "set", "target": "$join", "prop": "LeftSource", "value": "$srcLine"},
  {"op": "set", "target": "$join", "prop": "RightSource", "value": "$srcProduct"},
  {"op": "set", "target": "$join", "prop": "JoinType", "value": "Inner"},
  {"op": "set", "target": "$join", "prop": "Condition", "value": "CartItem.ProductId = Product.Id"},
  {"op": "create", "parent": "$agg", "type": "ISort", "as": "$sort"},
  {"op": "set", "target": "$sort", "prop": "Attribute", "value": "Product.Name"},

  {"op": "logic", "_why": "2. the summary comes from a data action; the quantity change writes to the line and to the summary, without Refresh Data", "data": {"actions": [
   {"name": "LoadSummary", "kind": "data", "owner": "IMobileScreen:Cart", "fetch": "AtStart",
    "outputs": [{"name": "Summary", "type": "CartSummary"}],
    "steps": [{"call": "Cart_GetSummary", "as": "ReadSummary"}, {"assign": {"Summary": "ReadSummary.Summary"}, "as": "SetSummary"}]},
   {"name": "ChangeQuantity", "kind": "screen", "owner": "IMobileScreen:Cart",
    "inputs": [{"name": "RowIndex", "type": "Integer"}, {"name": "Delta", "type": "Integer"}],
    "steps": [
     {"call": "Cart_ChangeQuantity", "as": "Change", "args": {"CartItemId": "GetCartLines.List[RowIndex].CartItem.Id", "Delta": "Delta"}},
     {"assign": {"GetCartLines.List[RowIndex].CartItem.Quantity": "Change.NewQuantity", "LoadSummary.Summary": "Change.Summary"}, "as": "ApplyResult"}]}]}},

  {"op": "create", "parent": "$scr/#IMobileBlockInstanceWidget/MainContent", "type": "ITableRecords", "name": "CartTable", "as": "$tbl", "_why": "3. the table: one column = one IHeaderCell + one IRowCell"},
  {"op": "set", "target": "$tbl", "prop": "Source", "value": "GetCartLines.List"},
  {"op": "create", "parent": "$tbl/HeaderRow", "type": "IHeaderCell", "name": "ProductHeader", "as": "$h1"},
  {"op": "create", "parent": "$h1/Content", "type": "IExpression", "as": "$h1Text"},
  {"op": "set", "target": "$h1Text", "prop": "Value", "value": "\"Product\""},
  {"op": "create", "parent": "$tbl/Row", "type": "IRowCell", "name": "ProductCell", "as": "$r1"},
  {"op": "create", "parent": "$r1/Content", "type": "IExpression", "as": "$r1Text"},
  {"op": "set", "target": "$r1Text", "prop": "Value", "value": "GetCartLines.List.Current.Product.Name"},

  {"op": "create", "parent": "$tbl/HeaderRow", "type": "IHeaderCell", "name": "PriceHeader", "as": "$h2"},
  {"op": "create", "parent": "$h2/Content", "type": "IExpression", "as": "$h2Text"},
  {"op": "set", "target": "$h2Text", "prop": "Value", "value": "\"Unit price\""},
  {"op": "create", "parent": "$tbl/Row", "type": "IRowCell", "name": "PriceCell", "as": "$r2"},
  {"op": "create", "parent": "$r2/Content", "type": "IExpression", "as": "$r2Text"},
  {"op": "set", "target": "$r2Text", "prop": "Value", "value": "FormatCurrency(GetCartLines.List.Current.CartItem.UnitPrice, \"$\", 2, \".\", \",\")"},

  {"op": "create", "parent": "$tbl/HeaderRow", "type": "IHeaderCell", "name": "QuantityHeader", "as": "$h3"},
  {"op": "create", "parent": "$h3/Content", "type": "IExpression", "as": "$h3Text"},
  {"op": "set", "target": "$h3Text", "prop": "Value", "value": "\"Quantity\""},
  {"op": "create", "parent": "$tbl/Row", "type": "IRowCell", "name": "QuantityCell", "as": "$r3"},
  {"op": "create", "parent": "$r3/Content", "type": "IButton", "name": "MinusButton", "as": "$minus"},
  {"op": "set", "target": "$minus/#ITextWidget", "prop": "Text", "value": "-"},
  {"op": "set", "target": "$minus/OnClick", "prop": "Destination", "value": "IMobileScreen:Cart/ChangeQuantity"},
  {"op": "set", "target": "$minus/OnClick/RowIndex", "prop": "Value", "value": "GetCartLines.List.CurrentRowNumber"},
  {"op": "set", "target": "$minus/OnClick/Delta", "prop": "Value", "value": "-1"},
  {"op": "create", "parent": "$r3/Content", "type": "IExpression", "as": "$qty"},
  {"op": "set", "target": "$qty", "prop": "Value", "value": "GetCartLines.List.Current.CartItem.Quantity"},
  {"op": "create", "parent": "$r3/Content", "type": "IButton", "name": "PlusButton", "as": "$plus"},
  {"op": "set", "target": "$plus/#ITextWidget", "prop": "Text", "value": "+"},
  {"op": "set", "target": "$plus/OnClick", "prop": "Destination", "value": "IMobileScreen:Cart/ChangeQuantity"},
  {"op": "set", "target": "$plus/OnClick/RowIndex", "prop": "Value", "value": "GetCartLines.List.CurrentRowNumber"},
  {"op": "set", "target": "$plus/OnClick/Delta", "prop": "Value", "value": "1"},

  {"op": "create", "parent": "$tbl/HeaderRow", "type": "IHeaderCell", "name": "LineTotalHeader", "as": "$h4"},
  {"op": "create", "parent": "$h4/Content", "type": "IExpression", "as": "$h4Text"},
  {"op": "set", "target": "$h4Text", "prop": "Value", "value": "\"Total\""},
  {"op": "create", "parent": "$tbl/Row", "type": "IRowCell", "name": "LineTotalCell", "as": "$r4"},
  {"op": "create", "parent": "$r4/Content", "type": "IExpression", "as": "$r4Text"},
  {"op": "set", "target": "$r4Text", "prop": "Value", "value": "FormatCurrency(GetCartLines.List.Current.CartItem.Quantity * GetCartLines.List.Current.CartItem.UnitPrice, \"$\", 2, \".\", \",\")"},

  {"op": "create", "parent": "$scr/#IMobileBlockInstanceWidget/MainContent", "type": "IContainer", "name": "CartTotals", "as": "$totals", "_why": "4. the summary reads the output of the data action, which ChangeQuantity updates"},
  {"op": "set", "target": "$totals", "prop": "Style", "value": "\"text-align-right\""},
  {"op": "create", "parent": "$totals", "type": "IExpression", "as": "$count"},
  {"op": "set", "target": "$count", "prop": "Value", "value": "\"Items: \" + LoadSummary.Summary.ItemCount"},
  {"op": "create", "parent": "$totals", "type": "IExpression", "as": "$total"},
  {"op": "set", "target": "$total", "prop": "Value", "value": "\"Total: \" + FormatCurrency(LoadSummary.Summary.Total, \"$\", 2, \".\", \",\")"}
 ]
}
