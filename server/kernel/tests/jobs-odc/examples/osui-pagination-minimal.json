{
 "description": "Pagination of OSUI: the three required inputs and the required event OnNavigate keeping the new start.",
 "base": "tests/fixtures/odc/insurance-reactive-r8.oml",
 "expectValid": true,
 "expectedMessages": [],
 "ops": [
  {"op": "spec", "data": {"entities": [{"name": "PageDemoItem", "attributes": [{"name": "Name", "type": "Text", "length": 50}]}]}},
  {"op": "create", "parent": "IMobileFlow:MainFlow", "type": "IMobileScreen", "name": "PaginationDemo", "as": "$scr"},
  {"op": "set", "target": "$scr/#IMobileBlockInstanceWidget", "prop": "SourceBlock", "value": "IMobileBlock:LayoutTopMenu"},
  {"op": "create", "parent": "$scr", "type": "ILocalVariable", "name": "StartIndex", "as": "$vStartIndex"},
  {"op": "set", "target": "$vStartIndex", "prop": "DataType", "value": "Integer"},
  {"op": "set", "target": "$vStartIndex", "prop": "DefaultValue", "value": "0"},
  {"op": "create", "parent": "$scr", "type": "IScreenAggregate", "name": "GetItems", "as": "$agg"},
  {"op": "create", "parent": "$agg", "type": "IAliasedSource", "args": {"dataSource": "IServerEntity:PageDemoItem"}},
  {"op": "set", "target": "$agg", "prop": "MaxRecords", "value": "10"},
  {"op": "set", "target": "$agg", "prop": "StartIndex", "value": "StartIndex"},
  {"op": "logic", "data": {"actions": [{"name": "PageChanged", "kind": "screen", "owner": "IMobileScreen:PaginationDemo", "inputs": [{"name": "NewStartIndex", "type": "Integer"}], "steps": [{"assign": {"StartIndex": "NewStartIndex"}, "as": "Move"}, {"node": "IRefreshDataNode", "as": "Reload", "properties": {"DataSource": "IMobileScreen:PaginationDemo/GetItems"}}]}]}},
  {"op": "create", "parent": "$scr/#IMobileBlockInstanceWidget/MainContent", "type": "IMobileBlockInstanceWidget", "name": "Pagination1", "source": "IMobileBlock:Pagination", "as": "$pg"},
  {"op": "set", "target": "$pg/StartIndex", "prop": "Value", "value": "StartIndex"},
  {"op": "set", "target": "$pg/MaxRecords", "prop": "Value", "value": "10"},
  {"op": "set", "target": "$pg/TotalCount", "prop": "Value", "value": "GetItems.Count"},
  {"op": "set", "target": "$pg/OnNavigate", "prop": "Handler", "value": "IMobileScreen:PaginationDemo/PageChanged"},
  {"op": "set", "target": "$pg/OnNavigate/NewStartIndex", "prop": "Value", "value": "NewStartIndex"}
 ]
}
