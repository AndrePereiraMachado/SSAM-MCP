{
 "description": "Upload: an IUpload saves the content and the name of the file in two screen variables (Binary Data and Text).",
 "base": "tests/fixtures/odc/insurance-reactive-r8.oml",
 "expectValid": true,
 "expectedMessages": [],
 "ops": [
  {"op": "create", "parent": "IMobileFlow:MainFlow", "type": "IMobileScreen", "name": "UploadDemo", "as": "$scr"},
  {"op": "set", "target": "$scr/#IMobileBlockInstanceWidget", "prop": "SourceBlock", "value": "IMobileBlock:LayoutTopMenu"},
  {"op": "create", "parent": "$scr", "type": "ILocalVariable", "name": "FileContent", "as": "$content"},
  {"op": "set", "target": "$content", "prop": "DataType", "value": "Binary Data"},
  {"op": "create", "parent": "$scr", "type": "ILocalVariable", "name": "FileName", "as": "$name"},
  {"op": "set", "target": "$name", "prop": "DataType", "value": "Text"},
  {"op": "create", "parent": "$scr/#IMobileBlockInstanceWidget/MainContent", "type": "IUpload", "name": "AttachmentUpload", "as": "$up"},
  {"op": "set", "target": "$up", "prop": "FileContent", "value": "FileContent", "_why": "FileContent and FileName are required"},
  {"op": "set", "target": "$up", "prop": "FileName", "value": "FileName"}
 ]
}
