{
 "description": "RangeSliderInterval do OSUI como filtro de faixa de preco: o OnValueChange grava o intervalo e faz Refresh Data dos produtos dentro dele.",
 "base": "tests/fixtures/odc/insurance-reactive-r8.oml",
 "expectValid": true,
 "expectedMessages": [],
 "ops": [
  {"op": "spec", "data": {"entities": [{"name": "Product", "attributes": [{"name": "Name", "type": "Text", "length": 100, "mandatory": true}, {"name": "Price", "type": "Currency"}, {"name": "ImageUrl", "type": "Text", "length": 500}]}]}},
  {"op": "create", "parent": "IMobileFlow:MainFlow", "type": "IMobileScreen", "name": "PriceRangeFilter", "as": "$scr"},
  {"op": "set", "target": "$scr/#IMobileBlockInstanceWidget", "prop": "SourceBlock", "value": "IMobileBlock:LayoutTopMenu"},
  {"op": "create", "parent": "$scr/#IMobileBlockInstanceWidget/Title", "type": "IExpression", "as": "$title"},
  {"op": "set", "target": "$title", "prop": "Value", "value": "\"Price range\""},
  {"op": "create", "parent": "$scr", "type": "ILocalVariable", "name": "MinPrice", "as": "$vMinPrice"},
  {"op": "set", "target": "$vMinPrice", "prop": "DataType", "value": "Decimal"},
  {"op": "set", "target": "$vMinPrice", "prop": "DefaultValue", "value": "0"},
  {"op": "create", "parent": "$scr", "type": "ILocalVariable", "name": "MaxPrice", "as": "$vMaxPrice"},
  {"op": "set", "target": "$vMaxPrice", "prop": "DataType", "value": "Decimal"},
  {"op": "set", "target": "$vMaxPrice", "prop": "DefaultValue", "value": "200"},
  {"op": "create", "parent": "$scr", "type": "IScreenAggregate", "name": "LoadProducts", "as": "$LoadProducts"},
  {"op": "create", "parent": "$LoadProducts", "type": "IAliasedSource", "args": {"dataSource": "IServerEntity:Product"}},
  {"op": "create", "parent": "$LoadProducts", "type": "IFilter", "args": {"condition": "Product.Price >= MinPrice and Product.Price <= MaxPrice"}},
  {"op": "create", "parent": "$LoadProducts", "type": "ISort", "as": "$LoadProductsSort"},
  {"op": "set", "target": "$LoadProductsSort", "prop": "Attribute", "value": "Product.Price"},
  {"op": "logic", "data": {"actions": [{"name": "RangeChanged", "kind": "screen", "owner": "IMobileScreen:PriceRangeFilter", "inputs": [{"name": "IntervalStart", "type": "Decimal"}, {"name": "IntervalEnd", "type": "Decimal"}], "steps": [{"assign": {"MinPrice": "IntervalStart", "MaxPrice": "IntervalEnd"}, "as": "Keep"}, {"node": "IRefreshDataNode", "as": "Reload", "properties": {"DataSource": "IMobileScreen:PriceRangeFilter/LoadProducts"}}]}]}},
  {"op": "create", "parent": "$scr/#IMobileBlockInstanceWidget/MainContent", "type": "IMobileBlockInstanceWidget", "name": "RangeSliderInterval1", "source": "IMobileBlock:RangeSliderInterval", "as": "$ri"},
  {"op": "set", "target": "$ri/MinValue", "prop": "Value", "value": "0"},
  {"op": "set", "target": "$ri/MaxValue", "prop": "Value", "value": "500"},
  {"op": "set", "target": "$ri/StartingValueFrom", "prop": "Value", "value": "MinPrice"},
  {"op": "set", "target": "$ri/StartingValueTo", "prop": "Value", "value": "MaxPrice"},
  {"op": "set", "target": "$ri/OnValueChange", "prop": "Handler", "value": "IMobileScreen:PriceRangeFilter/RangeChanged"},
  {"op": "set", "target": "$ri/OnValueChange/IntervalStart", "prop": "Value", "value": "IntervalStart"},
  {"op": "set", "target": "$ri/OnValueChange/IntervalEnd", "prop": "Value", "value": "IntervalEnd"},
  {"op": "create", "parent": "$scr/#IMobileBlockInstanceWidget/MainContent", "type": "IList", "name": "ProductList", "as": "$list"},
  {"op": "set", "target": "$list", "prop": "Source", "value": "LoadProducts.List"},
  {"op": "create", "parent": "$list", "type": "IExpression", "as": "$expr1"},
  {"op": "set", "target": "$expr1", "prop": "Value", "value": "LoadProducts.List.Current.Product.Name"}
 ]
}
