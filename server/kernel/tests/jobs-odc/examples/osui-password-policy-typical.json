  {"op": "set", "target": "$pp/Compliant/IsValid", "prop": "Value", "value": "IsValid"},
  {"op": "create", "parent": "$scr/#IMobileBlockInstanceWidget/MainContent", "type": "IButton", "name": "ContinueButton", "as": "$bContinueButton"},
  {"op": "set", "target": "$bContinueButton/#ITextWidget", "prop": "Text", "value": "Continue"},
  {"op": "set", "target": "$bContinueButton/OnClick", "prop": "Destination", "value": "IMobileScreen:UserProfile"},
  {"op": "set", "target": "$bContinueButton", "prop": "Enabled", "value": "IsStrong"}
 ]
