{
 "description": "PasswordPolicy do OSUI: Input de senha ligado a variavel, o Compliant grava se a senha cumpre a regra e o botao so liga quando cumpre.",
 "base": "tests/fixtures/odc/insurance-reactive-r8.oml",
 "expectValid": true,
 "expectedMessages": [],
 "ops": [
  {"op": "create", "parent": "IMobileFlow:MainFlow", "type": "IMobileScreen", "name": "SetPassword", "as": "$scr"},
  {"op": "set", "target": "$scr/#IMobileBlockInstanceWidget", "prop": "SourceBlock", "value": "IMobileBlock:LayoutTopMenu"},
  {"op": "create", "parent": "$scr/#IMobileBlockInstanceWidget/Title", "type": "IExpression", "as": "$title"},
  {"op": "set", "target": "$title", "prop": "Value", "value": "\"Password\""},
  {"op": "create", "parent": "$scr", "type": "ILocalVariable", "name": "NewPassword", "as": "$vNewPassword"},
  {"op": "set", "target": "$vNewPassword", "prop": "DataType", "value": "Text"},
  {"op": "create", "parent": "$scr", "type": "ILocalVariable", "name": "IsStrong", "as": "$vIsStrong"},
  {"op": "set", "target": "$vIsStrong", "prop": "DataType", "value": "Boolean"},
  {"op": "logic", "data": {"actions": [{"name": "PolicyChecked", "kind": "screen", "owner": "IMobileScreen:SetPassword", "inputs": [{"name": "IsValid", "type": "Boolean"}], "steps": [{"assign": {"IsStrong": "IsValid"}, "as": "Keep"}]}]}},
  {"op": "create", "parent": "$scr/#IMobileBlockInstanceWidget/MainContent", "type": "IInput", "name": "PasswordInput", "as": "$pw"},
  {"op": "set", "target": "$pw", "prop": "Variable", "value": "NewPassword"},
  {"op": "set", "target": "$pw", "prop": "InputType", "value": "Password"},
  {"op": "create", "parent": "$scr/#IMobileBlockInstanceWidget/MainContent", "type": "IMobileBlockInstanceWidget", "name": "PasswordPolicy1", "source": "IMobileBlock:PasswordPolicy", "as": "$pp"},
  {"op": "set", "target": "$pp/Password", "prop": "Value", "value": "NewPassword"},
