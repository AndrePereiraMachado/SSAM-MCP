{
 "description": "Native Button Group: the group binds the variable and is born with ButtonGroupItem1..3; each item gets its Value and its caption.",
 "base": "tests/fixtures/odc/insurance-reactive-r8.oml",
 "expectValid": true,
 "expectedMessages": [],
 "ops": [
  {"op": "create", "parent": "IMobileFlow:MainFlow", "type": "IMobileScreen", "name": "ButtonGroupDemo", "as": "$scr"},
  {"op": "set", "target": "$scr/#IMobileBlockInstanceWidget", "prop": "SourceBlock", "value": "IMobileBlock:LayoutTopMenu"},
  {"op": "create", "parent": "$scr", "type": "ILocalVariable", "name": "Period", "as": "$period"},
  {"op": "set", "target": "$period", "prop": "DataType", "value": "Text"},
  {"op": "create", "parent": "$scr/#IMobileBlockInstanceWidget/MainContent", "type": "IButtonGroup", "name": "PeriodButtonGroup", "as": "$bg"},
  {"op": "set", "target": "$bg", "prop": "Variable", "value": "Period"},
  {"op": "set", "target": "$bg/Content/ButtonGroupItem1", "prop": "Value", "value": "\"day\"", "_why": "the three items are born without a Value (an error in the Verify): each one gets its own"},
  {"op": "set", "target": "$bg/Content/ButtonGroupItem1/#ITextWidget", "prop": "Text", "value": "Day"},
  {"op": "set", "target": "$bg/Content/ButtonGroupItem2", "prop": "Value", "value": "\"week\""},
  {"op": "set", "target": "$bg/Content/ButtonGroupItem2/#ITextWidget", "prop": "Text", "value": "Week"},
  {"op": "set", "target": "$bg/Content/ButtonGroupItem3", "prop": "Value", "value": "\"month\""},
  {"op": "set", "target": "$bg/Content/ButtonGroupItem3/#ITextWidget", "prop": "Text", "value": "Month"},
  {"op": "dump", "target": "$bg", "depth": 4}
 ]
