{
 "description": "Map of OutSystemsMaps (Google): the API key read from a Setting by a data action, center, height, a MarkerPopup with a text and OnError keeping the failure.",
 "base": "tests/fixtures/odc/insurance-reactive-r8.oml",
 "expectValid": true,
 "expectedMessages": [],
 "ops": [
  {"op": "create", "parent": "@espace", "type": "ISiteProperty", "name": "MapsApiKey", "as": "$key", "_why": "the key stays in a Setting configured in the Portal, never written in the model"},
  {"op": "set", "target": "$key", "prop": "DataType", "value": "Text"},
  {"op": "create", "parent": "IMobileFlow:MainFlow", "type": "IMobileScreen", "name": "GoogleStoreMap", "as": "$scr"},
  {"op": "set", "target": "$scr/#IMobileBlockInstanceWidget", "prop": "SourceBlock", "value": "IMobileBlock:LayoutTopMenu"},
  {"op": "create", "parent": "$scr/#IMobileBlockInstanceWidget/Title", "type": "IExpression", "as": "$title"},
  {"op": "set", "target": "$title", "prop": "Value", "value": "\"Store\""},
  {"op": "create", "parent": "$scr", "type": "ILocalVariable", "name": "MapError", "as": "$vMapError"},
  {"op": "set", "target": "$vMapError", "prop": "DataType", "value": "Text"},
  {"op": "logic", "_why": "Settings exist only on the server: the data action reads the key and the screen uses its output", "data": {"actions": [{"name": "GetMapsConfig", "kind": "data", "owner": "IMobileScreen:GoogleStoreMap", "fetch": "AtStart", "outputs": [{"name": "ApiKey", "type": "Text"}], "steps": [{"assign": {"ApiKey": "Settings.MapsApiKey"}, "as": "ReadKey"}]}]}},
  {"op": "logic", "data": {"actions": [{"name": "MapFailed", "kind": "screen", "owner": "IMobileScreen:GoogleStoreMap", "inputs": [{"name": "Message", "type": "Text"}], "steps": [{"assign": {"MapError": "Message"}, "as": "Keep"}]}]}},
  {"op": "create", "parent": "$scr/#IMobileBlockInstanceWidget/MainContent", "type": "IMobileBlockInstanceWidget", "name": "Map1", "source": "IMobileBlock:Map", "as": "$map"},
  {"op": "set", "target": "$map/APIKey", "prop": "Value", "value": "GetMapsConfig.ApiKey"},
  {"op": "set", "target": "$map/Center", "prop": "Value", "value": "\"Lisbon, Portugal\""},
  {"op": "set", "target": "$map/Height", "prop": "Value", "value": "\"400px\""},
  {"op": "set", "target": "$map/OnError", "prop": "Handler", "value": "IMobileScreen:GoogleStoreMap/MapFailed"},
  {"op": "set", "target": "$map/OnError/Message", "prop": "Value", "value": "ErrorMessage"},
  {"op": "create", "parent": "$map/AddOns_Placeholder", "type": "IMobileBlockInstanceWidget", "name": "StorePin", "source": "IMobileBlock:MarkerPopup", "as": "$mk"},
  {"op": "set", "target": "$mk/Position", "prop": "Value", "value": "\"Lisbon, Portugal\""},
  {"op": "create", "parent": "$mk/Popup", "type": "ITextWidget", "as": "$text1"},
  {"op": "set", "target": "$text1", "prop": "Text", "value": "Our store"},
  {"op": "create", "parent": "$scr/#IMobileBlockInstanceWidget/MainContent", "type": "IExpression", "as": "$expr1"},
  {"op": "set", "target": "$expr1", "prop": "Value", "value": "MapError"}
 ]
}
