{
 "description": "List Item: an IListItem inside the List, with a text in the Content and the sample swipe action removed.",
 "base": "tests/fixtures/odc/insurance-reactive-r8.oml",
 "expectValid": true,
 "expectedMessages": [],
 "ops": [
  {"op": "spec", "data": {"entities": [{"name": "Contact", "attributes": [{"name": "FullName", "type": "Text", "length": 100, "mandatory": true}]}]}},
  {"op": "create", "parent": "IMobileFlow:MainFlow", "type": "IMobileScreen", "name": "Contacts", "as": "$scr"},
  {"op": "set", "target": "$scr/#IMobileBlockInstanceWidget", "prop": "SourceBlock", "value": "IMobileBlock:LayoutTopMenu"},
  {"op": "create", "parent": "$scr", "type": "IScreenAggregate", "name": "GetContacts", "as": "$agg"},
  {"op": "create", "parent": "$agg", "type": "IAliasedSource", "args": {"dataSource": "IServerEntity:Contact"}},
  {"op": "create", "parent": "$scr/#IMobileBlockInstanceWidget/MainContent", "type": "IList", "name": "ContactList", "as": "$list"},
  {"op": "set", "target": "$list", "prop": "Source", "value": "GetContacts.List"},
  {"op": "create", "parent": "$list", "type": "IListItem", "name": "ContactItem", "as": "$item"},
  {"op": "delete", "target": "$item/RightActions/#IListItemAction", "_why": "the List Item is born with a swipe action without an OnClick (an error in the Verify)"},
  {"op": "create", "parent": "$item/Content", "type": "IExpression", "as": "$name"},
  {"op": "set", "target": "$name", "prop": "Value", "value": "GetContacts.List.Current.Contact.FullName"}
 ]
}
