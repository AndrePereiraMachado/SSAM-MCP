{
 "description": "Shapes of OutSystemsMaps in a LeafletMap: a Circle with its radius bound to a variable, a Rectangle and a Polygon, each with an OnClick keeping which zone was clicked.",
 "base": "tests/fixtures/odc/insurance-reactive-r8.oml",
 "expectValid": true,
 "expectedMessages": [],
 "ops": [
  {"op": "create", "parent": "IMobileFlow:MainFlow", "type": "IMobileScreen", "name": "DeliveryZones", "as": "$scr"},
  {"op": "set", "target": "$scr/#IMobileBlockInstanceWidget", "prop": "SourceBlock", "value": "IMobileBlock:LayoutTopMenu"},
  {"op": "create", "parent": "$scr/#IMobileBlockInstanceWidget/Title", "type": "IExpression", "as": "$title"},
  {"op": "set", "target": "$title", "prop": "Value", "value": "\"Delivery zones\""},
  {"op": "create", "parent": "$scr", "type": "ILocalVariable", "name": "RadiusMeters", "as": "$vRadiusMeters"},
  {"op": "set", "target": "$vRadiusMeters", "prop": "DataType", "value": "Integer"},
  {"op": "set", "target": "$vRadiusMeters", "prop": "DefaultValue", "value": "800"},
  {"op": "create", "parent": "$scr", "type": "ILocalVariable", "name": "ClickedZone", "as": "$vClickedZone"},
  {"op": "set", "target": "$vClickedZone", "prop": "DataType", "value": "Text"},
  {"op": "logic", "data": {"actions": [{"name": "ZoneClicked", "kind": "screen", "owner": "IMobileScreen:DeliveryZones", "inputs": [{"name": "Zone", "type": "Text"}], "steps": [{"assign": {"ClickedZone": "Zone"}, "as": "Keep"}]}]}},
  {"op": "create", "parent": "$scr/#IMobileBlockInstanceWidget/MainContent", "type": "IMobileBlockInstanceWidget", "name": "LeafletMap1", "source": "IMobileBlock:LeafletMap", "as": "$map"},
  {"op": "set", "target": "$map/Center", "prop": "Value", "value": "\"38.7223, -9.1393\""},
  {"op": "set", "target": "$map/Height", "prop": "Value", "value": "\"420px\""},
  {"op": "create", "parent": "$map/AddOns_Placeholder", "type": "IMobileBlockInstanceWidget", "name": "CenterZone", "source": "IMobileBlock:Circle", "as": "$c"},
  {"op": "set", "target": "$c/Center", "prop": "Value", "value": "\"38.7223, -9.1393\""},
  {"op": "set", "target": "$c/Radius", "prop": "Value", "value": "RadiusMeters"},
  {"op": "set", "target": "$c/OnClick", "prop": "Handler", "value": "IMobileScreen:DeliveryZones/ZoneClicked"},
  {"op": "set", "target": "$c/OnClick/Zone", "prop": "Value", "value": "\"center\""},
  {"op": "create", "parent": "$map/AddOns_Placeholder", "type": "IMobileBlockInstanceWidget", "name": "NorthZone", "source": "IMobileBlock:Rectangle", "as": "$r"},
  {"op": "set", "target": "$r/North", "prop": "Value", "value": "\"38.76\""},
  {"op": "set", "target": "$r/South", "prop": "Value", "value": "\"38.74\""},
  {"op": "set", "target": "$r/East", "prop": "Value", "value": "\"-9.10\""},
  {"op": "set", "target": "$r/West", "prop": "Value", "value": "\"-9.16\""},
  {"op": "set", "target": "$r/OnClick", "prop": "Handler", "value": "IMobileScreen:DeliveryZones/ZoneClicked"},
  {"op": "set", "target": "$r/OnClick/Zone", "prop": "Value", "value": "\"north\""},
  {"op": "create", "parent": "$map/AddOns_Placeholder", "type": "IMobileBlockInstanceWidget", "name": "RiverZone", "source": "IMobileBlock:Polygon", "as": "$p"},
  {"op": "set", "target": "$p/Locations", "prop": "Value", "value": "[\"38.70, -9.15\", \"38.70, -9.12\", \"38.69, -9.13\"]"},
  {"op": "set", "target": "$p/OnClick", "prop": "Handler", "value": "IMobileScreen:DeliveryZones/ZoneClicked"},
  {"op": "set", "target": "$p/OnClick/Zone", "prop": "Value", "value": "\"river\""},
  {"op": "create", "parent": "$scr/#IMobileBlockInstanceWidget/MainContent", "type": "IExpression", "as": "$expr1"},
  {"op": "set", "target": "$expr1", "prop": "Value", "value": "If(ClickedZone = \"\", \"Click a zone\", \"Zone: \" + ClickedZone)"}
 ]
}
