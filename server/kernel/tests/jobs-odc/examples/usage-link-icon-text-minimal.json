{
 "description": "A Link with an icon and a visible text: the default text of the Link goes out and an Icon and an Expression go in it; the click navigates to another screen.",
 "base": "tests/fixtures/odc/insurance-reactive-r8.oml",
 "expectValid": true,
 "expectedMessages": [],
 "ops": [
  {"op": "create", "parent": "IMobileFlow:MainFlow", "type": "IMobileScreen", "name": "LinkWithIcon", "as": "$scr"},
  {"op": "set", "target": "$scr/#IMobileBlockInstanceWidget", "prop": "SourceBlock", "value": "IMobileBlock:LayoutTopMenu"},

  {"op": "create", "parent": "$scr/#IMobileBlockInstanceWidget/MainContent", "type": "ILink", "name": "ProfileLink", "as": "$lnk"},
  {"op": "delete", "target": "$lnk/#ITextWidget", "_why": "the Link is born with the text 'Link'; to have icon + text, the default text goes out and the children go into the Link"},
  {"op": "create", "parent": "$lnk", "type": "IIcon", "name": "ProfileIcon", "as": "$ico"},
  {"op": "set", "target": "$ico", "prop": "Icon", "value": "user"},
  {"op": "set", "target": "$ico", "prop": "Weight", "value": "regular", "_why": "on ODC the icon name (Phosphor) resolves only together with the Weight"},
  {"op": "create", "parent": "$lnk", "type": "IExpression", "as": "$text"},
  {"op": "set", "target": "$text", "prop": "Value", "value": "\" My profile\""},
  {"op": "set", "target": "$lnk/OnClick", "prop": "Destination", "value": "IMobileScreen:UserProfile", "_why": "UserProfile is a screen the app already has"},

  {"op": "dump", "target": "$lnk", "depth": 3}
 ]
}
