{
 "description": "ODC (coverage T): ROLE, USER EXCEPTION, SETTING and CLIENT VARIABLE, four types that had never passed through the ODC lane. It mirrors tests/jobs/security-config-reactive.json. MIND THE NAME: what SS11 calls Site Property the ODC product calls SETTING; the public API kept the old name (OutSystems.Model.Data.ISiteProperty, IESpace.CreateSiteProperty), so the job creates ISiteProperty but the vocabulary is Setting. Here the two Settings are READ by a server action (in ODC a Setting can only be read: writing inside an action is an error, see the report of front T), one of them is secret, the client variable is read and written by the screen, and the screen is restricted to the role.",
 "base": "tests/fixtures/odc/insurance-reactive-r8.oml",
 "expectValid": true,
 "expectedMessages": [],
 "ops": [
  {"op": "create", "parent": "@espace", "type": "IRole", "name": "WfCovAuditor", "as": "$role"},
  {"op": "set", "target": "$role", "prop": "Description", "value": "Cobertura T: ve a tela de auditoria"},

  {"op": "create", "parent": "@espace", "type": "ISiteProperty", "name": "WfCovMaxRows", "as": "$setting"},
  {"op": "set", "target": "$setting", "prop": "DataType", "value": "Integer"},
  {"op": "set", "target": "$setting", "prop": "DefaultValue", "value": "100"},
  {"op": "set", "target": "$setting", "prop": "Description", "value": "Cobertura T: Setting (Site Property na API) lida pela logica de auditoria"},

  {"op": "create", "parent": "@espace", "type": "ISiteProperty", "name": "WfCovAuditToken", "as": "$secret"},
  {"op": "set", "target": "$secret", "prop": "DataType", "value": "Text"},
  {"op": "set", "target": "$secret", "prop": "IsSecret", "value": true, "_why": "secret Setting: the value does not travel in the OML nor appear in the Studio; it is the ModelFeature_SitePropertiesSupportsSecrets of ODC"},
  {"op": "set", "target": "$secret", "prop": "Description", "value": "Cobertura T: Setting secreta"},

  {"op": "create", "parent": "@espace", "type": "IClientVariable", "name": "WfCovLastFilter", "as": "$clientvar"},
  {"op": "set", "target": "$clientvar", "prop": "DataType", "value": "Text"},
  {"op": "set", "target": "$clientvar", "prop": "Description", "value": "Cobertura T: ultimo filtro escrito na tela, sobrevive a navegacao"},

  {"op": "create", "parent": "@espace", "type": "IUserException", "name": "WfCovNotAllowed", "as": "$exception"},

  {
   "op": "logic",
   "data": {
    "actions": [
     {
      "name": "WfCovAudit_Check",
      "kind": "server",
      "description": "Cobertura T: le as duas Settings e levanta a excecao de usuario quando o pedido passa do limite",
      "inputs": [
       {"name": "Rows", "type": "Integer"},
       {"name": "Token", "type": "Text"}
      ],
      "outputs": [{"name": "Allowed", "type": "Boolean"}],
      "steps": [
       {"if": "Rows > Settings.WfCovMaxRows", "then": [{"raise": "WfCovNotAllowed", "message": "\"Too many rows requested: the WfCovMaxRows setting allows \" + IntegerToText(Settings.WfCovMaxRows)"}]},
       {"if": "Token <> Settings.WfCovAuditToken", "then": [{"raise": "WfCovNotAllowed", "message": "\"Wrong audit token\""}]},
       {"assign": {"Allowed": "True"}, "as": "SetAllowed"}
      ]
     }
    ]
   }
  },

  {"op": "create", "parent": "IMobileFlow:MainFlow", "type": "IMobileScreen", "name": "WfCovAuditScreen", "as": "$scr"},
  {"op": "set", "target": "$scr/#IMobileBlockInstanceWidget", "prop": "SourceBlock", "value": "IMobileBlock:LayoutTopMenu"},
  {"op": "link", "from": "$scr", "connector": "Roles", "to": "$role", "_why": "this is how the screen is restricted to the role, same as the SS11 job"},
  {"op": "create", "parent": "$scr/#IMobileBlockInstanceWidget/Title", "type": "IExpression", "as": "$title"},
  {"op": "set", "target": "$title", "prop": "Value", "value": "\"Audit\""},

  {"op": "create", "parent": "$scr", "type": "ILocalVariable", "name": "Filter", "as": "$filter"},
  {"op": "set", "target": "$filter", "prop": "DataType", "value": "Text"},

  {"op": "create", "parent": "$scr/#IMobileBlockInstanceWidget/MainContent", "type": "IContainer", "name": "AuditBox", "as": "$box"},
  {"op": "create", "parent": "$box", "type": "IExpression", "as": "$last"},
  {"op": "set", "target": "$last", "prop": "Value", "value": "\"Last filter: \" + Client.WfCovLastFilter", "_why": "reads the client variable in a screen expression"},
  {"op": "create", "parent": "$box", "type": "IInput", "name": "FilterInput", "as": "$input"},
  {"op": "set", "target": "$input", "prop": "Variable", "value": "Filter"},
  {"op": "create", "parent": "$box", "type": "IButton", "name": "ApplyButton", "as": "$btn"},
  {"op": "set", "target": "$btn/#ITextWidget", "prop": "Text", "value": "Apply"},

  {"op": "create", "parent": "$scr", "type": "IScreenAction", "name": "ApplyFilter", "as": "$act"},
  {"op": "create", "parent": "$act", "type": "IStartNode", "as": "$n0"},
  {"op": "create", "parent": "$act", "type": "IAssignNode", "as": "$remember"},
  {"op": "set", "target": "$remember", "prop": "Label", "value": "RememberFilter"},
  {"op": "create", "parent": "$remember", "type": "IAssignment", "as": "$assign1"},
  {"op": "set", "target": "$assign1", "prop": "Variable", "value": "Client.WfCovLastFilter", "_why": "writes the client variable: this is what a Setting does NOT allow in ODC"},
  {"op": "set", "target": "$assign1", "prop": "Value", "value": "Filter"},
  {"op": "create", "parent": "$act", "type": "IExecuteServerActionNode", "name": "CheckAudit", "as": "$call"},
  {"op": "set", "target": "$call", "prop": "Action", "value": "IServerAction:WfCovAudit_Check"},
  {"op": "set", "target": "$call/Rows", "prop": "Value", "value": "Length(Filter)"},
  {"op": "set", "target": "$call/Token", "prop": "Value", "value": "Filter"},
  {"op": "create", "parent": "$act", "type": "IEndNode", "as": "$n9"},
  {"op": "link", "from": "$n0", "to": "$remember"},
  {"op": "link", "from": "$remember", "to": "$call"},
  {"op": "link", "from": "$call", "to": "$n9"},
  {"op": "layout", "target": "$act"},
  {"op": "set", "target": "$btn/OnClick", "prop": "Destination", "value": "$act"},

  {"op": "get", "target": "$setting", "_why": "prova DataType e DefaultValue da Setting"},
  {"op": "get", "target": "$secret", "_why": "proves IsSecret on the secret Setting"},
  {"op": "get", "target": "$scr", "_why": "proves the screen ended up with Roles filled in"},
  {"op": "usages", "target": "$exception", "_why": "proves the user exception is raised in both branches"},
  {"op": "usages", "target": "$clientvar", "_why": "proves the client variable read in the expression and written in the Assign"}
 ]
}

