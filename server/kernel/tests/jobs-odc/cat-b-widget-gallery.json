{
 "description": "Front B (broad catalog): native Reactive widgets that no ODC job created, over job:screen-form (entity WfCovTask and screen WfCovTaskDetail with the input TaskId). ODC equivalent of the corresponding part of tests/jobs/gallery-native-reactive.json, with the lane differences: the caption of a button, link and label lives in the Content of the widget (addressed by #ITextWidget), and the popup children go in its Content (ODC Model API of the NRWidgets plugin). It covers: TextArea, Switch, Dropdown bound to the aggregate, Link that navigates to the detail screen with an argument, external Image, If with both branches, Popup opened and closed by a screen action; and the usages -> delete cycle of an Input that a Label points to (the Label goes first). Radio, table and upload are in cat-b-choice-table.json.",
 "base": "job:screen-form",
 "expectValid": true,
 "expectedMessages": [],
 "ops": [
  {"op": "create", "parent": "IMobileFlow:MainFlow", "type": "IMobileScreen", "name": "CatBWidgetGallery", "as": "$scr", "_why": "1. the screen, the variables the widgets bind and the aggregate that feeds the dropdown"},
  {"op": "set", "target": "$scr/#IMobileBlockInstanceWidget", "prop": "SourceBlock", "value": "IMobileBlock:LayoutTopMenu"},
  {"op": "create", "parent": "$scr/#IMobileBlockInstanceWidget/Title", "type": "IExpression", "as": "$title"},
  {"op": "set", "target": "$title", "prop": "Value", "value": "\"Widget gallery\""},
  {"op": "create", "parent": "$scr", "type": "ILocalVariable", "name": "TitleVar", "as": "$vTitle"},
  {"op": "set", "target": "$vTitle", "prop": "DataType", "value": "Text"},
  {"op": "create", "parent": "$scr", "type": "ILocalVariable", "name": "DoneVar", "as": "$vDone"},
  {"op": "set", "target": "$vDone", "prop": "DataType", "value": "Boolean"},
  {"op": "create", "parent": "$scr", "type": "ILocalVariable", "name": "TaskVar", "as": "$vTask"},
  {"op": "set", "target": "$vTask", "prop": "DataType", "value": "WfCovTask Identifier"},
  {"op": "create", "parent": "$scr", "type": "ILocalVariable", "name": "ShowPopup", "as": "$vPopup"},
  {"op": "set", "target": "$vPopup", "prop": "DataType", "value": "Boolean"},
  {"op": "create", "parent": "$scr", "type": "IScreenAggregate", "name": "GetTasks", "as": "$agg"},
  {"op": "create", "parent": "$agg", "type": "IAliasedSource", "args": {"dataSource": "IServerEntity:WfCovTask"}},

  {"op": "create", "parent": "$scr", "type": "IScreenAction", "name": "TogglePopup", "as": "$toggle", "_why": "2. the screen action that opens and closes the popup"},
  {"op": "create", "parent": "$toggle", "type": "IStartNode", "as": "$t0"},
  {"op": "create", "parent": "$toggle", "type": "IAssignNode", "as": "$tAssign"},
  {"op": "set", "target": "$tAssign", "prop": "Label", "value": "FlipPopup"},
  {"op": "create", "parent": "$tAssign", "type": "IAssignment", "as": "$tA1"},
  {"op": "set", "target": "$tA1", "prop": "Variable", "value": "ShowPopup"},
  {"op": "set", "target": "$tA1", "prop": "Value", "value": "not ShowPopup"},
  {"op": "create", "parent": "$toggle", "type": "IEndNode", "as": "$t9"},
  {"op": "link", "from": "$t0", "to": "$tAssign"},
  {"op": "link", "from": "$tAssign", "to": "$t9"},
  {"op": "layout", "target": "$toggle"},

  {"op": "create", "parent": "$scr/#IMobileBlockInstanceWidget/MainContent", "type": "IContainer", "name": "Inputs", "as": "$c1", "_why": "3. value widgets"},
  {"op": "set", "target": "$c1", "prop": "Style", "value": "\"padding-m\""},
  {"op": "create", "parent": "$c1", "type": "ILabel", "name": "Scratch_Label", "as": "$lbl"},
  {"op": "set", "target": "$lbl/#ITextWidget", "prop": "Text", "value": "Scratch"},
  {"op": "create", "parent": "$c1", "type": "IInput", "name": "Scratch_Input", "as": "$in"},
  {"op": "set", "target": "$in", "prop": "Variable", "value": "TitleVar"},
  {"op": "set", "target": "$in", "prop": "Prompt", "value": "\"Type here\""},
  {"op": "set", "target": "$lbl", "prop": "TargetWidget", "value": "$in"},
  {"op": "create", "parent": "$c1", "type": "ITextArea", "name": "Notes_TextArea", "as": "$ta"},
  {"op": "set", "target": "$ta", "prop": "Variable", "value": "TitleVar"},
  {"op": "set", "target": "$ta", "prop": "TextLines", "value": 3},
  {"op": "create", "parent": "$c1", "type": "ISwitch", "name": "Done_Switch", "as": "$sw"},
  {"op": "set", "target": "$sw", "prop": "Variable", "value": "DoneVar"},
  {"op": "create", "parent": "$c1", "type": "IDropdown", "name": "Task_Dropdown", "as": "$dd"},
  {"op": "set", "target": "$dd", "prop": "List", "value": "GetTasks.List"},
  {"op": "set", "target": "$dd", "prop": "Values", "value": "WfCovTask.Id"},
  {"op": "set", "target": "$dd", "prop": "Labels", "value": "WfCovTask.Title"},
  {"op": "set", "target": "$dd", "prop": "Variable", "value": "TaskVar"},

  {"op": "create", "parent": "$scr/#IMobileBlockInstanceWidget/MainContent", "type": "IContainer", "name": "Actions", "as": "$c2", "_why": "4. widgets de navegacao e conteudo"},
  {"op": "set", "target": "$c2", "prop": "Style", "value": "\"padding-m\""},
  {"op": "create", "parent": "$c2", "type": "IButton", "name": "Toggle_Button", "as": "$btn"},
  {"op": "set", "target": "$btn/#ITextWidget", "prop": "Text", "value": "Show popup"},
  {"op": "set", "target": "$btn/OnClick", "prop": "Destination", "value": "$toggle"},
  {"op": "create", "parent": "$c2", "type": "ILink", "name": "OpenTask_Link", "as": "$lnk"},
  {"op": "set", "target": "$lnk/#ITextWidget", "prop": "Text", "value": "Open selected task"},
  {"op": "set", "target": "$lnk/OnClick", "prop": "Destination", "value": "IMobileScreen:WfCovTaskDetail"},
  {"op": "set", "target": "$lnk/OnClick/TaskId", "prop": "Value", "value": "TaskVar"},
  {"op": "create", "parent": "$c2", "type": "IImage", "name": "Banner_Image", "as": "$img"},
  {"op": "set", "target": "$img", "prop": "Type", "value": "External"},
  {"op": "set", "target": "$img", "prop": "Url", "value": "\"https://picsum.photos/200/120\""},

  {"op": "create", "parent": "$scr/#IMobileBlockInstanceWidget/MainContent", "type": "IContainer", "name": "State", "as": "$c3", "_why": "5. If with both branches and the popup"},
  {"op": "set", "target": "$c3", "prop": "Style", "value": "\"padding-m\""},
  {"op": "create", "parent": "$c3", "type": "IIfWidget", "name": "Done_If", "as": "$if"},
  {"op": "set", "target": "$if", "prop": "Condition", "value": "DoneVar"},
  {"op": "create", "parent": "$if/TrueBranch", "type": "IExpression", "as": "$ifT"},
  {"op": "set", "target": "$ifT", "prop": "Value", "value": "\"Done\""},
  {"op": "create", "parent": "$if/FalseBranch", "type": "IExpression", "as": "$ifF"},
  {"op": "set", "target": "$ifF", "prop": "Value", "value": "\"Open\""},
  {"op": "create", "parent": "$c3", "type": "IPopup", "name": "Info_Popup", "as": "$pop"},
  {"op": "set", "target": "$pop", "prop": "ShowPopup", "value": "ShowPopup"},
  {"op": "create", "parent": "$pop/Content", "type": "IExpression", "as": "$popText"},
  {"op": "set", "target": "$popText", "prop": "Value", "value": "\"Task details are one link away\""},
  {"op": "create", "parent": "$pop/Content", "type": "IButton", "name": "Close_Button", "as": "$close"},
  {"op": "set", "target": "$close/#ITextWidget", "prop": "Text", "value": "Close"},
  {"op": "set", "target": "$close/OnClick", "prop": "Destination", "value": "$toggle"},

  {"op": "get", "target": "$dd", "_why": "6. LER DE VOLTA"},
  {"op": "get", "target": "$lnk/OnClick"},
  {"op": "get", "target": "$img"},
  {"op": "get", "target": "$if"},
  {"op": "get", "target": "$pop"},
  {"op": "get", "target": "$sw"},
  {"op": "get", "target": "$ta"},

  {"op": "usages", "target": "$in", "_why": "7. the Input has 1 consumer: the TargetWidget of the Label"},
  {"op": "delete", "target": "$lbl", "_why": "the consumer goes first"},
  {"op": "delete", "target": "$in", "_why": "now the Input goes without force"},
  {"op": "usages", "target": "$toggle", "_why": "the action has the two OnClick as consumers"},
  {"op": "dump", "target": "$scr", "depth": 8}
 ]
}
