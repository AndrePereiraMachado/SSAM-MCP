{
 "description": "Front B (broad catalog): lifecycle of SCREEN and of BLOCK linked to screen actions, the gap that no ODC job covered (only the OnAfterFetch of a Data Action had proof). The screen CatBLifeDemo links OnInitialize, OnReady and OnDestroy to three screen actions without outputs that write a local variable; the block CatBLifeBadge links OnParametersChanged to a screen action of the block itself that copies the input to a variable; the screen instantiates the block passing the variable as an argument. The job reads back each event (Destination) and the consumers of the actions. Same scenario, by design, as tests/jobs/cat-b-screen-lifecycle.json (O11 Reactive); independent results per lane.",
 "base": "tests/fixtures/odc/insurance-reactive-r8.oml",
 "expectValid": true,
 "expectedMessages": [],
 "ops": [
  {"op": "create", "parent": "IMobileFlow:MainFlow", "type": "IMobileBlock", "name": "CatBLifeBadge", "as": "$blk", "_why": "1. the block: an input and a variable that OnParametersChanged maintains"},
  {"op": "create", "parent": "$blk", "type": "IInputParameter", "name": "Label", "as": "$blkIn"},
  {"op": "set", "target": "$blkIn", "prop": "DataType", "value": "Text"},
  {"op": "create", "parent": "$blk", "type": "ILocalVariable", "name": "Shown", "as": "$shown"},
  {"op": "set", "target": "$shown", "prop": "DataType", "value": "Text"},
  {"op": "create", "parent": "$blk", "type": "IContainer", "name": "BadgeBody", "as": "$bbody"},
  {"op": "create", "parent": "$bbody", "type": "IExpression", "as": "$bexpr"},
  {"op": "set", "target": "$bexpr", "prop": "Value", "value": "Shown"},
  {"op": "create", "parent": "$blk", "type": "IScreenAction", "name": "LabelChanged", "as": "$pc", "_why": "2. the handler of OnParametersChanged: screen action of the block itself, without outputs"},
  {"op": "create", "parent": "$pc", "type": "IStartNode", "as": "$pc0"},
  {"op": "create", "parent": "$pc", "type": "IAssignNode", "as": "$pcAssign"},
  {"op": "set", "target": "$pcAssign", "prop": "Label", "value": "KeepLabel"},
  {"op": "create", "parent": "$pcAssign", "type": "IAssignment", "as": "$pcA1"},
  {"op": "set", "target": "$pcA1", "prop": "Variable", "value": "Shown"},
  {"op": "set", "target": "$pcA1", "prop": "Value", "value": "Label"},
  {"op": "create", "parent": "$pc", "type": "IEndNode", "as": "$pc9"},
  {"op": "link", "from": "$pc0", "to": "$pcAssign"},
  {"op": "link", "from": "$pcAssign", "to": "$pc9"},
  {"op": "layout", "target": "$pc"},
  {"op": "set", "target": "$blk/OnParametersChanged", "prop": "Destination", "value": "$pc", "_why": "3. the link of the lifecycle of the block: the same verb and the same property as an OnClick"},

  {"op": "create", "parent": "IMobileFlow:MainFlow", "type": "IMobileScreen", "name": "CatBLifeDemo", "as": "$scr", "_why": "4. the screen and its three lifecycle events"},
  {"op": "set", "target": "$scr/#IMobileBlockInstanceWidget", "prop": "SourceBlock", "value": "IMobileBlock:LayoutTopMenu"},
  {"op": "create", "parent": "$scr/#IMobileBlockInstanceWidget/Title", "type": "IExpression", "as": "$title"},
  {"op": "set", "target": "$title", "prop": "Value", "value": "\"Lifecycle\""},
  {"op": "create", "parent": "$scr", "type": "ILocalVariable", "name": "Status", "as": "$status"},
  {"op": "set", "target": "$status", "prop": "DataType", "value": "Text"},

  {"op": "create", "parent": "$scr", "type": "IScreenAction", "name": "InitStatus", "as": "$init"},
  {"op": "create", "parent": "$init", "type": "IStartNode", "as": "$i0"},
  {"op": "create", "parent": "$init", "type": "IAssignNode", "as": "$iAssign"},
  {"op": "set", "target": "$iAssign", "prop": "Label", "value": "MarkInitialized"},
  {"op": "create", "parent": "$iAssign", "type": "IAssignment", "as": "$iA1"},
  {"op": "set", "target": "$iA1", "prop": "Variable", "value": "Status"},
  {"op": "set", "target": "$iA1", "prop": "Value", "value": "\"initialized\""},
  {"op": "create", "parent": "$init", "type": "IEndNode", "as": "$i9"},
  {"op": "link", "from": "$i0", "to": "$iAssign"},
  {"op": "link", "from": "$iAssign", "to": "$i9"},
  {"op": "layout", "target": "$init"},

  {"op": "create", "parent": "$scr", "type": "IScreenAction", "name": "ReadyStatus", "as": "$ready"},
  {"op": "create", "parent": "$ready", "type": "IStartNode", "as": "$r0"},
  {"op": "create", "parent": "$ready", "type": "IAssignNode", "as": "$rAssign"},
  {"op": "set", "target": "$rAssign", "prop": "Label", "value": "MarkReady"},
  {"op": "create", "parent": "$rAssign", "type": "IAssignment", "as": "$rA1"},
  {"op": "set", "target": "$rA1", "prop": "Variable", "value": "Status"},
  {"op": "set", "target": "$rA1", "prop": "Value", "value": "Status + \" / ready\""},
  {"op": "create", "parent": "$ready", "type": "IEndNode", "as": "$r9"},
  {"op": "link", "from": "$r0", "to": "$rAssign"},
  {"op": "link", "from": "$rAssign", "to": "$r9"},
  {"op": "layout", "target": "$ready"},

  {"op": "create", "parent": "$scr", "type": "IScreenAction", "name": "ClearStatus", "as": "$clear"},
  {"op": "create", "parent": "$clear", "type": "IStartNode", "as": "$c0"},
  {"op": "create", "parent": "$clear", "type": "IAssignNode", "as": "$cAssign"},
  {"op": "set", "target": "$cAssign", "prop": "Label", "value": "ClearOnLeave"},
  {"op": "create", "parent": "$cAssign", "type": "IAssignment", "as": "$cA1"},
  {"op": "set", "target": "$cA1", "prop": "Variable", "value": "Status"},
  {"op": "set", "target": "$cA1", "prop": "Value", "value": "\"\""},
  {"op": "create", "parent": "$clear", "type": "IEndNode", "as": "$c9"},
  {"op": "link", "from": "$c0", "to": "$cAssign"},
  {"op": "link", "from": "$cAssign", "to": "$c9"},
  {"op": "layout", "target": "$clear"},

  {"op": "set", "target": "$scr/OnInitialize", "prop": "Destination", "value": "$init", "_why": "5. the three lifecycle links of the screen"},
  {"op": "set", "target": "$scr/OnReady", "prop": "Destination", "value": "$ready"},
  {"op": "set", "target": "$scr/OnDestroy", "prop": "Destination", "value": "$clear"},

  {"op": "create", "parent": "$scr/#IMobileBlockInstanceWidget/MainContent", "type": "IExpression", "as": "$show"},
  {"op": "set", "target": "$show", "prop": "Value", "value": "Status"},
  {"op": "create", "parent": "$scr/#IMobileBlockInstanceWidget/MainContent", "type": "IMobileBlockInstanceWidget", "name": "Badge", "source": "IMobileBlock:CatBLifeBadge", "as": "$inst", "_why": "6. the block instance receives the variable of the screen: each change fires the OnParametersChanged of the block"},
  {"op": "set", "target": "$inst/Label", "prop": "Value", "value": "Status"},

  {"op": "get", "target": "$scr/OnInitialize", "_why": "7. READ BACK: each event points to its action"},
  {"op": "get", "target": "$scr/OnReady"},
  {"op": "get", "target": "$scr/OnDestroy"},
  {"op": "get", "target": "$blk/OnParametersChanged"},
  {"op": "usages", "target": "$ready", "_why": "the consumer of the action is the lifecycle event of the screen"},
  {"op": "usages", "target": "$pc", "_why": "the consumer of the action of the block is the OnParametersChanged"},
  {"op": "dump", "target": "$scr", "depth": 4}
 ]
}
