{
 "description": "ODC: o layout automatico (depois das ops, fora de qualquer uma) com conectores que ele nao pode seguir (cobertura testada, fase 2). Um comentario de processo ligado ao End e um comentario do fluxo de UI ligado a uma tela: IActionConnector.Target caia com InvalidCastException ('to type IActionNode') e o job abortava sem indice de op. O layout ignora conector cujo alvo nao e no de logica (e alvo nulo, o caso do Switch copiado no O11, tambem aqui exercitado); o resto do desenho fica igual. Mesmo cenario na faixa O11: tests/jobs/layout-unfollowed-connectors.json.",
 "base": "tests/fixtures/odc/insurance-reactive-r8.oml",
 "expectValid": true,
 "expectedMessages": [{"id": "UnusedUserAction", "element": "InsuranceApp (ESpace) / LayoutSwitchCopy (ServerAction)", "why": "ODC: um app (CrossDevice) nao expoe server action publica (o Studio ao vivo da erro); a action fica privada e sem consumidor neste job de prova"}],
 "ops": [
  {"op": "create", "parent": "@espace", "type": "IServerAction", "name": "LayoutSwitchCopy", "as": "$act"},
  {"op": "create", "parent": "$act", "type": "IStartNode", "as": "$s"},
  {"op": "create", "parent": "$act", "type": "IEndNode", "as": "$e"},
  {"op": "create", "parent": "$act", "type": "ISwitchNode", "as": "$sw"},
  {"op": "create", "parent": "$sw", "type": "ISwitchCondition", "as": "$c1"},
  {"op": "set", "target": "$c1", "prop": "Value", "value": "True"},
  {"op": "create", "parent": "$act", "type": "IEndNode", "as": "$e1"},
  {"op": "link", "from": "$c1", "to": "$e1"},
  {"op": "link", "from": "$s", "to": "$sw"},
  {"op": "link", "from": "$sw", "connector": "OtherwiseTarget", "to": "$e"},
  {"op": "duplicate", "target": "$sw", "as": "$copy"},
  {"op": "link", "from": "$sw", "connector": "OtherwiseTarget", "to": "$copy"},
  {"op": "link", "from": "$copy", "connector": "OtherwiseTarget", "to": "$e"},

  {"op": "create", "parent": "@espace", "type": "IProcess", "name": "LayoutCommentProcess", "as": "$proc"},
  {"op": "set", "target": "$proc", "prop": "Detail", "value": "\"Proof\""},
  {"op": "create", "parent": "$proc", "type": "IStartNode", "as": "$ps"},
  {"op": "create", "parent": "$proc", "type": "IEndNode", "as": "$pe"},
  {"op": "link", "from": "$ps", "to": "$pe"},
  {"op": "create", "parent": "$proc", "type": "ICommentNode", "as": "$note"},
  {"op": "create", "parent": "$note", "type": "OutSystems.Model.Processes.Nodes.ICommentConnector", "args": {"target": "$pe"}},

  {"op": "create", "parent": "IMobileFlow:MainFlow", "type": "IMobileScreen", "name": "LayoutCommentScreen", "as": "$scr"},
  {"op": "set", "target": "$scr/#IMobileBlockInstanceWidget", "prop": "SourceBlock", "value": "IMobileBlock:LayoutTopMenu"},
  {"op": "create", "parent": "IMobileFlow:MainFlow", "type": "OutSystems.Model.UI.Mobile.IComment", "as": "$flowNote"},
  {"op": "set", "target": "$flowNote", "prop": "Text", "value": "Proof"},
  {"op": "create", "parent": "$flowNote", "type": "OutSystems.Model.UI.Mobile.ICommentConnector", "args": {"target": "$scr"}}
 ]
}
