{
 "description": "ODC: rename INTERFACE and read back the CSS and the URLs that were left behind, the mirror of tests/jobs/rename-interface-propagation.json. Screen, block, block parameter and screen variable are renamed; the job reads the StyleSheet of the screen itself and of the block itself, the CSS class in the Style property, the button caption and a variable with a deep link written by hand. It also serves to compare with the O11 lane what the platform rewrites by itself.",
 "base": "tests/fixtures/odc/insurance-reactive-r8.oml",
 "expectValid": true,
 "expectedMessages": [],
 "ops": [
  {"op": "create", "parent": "IMobileFlow:MainFlow", "type": "IMobileBlock", "name": "WfRenCard", "as": "$blk", "_why": "1. the block: own CSS with the name of the block in the class, and an input cited by an expression"},
  {"op": "set", "target": "$blk", "prop": "StyleSheet", "value": ".wfren-card { border: 1px solid #ddd; }\n.wfren-card__title { font-weight: 700; }"},
  {"op": "set", "target": "$blk", "prop": "Description", "value": "Cartao do WfRenCard, estilizado pela classe wfren-card"},
  {"op": "create", "parent": "$blk", "type": "IInputParameter", "name": "Caption", "as": "$blkIn"},
  {"op": "set", "target": "$blkIn", "prop": "DataType", "value": "Text"},
  {"op": "create", "parent": "$blk", "type": "IContainer", "name": "CardBody", "as": "$cardBody"},
  {"op": "set", "target": "$cardBody", "prop": "Style", "value": "\"wfren-card\""},
  {"op": "create", "parent": "$cardBody", "type": "IExpression", "as": "$cardText"},
  {"op": "set", "target": "$cardText", "prop": "Value", "value": "\"WfRenCard: \" + Caption"},

  {"op": "create", "parent": "IMobileFlow:MainFlow", "type": "IMobileScreen", "name": "WfRenDetail", "as": "$det", "_why": "2. o destino da navegacao"},
  {"op": "set", "target": "$det/#IMobileBlockInstanceWidget", "prop": "SourceBlock", "value": "IMobileBlock:LayoutTopMenu"},
  {"op": "create", "parent": "$det", "type": "IInputParameter", "name": "NoticeId", "as": "$detIn"},
  {"op": "set", "target": "$detIn", "prop": "DataType", "value": "Integer"},
  {"op": "create", "parent": "$det/#IMobileBlockInstanceWidget/Title", "type": "IExpression", "as": "$detTitle"},
  {"op": "set", "target": "$detTitle", "prop": "Value", "value": "\"WfRenDetail \" + IntegerToText(NoticeId)"},

  {"op": "create", "parent": "IMobileFlow:MainFlow", "type": "IMobileScreen", "name": "WfRenList", "as": "$scr", "_why": "3. the consuming screen: own CSS, class in the container, block instance, hand-written deep link and a button that navigates"},
  {"op": "set", "target": "$scr/#IMobileBlockInstanceWidget", "prop": "SourceBlock", "value": "IMobileBlock:LayoutTopMenu"},
  {"op": "set", "target": "$scr", "prop": "StyleSheet", "value": ".wfren-list { padding: 16px; }\n.wfren-list .wfren-card { margin-bottom: 8px; }"},
  {"op": "create", "parent": "$scr", "type": "ILocalVariable", "name": "DetailUrl", "as": "$url"},
  {"op": "set", "target": "$url", "prop": "DataType", "value": "Text"},
  {"op": "set", "target": "$url", "prop": "DefaultValue", "value": "\"/InsuranceApp/WfRenDetail?NoticeId=1\""},
  {"op": "create", "parent": "$scr/#IMobileBlockInstanceWidget/Title", "type": "IExpression", "as": "$title"},
  {"op": "set", "target": "$title", "prop": "Value", "value": "\"WfRen notices\""},
  {"op": "create", "parent": "$scr/#IMobileBlockInstanceWidget/MainContent", "type": "IContainer", "name": "ListBody", "as": "$listBody"},
  {"op": "set", "target": "$listBody", "prop": "Style", "value": "\"wfren-list\""},
  {"op": "create", "parent": "$listBody", "type": "IMobileBlockInstanceWidget", "name": "WfRenCard1", "as": "$inst", "source": "IMobileBlock:WfRenCard"},
  {"op": "set", "target": "$inst/Caption", "prop": "Value", "value": "\"Primeiro WfRenCard\""},
  {"op": "create", "parent": "$listBody", "type": "IExpression", "as": "$urlText"},
  {"op": "set", "target": "$urlText", "prop": "Value", "value": "\"Link directo: \" + DetailUrl"},
  {"op": "create", "parent": "$listBody", "type": "IButton", "name": "OpenDetailButton", "as": "$btn"},
  {"op": "set", "target": "$btn/#ITextWidget", "prop": "Text", "value": "Abrir o WfRenDetail"},
  {"op": "set", "target": "$btn/OnClick", "prop": "Destination", "value": "$det"},
  {"op": "set", "target": "$btn/OnClick/NoticeId", "prop": "Value", "value": "1"},

  {"op": "usages", "target": "$det", "_why": "4. ANTES"},
  {"op": "usages", "target": "$blk"},

  {"op": "rename", "target": "$det", "name": "WfRenNoticeDetail", "_why": "5. renomear a TELA de destino"},
  {"op": "get", "target": "$btn/OnClick", "_why": "READ BACK: the Destination followed by key"},
  {"op": "get", "target": "$url", "_why": "the deep link written by hand still points to /InsuranceApp/WfRenDetail"},
  {"op": "get", "target": "$btn/#ITextWidget", "_why": "and the caption of the button still says WfRenDetail"},

  {"op": "rename", "target": "$blk", "name": "WfRenNoticeCard", "_why": "6. renomear o BLOCO"},
  {"op": "get", "target": "$inst", "_why": "READ BACK: the name of the instance and the SourceBlock"},
  {"op": "get", "target": "$blk", "_why": "the StyleSheet of the block still defines .wfren-card and the Description did not change"},
  {"op": "get", "target": "$cardBody", "_why": "the CSS class in the Style property is a literal: it did not change"},

  {"op": "rename", "target": "$blkIn", "name": "Heading", "_why": "7. renomear o PARAMETRO do bloco"},
  {"op": "get", "target": "$inst/Heading"},
  {"op": "get", "target": "$cardText"},

  {"op": "rename", "target": "$url", "name": "NoticeDetailUrl", "_why": "8. rename the screen VARIABLE"},
  {"op": "get", "target": "$urlText"},

  {"op": "rename", "target": "$scr", "name": "WfRenNoticeList", "_why": "9. rename the consuming SCREEN itself"},
  {"op": "get", "target": "$scr", "_why": "READ BACK: the StyleSheet of the screen still talks about .wfren-list and .wfren-card"},
  {"op": "get", "target": "$listBody"},

  {"op": "dump", "target": "$scr", "depth": 7},
  {"op": "dump", "target": "$blk", "depth": 5}
 ]
}
