{
 "description": "The mirror of tests/jobs/refactor-duplicate.json in the ODC lane, on the InsuranceApp of the personal tenant: attribute, whole entity, widget inside a container, screen action with its nodes and the whole screen. It proves that the duplicate verb behaves the same in both lanes -- suffix chosen by the platform, copy at the end of the sequence of the same parent, and copy without consumers.",
 "base": "tests/fixtures/odc/insurance-reactive-r8.oml",
 "expectValid": true,
 "expectedMessages": [
  {
   "id": "UnusedAction",
   "element": "WfDupScreen (MobileScreen) / Greet2 (ScreenAction)",
   "why": "The copy of a screen action is born without consumers: that is exactly what this job proves, and the ODC Verify says the same as the O11 one."
  },
  {
   "id": "UnusedAction",
   "element": "WfDupScreen2 (MobileScreen) / Greet2 (ScreenAction)",
   "why": "The copied screen carries the two actions, and the copy of the copy still has no consumers."
  }
 ],
 "ops": [
  {"op": "spec", "data": {"entities": [
   {"name": "WfDupNotice", "attributes": [
    {"name": "Title", "type": "Text", "mandatory": true, "length": 100},
    {"name": "Body", "type": "Text", "length": 500},
    {"name": "Rank", "type": "Integer"}
   ]}
  ]}},

  {"op": "create", "parent": "IMobileFlow:MainFlow", "type": "IMobileScreen", "name": "WfDupScreen", "as": "$scr"},
  {"op": "set", "target": "$scr/#IMobileBlockInstanceWidget", "prop": "SourceBlock", "value": "IMobileBlock:LayoutTopMenu"},
  {"op": "create", "parent": "$scr/#IMobileBlockInstanceWidget/Title", "type": "IExpression", "as": "$title"},
  {"op": "set", "target": "$title", "prop": "Value", "value": "\"Duplicar\""},

  {"op": "create", "parent": "$scr", "type": "IScreenAggregate", "name": "GetWfDupNotices", "as": "$agg"},
  {"op": "create", "parent": "$agg", "type": "IAliasedSource", "args": {"dataSource": "$WfDupNotice"}},
  {"op": "create", "parent": "$scr/#IMobileBlockInstanceWidget/MainContent", "type": "IContainer", "name": "Box", "as": "$box"},
  {"op": "create", "parent": "$box", "type": "IContainer", "name": "Um", "as": "$c1"},
  {"op": "create", "parent": "$box", "type": "IContainer", "name": "Dois", "as": "$c2"},
  {"op": "create", "parent": "$c2", "type": "IExpression", "as": "$usaBody"},
  {"op": "set", "target": "$usaBody", "prop": "Value", "value": "GetWfDupNotices.List.Current.WfDupNotice.Body"},
  {"op": "create", "parent": "$box", "type": "IContainer", "name": "Tres", "as": "$c3"},

  {"op": "create", "parent": "$scr", "type": "IScreenAction", "name": "Greet", "as": "$act"},
  {"op": "create", "parent": "$act", "type": "IStartNode", "as": "$a0"},
  {"op": "create", "parent": "$act", "type": "IAssignNode", "as": "$a1"},
  {"op": "set", "target": "$a1", "prop": "Label", "value": "Passo"},
  {"op": "create", "parent": "$act", "type": "IEndNode", "as": "$a9"},
  {"op": "link", "from": "$a0", "to": "$a1"},
  {"op": "link", "from": "$a1", "to": "$a9"},
  {"op": "layout", "target": "$act"},
  {"op": "create", "parent": "$c1", "type": "IButton", "name": "Go", "as": "$btn"},
  {"op": "set", "target": "$btn/#ITextWidget", "prop": "Text", "value": "Go"},
  {"op": "set", "target": "$btn/OnClick", "prop": "Destination", "value": "$act"},

  {"op": "usages", "target": "$WfDupNotice.Body", "_why": "before duplicating"},
  {"op": "duplicate", "target": "$WfDupNotice.Body", "as": "$bodyCopy"},
  {"op": "get", "target": "$bodyCopy", "_why": "Body2, as in O11"},
  {"op": "usages", "target": "$bodyCopy", "_why": "zero consumidores reais"},
  {"op": "dump", "target": "$WfDupNotice", "depth": 2},

  {"op": "duplicate", "target": "$WfDupNotice", "as": "$entityCopy"},
  {"op": "dump", "target": "$entityCopy", "depth": 2},

  {"op": "duplicate", "target": "$c2", "as": "$c2copy"},
  {"op": "dump", "target": "$box", "depth": 2},

  {"op": "duplicate", "target": "$act", "as": "$actCopy"},
  {"op": "dump", "target": "$actCopy", "depth": 2},
  {"op": "usages", "target": "$act", "_why": "the OnClick of the button stays on the original"},

  {"op": "duplicate", "target": "$scr", "as": "$scrCopy"},
  {"op": "get", "target": "$scrCopy"},
  {"op": "dump", "target": "$scrCopy", "depth": 3}
 ]
}
