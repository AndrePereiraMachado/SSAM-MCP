{
 "description": "ODC (T coverage): CLIENT ACTION and CLIENT ENTITY (local storage), two types that had never passed through the ODC lane. Mirrors tests/jobs/local-storage-mobile.json (client entity with Id without AutoNumber, client action that saves with CreateOrUpdate and client-side screen aggregate) and adds the JavaScript node of tests/jobs/client-js-reactive.json in an isolated client action (WfCovNormalizeTitle, decision 6) that the client action calls. The InsuranceApp is CrossDevice, so the screen is IMobileScreen with the module's own LayoutTopMenu.",
 "base": "tests/fixtures/odc/insurance-reactive-r8.oml",
 "expectValid": true,
 "expectedMessages": [],
 "ops": [
  {"op": "create", "parent": "@espace", "type": "IClientEntity", "name": "WfCovDraft", "as": "$ce"},
  {"op": "create", "parent": "$ce", "type": "IEntityAttribute", "name": "Id", "as": "$id"},
  {"op": "set", "target": "$id", "prop": "DataType", "value": "Long Integer"},
  {"op": "set", "target": "$id", "prop": "IsAutoNumber", "value": "No", "_why": "o Verify recusa AutoNumber Yes em client entity; o Id e do dispositivo"},
  {"op": "set", "target": "$ce", "prop": "IdentifierAttribute", "value": "$id"},
  {"op": "create", "parent": "$ce", "type": "IEntityAttribute", "name": "Title", "as": "$title"},
  {"op": "set", "target": "$title", "prop": "DataType", "value": "Text"},
  {"op": "create", "parent": "$ce", "type": "IEntityAttribute", "name": "SavedOn", "as": "$savedOn"},
  {"op": "set", "target": "$savedOn", "prop": "DataType", "value": "Date Time"},

  {"op": "create", "parent": "@espace", "type": "IClientAction", "name": "WfCovNormalizeTitle", "as": "$norm", "_why": "decision 6: the new JavaScript lives in an isolated, named client action (only the script and the output), called by the one that saves"},
  {"op": "create", "parent": "$norm", "type": "IInputParameter", "name": "Raw", "as": "$normIn"},
  {"op": "set", "target": "$normIn", "prop": "DataType", "value": "Text"},
  {"op": "create", "parent": "$norm", "type": "IOutputParameter", "name": "Clean", "as": "$normOut"},
  {"op": "set", "target": "$normOut", "prop": "DataType", "value": "Text"},
  {"op": "create", "parent": "$norm", "type": "IStartNode", "as": "$n0"},
  {"op": "create", "parent": "$norm", "type": "IJavaScriptNode", "name": "Normalize", "as": "$js"},
  {"op": "create", "parent": "$js", "type": "IInputParameter", "name": "Raw", "as": "$jsIn"},
  {"op": "set", "target": "$jsIn", "prop": "DataType", "value": "Text"},
  {"op": "create", "parent": "$js", "type": "IOutputParameter", "name": "Clean", "as": "$jsOut"},
  {"op": "set", "target": "$jsOut", "prop": "DataType", "value": "Text"},
  {"op": "set", "target": "$js", "prop": "JavaScript", "value": "$parameters.Clean = String($parameters.Raw || \"\").trim().replace(/\\s+/g, \" \");"},
  {"op": "set", "target": "$js/arg:Raw", "prop": "Value", "value": "Raw"},
  {"op": "create", "parent": "$norm", "type": "IAssignNode", "as": "$nOut"},
  {"op": "set", "target": "$nOut", "prop": "Label", "value": "SetClean"},
  {"op": "create", "parent": "$nOut", "type": "IAssignment", "as": "$nA1"},
  {"op": "set", "target": "$nA1", "prop": "Variable", "value": "Clean"},
  {"op": "set", "target": "$nA1", "prop": "Value", "value": "Normalize.Clean"},
  {"op": "create", "parent": "$norm", "type": "IEndNode", "as": "$n9"},
  {"op": "link", "from": "$n0", "to": "$js"},
  {"op": "link", "from": "$js", "to": "$nOut"},
  {"op": "link", "from": "$nOut", "to": "$n9"},
  {"op": "layout", "target": "$norm"},

  {"op": "create", "parent": "@espace", "type": "IClientAction", "name": "WfCovDraft_Save", "as": "$ca"},
  {"op": "create", "parent": "$ca", "type": "IInputParameter", "name": "Title", "as": "$caIn"},
  {"op": "set", "target": "$caIn", "prop": "DataType", "value": "Text"},
  {"op": "create", "parent": "$ca", "type": "ILocalVariable", "name": "Draft", "as": "$draft"},
  {"op": "set", "target": "$draft", "prop": "DataType", "value": "WfCovDraft"},

  {"op": "create", "parent": "$ca", "type": "IStartNode", "as": "$c0"},
  {"op": "create", "parent": "$ca", "type": "IExecuteClientActionNode", "name": "NormalizeTitle", "as": "$normCall"},
  {"op": "set", "target": "$normCall", "prop": "Action", "value": "IClientAction:WfCovNormalizeTitle"},
  {"op": "set", "target": "$normCall/Raw", "prop": "Value", "value": "Title"},

  {"op": "create", "parent": "$ca", "type": "IAssignNode", "as": "$fill"},
  {"op": "set", "target": "$fill", "prop": "Label", "value": "FillDraft"},
  {"op": "create", "parent": "$fill", "type": "IAssignment", "as": "$f1"},
  {"op": "set", "target": "$f1", "prop": "Variable", "value": "Draft.Title"},
  {"op": "set", "target": "$f1", "prop": "Value", "value": "NormalizeTitle.Clean"},
  {"op": "create", "parent": "$fill", "type": "IAssignment", "as": "$f2"},
  {"op": "set", "target": "$f2", "prop": "Variable", "value": "Draft.SavedOn"},
  {"op": "set", "target": "$f2", "prop": "Value", "value": "CurrDateTime()"},

  {"op": "create", "parent": "$ca", "type": "IExecuteClientActionNode", "name": "StoreDraft", "as": "$store"},
  {"op": "set", "target": "$store", "prop": "Action", "value": "IEntityActionSignature:CreateOrUpdateWfCovDraft", "_why": "saving to local storage is the entity action of the client entity, called by an IExecuteClientActionNode"},
  {"op": "set", "target": "$store/Source", "prop": "Value", "value": "Draft"},
  {"op": "create", "parent": "$ca", "type": "IEndNode", "as": "$c9"},
  {"op": "link", "from": "$c0", "to": "$normCall"},
  {"op": "link", "from": "$normCall", "to": "$fill"},
  {"op": "link", "from": "$fill", "to": "$store"},
  {"op": "link", "from": "$store", "to": "$c9"},
  {"op": "layout", "target": "$ca"},

  {"op": "create", "parent": "IMobileFlow:MainFlow", "type": "IMobileScreen", "name": "WfCovDraftScreen", "as": "$scr"},
  {"op": "set", "target": "$scr/#IMobileBlockInstanceWidget", "prop": "SourceBlock", "value": "IMobileBlock:LayoutTopMenu"},
  {"op": "create", "parent": "$scr/#IMobileBlockInstanceWidget/Title", "type": "IExpression", "as": "$scrTitle"},
  {"op": "set", "target": "$scrTitle", "prop": "Value", "value": "\"Drafts\""},

  {"op": "create", "parent": "$scr", "type": "IScreenAggregate", "name": "GetDrafts", "as": "$agg", "args": {"isClientSide": true}, "_why": "CLIENT-side aggregate: this is how the screen reads local storage"},
  {"op": "create", "parent": "$agg", "type": "IAliasedSource", "args": {"dataSource": "IClientEntity:WfCovDraft"}},

  {"op": "create", "parent": "$scr", "type": "ILocalVariable", "name": "NewTitle", "as": "$newTitle"},
  {"op": "set", "target": "$newTitle", "prop": "DataType", "value": "Text"},

  {"op": "create", "parent": "$scr/#IMobileBlockInstanceWidget/MainContent", "type": "IContainer", "name": "DraftBox", "as": "$box"},
  {"op": "create", "parent": "$box", "type": "IInput", "name": "TitleInput", "as": "$input"},
  {"op": "set", "target": "$input", "prop": "Variable", "value": "NewTitle"},
  {"op": "create", "parent": "$box", "type": "IButton", "name": "SaveButton", "as": "$btn"},
  {"op": "set", "target": "$btn/#ITextWidget", "prop": "Text", "value": "Save"},
  {"op": "create", "parent": "$box", "type": "IList", "name": "DraftList", "as": "$list"},
  {"op": "set", "target": "$list", "prop": "Source", "value": "GetDrafts.List"},
  {"op": "create", "parent": "$list", "type": "IExpression", "as": "$row"},
  {"op": "set", "target": "$row", "prop": "Value", "value": "GetDrafts.List.Current.WfCovDraft.Title"},

  {"op": "create", "parent": "$scr", "type": "IScreenAction", "name": "SaveDraft", "as": "$act"},
  {"op": "create", "parent": "$act", "type": "IStartNode", "as": "$a0"},
  {"op": "create", "parent": "$act", "type": "IExecuteClientActionNode", "name": "CallSave", "as": "$call"},
  {"op": "set", "target": "$call", "prop": "Action", "value": "IClientAction:WfCovDraft_Save"},
  {"op": "set", "target": "$call/Title", "prop": "Value", "value": "NewTitle"},
  {"op": "create", "parent": "$act", "type": "IEndNode", "as": "$a9"},
  {"op": "link", "from": "$a0", "to": "$call"},
  {"op": "link", "from": "$call", "to": "$a9"},
  {"op": "layout", "target": "$act"},
  {"op": "set", "target": "$btn/OnClick", "prop": "Destination", "value": "$act"},

  {"op": "get", "target": "$ce", "_why": "proves the client entity and its IdentifierAttribute"},
  {"op": "get", "target": "$id", "_why": "proves Id Long Integer WITHOUT AutoNumber"},
  {"op": "dump", "target": "$ca", "depth": 3, "_why": "proves the flow of the client action: the call to the JavaScript client action, Assign and the CreateOrUpdate of the client entity"},
  {"op": "usages", "target": "$ca", "_why": "proves the screen action as consumer of the client action"}
 ]
}
