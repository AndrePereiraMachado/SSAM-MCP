  {"op": "create", "parent": "$scr", "type": "IScreenAggregate", "name": "GetDrafts", "as": "$agg", "args": {"isClientSide": true}, "_why": "aggregate do lado do CLIENTE: e assim que a tela le o local storage"},
  {"op": "create", "parent": "$agg", "type": "IAliasedSource", "args": {"dataSource": "IClientEntity:WfCovDraft"}},

