  {"op": "create", "parent": "$box", "type": "IList", "name": "DraftList", "as": "$list"},
  {"op": "set", "target": "$list", "prop": "Source", "value": "GetDrafts.List"},
  {"op": "create", "parent": "$list", "type": "IExpression", "as": "$row"},
  {"op": "set", "target": "$row", "prop": "Value", "value": "GetDrafts.List.Current.WfCovDraft.Title"},

  {"op": "create", "parent": "$scr", "type": "IScreenAction", "name": "SaveDraft", "as": "$act"},
  {"op": "create", "parent": "$act", "type": "IStartNode", "as": "$a0"},
  {"op": "create", "parent": "$act", "type": "IExecuteClientActionNode", "name": "CallSave", "as": "$call"},
  {"op": "set", "target": "$call", "prop": "Action", "value": "IClientAction:WfCovDraft_Save"},
  {"op": "set", "target": "$call/Title", "prop": "Value", "value": "NewTitle"},
  {"op": "create", "parent": "$act", "type": "IEndNode", "as": "$a9"},
  {"op": "link", "from": "$a0", "to": "$call"},
  {"op": "link", "from": "$call", "to": "$a9"},
  {"op": "layout", "target": "$act"},
  {"op": "set", "target": "$btn/OnClick", "prop": "Destination", "value": "$act"},

  {"op": "get", "target": "$ce", "_why": "prova a client entity e o seu IdentifierAttribute"},
  {"op": "get", "target": "$id", "_why": "prova Id Long Integer SEM AutoNumber"},
  {"op": "dump", "target": "$ca", "depth": 3, "_why": "prova o fluxo da client action: JavaScript, Assign e o CreateOrUpdate da client entity"},
  {"op": "usages", "target": "$ca", "_why": "prova a screen action como consumidora da client action"}
 ]
}
