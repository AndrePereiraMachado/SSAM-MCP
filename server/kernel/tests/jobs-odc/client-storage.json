  {"op": "set", "target": "$f1", "prop": "Variable", "value": "Draft.Title"},
  {"op": "set", "target": "$f1", "prop": "Value", "value": "NormalizeTitle.Clean"},
  {"op": "create", "parent": "$fill", "type": "IAssignment", "as": "$f2"},
  {"op": "set", "target": "$f2", "prop": "Variable", "value": "Draft.SavedOn"},
  {"op": "set", "target": "$f2", "prop": "Value", "value": "CurrDateTime()"},

  {"op": "create", "parent": "$ca", "type": "IExecuteClientActionNode", "name": "StoreDraft", "as": "$store"},
  {"op": "set", "target": "$store", "prop": "Action", "value": "IEntityActionSignature:CreateOrUpdateWfCovDraft", "_why": "gravar no local storage e a entity action da client entity, chamada por um IExecuteClientActionNode"},
  {"op": "set", "target": "$store/Source", "prop": "Value", "value": "Draft"},
  {"op": "create", "parent": "$ca", "type": "IEndNode", "as": "$c9"},
  {"op": "link", "from": "$c0", "to": "$js"},
  {"op": "link", "from": "$js", "to": "$fill"},
  {"op": "link", "from": "$fill", "to": "$store"},
