using OutSystems.ExternalLibraries.SDK;
using System.Text;

namespace SSAMTextTools;

public class SSAMTextTools : ISSAMTextTools
{
    public string Reverse(string Text)
    {
        string Result = "";
        Result = new string(Text.Reverse().ToArray());
        return Result;
    }

    public void CountWords(string Text, out List<WordCount> Words, out int Total)
    {
        Words = new List<WordCount>();
        Total = default;
        foreach (var group in Text.Split(' ', StringSplitOptions.RemoveEmptyEntries).GroupBy(w => w))
            Words.Add(new WordCount { Word = group.Key, Count = group.Count() });
        Total = Words.Sum(w => w.Count);
    }
}
