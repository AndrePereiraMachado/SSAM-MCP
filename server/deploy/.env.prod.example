# Production settings of compose.prod.yml. Copy to .env in this folder (server/deploy) and fill in:
#   cp .env.prod.example .env && chmod 600 .env
# No secret goes here: tokens are issued with `ssam-admin` and only their SHA-256 lives in the state volume; registry
# credentials stay in `docker login`. .env never enters the image (.dockerignore) nor git (.gitignore).

# Compose project (volume and container names start with it). Keep it fixed once the server is up.
COMPOSE_PROJECT_NAME=ssam-prod

# DNS name of this VPS (an A/AAAA record pointing here), without scheme or port. Caddy gets its certificate and the server
# accepts it as --public-host.
SSAM_DOMAIN=ssam.example.com
# Contact of the ACME (Let's Encrypt) account.
ACME_EMAIL=ops@example.com
# Let's Encrypt staging while testing DNS and firewall (untrusted certificate, no rate limit); remove for production.
# SSAM_ACME_CA=https://acme-staging-v02.api.letsencrypt.org/directory

# Image: one tag per build (prod-<yyyymmdd>-<commit>); upgrade and rollback change only this tag.
# Built on this VPS: SSAM_IMAGE=ssam-server. From the private registry: its full name, e.g.
# SSAM_IMAGE=registry.example.com/ssam/ssam-server, and the tag WITH the digest of the push (immutable):
# SSAM_IMAGE_TAG=prod-20261010-0000000@sha256:<digest>
SSAM_IMAGE=ssam-server
SSAM_IMAGE_TAG=prod-20261010-0000000

# Host ports of Caddy (the only published ones). They may carry an address: 127.0.0.1:28443 for a local rehearsal.
SSAM_HTTP_PORT=80
SSAM_HTTPS_PORT=443
# IPv6 on Caddy's network (default true), so IPv6 clients are logged with their own address. false only on a host
# without IPv6, and then no AAAA record.
# SSAM_EDGE_IPV6=false

# Limits of ssam-server. SSAM_CPUS cannot exceed the VPS's vCPUs. Reference: 4 vCPU / 8 GB -> CPUS 3, MEMORY 6g,
# BUILD_WORKERS 2; 8 vCPU / 16 GB -> CPUS 7, MEMORY 13g, BUILD_WORKERS 4.
SSAM_CPUS=3
SSAM_MEMORY=6g
SSAM_PIDS=4096
SSAM_BUILD_WORKERS=2
# Resident O11 workers of the customers (one per token): at most this many at once (0 runs every O11 call cold), each
# stopped after SSAM_O11_WORKER_IDLE_MS without a call. 2 for a 2 vCPU / 8 GB VPS. The first call of a customer runs
# cold and starts its worker in the background; an idle worker gives its place to another customer only after
# SSAM_O11_WORKER_MIN_IDLE_MS.
SSAM_O11_WORKERS_MAX=2
SSAM_O11_WORKER_IDLE_MS=600000
SSAM_O11_WORKER_MIN_IDLE_MS=120000
# Memory profile of each worker (set by the server, never by the customer): base cache off (or a budget in MB for one
# spare base), GC heap hard limit in MB (0 = the runtime's own), commands before it recycles itself, and the resident set
# in MB above which it is retired after its call (0 = no guard).
SSAM_O11_WORKER_BASE_CACHE=off
SSAM_O11_WORKER_HEAP_MB=1536
SSAM_O11_WORKER_MAX_COMMANDS=1000
SSAM_O11_WORKER_RSS_MB=1200
# MCP requests per minute per token (429 above it).
SSAM_RATE_PER_MINUTE=240

# ---- Build on this VPS only (ignored when the image comes from the registry) -------------------------------------------
# Folder with the Studio bundles (or installers), relative to this folder.
STUDIO_INSTALLERS_DIR=../docker/installers
# The SHA256 printed by studio-bundle.ps1 (also in each <bundle>.sha256). The build refuses an unpinned Studio input.
ODC_STUDIO_BUNDLE_SHA256=
SERVICE_STUDIO_BUNDLE_SHA256=
# Only when the file names differ from the defaults (other Studio versions):
# ODC_STUDIO_BUNDLE=odc-studio-1.7.27.10846.tar.gz
# SERVICE_STUDIO_BUNDLE=o11-studio-11.55.91.65258.tar.gz
# SERVICE_STUDIO_INSTALLER=ServiceStudio-11.55.91.65258.exe
# SERVICE_STUDIO_SHA256=10047d31a03adbbe6bd3a07c9de0506eeba3420e7031e51846607ee3fcde136c

# ---- backup.sh / restore.sh ----------------------------------------------------------------------------------------------
# Outside the repository (the archives hold customer data), created once with its owner (DEPLOY.md section 5); best on a
# block volume of its own. 0 keeps every archive.
BACKUP_DIR=/var/backups/ssam-server
BACKUP_KEEP_DAYS=14
# Off-site copy after each backup (both or neither; needs `age` and `rclone` on the host, DEPLOY.md section 9): the age
# PUBLIC key of the owner (the private key never comes to this VPS) and an rclone remote configured for this user.
# BACKUP_AGE_RECIPIENT=age1...
# BACKUP_RCLONE_REMOTE=offsite:ssam-backups
# Heartbeat (dead man's switch): one GET after each good backup; the monitor alerts when a day passes without it.
# BACKUP_HEARTBEAT_URL=https://hc-ping.com/<uuid>

# ---- rotate-logs.sh (cron, DEPLOY.md section 10) ---------------------------------------------------------------------------
# Rotated server.log kept this many days; compressed audit-*.jsonl kept this many days (0 = keep all, per your retention
# policy); module index files of the cache not written for this many days removed (0 = off).
LOG_KEEP_DAYS=56
AUDIT_KEEP_DAYS=0
INDEX_KEEP_DAYS=30
