# The variables of compose.coolify.yml. In Coolify they are the resource's Environment Variables (COOLIFY.md 4): Coolify
# reads every ${VAR} of the compose and asks for the ones with :? before the first deploy. This file is the same list for
# a plain `docker compose --env-file` run, such as the local rehearsal (COOLIFY.md 10). No secret goes here.

# Images and the version window are pinned in versions.json and generated into compose.coolify.yml.
# Do not set a moving latest tag. Regenerate the compose after owner approval.

# The tokens' database: the INTERNAL URL of the Postgres resource of Coolify (Add resource > Database > PostgreSQL; its
# page shows the URL, with the host that only the Coolify network resolves). Both resources must be on that network
# (COOLIFY.md 4, "Connect to predefined network"). ?sslmode=require when the database asks for TLS.
SSAM_DATABASE_URL=postgres://<user>:<password>@<host>:5432/<database>

# DNS name of the VPS (an A/AAAA record pointing at it), without scheme or port. Traefik gets the certificate for it; the
# server accepts it as --public-host.
SSAM_DOMAIN=ssam.example.com

# The owner console (COOLIFY.md 11): its own DNS name (another A/AAAA record to the VPS; never the server's), the GitHub
# OAuth App (Settings > Developer settings > OAuth Apps; callback https://<CONSOLE_DOMAIN>/auth/github/callback) and the
# GitHub logins allowed in (comma-separated, case does not matter). CONSOLE_SESSION_SECRET may stay empty (made at the
# first start, kept in the state). The console code comes with the image (no folder on the VPS).
CONSOLE_DOMAIN=painel.ssam.example.com
CONSOLE_GITHUB_CLIENT_ID=<the OAuth App's Client ID>
CONSOLE_GITHUB_CLIENT_SECRET=<the OAuth App's client secret>
CONSOLE_GITHUB_ALLOWED_LOGINS=<your-github-login>
CONSOLE_SESSION_SECRET=
CONSOLE_LICENSE_WRITES=auto

# Limits of ssam-server. SSAM_CPUS cannot exceed the VPS's vCPUs (DEPLOY.md section 5: 4 vCPU / 8 GB -> 3, 6g, 2;
# 8 vCPU / 16 GB -> 7, 13g, 4).
SSAM_CPUS=3
SSAM_MEMORY=6g
SSAM_PIDS=4096
SSAM_BUILD_WORKERS=2

# Capacity tiers (COOLIFY.md section 13). When versions.json has "sizing", the backends no longer read SSAM_CPUS,
# SSAM_MEMORY, SSAM_BUILD_WORKERS or SSAM_O11_WORKERS_MAX: the newest pair reads SSAM_HOT_*, every other pair SSAM_OTHER_*,
# the router SSAM_ROUTER_*. The compose already carries the measured defaults; set these only to override one tier.
#SSAM_HOT_CPUS=5
#SSAM_HOT_MEMORY=12g
#SSAM_HOT_BUILD_WORKERS=6
#SSAM_HOT_O11_WORKERS_MAX=3
#SSAM_HOT_BUILD_QUEUE_MS=240000
#SSAM_OTHER_CPUS=1.5
#SSAM_OTHER_MEMORY=3584m
#SSAM_OTHER_BUILD_WORKERS=2
#SSAM_OTHER_O11_WORKERS_MAX=1
#SSAM_OTHER_BUILD_QUEUE_MS=240000
#SSAM_ROUTER_CPUS=1
#SSAM_ROUTER_MEMORY=512m

# Resident O11 workers (DEPLOY.md section 5).
SSAM_O11_WORKERS_MAX=2
SSAM_O11_WORKER_IDLE_MS=600000
SSAM_O11_WORKER_MIN_IDLE_MS=120000
SSAM_O11_WORKER_BASE_CACHE=off
SSAM_LOCAL_UPLOAD=0
SSAM_SCREEN_RENDER=0
SSAM_O11_WORKER_HEAP_MB=1536
SSAM_O11_WORKER_MAX_COMMANDS=1000
SSAM_O11_WORKER_RSS_MB=1200

# Requests per minute per client, quality records (1 on, 0 off), hosted ssam_code (empty = as the image says).
SSAM_RATE_PER_MINUTE=240
SSAM_QUALITY=1
SSAM_HOSTED_SSAM_CODE=
