<Project Sdk="Microsoft.NET.Sdk">
  <!-- The real bridge DLL in a process of its own, without a Studio (Program.cs). A test tool, never in a package. -->
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <AssemblyName>ODC3.Bridge.IsolatedHost</AssemblyName>
    <UseAppHost>false</UseAppHost>
    <OdcInstall Condition="'$(OdcInstall)' == ''">$(ProgramFiles)\OutSystems\ODC Studio\ODC Studio</OdcInstall>
  </PropertyGroup>
</Project>
