{
  "name": "ssam-hybrid-odc",
  "version": "0.2.0",
  "private": true,
  "type": "module",
  "description": "SSAM Hybrid-ODC: ODC Studio native delivery (bridge + builder) and the official ODC public REST APIs behind one CLI and one MCP server",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "start": "node facade/mcp.mjs",
    "doctor": "node facade/odc.mjs doctor",
    "test": "node --test portal/tests/*.test.mjs facade/tests/*.test.mjs tests/*.test.mjs",
    "test:portal": "node --test portal/tests/*.test.mjs",
    "test:facade": "node --test facade/tests/*.test.mjs",
    "check": "node portal/runtime/check-catalog.mjs"
  },
  "dependencies": {
    "@modelcontextprotocol/server": "2.0.0",
    "acorn": "8.18.0",
    "ajv": "8.20.0",
    "ajv-formats": "3.0.1",
    "amazon-cognito-identity-js": "6.3.20",
    "jsdom": "30.1.1",
    "pg": "8.16.3",
    "tough-cookie": "6.0.2",
    "zod": "4.6.5"
  },
  "devDependencies": {
    "@modelcontextprotocol/client": "2.0.0"
  }
}
