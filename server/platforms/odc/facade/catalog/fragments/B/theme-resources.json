       },
       "o11": {
        "status": "applicable",
        "proofs": [
         "cat-b-theme-resource"
        ],
        "scope": "cat-b-theme-resource: set BaseTheme, StyleSheet, Description (ops 2-3)"
       }
      }
     }
    },
    "read": {
     "route": "get IMobileTheme:<Name> (the three CSS halves)",
     "preconditions": [],
     "roles": {
      "theme": {
       "odc": {
        "status": "applicable",
        "proofs": [
         "theme-css-halves"
        ],
        "scope": "generated, Theme Editor and author halves read back"
       },
       "o11": {
        "status": "applicable",
        "proofs": [
         "html-visual-alert"
        ],
        "scope": "get of the module theme (html-visual-alert); the O11 fixture theme has no Theme Editor CSS"
       }
      }
     }
