 "capabilities": [
  {
   "id": "ui.theme-css",
   "supersedes": [
    "ui.theme-css"
   ],
   "category": "ui",
   "title": "Theme CSS (three halves) and the theme of a UI flow",
   "keywords": [
    "css",
    "theme",
    "stylesheet",
    "style",
    "theme editor",
    "base theme"
   ],
   "summary": "`set StyleSheet` on a theme writes the author half (the Theme Editor CSS is a separate half; the effective sheet is generated + author): read the three halves with get first. A theme is created with a BaseTheme and assigned to a UI flow (`set $flow Theme`). Screens and blocks have their own StyleSheet (ui.screen, ui.block).",
   "route": {
    "kind": "job",
    "operation": "get IMobileTheme:X (three halves) then set StyleSheet with the whole author text; create IMobileTheme + set BaseTheme; set IMobileFlow:<Flow> Theme"
   },
   "contract": [
    "verbs.verbs.set",
    "verbs.verbs.get",
    "verbs.verbs.create"
   ],
   "depends": [],
   "alternatives": [
    {
     "id": "ui.html-visual",
     "when": "the CSS belongs to a fragment: `<style>` is installed under the fragment class"
    }
   ],
   "guidance": "Prefer the classes the theme and OutSystemsUI already provide (Style on widgets) and keep custom CSS in the author half or in the screen/block StyleSheet; this is a recommendation, not a platform rule.",
   "example": {
    "ops": [
     "get",
     "set"
    ],
    "max": 4
   },
   "elements": [
    {
     "role": "theme",
     "platforms": {
      "odc": {
       "native": "OutSystems.Model.UI.Mobile.IMobileTheme",
       "jobType": "IMobileTheme",
       "address": "IMobileTheme:<Name>"
      },
      "o11": {
       "native": "OutSystems.Model.UI.Mobile.IMobileTheme",
       "jobType": "IMobileTheme",
       "address": "IMobileTheme:<Name>"
      }
     }
    }
   ],
   "operations": {
