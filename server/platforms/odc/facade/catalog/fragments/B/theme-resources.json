        "scope": "usages of a new theme: 1 real consumer, the UI flow whose Theme was set"
       },
       "o11": {
        "status": "applicable",
        "proofs": [
         "cat-b-theme-resource"
        ],
        "scope": "cat-b-theme-resource: usages (op 25), consumers 1"
