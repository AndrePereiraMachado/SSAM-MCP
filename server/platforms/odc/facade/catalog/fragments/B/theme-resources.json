  {
   "id": "ui.script-resource",
   "supersedes": [
    "ui.script-resource"
   ],
   "category": "ui",
   "title": "Scripts (JS files), resources, required scripts and module images",
   "keywords": [
    "script",
    "javascript file",
    "resource",
    "required scripts",
    "static file",
    "asset",
    "module image"
   ],
   "summary": "IScript with JavaScript (linked to screens by `link $scr RequiredScripts $script`), IResource with TargetDirectory/DeployAction (its binary content is read-only), module images (IImage) referenced by name; RuntimePath is derived and follows renames. A JavaScript node inside a client action is logic, not a script file.",
   "route": {
    "kind": "job",
    "operation": "create IScript|IResource; set JavaScript/TargetDirectory/DeployAction; link <screen> RequiredScripts <script>; rename/replace/delete by path"
   },
   "contract": [
    "verbs.verbs.create",
    "verbs.verbs.set",
    "verbs.verbs.link",
    "verbs.verbs.rename",
    "verbs.verbs.replace",
    "verbs.verbs.delete",
    "verbs.verbs.usages"
   ],
   "depends": [],
   "alternatives": [],
   "guidance": "Prefer a native widget or an OutSystemsUI pattern over custom JavaScript when one exists; custom JS stays in a script or a client action JavaScript node with declared inputs (a recommendation, not a platform rule).",
   "example": {
    "ops": [
     "create",
     "set"
    ],
    "max": 12
   },
   "elements": [
    {
     "role": "script",
