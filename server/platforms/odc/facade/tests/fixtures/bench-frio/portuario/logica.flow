    raise PortRuleViolation("Authentication required")
  if not (CheckPortOperatorRole(GetUserId())):  # CheckCheckPortOperatorRole
    raise PortRuleViolation("Role required")
  if not (Tenant <> ""):  # CheckTenant
    raise PortRuleViolation("Business context rejected")
  GetPortInspectionForUpdate = GetPortInspectionForUpdate(Id=IId)
  assign  # SetI
    I = GetPortInspectionForUpdate.Record.PortInspection
  if not (I.Tenant = Tenant):  # CheckITenant
    raise PortRuleViolation("Record outside requested scope")
  if not (I.Version = IVersion):  # CheckIVersion
    raise PortRuleViolation("Record changed; reload before editing")
  if not (I.State = "Closed"):  # CheckIState
    raise PortRuleViolation("Closed")
  if not (Length(Reason) >= 15):  # CheckLength
    raise PortRuleViolation("Evidence")
  assign  # SetIState
    I.State = "Draft"
    I.ApproverId = NullIdentifier()
    I.UpdatedOn = CurrDateTime()
    I.Version = I.Version + 1
  UpdatePortInspection = UpdatePortInspection(Source=I)
  end

/// ssam-rule-map:{"CheckGetUserId":"Rule_Authenticated_6ab694","CheckCheckPortOperatorRole":"Rule_AuthorizedRole_d1cdc5","CheckTenant":"Rule_AuthorizedScope0_29e52c","GetPortInspectionForUpdate":"Rule_LoadI_fetch_0a9d14","SetI":"Rule_LoadI_record_cde031","CheckITenant":"Rule_LoadI_scope0_29169e","CheckIVersion":"Rule_LoadI_version_740330","CheckIState":"Rule_Draft_ebf12e","CheckNewInspector":"Rule_Independent_6cbf06","SetIInspectorId":"Rule_Transfer_values_0ca8a2","UpdatePortInspection":"Rule_Transfer_persist_83d187"}
server action PortTransferInspector public
  in Tenant: Text
  in NewInspector: User Identifier
  in IId: PortInspection Identifier
  in IVersion: Long Integer
  local I: PortInspection
  if not (GetUserId() <> NullIdentifier()):  # CheckGetUserId
    raise PortRuleViolation("Authentication required")
  if not (CheckPortOperatorRole(GetUserId())):  # CheckCheckPortOperatorRole
    raise PortRuleViolation("Role required")
  if not (Tenant <> ""):  # CheckTenant
    raise PortRuleViolation("Business context rejected")
  GetPortInspectionForUpdate = GetPortInspectionForUpdate(Id=IId)
  assign  # SetI
    I = GetPortInspectionForUpdate.Record.PortInspection
  if not (I.Tenant = Tenant):  # CheckITenant
    raise PortRuleViolation("Record outside requested scope")
  if not (I.Version = IVersion):  # CheckIVersion
    raise PortRuleViolation("Record changed; reload before editing")
  if not (I.State = "Draft" or I.State = "ReinspectionScheduled"):  # CheckIState
    raise PortRuleViolation("Draft")
  if not (NewInspector <> NullIdentifier() and NewInspector <> I.ApproverId):  # CheckNewInspector
    raise PortRuleViolation("Independent")
  assign  # SetIInspectorId
    I.InspectorId = NewInspector
    I.UpdatedOn = CurrDateTime()
    I.Version = I.Version + 1
  UpdatePortInspection = UpdatePortInspection(Source=I)
  end

/// ssam-rule-map:{"CheckGetUserId":"Rule_Authenticated_6ab694","CheckCheckPortOperatorRole":"Rule_AuthorizedRole_d1cdc5","CheckTenant":"Rule_AuthorizedScope0_29e52c","GetPortInspection":"Rule_QueryInspections_query_a436da","CheckGetPortInspectionCount":"Rule_QueryInspections_complete_910bb8","SetInspections":"Rule_QueryInspections_list_b23d0b","SetMajor":"Rule_Scan_seed_ef386d","ForEachInspections":"Rule_Scan_each_0094ef","SetWorkflowAccumulator2":"Rule_Scan_each_Scan_prior_78bba3","SetMajor2":"Rule_Scan_each_Scan_step_cc9e7d"}
server action PortInspectionSummary public
  in Tenant: Text
  in CallId: PortCall Identifier
  out Major: Integer
  out Minor: Integer
  out Open: Integer
  out Worst: Integer
  local Inspections: PortInspection List
  local WorkflowAccumulator2: Integer
  local WorkflowAccumulator3: Integer
  local WorkflowAccumulator4: Integer
  local WorkflowAccumulator5: Integer
  if not (GetUserId() <> NullIdentifier()):  # CheckGetUserId
    raise PortRuleViolation("Authentication required")
  if not (CheckPortOperatorRole(GetUserId())):  # CheckCheckPortOperatorRole
    raise PortRuleViolation("Role required")
  if not (Tenant <> ""):  # CheckTenant
    raise PortRuleViolation("Business context rejected")
  GetPortInspection = aggregate FROM PortInspection WHERE (PortInspection.Tenant = Tenant and PortInspection.CallId = CallId) MAX 1000
  if not (GetPortInspection.Count <= 1000):  # CheckGetPortInspectionCount
    raise PortRuleViolation("Result exceeds declared limit")
  assign  # SetInspections
    Inspections = GetPortInspection.List
  assign  # SetMajor
    Major = 0
    Minor = 0
    Open = 0
    Worst = 100
  foreach Inspections:  # ForEachInspections @ruleNew1
    assign  # SetWorkflowAccumulator2
      WorkflowAccumulator2 = Major
      WorkflowAccumulator3 = Minor
      WorkflowAccumulator4 = Open
      WorkflowAccumulator5 = Worst
    assign  # SetMajor2
      Major = WorkflowAccumulator2 + Inspections.Current.MajorDefects
      Minor = WorkflowAccumulator3 + Inspections.Current.MinorDefects
      Open = WorkflowAccumulator4 + If(Inspections.Current.State = "Closed", 0, 1)
      Worst = Min(WorkflowAccumulator5, Inspections.Current.Score)
    next
  end

/// ssam-rule-map:{"CheckGetUserId":"Rule_Authenticated_6ab694","CheckCheckPortOperatorRole":"Rule_AuthorizedRole_d1cdc5","CheckTenant":"Rule_AuthorizedScope0_29e52c","GetPortInspection":"Rule_QueryUnsafe_query_42b6bb","SetUnsafe":"Rule_QueryUnsafe_list_39c3b4","GetPortInspection2":"Rule_QueryAny_query_e1d81c","SetAny":"Rule_QueryAny_list_51ba9d","ChooseOutcome":"Rule_Outcome_4e80ab","SetGate":"Rule_Outcome_case0_bca9dc","SetGate2":"Rule_Outcome_case1_31db1a","SetGate3":"Rule_Outcome_otherwise_3df6d4"}
server action PortInspectionGate public
  in Tenant: Text
  in CallId: PortCall Identifier
  out Gate: Text
  local Unsafe: Boolean
  local Any: Boolean
  if not (GetUserId() <> NullIdentifier()):  # CheckGetUserId
    raise PortRuleViolation("Authentication required")
  if not (CheckPortOperatorRole(GetUserId())):  # CheckCheckPortOperatorRole
    raise PortRuleViolation("Role required")
  if not (Tenant <> ""):  # CheckTenant
    raise PortRuleViolation("Business context rejected")
  GetPortInspection = aggregate FROM PortInspection WHERE (PortInspection.Tenant = Tenant and PortInspection.CallId = CallId and PortInspection.MajorDefects > 0 and PortInspection.State <> "Closed") MAX 1
  assign  # SetUnsafe
    Unsafe = not GetPortInspection.List.Empty
  GetPortInspection2 = aggregate FROM PortInspection WHERE (PortInspection.Tenant = Tenant and PortInspection.CallId = CallId) MAX 1
  assign  # SetAny
    Any = not GetPortInspection2.List.Empty
  switch:  # ChooseOutcome
    case not Any:
      assign  # SetGate
        Gate = "InspectionMissing"
      end
    case Unsafe:
      assign  # SetGate2
        Gate = "Blocked"
      end
    otherwise:
      assign  # SetGate3
        Gate = "Clear"
      end

/// ssam-rule-map:{"CheckGetUserId":"Rule_Authenticated_6ab694","CheckCheckPortOperatorRole":"Rule_AuthorizedRole_d1cdc5","CheckTenant":"Rule_AuthorizedScope0_29e52c","GetPortInspection":"Rule_QueryPending_query_31d928","CheckGetPortInspectionCount":"Rule_QueryPending_complete_80e2cf","SetPending":"Rule_QueryPending_list_60b9fb","SetOverdue":"Rule_Scan_seed_ef386d","ForEachPending":"Rule_Scan_each_0094ef","SetWorkflowAccumulator2":"Rule_Scan_each_Scan_prior_78bba3","SetOverdue2":"Rule_Scan_each_Scan_step_cc9e7d","CheckOverdue":"Rule_Alert_44a57b","SetNotice":"Rule_Alert_Event_reset_dad169","SetNoticeTenant":"Rule_Alert_Event_values_7f394c","CreatePortEvent":"Rule_Alert_Event_persist_26501b","SetNoticeId":"Rule_Alert_Event_identity_c8d87d"}
server action PortEscalateOverdueInspections public
  in Tenant: Text
  out Overdue: Integer
  out HighestDefects: Integer
  local Pending: PortInspection List
  local WorkflowAccumulator2: Integer
  local WorkflowAccumulator3: Integer
  local Notice: PortEvent
  local WorkflowEmpty4: PortEvent
  if not (GetUserId() <> NullIdentifier()):  # CheckGetUserId
    raise PortRuleViolation("Authentication required")
  if not (CheckPortOperatorRole(GetUserId())):  # CheckCheckPortOperatorRole
    raise PortRuleViolation("Role required")
  if not (Tenant <> ""):  # CheckTenant
    raise PortRuleViolation("Business context rejected")
  GetPortInspection = aggregate FROM PortInspection WHERE (PortInspection.Tenant = Tenant and PortInspection.State = "ReinspectionScheduled" and PortInspection.ReinspectionAt < CurrDateTime()) MAX 1000
  if not (GetPortInspection.Count <= 1000):  # CheckGetPortInspectionCount
    raise PortRuleViolation("Result exceeds declared limit")
  assign  # SetPending
    Pending = GetPortInspection.List
  assign  # SetOverdue
    Overdue = 0
    HighestDefects = 0
  foreach Pending:  # ForEachPending @ruleNew1
    assign  # SetWorkflowAccumulator2
      WorkflowAccumulator2 = Overdue
      WorkflowAccumulator3 = HighestDefects
    assign  # SetOverdue2
      Overdue = WorkflowAccumulator2 + 1
      HighestDefects = Max(WorkflowAccumulator3, Pending.Current.MajorDefects)
    next
  if Overdue > 0:  # CheckOverdue
    assign  # SetNotice
      Notice = WorkflowEmpty4
    assign  # SetNoticeTenant
      Notice.Tenant = Tenant
      Notice.Kind = "OverdueInspections"
      Notice.Body = IntegerToText(Overdue)
      Notice.Severity = If(HighestDefects > 0, 5, 3)
      Notice.CreatedBy = GetUserId()
      Notice.UpdatedOn = CurrDateTime()
      Notice.CreatedOn = CurrDateTime()
      Notice.Version = 1
    CreatePortEvent = CreatePortEvent(Source=Notice)
    assign  # SetNoticeId
      Notice.Id = CreatePortEvent.Id
    end
  end

/// ssam-rule-map:{"CheckGetUserId":"Rule_Authenticated_6ab694","CheckCheckPortOperatorRole":"Rule_AuthorizedRole_d1cdc5","CheckTenant":"Rule_AuthorizedScope0_29e52c","GetPortCargo":"Rule_LoadL_fetch_f4bb0c","SetL":"Rule_LoadL_record_2b541b","CheckLTenant":"Rule_LoadL_scope0_67dc87","GetPortInspection":"Rule_QueryExisting_query_dc032c","SetExisting":"Rule_QueryExisting_list_c25fea","Checknot":"Rule_Unique_3a7275","SetInspection":"Rule_Create_reset_e4b5c4","SetInspectionTenant":"Rule_Create_values_c0cc3e","CreatePortInspection":"Rule_Create_persist_b6ff83","SetInspectionId":"Rule_Create_identity_609461","SetInspectionId2":"Rule_Result_6e7d50"}
server action PortOpenCargoInspection public
  in Tenant: Text
  in LId: PortCargo Identifier
  out InspectionId: PortInspection Identifier
  local L: PortCargo
  local Existing: Boolean
  local Inspection: PortInspection
  local WorkflowEmpty3: PortInspection
  if not (GetUserId() <> NullIdentifier()):  # CheckGetUserId
    raise PortRuleViolation("Authentication required")
  if not (CheckPortOperatorRole(GetUserId())):  # CheckCheckPortOperatorRole
    raise PortRuleViolation("Role required")
  if not (Tenant <> ""):  # CheckTenant
    raise PortRuleViolation("Business context rejected")
  GetPortCargo = GetPortCargo(Id=LId)
  assign  # SetL
    L = GetPortCargo.Record.PortCargo
  if not (L.Tenant = Tenant):  # CheckLTenant
    raise PortRuleViolation("Record outside requested scope")
  GetPortInspection = aggregate FROM PortInspection WHERE (PortInspection.Tenant = Tenant and PortInspection.CargoId = L.Id and PortInspection.State <> "Closed") MAX 1
  assign  # SetExisting
    Existing = not GetPortInspection.List.Empty
  if not (not Existing):  # Checknot
    raise PortRuleViolation("Unique")
  assign  # SetInspection
    Inspection = WorkflowEmpty3
  assign  # SetInspectionTenant
    Inspection.Tenant = Tenant
    Inspection.CargoId = L.Id
    Inspection.CallId = L.CallId
    Inspection.InspectorId = GetUserId()
    Inspection.State = "Draft"
    Inspection.Score = 100
    Inspection.UpdatedOn = CurrDateTime()
    Inspection.CreatedOn = CurrDateTime()
    Inspection.Version = 1
  CreatePortInspection = CreatePortInspection(Source=Inspection)
  assign  # SetInspectionId
    Inspection.Id = CreatePortInspection.Id
  assign  # SetInspectionId2
    InspectionId = Inspection.Id
  end

/// ssam-rule-map:{"CheckGetUserId":"Rule_Authenticated_6ab694","CheckCheckPortOperatorRole":"Rule_AuthorizedRole_d1cdc5","CheckTenant":"Rule_AuthorizedScope0_29e52c","GetPortInvoiceForUpdate":"Rule_LoadF_fetch_8d6f07","SetF":"Rule_LoadF_record_c52f8d","CheckFTenant":"Rule_LoadF_scope0_42a26d","CheckFVersion":"Rule_LoadF_version_057e19","GetPortCall":"Rule_LoadC_fetch_e1b659","SetC":"Rule_LoadC_record_8a1990","CheckCTenant":"Rule_LoadC_scope0_da3cb1","CheckFCallId":"Rule_Linked_bfda02","CheckCState":"Rule_Closed_c21ead","CheckTaxRate":"Rule_Rates_54dd21","SetWorkflowPrior3":"Rule_Calculate_prior_369241","SetFHours":"Rule_Calculate_values_b8290a","UpdatePortInvoice":"Rule_Calculate_persist_885297"}
server action PortCalculateBerthInvoice public
  in Tenant: Text
  in TaxRate: Decimal
  in FreeHours: Decimal
  in FId: PortInvoice Identifier
  in FVersion: Long Integer
  in CId: PortCall Identifier
  local F: PortInvoice
  local C: PortCall
  local WorkflowPrior3: PortInvoice
  if not (GetUserId() <> NullIdentifier()):  # CheckGetUserId
    raise PortRuleViolation("Authentication required")
  if not (CheckPortOperatorRole(GetUserId())):  # CheckCheckPortOperatorRole
    raise PortRuleViolation("Role required")
  if not (Tenant <> ""):  # CheckTenant
    raise PortRuleViolation("Business context rejected")
  GetPortInvoiceForUpdate = GetPortInvoiceForUpdate(Id=FId)
  assign  # SetF
    F = GetPortInvoiceForUpdate.Record.PortInvoice
  if not (F.Tenant = Tenant):  # CheckFTenant
    raise PortRuleViolation("Record outside requested scope")
  if not (F.Version = FVersion):  # CheckFVersion
    raise PortRuleViolation("Record changed; reload before editing")
  GetPortCall = GetPortCall(Id=CId)
  assign  # SetC
    C = GetPortCall.Record.PortCall
  if not (C.Tenant = Tenant):  # CheckCTenant
    raise PortRuleViolation("Record outside requested scope")
  if not (F.CallId = C.Id):  # CheckFCallId
    raise PortRuleViolation("Linked")
  if not (C.State = "Departed" and F.State = "Draft"):  # CheckCState
    raise PortRuleViolation("Closed")
  if not (TaxRate >= 0 and TaxRate <= 1 and F.Rate > 0 and FreeHours >= 0):  # CheckTaxRate
    raise PortRuleViolation("Rates")
  assign  # SetWorkflowPrior3
    WorkflowPrior3 = F
  assign  # SetFHours
    F.Hours = Max(0, DiffSeconds(C.ActualStart, C.ActualEnd) / 3600 - FreeHours)
    F.Subtotal = Round(Max(0, DiffSeconds(C.ActualStart, C.ActualEnd) / 3600 - FreeHours) * WorkflowPrior3.Rate, 2)
    F.Tax = Round(Max(0, DiffSeconds(C.ActualStart, C.ActualEnd) / 3600 - FreeHours) * WorkflowPrior3.Rate * TaxRate, 2)
    F.UpdatedOn = CurrDateTime()
    F.Version = F.Version + 1
  UpdatePortInvoice = UpdatePortInvoice(Source=F)
  end

/// ssam-rule-map:{"CheckGetUserId":"Rule_Authenticated_6ab694","CheckCheckPortOperatorRole":"Rule_AuthorizedRole_d1cdc5","CheckTenant":"Rule_AuthorizedScope0_29e52c","GetPortInvoiceForUpdate":"Rule_LoadF_fetch_8d6f07","SetF":"Rule_LoadF_record_c52f8d","CheckFTenant":"Rule_LoadF_scope0_42a26d","CheckFVersion":"Rule_LoadF_version_057e19","CheckFState":"Rule_Draft_ebf12e","CheckDueAt":"Rule_Due_907173","SetFState":"Rule_Issue_values_c19fa6","UpdatePortInvoice":"Rule_Issue_persist_cf5437"}
server action PortIssueInvoice public
  in Tenant: Text
  in DueAt: Date Time
  in FId: PortInvoice Identifier
  in FVersion: Long Integer
  local F: PortInvoice
  if not (GetUserId() <> NullIdentifier()):  # CheckGetUserId
    raise PortRuleViolation("Authentication required")
  if not (CheckPortOperatorRole(GetUserId())):  # CheckCheckPortOperatorRole
    raise PortRuleViolation("Role required")
  if not (Tenant <> ""):  # CheckTenant
    raise PortRuleViolation("Business context rejected")
  GetPortInvoiceForUpdate = GetPortInvoiceForUpdate(Id=FId)
  assign  # SetF
    F = GetPortInvoiceForUpdate.Record.PortInvoice
  if not (F.Tenant = Tenant):  # CheckFTenant
    raise PortRuleViolation("Record outside requested scope")
  if not (F.Version = FVersion):  # CheckFVersion
    raise PortRuleViolation("Record changed; reload before editing")
  if not (F.State = "Draft" and F.Subtotal >= 0 and F.Tax >= 0):  # CheckFState
    raise PortRuleViolation("Draft")
  if not (DueAt > CurrDateTime() and Length(F.Currency) = 3):  # CheckDueAt
    raise PortRuleViolation("Due")
  assign  # SetFState
    F.State = "Issued"
    F.DueAt = DueAt
    F.UpdatedOn = CurrDateTime()
    F.Version = F.Version + 1
  UpdatePortInvoice = UpdatePortInvoice(Source=F)
  end

/// ssam-rule-map:{"CheckGetUserId":"Rule_Authenticated_6ab694","CheckCheckPortOperatorRole":"Rule_AuthorizedRole_d1cdc5","CheckTenant":"Rule_AuthorizedScope0_29e52c","GetPortInvoiceForUpdate":"Rule_LoadF_fetch_8d6f07","SetF":"Rule_LoadF_record_c52f8d","CheckFTenant":"Rule_LoadF_scope0_42a26d","CheckFVersion":"Rule_LoadF_version_057e19","CheckFState":"Rule_Issued_0221e4","CheckAmount":"Rule_Amount_49e96d","SetWorkflowPrior2":"Rule_Apply_prior_c6b5fe","SetFPaid":"Rule_Apply_values_d906e6","UpdatePortInvoice":"Rule_Apply_persist_00ed66","SetEvent":"Rule_Audit_reset_f0a34c","SetEventTenant":"Rule_Audit_values_c5f614","CreatePortEvent":"Rule_Audit_persist_225f32","SetEventId":"Rule_Audit_identity_dd9ab7"}
server action PortApplyInvoicePayment public
  in Tenant: Text
  in Amount: Decimal
  in Reference: Text
  in FId: PortInvoice Identifier
  in FVersion: Long Integer
  local F: PortInvoice
  local WorkflowPrior2: PortInvoice
  local Event: PortEvent
  local WorkflowEmpty3: PortEvent
  if not (GetUserId() <> NullIdentifier()):  # CheckGetUserId
    raise PortRuleViolation("Authentication required")
  if not (CheckPortOperatorRole(GetUserId())):  # CheckCheckPortOperatorRole
    raise PortRuleViolation("Role required")
  if not (Tenant <> ""):  # CheckTenant
    raise PortRuleViolation("Business context rejected")
  GetPortInvoiceForUpdate = GetPortInvoiceForUpdate(Id=FId)
  assign  # SetF
    F = GetPortInvoiceForUpdate.Record.PortInvoice
  if not (F.Tenant = Tenant):  # CheckFTenant
    raise PortRuleViolation("Record outside requested scope")
  if not (F.Version = FVersion):  # CheckFVersion
    raise PortRuleViolation("Record changed; reload before editing")
  if not (F.State = "Issued" or F.State = "Partial"):  # CheckFState
    raise PortRuleViolation("Issued")
  if not (Amount > 0 and Amount <= F.Subtotal + F.Tax - F.Credit - F.Paid and Length(Reference) >= 5):  # CheckAmount
    raise PortRuleViolation("Amount")
  assign  # SetWorkflowPrior2
    WorkflowPrior2 = F
  assign  # SetFPaid
    F.Paid = WorkflowPrior2.Paid + Amount
    F.State = If(WorkflowPrior2.Paid + Amount = WorkflowPrior2.Subtotal + WorkflowPrior2.Tax - WorkflowPrior2.Credit, "Settled", "Partial")
    F.UpdatedOn = CurrDateTime()
    F.Version = F.Version + 1
  UpdatePortInvoice = UpdatePortInvoice(Source=F)
  assign  # SetEvent
    Event = WorkflowEmpty3
  assign  # SetEventTenant
    Event.Tenant = Tenant
    Event.CallId = F.CallId
    Event.Kind = "ManualPayment"
    Event.Body = Reference
    Event.Severity = 1
    Event.CreatedBy = GetUserId()
    Event.UpdatedOn = CurrDateTime()
    Event.CreatedOn = CurrDateTime()
    Event.Version = 1
  CreatePortEvent = CreatePortEvent(Source=Event)
  assign  # SetEventId
    Event.Id = CreatePortEvent.Id
  end

/// ssam-rule-map:{"CheckGetUserId":"Rule_Authenticated_6ab694","CheckCheckPortOperatorRole":"Rule_AuthorizedRole_d1cdc5","CheckTenant":"Rule_AuthorizedScope0_29e52c","GetPortInvoiceForUpdate":"Rule_LoadF_fetch_8d6f07","SetF":"Rule_LoadF_record_c52f8d","CheckFTenant":"Rule_LoadF_scope0_42a26d","CheckFVersion":"Rule_LoadF_version_057e19","CheckFState":"Rule_Issued_0221e4","CheckAmount":"Rule_Amount_49e96d","SetWorkflowPrior2":"Rule_Credit_prior_3a412a","SetFCredit":"Rule_Credit_values_b497bb","UpdatePortInvoice":"Rule_Credit_persist_17b8b5"}
server action PortCreditInvoice public
  in Tenant: Text
  in Amount: Decimal
  in Reason: Text
  in FId: PortInvoice Identifier
  in FVersion: Long Integer
  local F: PortInvoice
  local WorkflowPrior2: PortInvoice
  if not (GetUserId() <> NullIdentifier()):  # CheckGetUserId
    raise PortRuleViolation("Authentication required")
  if not (CheckPortOperatorRole(GetUserId())):  # CheckCheckPortOperatorRole
    raise PortRuleViolation("Role required")
  if not (Tenant <> ""):  # CheckTenant
    raise PortRuleViolation("Business context rejected")
  GetPortInvoiceForUpdate = GetPortInvoiceForUpdate(Id=FId)
  assign  # SetF
    F = GetPortInvoiceForUpdate.Record.PortInvoice
  if not (F.Tenant = Tenant):  # CheckFTenant
    raise PortRuleViolation("Record outside requested scope")
  if not (F.Version = FVersion):  # CheckFVersion
    raise PortRuleViolation("Record changed; reload before editing")
  if not (F.State <> "Draft" and F.State <> "Cancelled"):  # CheckFState
    raise PortRuleViolation("Issued")
  if not (Amount > 0 and Amount <= F.Subtotal + F.Tax - F.Credit - F.Paid and Length(Reason) >= 10):  # CheckAmount
    raise PortRuleViolation("Amount")
  assign  # SetWorkflowPrior2
    WorkflowPrior2 = F
  assign  # SetFCredit
    F.Credit = WorkflowPrior2.Credit + Amount
    F.State = If(WorkflowPrior2.Paid = WorkflowPrior2.Subtotal + WorkflowPrior2.Tax - WorkflowPrior2.Credit - Amount, "Settled", WorkflowPrior2.State)
    F.UpdatedOn = CurrDateTime()
    F.Version = F.Version + 1
  UpdatePortInvoice = UpdatePortInvoice(Source=F)
  end

/// ssam-rule-map:{"CheckGetUserId":"Rule_Authenticated_6ab694","CheckCheckPortOperatorRole":"Rule_AuthorizedRole_d1cdc5","CheckTenant":"Rule_AuthorizedScope0_29e52c","GetPortInvoiceForUpdate":"Rule_LoadF_fetch_8d6f07","SetF":"Rule_LoadF_record_c52f8d","CheckFTenant":"Rule_LoadF_scope0_42a26d","CheckFVersion":"Rule_LoadF_version_057e19","CheckAmount":"Rule_Outstanding_e681b8","CheckFState":"Rule_NotCancelled_48f6b3","SetFDisputed":"Rule_Dispute_values_847123","UpdatePortInvoice":"Rule_Dispute_persist_bb8eab"}
server action PortDisputeInvoice public
  in Tenant: Text
  in Amount: Decimal
  in Reason: Text
  in FId: PortInvoice Identifier
  in FVersion: Long Integer
  local F: PortInvoice
  if not (GetUserId() <> NullIdentifier()):  # CheckGetUserId
    raise PortRuleViolation("Authentication required")
  if not (CheckPortOperatorRole(GetUserId())):  # CheckCheckPortOperatorRole
    raise PortRuleViolation("Role required")
  if not (Tenant <> ""):  # CheckTenant
    raise PortRuleViolation("Business context rejected")
  GetPortInvoiceForUpdate = GetPortInvoiceForUpdate(Id=FId)
  assign  # SetF
    F = GetPortInvoiceForUpdate.Record.PortInvoice
  if not (F.Tenant = Tenant):  # CheckFTenant
    raise PortRuleViolation("Record outside requested scope")
  if not (F.Version = FVersion):  # CheckFVersion
    raise PortRuleViolation("Record changed; reload before editing")
  if not (Amount > 0 and Amount <= F.Subtotal + F.Tax - F.Credit - F.Paid and Length(Reason) >= 10):  # CheckAmount
    raise PortRuleViolation("Outstanding")
  if not (F.State <> "Cancelled" and F.State <> "Draft"):  # CheckFState
    raise PortRuleViolation("NotCancelled")
  assign  # SetFDisputed
    F.Disputed = Amount
    F.State = "Disputed"
    F.UpdatedOn = CurrDateTime()
    F.Version = F.Version + 1
  UpdatePortInvoice = UpdatePortInvoice(Source=F)
  end

/// ssam-rule-map:{"CheckGetUserId":"Rule_Authenticated_6ab694","CheckCheckPortOperatorRole":"Rule_AuthorizedRole_d1cdc5","CheckTenant":"Rule_AuthorizedScope0_29e52c","GetPortInvoiceForUpdate":"Rule_LoadF_fetch_8d6f07","SetF":"Rule_LoadF_record_c52f8d","CheckFTenant":"Rule_LoadF_scope0_42a26d","CheckFVersion":"Rule_LoadF_version_057e19","CheckFState":"Rule_Disputed_b3b310","CheckAccepted":"Rule_Amount_49e96d","SetWorkflowPrior2":"Rule_Resolve_prior_9d0264","SetFCredit":"Rule_Resolve_values_af0989","UpdatePortInvoice":"Rule_Resolve_persist_9ad420"}
server action PortResolveInvoiceDispute public
  in Tenant: Text
  in Accepted: Decimal
  in FId: PortInvoice Identifier
  in FVersion: Long Integer
  local F: PortInvoice
  local WorkflowPrior2: PortInvoice
  if not (GetUserId() <> NullIdentifier()):  # CheckGetUserId
    raise PortRuleViolation("Authentication required")
  if not (CheckPortOperatorRole(GetUserId())):  # CheckCheckPortOperatorRole
    raise PortRuleViolation("Role required")
  if not (Tenant <> ""):  # CheckTenant
    raise PortRuleViolation("Business context rejected")
  GetPortInvoiceForUpdate = GetPortInvoiceForUpdate(Id=FId)
  assign  # SetF
    F = GetPortInvoiceForUpdate.Record.PortInvoice
  if not (F.Tenant = Tenant):  # CheckFTenant
    raise PortRuleViolation("Record outside requested scope")
  if not (F.Version = FVersion):  # CheckFVersion
    raise PortRuleViolation("Record changed; reload before editing")
  if not (F.State = "Disputed"):  # CheckFState
    raise PortRuleViolation("Disputed")
  if not (Accepted >= 0 and Accepted <= F.Disputed and Accepted <= F.Subtotal + F.Tax - F.Credit - F.Paid):  # CheckAccepted
    raise PortRuleViolation("Amount")
  assign  # SetWorkflowPrior2
    WorkflowPrior2 = F
  assign  # SetFCredit
    F.Credit = WorkflowPrior2.Credit + Accepted
    F.Disputed = 0
    F.State = If(WorkflowPrior2.Paid = WorkflowPrior2.Subtotal + WorkflowPrior2.Tax - WorkflowPrior2.Credit - Accepted, "Settled", "Issued")
    F.UpdatedOn = CurrDateTime()
    F.Version = F.Version + 1
  UpdatePortInvoice = UpdatePortInvoice(Source=F)
  end

/// ssam-rule-map:{"CheckGetUserId":"Rule_Authenticated_6ab694","CheckCheckPortOperatorRole":"Rule_AuthorizedRole_d1cdc5","CheckTenant":"Rule_AuthorizedScope0_29e52c","GetPortInvoiceForUpdate":"Rule_LoadF_fetch_8d6f07","SetF":"Rule_LoadF_record_c52f8d","CheckFTenant":"Rule_LoadF_scope0_42a26d","CheckFVersion":"Rule_LoadF_version_057e19","CheckFPaid":"Rule_Unpaid_4b80e7","CheckLength":"Rule_Reasoned_592d44","SetFState":"Rule_Cancel_values_bc24f6","UpdatePortInvoice":"Rule_Cancel_persist_dcc02e"}
server action PortCancelInvoice public
  in Tenant: Text
  in Reason: Text
  in FId: PortInvoice Identifier
  in FVersion: Long Integer
  local F: PortInvoice
  if not (GetUserId() <> NullIdentifier()):  # CheckGetUserId
    raise PortRuleViolation("Authentication required")
  if not (CheckPortOperatorRole(GetUserId())):  # CheckCheckPortOperatorRole
    raise PortRuleViolation("Role required")
  if not (Tenant <> ""):  # CheckTenant
    raise PortRuleViolation("Business context rejected")
  GetPortInvoiceForUpdate = GetPortInvoiceForUpdate(Id=FId)
  assign  # SetF
    F = GetPortInvoiceForUpdate.Record.PortInvoice
  if not (F.Tenant = Tenant):  # CheckFTenant
    raise PortRuleViolation("Record outside requested scope")
  if not (F.Version = FVersion):  # CheckFVersion
    raise PortRuleViolation("Record changed; reload before editing")
  if not (F.Paid = 0 and F.Credit = 0 and F.Disputed = 0 and F.State <> "Settled"):  # CheckFPaid
    raise PortRuleViolation("Unpaid")
  if not (Length(Reason) >= 10):  # CheckLength
    raise PortRuleViolation("Reasoned")
  assign  # SetFState
    F.State = "Cancelled"
    F.UpdatedOn = CurrDateTime()
    F.Version = F.Version + 1
  UpdatePortInvoice = UpdatePortInvoice(Source=F)
  end

/// ssam-rule-map:{"CheckGetUserId":"Rule_Authenticated_6ab694","CheckCheckPortOperatorRole":"Rule_AuthorizedRole_d1cdc5","CheckTenant":"Rule_AuthorizedScope0_29e52c","GetPortInvoice":"Rule_QueryBills_query_55068d","CheckGetPortInvoiceCount":"Rule_QueryBills_complete_dc08e6","SetBills":"Rule_QueryBills_list_c93aff","SetDue":"Rule_Balances_seed_5cd0d5","ForEachBills":"Rule_Balances_each_b96c1c","SetWorkflowAccumulator2":"Rule_Balances_each_Balances_prior_114d90","SetDue2":"Rule_Balances_each_Balances_step_9654f7"}
server action PortOutstandingByCall public
  in Tenant: Text
  in CallId: PortCall Identifier
  out Due: Decimal
  out Disputed: Decimal
  out Overdue: Decimal
  local Bills: PortInvoice List
  local WorkflowAccumulator2: Decimal
  local WorkflowAccumulator3: Decimal
  local WorkflowAccumulator4: Decimal
  if not (GetUserId() <> NullIdentifier()):  # CheckGetUserId
    raise PortRuleViolation("Authentication required")
  if not (CheckPortOperatorRole(GetUserId())):  # CheckCheckPortOperatorRole
    raise PortRuleViolation("Role required")
  if not (Tenant <> ""):  # CheckTenant
    raise PortRuleViolation("Business context rejected")
  GetPortInvoice = aggregate FROM PortInvoice WHERE (PortInvoice.Tenant = Tenant and PortInvoice.CallId = CallId and PortInvoice.State <> "Cancelled" and PortInvoice.State <> "Draft") MAX 1000
  if not (GetPortInvoice.Count <= 1000):  # CheckGetPortInvoiceCount
    raise PortRuleViolation("Result exceeds declared limit")
  assign  # SetBills
    Bills = GetPortInvoice.List
  assign  # SetDue
    Due = 0
    Disputed = 0
    Overdue = 0
  foreach Bills:  # ForEachBills @ruleNew1
    assign  # SetWorkflowAccumulator2
      WorkflowAccumulator2 = Due
      WorkflowAccumulator3 = Disputed
      WorkflowAccumulator4 = Overdue
    assign  # SetDue2
      Due = WorkflowAccumulator2 + Max(0, Bills.Current.Subtotal + Bills.Current.Tax - Bills.Current.Credit - Bills.Current.Paid)
      Disputed = WorkflowAccumulator3 + Bills.Current.Disputed
      Overdue = WorkflowAccumulator4 + If(Bills.Current.DueAt < CurrDateTime(), Max(0, Bills.Current.Subtotal + Bills.Current.Tax - Bills.Current.Credit - Bills.Current.Paid), 0)
    next
  end

/// ssam-rule-map:{"CheckGetUserId":"Rule_Authenticated_6ab694","CheckCheckPortOperatorRole":"Rule_AuthorizedRole_d1cdc5","CheckTenant":"Rule_AuthorizedScope0_29e52c","GetPortInvoice":"Rule_QueryBills_query_55068d","CheckGetPortInvoiceCount":"Rule_QueryBills_complete_dc08e6","SetBills":"Rule_QueryBills_list_c93aff","SetCurrent":"Rule_Buckets_seed_b89cf6","ForEachBills":"Rule_Buckets_each_735357","SetWorkflowAccumulator2":"Rule_Buckets_each_Buckets_prior_fd03a8","SetCurrent2":"Rule_Buckets_each_Buckets_step_ca165f"}
server action PortInvoiceAging public
  in Tenant: Text
  out Current: Decimal
  out Late30: Decimal
  out Older: Decimal
  local Bills: PortInvoice List
  local WorkflowAccumulator2: Decimal
  local WorkflowAccumulator3: Decimal
  local WorkflowAccumulator4: Decimal
  if not (GetUserId() <> NullIdentifier()):  # CheckGetUserId
    raise PortRuleViolation("Authentication required")
  if not (CheckPortOperatorRole(GetUserId())):  # CheckCheckPortOperatorRole
    raise PortRuleViolation("Role required")
  if not (Tenant <> ""):  # CheckTenant
    raise PortRuleViolation("Business context rejected")
  GetPortInvoice = aggregate FROM PortInvoice WHERE (PortInvoice.Tenant = Tenant and (PortInvoice.State = "Issued" or PortInvoice.State = "Partial")) MAX 1000
  if not (GetPortInvoice.Count <= 1000):  # CheckGetPortInvoiceCount
    raise PortRuleViolation("Result exceeds declared limit")
  assign  # SetBills
    Bills = GetPortInvoice.List
  assign  # SetCurrent
    Current = 0
    Late30 = 0
    Older = 0
  foreach Bills:  # ForEachBills @ruleNew1
    assign  # SetWorkflowAccumulator2
      WorkflowAccumulator2 = Current
      WorkflowAccumulator3 = Late30
      WorkflowAccumulator4 = Older
    assign  # SetCurrent2
      Current = WorkflowAccumulator2 + If(Bills.Current.DueAt >= CurrDateTime(), Max(0, Bills.Current.Subtotal + Bills.Current.Tax - Bills.Current.Credit - Bills.Current.Paid), 0)
      Late30 = WorkflowAccumulator3 + If(Bills.Current.DueAt < CurrDateTime() and Bills.Current.DueAt >= AddDays(CurrDateTime(), -30), Max(0, Bills.Current.Subtotal + Bills.Current.Tax - Bills.Current.Credit - Bills.Current.Paid), 0)
      Older = WorkflowAccumulator4 + If(Bills.Current.DueAt < AddDays(CurrDateTime(), -30), Max(0, Bills.Current.Subtotal + Bills.Current.Tax - Bills.Current.Credit - Bills.Current.Paid), 0)
    next
  end

/// ssam-rule-map:{"CheckGetUserId":"Rule_Authenticated_6ab694","CheckCheckPortOperatorRole":"Rule_AuthorizedRole_d1cdc5","CheckTenant":"Rule_AuthorizedScope0_29e52c","CheckHours":"Rule_Inputs_7abc49","SetNet":"Rule_Net_660fb2","SetTax":"Rule_Tax_47e288","SetNet2":"Rule_Result_6e7d50"}
server action PortPreviewTariff public
  in Tenant: Text
  in Hours: Decimal
  in Rate: Decimal
  in Minimum: Decimal
  in Discount: Decimal
  in TaxRate: Decimal
  out Net: Decimal
  out Tax: Decimal
  out Total: Decimal
  if not (GetUserId() <> NullIdentifier()):  # CheckGetUserId
    raise PortRuleViolation("Authentication required")
  if not (CheckPortOperatorRole(GetUserId())):  # CheckCheckPortOperatorRole
    raise PortRuleViolation("Role required")
  if not (Tenant <> ""):  # CheckTenant
    raise PortRuleViolation("Business context rejected")
  if not (Hours >= 0 and Rate > 0 and Minimum >= 0 and Discount >= 0 and Discount <= 1 and TaxRate >= 0 and TaxRate <= 1):  # CheckHours
    raise PortRuleViolation("Inputs")
  assign  # SetNet
    Net = Round(Max(Minimum, Hours * Rate) * (1 - Discount), 2)
  assign  # SetTax
    Tax = Round(Net * TaxRate, 2)
  assign  # SetNet2
    Net = Net
    Tax = Tax
    Total = Net + Tax
  end

/// ssam-rule-map:{"CheckGetUserId":"Rule_Authenticated_6ab694","CheckCheckPortOperatorRole":"Rule_AuthorizedRole_d1cdc5","CheckTenant":"Rule_AuthorizedScope0_29e52c","GetPortEmissionForUpdate":"Rule_LoadE_fetch_7a95d3","SetE":"Rule_LoadE_record_fec5e0","CheckETenant":"Rule_LoadE_scope0_71d44b","CheckEVersion":"Rule_LoadE_version_789572","CheckEState":"Rule_Open_ed077f","CheckKwh":"Rule_Values_53b09e","SetWorkflowPrior2":"Rule_Record_prior_693e77","SetEGridKwh":"Rule_Record_values_fd7b8a","UpdatePortEmission":"Rule_Record_persist_56ea16"}
server action PortRecordGridEnergy public
  in Tenant: Text
  in Kwh: Decimal
  in GridFactor: Decimal
  in EId: PortEmission Identifier
  in EVersion: Long Integer
  local E: PortEmission
  local WorkflowPrior2: PortEmission
  if not (GetUserId() <> NullIdentifier()):  # CheckGetUserId
    raise PortRuleViolation("Authentication required")
  if not (CheckPortOperatorRole(GetUserId())):  # CheckCheckPortOperatorRole
    raise PortRuleViolation("Role required")
  if not (Tenant <> ""):  # CheckTenant
    raise PortRuleViolation("Business context rejected")
  GetPortEmissionForUpdate = GetPortEmissionForUpdate(Id=EId)
  assign  # SetE
    E = GetPortEmissionForUpdate.Record.PortEmission
  if not (E.Tenant = Tenant):  # CheckETenant
    raise PortRuleViolation("Record outside requested scope")
  if not (E.Version = EVersion):  # CheckEVersion
    raise PortRuleViolation("Record changed; reload before editing")
  if not (E.State <> "Closed"):  # CheckEState
    raise PortRuleViolation("Open")
  if not (Kwh > 0 and GridFactor >= 0 and GridFactor <= 5):  # CheckKwh
    raise PortRuleViolation("Values")
  assign  # SetWorkflowPrior2
    WorkflowPrior2 = E
  assign  # SetEGridKwh
    E.GridKwh = WorkflowPrior2.GridKwh + Kwh
    E.Co2 = WorkflowPrior2.Co2 + Kwh * GridFactor
    E.Verified = False
    E.UpdatedOn = CurrDateTime()
    E.Version = E.Version + 1
  UpdatePortEmission = UpdatePortEmission(Source=E)
  end

/// ssam-rule-map:{"CheckGetUserId":"Rule_Authenticated_6ab694","CheckCheckPortOperatorRole":"Rule_AuthorizedRole_d1cdc5","CheckTenant":"Rule_AuthorizedScope0_29e52c","GetPortEmissionForUpdate":"Rule_LoadE_fetch_7a95d3","SetE":"Rule_LoadE_record_fec5e0","CheckETenant":"Rule_LoadE_scope0_71d44b","CheckEVersion":"Rule_LoadE_version_789572","CheckEState":"Rule_Open_ed077f","CheckFactor":"Rule_Value_8e3795","SetWorkflowPrior2":"Rule_Recalculate_prior_b299b8","SetECo2":"Rule_Recalculate_values_091900","UpdatePortEmission":"Rule_Recalculate_persist_ae9493"}
server action PortChangeFuelFactor public
  in Tenant: Text
  in Factor: Decimal
  in EId: PortEmission Identifier
  in EVersion: Long Integer
  local E: PortEmission
  local WorkflowPrior2: PortEmission
  if not (GetUserId() <> NullIdentifier()):  # CheckGetUserId
    raise PortRuleViolation("Authentication required")
  if not (CheckPortOperatorRole(GetUserId())):  # CheckCheckPortOperatorRole
    raise PortRuleViolation("Role required")
  if not (Tenant <> ""):  # CheckTenant
    raise PortRuleViolation("Business context rejected")
  GetPortEmissionForUpdate = GetPortEmissionForUpdate(Id=EId)
  assign  # SetE
    E = GetPortEmissionForUpdate.Record.PortEmission
  if not (E.Tenant = Tenant):  # CheckETenant
    raise PortRuleViolation("Record outside requested scope")
  if not (E.Version = EVersion):  # CheckEVersion
    raise PortRuleViolation("Record changed; reload before editing")
  if not (E.State <> "Closed"):  # CheckEState
    raise PortRuleViolation("Open")
  if not (Factor > 0 and Factor <= 10):  # CheckFactor
    raise PortRuleViolation("Value")
  assign  # SetWorkflowPrior2
    WorkflowPrior2 = E
  assign  # SetECo2
    E.Co2 = Max(0, WorkflowPrior2.Co2 + WorkflowPrior2.FuelLitres * (Factor - WorkflowPrior2.Factor))
    E.Factor = Factor
    E.Verified = False
    E.UpdatedOn = CurrDateTime()
    E.Version = E.Version + 1
  UpdatePortEmission = UpdatePortEmission(Source=E)
  end

/// ssam-rule-map:{"CheckGetUserId":"Rule_Authenticated_6ab694","CheckCheckPortOperatorRole":"Rule_AuthorizedRole_d1cdc5","CheckTenant":"Rule_AuthorizedScope0_29e52c","GetPortEmissionForUpdate":"Rule_LoadE_fetch_7a95d3","SetE":"Rule_LoadE_record_fec5e0","CheckETenant":"Rule_LoadE_scope0_71d44b","CheckEVersion":"Rule_LoadE_version_789572","CheckEVerified":"Rule_Verified_4f7838","CheckLength":"Rule_Certificate_2a93a8","SetWorkflowPrior2":"Rule_Apply_prior_c6b5fe","SetEOffset":"Rule_Apply_values_d906e6","UpdatePortEmission":"Rule_Apply_persist_00ed66","SetEvent":"Rule_Audit_reset_f0a34c","SetEventTenant":"Rule_Audit_values_c5f614","CreatePortEvent":"Rule_Audit_persist_225f32","SetEventId":"Rule_Audit_identity_dd9ab7"}
server action PortAddCarbonOffset public
  in Tenant: Text
  in Offset: Decimal
  in Certificate: Text
  in EId: PortEmission Identifier
  in EVersion: Long Integer
  local E: PortEmission
  local WorkflowPrior2: PortEmission
  local Event: PortEvent
  local WorkflowEmpty3: PortEvent
  if not (GetUserId() <> NullIdentifier()):  # CheckGetUserId
    raise PortRuleViolation("Authentication required")
  if not (CheckPortOperatorRole(GetUserId())):  # CheckCheckPortOperatorRole
    raise PortRuleViolation("Role required")
  if not (Tenant <> ""):  # CheckTenant
    raise PortRuleViolation("Business context rejected")
  GetPortEmissionForUpdate = GetPortEmissionForUpdate(Id=EId)
  assign  # SetE
    E = GetPortEmissionForUpdate.Record.PortEmission
  if not (E.Tenant = Tenant):  # CheckETenant
    raise PortRuleViolation("Record outside requested scope")
  if not (E.Version = EVersion):  # CheckEVersion
    raise PortRuleViolation("Record changed; reload before editing")
  if not (E.Verified):  # CheckEVerified
    raise PortRuleViolation("Verified")
  if not (Length(Certificate) >= 10 and Offset > 0 and E.Offset + Offset <= E.Co2):  # CheckLength
    raise PortRuleViolation("Certificate")
  assign  # SetWorkflowPrior2
    WorkflowPrior2 = E
  assign  # SetEOffset
    E.Offset = WorkflowPrior2.Offset + Offset
    E.UpdatedOn = CurrDateTime()
    E.Version = E.Version + 1
  UpdatePortEmission = UpdatePortEmission(Source=E)
  assign  # SetEvent
    Event = WorkflowEmpty3
  assign  # SetEventTenant
    Event.Tenant = Tenant
    Event.CallId = E.CallId
    Event.Kind = "CarbonOffset"
    Event.Body = Certificate
    Event.Severity = 1
    Event.CreatedBy = GetUserId()
    Event.UpdatedOn = CurrDateTime()
    Event.CreatedOn = CurrDateTime()
    Event.Version = 1
  CreatePortEvent = CreatePortEvent(Source=Event)
  assign  # SetEventId
    Event.Id = CreatePortEvent.Id
  end

/// ssam-rule-map:{"CheckGetUserId":"Rule_Authenticated_6ab694","CheckCheckPortOperatorRole":"Rule_AuthorizedRole_d1cdc5","CheckTenant":"Rule_AuthorizedScope0_29e52c","GetPortEmissionForUpdate":"Rule_LoadE_fetch_7a95d3","SetE":"Rule_LoadE_record_fec5e0","CheckETenant":"Rule_LoadE_scope0_71d44b","CheckEVersion":"Rule_LoadE_version_789572","CheckECo2":"Rule_Consistent_d9f525","CheckLength":"Rule_Evidence_03867a","SetEVerified":"Rule_Approve_values_b86499","UpdatePortEmission":"Rule_Approve_persist_b4a05b"}
server action PortApproveEmissionStatement public
  in Tenant: Text
  in Evidence: Text
  in EId: PortEmission Identifier
  in EVersion: Long Integer
  local E: PortEmission
  if not (GetUserId() <> NullIdentifier()):  # CheckGetUserId
    raise PortRuleViolation("Authentication required")
  if not (CheckPortOperatorRole(GetUserId())):  # CheckCheckPortOperatorRole
    raise PortRuleViolation("Role required")
  if not (Tenant <> ""):  # CheckTenant
    raise PortRuleViolation("Business context rejected")
  GetPortEmissionForUpdate = GetPortEmissionForUpdate(Id=EId)
  assign  # SetE
    E = GetPortEmissionForUpdate.Record.PortEmission
  if not (E.Tenant = Tenant):  # CheckETenant
    raise PortRuleViolation("Record outside requested scope")
  if not (E.Version = EVersion):  # CheckEVersion
    raise PortRuleViolation("Record changed; reload before editing")
  if not (E.Co2 >= E.Offset and E.FuelLitres >= 0 and E.GridKwh >= 0 and E.Factor > 0):  # CheckECo2
    raise PortRuleViolation("Consistent")
  if not (Length(Evidence) >= 10):  # CheckLength
    raise PortRuleViolation("Evidence")
  assign  # SetEVerified
    E.Verified = True
    E.State = "Verified"
    E.UpdatedOn = CurrDateTime()
    E.Version = E.Version + 1
  UpdatePortEmission = UpdatePortEmission(Source=E)
  end

/// ssam-rule-map:{"CheckGetUserId":"Rule_Authenticated_6ab694","CheckCheckPortOperatorRole":"Rule_AuthorizedRole_d1cdc5","CheckTenant":"Rule_AuthorizedScope0_29e52c","GetPortEmissionForUpdate":"Rule_LoadE_fetch_7a95d3","SetE":"Rule_LoadE_record_fec5e0","CheckETenant":"Rule_LoadE_scope0_71d44b","CheckEVersion":"Rule_LoadE_version_789572","GetPortCall":"Rule_LoadC_fetch_e1b659","SetC":"Rule_LoadC_record_8a1990","CheckCTenant":"Rule_LoadC_scope0_da3cb1","CheckECallId":"Rule_Linked_bfda02","CheckCState":"Rule_Departed_5ec74c","CheckEVerified":"Rule_Balanced_5386ea","SetEState":"Rule_Close_values_42bd1c","UpdatePortEmission":"Rule_Close_persist_e98840"}
server action PortCloseEmissionStatement public
  in Tenant: Text
  in EId: PortEmission Identifier
  in EVersion: Long Integer
  in CId: PortCall Identifier
  local E: PortEmission
  local C: PortCall
  if not (GetUserId() <> NullIdentifier()):  # CheckGetUserId
    raise PortRuleViolation("Authentication required")
  if not (CheckPortOperatorRole(GetUserId())):  # CheckCheckPortOperatorRole
    raise PortRuleViolation("Role required")
  if not (Tenant <> ""):  # CheckTenant
    raise PortRuleViolation("Business context rejected")
  GetPortEmissionForUpdate = GetPortEmissionForUpdate(Id=EId)
  assign  # SetE
    E = GetPortEmissionForUpdate.Record.PortEmission
  if not (E.Tenant = Tenant):  # CheckETenant
    raise PortRuleViolation("Record outside requested scope")
  if not (E.Version = EVersion):  # CheckEVersion
    raise PortRuleViolation("Record changed; reload before editing")
  GetPortCall = GetPortCall(Id=CId)
  assign  # SetC
    C = GetPortCall.Record.PortCall
  if not (C.Tenant = Tenant):  # CheckCTenant
    raise PortRuleViolation("Record outside requested scope")
  if not (E.CallId = C.Id):  # CheckECallId
    raise PortRuleViolation("Linked")
  if not (C.State = "Departed"):  # CheckCState
    raise PortRuleViolation("Departed")
  if not (E.Verified and E.Co2 - E.Offset <= E.Budget):  # CheckEVerified
    raise PortRuleViolation("Balanced")
  assign  # SetEState
    E.State = "Closed"
    E.UpdatedOn = CurrDateTime()
    E.Version = E.Version + 1
  UpdatePortEmission = UpdatePortEmission(Source=E)
  end

/// ssam-rule-map:{"CheckGetUserId":"Rule_Authenticated_6ab694","CheckCheckPortOperatorRole":"Rule_AuthorizedRole_d1cdc5","CheckTenant":"Rule_AuthorizedScope0_29e52c","GetPortEmissionForUpdate":"Rule_LoadE_fetch_7a95d3","SetE":"Rule_LoadE_record_fec5e0","CheckETenant":"Rule_LoadE_scope0_71d44b","CheckEVersion":"Rule_LoadE_version_789572","CheckEState":"Rule_Open_ed077f","CheckExtra":"Rule_Authorized_67f542","SetWorkflowPrior2":"Rule_Increase_prior_ffefad","SetEBudget":"Rule_Increase_values_59a9c8","UpdatePortEmission":"Rule_Increase_persist_fcd5b2"}
server action PortIncreaseEmissionBudget public
  in Tenant: Text
  in Extra: Decimal
  in Reason: Text
  in EId: PortEmission Identifier
  in EVersion: Long Integer
  local E: PortEmission
  local WorkflowPrior2: PortEmission
  if not (GetUserId() <> NullIdentifier()):  # CheckGetUserId
    raise PortRuleViolation("Authentication required")
  if not (CheckPortOperatorRole(GetUserId())):  # CheckCheckPortOperatorRole
    raise PortRuleViolation("Role required")
  if not (Tenant <> ""):  # CheckTenant
    raise PortRuleViolation("Business context rejected")
  GetPortEmissionForUpdate = GetPortEmissionForUpdate(Id=EId)
  assign  # SetE
    E = GetPortEmissionForUpdate.Record.PortEmission
  if not (E.Tenant = Tenant):  # CheckETenant
    raise PortRuleViolation("Record outside requested scope")
  if not (E.Version = EVersion):  # CheckEVersion
    raise PortRuleViolation("Record changed; reload before editing")
  if not (E.State <> "Closed"):  # CheckEState
    raise PortRuleViolation("Open")
  if not (Extra > 0 and Extra <= E.Budget * 0.2 and Length(Reason) >= 15):  # CheckExtra
    raise PortRuleViolation("Authorized")
  assign  # SetWorkflowPrior2
    WorkflowPrior2 = E
  assign  # SetEBudget
    E.Budget = WorkflowPrior2.Budget + Extra
    E.UpdatedOn = CurrDateTime()
    E.Version = E.Version + 1
  UpdatePortEmission = UpdatePortEmission(Source=E)
  end

/// ssam-rule-map:{"CheckGetUserId":"Rule_Authenticated_6ab694","CheckCheckPortOperatorRole":"Rule_AuthorizedRole_d1cdc5","CheckTenant":"Rule_AuthorizedScope0_29e52c","GetPortEmission":"Rule_LoadE_fetch_7a95d3","SetE":"Rule_LoadE_record_fec5e0","CheckETenant":"Rule_LoadE_scope0_71d44b","CheckECo2":"Rule_Consistent_d9f525","SetGross":"Rule_Result_6e7d50"}
server action PortEmissionBalance public
  in Tenant: Text
  in EId: PortEmission Identifier
  out Gross: Decimal
  out Net: Decimal
  out Remaining: Decimal
  out Exceeded: Boolean
  local E: PortEmission
  if not (GetUserId() <> NullIdentifier()):  # CheckGetUserId
    raise PortRuleViolation("Authentication required")
  if not (CheckPortOperatorRole(GetUserId())):  # CheckCheckPortOperatorRole
    raise PortRuleViolation("Role required")
  if not (Tenant <> ""):  # CheckTenant
    raise PortRuleViolation("Business context rejected")
  GetPortEmission = GetPortEmission(Id=EId)
  assign  # SetE
    E = GetPortEmission.Record.PortEmission
  if not (E.Tenant = Tenant):  # CheckETenant
    raise PortRuleViolation("Record outside requested scope")
  if not (E.Co2 >= E.Offset and E.Offset >= 0 and E.Budget >= 0):  # CheckECo2
    raise PortRuleViolation("Consistent")
  assign  # SetGross
    Gross = E.Co2
    Net = E.Co2 - E.Offset
    Remaining = Max(0, E.Budget - E.Co2 + E.Offset)
    Exceeded = E.Co2 - E.Offset > E.Budget
  end

/// ssam-rule-map:{"CheckGetUserId":"Rule_Authenticated_6ab694","CheckCheckPortOperatorRole":"Rule_AuthorizedRole_d1cdc5","CheckTenant":"Rule_AuthorizedScope0_29e52c","GetPortEmission":"Rule_QueryStatements_query_c2a618","CheckGetPortEmissionCount":"Rule_QueryStatements_complete_0d1f1d","SetStatements":"Rule_QueryStatements_list_c8cd19","SetGross":"Rule_Totals_seed_898bc0","ForEachStatements":"Rule_Totals_each_cdb98e","SetWorkflowAccumulator2":"Rule_Totals_each_Totals_prior_cdc798","SetGross2":"Rule_Totals_each_Totals_step_4a0819"}
server action PortEmissionTotals public
  in Tenant: Text
  out Gross: Decimal
  out Offset: Decimal
  out Budget: Decimal
  out Unverified: Integer
  local Statements: PortEmission List
  local WorkflowAccumulator2: Decimal
  local WorkflowAccumulator3: Decimal
  local WorkflowAccumulator4: Decimal
  local WorkflowAccumulator5: Integer
  if not (GetUserId() <> NullIdentifier()):  # CheckGetUserId
    raise PortRuleViolation("Authentication required")
  if not (CheckPortOperatorRole(GetUserId())):  # CheckCheckPortOperatorRole
    raise PortRuleViolation("Role required")
  if not (Tenant <> ""):  # CheckTenant
    raise PortRuleViolation("Business context rejected")
  GetPortEmission = aggregate FROM PortEmission WHERE (PortEmission.Tenant = Tenant) MAX 1000
  if not (GetPortEmission.Count <= 1000):  # CheckGetPortEmissionCount
    raise PortRuleViolation("Result exceeds declared limit")
  assign  # SetStatements
    Statements = GetPortEmission.List
  assign  # SetGross
    Gross = 0
    Offset = 0
    Budget = 0
    Unverified = 0
  foreach Statements:  # ForEachStatements @ruleNew1
    assign  # SetWorkflowAccumulator2
      WorkflowAccumulator2 = Gross
      WorkflowAccumulator3 = Offset
      WorkflowAccumulator4 = Budget
      WorkflowAccumulator5 = Unverified
    assign  # SetGross2
      Gross = WorkflowAccumulator2 + Statements.Current.Co2
      Offset = WorkflowAccumulator3 + Statements.Current.Offset
      Budget = WorkflowAccumulator4 + Statements.Current.Budget
      Unverified = WorkflowAccumulator5 + If(Statements.Current.Verified, 0, 1)
    next
  end

/// ssam-rule-map:{"CheckGetUserId":"Rule_Authenticated_6ab694","CheckCheckPortOperatorRole":"Rule_AuthorizedRole_d1cdc5","CheckTenant":"Rule_AuthorizedScope0_29e52c","GetPortEmission":"Rule_LoadE_fetch_7a95d3","SetE":"Rule_LoadE_record_fec5e0","CheckETenant":"Rule_LoadE_scope0_71d44b","CheckHours":"Rule_Input_36ecb4","SetProjected":"Rule_Result_6e7d50"}
server action PortForecastFuelEmission public
  in Tenant: Text
  in Hours: Decimal
  in LitresPerHour: Decimal
  in EId: PortEmission Identifier
  out Projected: Decimal
  out WithinBudget: Boolean
  local E: PortEmission
  if not (GetUserId() <> NullIdentifier()):  # CheckGetUserId
    raise PortRuleViolation("Authentication required")
  if not (CheckPortOperatorRole(GetUserId())):  # CheckCheckPortOperatorRole
    raise PortRuleViolation("Role required")
  if not (Tenant <> ""):  # CheckTenant
    raise PortRuleViolation("Business context rejected")
  GetPortEmission = GetPortEmission(Id=EId)
  assign  # SetE
    E = GetPortEmission.Record.PortEmission
  if not (E.Tenant = Tenant):  # CheckETenant
    raise PortRuleViolation("Record outside requested scope")
  if not (Hours >= 0 and LitresPerHour > 0 and E.Factor > 0):  # CheckHours
    raise PortRuleViolation("Input")
  assign  # SetProjected
    Projected = E.Co2 - E.Offset + Hours * LitresPerHour * E.Factor
    WithinBudget = E.Co2 - E.Offset + Hours * LitresPerHour * E.Factor <= E.Budget
  end

/// ssam-rule-map:{"CheckGetUserId":"Rule_Authenticated_6ab694","CheckCheckPortOperatorRole":"Rule_AuthorizedRole_d1cdc5","CheckTenant":"Rule_AuthorizedScope0_29e52c","GetPortEmission":"Rule_QueryStatements_query_c2a618","CheckGetPortEmissionCount":"Rule_QueryStatements_complete_0d1f1d","SetStatements":"Rule_QueryStatements_list_c8cd19","SetOverruns":"Rule_Count_37bac4","ForEachStatements":"Rule_Notify_f4e2b7","SetNotice":"Rule_Notify_Event_reset_39ffbc","SetNoticeTenant":"Rule_Notify_Event_values_1eadef","CreatePortEvent":"Rule_Notify_Event_persist_272d48","SetNoticeId":"Rule_Notify_Event_identity_7847bc"}
server action PortFlagEmissionOverruns public
  in Tenant: Text
  out Overruns: Integer
  local Statements: PortEmission List
  local Notice: PortEvent
  local WorkflowEmpty2: PortEvent
  if not (GetUserId() <> NullIdentifier()):  # CheckGetUserId
    raise PortRuleViolation("Authentication required")
  if not (CheckPortOperatorRole(GetUserId())):  # CheckCheckPortOperatorRole
    raise PortRuleViolation("Role required")
  if not (Tenant <> ""):  # CheckTenant
    raise PortRuleViolation("Business context rejected")
  GetPortEmission = aggregate FROM PortEmission WHERE (PortEmission.Tenant = Tenant and PortEmission.Co2 - PortEmission.Offset > PortEmission.Budget) MAX 1000
  if not (GetPortEmission.Count <= 1000):  # CheckGetPortEmissionCount
    raise PortRuleViolation("Result exceeds declared limit")
  assign  # SetStatements
    Statements = GetPortEmission.List
  assign  # SetOverruns
    Overruns = Statements.Length
  foreach Statements:  # ForEachStatements @ruleNew1
    assign  # SetNotice
      Notice = WorkflowEmpty2
    assign  # SetNoticeTenant
      Notice.Tenant = Tenant
      Notice.CallId = Statements.Current.CallId
      Notice.Kind = "EmissionOverrun"
      Notice.Body = "Budget exceeded"
      Notice.Severity = 4
      Notice.CreatedBy = GetUserId()
      Notice.UpdatedOn = CurrDateTime()
      Notice.CreatedOn = CurrDateTime()
      Notice.Version = 1
    CreatePortEvent = CreatePortEvent(Source=Notice)
    assign  # SetNoticeId
      Notice.Id = CreatePortEvent.Id
    next
  end

/// ssam-rule-map:{"CheckGetUserId":"Rule_Authenticated_6ab694","CheckCheckPortOperatorRole":"Rule_AuthorizedRole_d1cdc5","CheckTenant":"Rule_AuthorizedScope0_29e52c","GetPortEventForUpdate":"Rule_LoadE_fetch_7a95d3","SetE":"Rule_LoadE_record_fec5e0","CheckETenant":"Rule_LoadE_scope0_71d44b","CheckEVersion":"Rule_LoadE_version_789572","Checknot":"Rule_Unacknowledged_b4658c","CheckECreatedBy":"Rule_Independent_6cbf06","SetEAcknowledged":"Rule_Acknowledge_values_d4e667","UpdatePortEvent":"Rule_Acknowledge_persist_9ce2d6"}
server action PortAcknowledgeEvent public
  in Tenant: Text
  in EId: PortEvent Identifier
  in EVersion: Long Integer
  local E: PortEvent
  if not (GetUserId() <> NullIdentifier()):  # CheckGetUserId
    raise PortRuleViolation("Authentication required")
  if not (CheckPortOperatorRole(GetUserId())):  # CheckCheckPortOperatorRole
    raise PortRuleViolation("Role required")
  if not (Tenant <> ""):  # CheckTenant
    raise PortRuleViolation("Business context rejected")
  GetPortEventForUpdate = GetPortEventForUpdate(Id=EId)
  assign  # SetE
    E = GetPortEventForUpdate.Record.PortEvent
  if not (E.Tenant = Tenant):  # CheckETenant
    raise PortRuleViolation("Record outside requested scope")
  if not (E.Version = EVersion):  # CheckEVersion
    raise PortRuleViolation("Record changed; reload before editing")
  if not (not E.Acknowledged):  # Checknot
    raise PortRuleViolation("Unacknowledged")
  if not (E.CreatedBy <> GetUserId() or E.Severity < 4):  # CheckECreatedBy
    raise PortRuleViolation("Independent")
  assign  # SetEAcknowledged
    E.Acknowledged = True
    E.UpdatedOn = CurrDateTime()
    E.Version = E.Version + 1
  UpdatePortEvent = UpdatePortEvent(Source=E)
  end

/// ssam-rule-map:{"CheckGetUserId":"Rule_Authenticated_6ab694","CheckCheckPortOperatorRole":"Rule_AuthorizedRole_d1cdc5","CheckTenant":"Rule_AuthorizedScope0_29e52c","GetPortEventForUpdate":"Rule_LoadE_fetch_7a95d3","SetE":"Rule_LoadE_record_fec5e0","CheckETenant":"Rule_LoadE_scope0_71d44b","CheckEVersion":"Rule_LoadE_version_789572","CheckSeverity":"Rule_Higher_f20a24","SetESeverity":"Rule_Escalate_values_d45b13","UpdatePortEvent":"Rule_Escalate_persist_681e29"}
server action PortEscalateEvent public
  in Tenant: Text
  in Severity: Integer
  in Note: Text
  in EId: PortEvent Identifier
  in EVersion: Long Integer
  local E: PortEvent
  if not (GetUserId() <> NullIdentifier()):  # CheckGetUserId
    raise PortRuleViolation("Authentication required")
  if not (CheckPortOperatorRole(GetUserId())):  # CheckCheckPortOperatorRole
    raise PortRuleViolation("Role required")
  if not (Tenant <> ""):  # CheckTenant
    raise PortRuleViolation("Business context rejected")
  GetPortEventForUpdate = GetPortEventForUpdate(Id=EId)
  assign  # SetE
    E = GetPortEventForUpdate.Record.PortEvent
  if not (E.Tenant = Tenant):  # CheckETenant
    raise PortRuleViolation("Record outside requested scope")
  if not (E.Version = EVersion):  # CheckEVersion
    raise PortRuleViolation("Record changed; reload before editing")
  if not (Severity > E.Severity and Severity <= 5 and Length(Note) >= 10):  # CheckSeverity
    raise PortRuleViolation("Higher")
  assign  # SetESeverity
    E.Severity = Severity
    E.Body = Note
    E.Acknowledged = False
    E.UpdatedOn = CurrDateTime()
    E.Version = E.Version + 1
  UpdatePortEvent = UpdatePortEvent(Source=E)
  end

/// ssam-rule-map:{"CheckGetUserId":"Rule_Authenticated_6ab694","CheckCheckPortOperatorRole":"Rule_AuthorizedRole_d1cdc5","CheckTenant":"Rule_AuthorizedScope0_29e52c","GetPortEvent":"Rule_QueryEvents_query_db0461","CheckGetPortEventCount":"Rule_QueryEvents_complete_203a22","SetEvents":"Rule_QueryEvents_list_61e567","JSONSerialize":"Rule_Serialize_be3403","SetJson":"Rule_Result_6e7d50"}
server action PortExportEventDigest public
  in Tenant: Text
  in CallId: PortCall Identifier
  out Json: Text
  out Count: Integer
  local Events: PortEvent List
  if not (GetUserId() <> NullIdentifier()):  # CheckGetUserId
    raise PortRuleViolation("Authentication required")
  if not (CheckPortOperatorRole(GetUserId())):  # CheckCheckPortOperatorRole
    raise PortRuleViolation("Role required")
  if not (Tenant <> ""):  # CheckTenant
    raise PortRuleViolation("Business context rejected")
  GetPortEvent = aggregate FROM PortEvent WHERE (PortEvent.Tenant = Tenant and PortEvent.CallId = CallId) SORT PortEvent.Severity desc, PortEvent.Id MAX 1000
  if not (GetPortEvent.Count <= 1000):  # CheckGetPortEventCount
    raise PortRuleViolation("Result exceeds declared limit")
  assign  # SetEvents
    Events = GetPortEvent.List
  JSONSerialize = JSONSerialize(Events)
    @{SerializeDefaultValues=True}
  assign  # SetJson
    Json = JSONSerialize.JSON
    Count = Events.Length
  end

/// ssam-rule-map:{"CheckGetUserId":"Rule_Authenticated_6ab694","CheckCheckPortOperatorRole":"Rule_AuthorizedRole_d1cdc5","CheckTenant":"Rule_AuthorizedScope0_29e52c","GetPortCargo":"Rule_QueryLots_query_441c3f","CheckGetPortCargoCount":"Rule_QueryLots_complete_f08141","SetLots":"Rule_QueryLots_list_9762f6","SetWeight":"Rule_Totals_seed_898bc0","ForEachLots":"Rule_Totals_each_cdb98e","SetWorkflowAccumulator2":"Rule_Totals_each_Totals_prior_cdc798","SetWeight2":"Rule_Totals_each_Totals_step_4a0819","JSONSerialize":"Rule_Encode_23389a","SetWeight3":"Rule_Result_6e7d50"}
server action PortCargoManifestDigest public
  in Tenant: Text
  in CallId: PortCall Identifier
  out Weight: Decimal
  out Loaded: Decimal
  out Hazardous: Integer
  out Json: Text
  local Lots: PortCargo List
  local WorkflowAccumulator2: Decimal
  local WorkflowAccumulator3: Decimal
  local WorkflowAccumulator4: Integer
  if not (GetUserId() <> NullIdentifier()):  # CheckGetUserId
    raise PortRuleViolation("Authentication required")
  if not (CheckPortOperatorRole(GetUserId())):  # CheckCheckPortOperatorRole
    raise PortRuleViolation("Role required")
  if not (Tenant <> ""):  # CheckTenant
    raise PortRuleViolation("Business context rejected")
  GetPortCargo = aggregate FROM PortCargo WHERE (PortCargo.Tenant = Tenant and PortCargo.CallId = CallId) MAX 1000
  if not (GetPortCargo.Count <= 1000):  # CheckGetPortCargoCount
    raise PortRuleViolation("Result exceeds declared limit")
  assign  # SetLots
    Lots = GetPortCargo.List
  assign  # SetWeight
    Weight = 0
    Loaded = 0
    Hazardous = 0
  foreach Lots:  # ForEachLots @ruleNew1
    assign  # SetWorkflowAccumulator2
      WorkflowAccumulator2 = Weight
      WorkflowAccumulator3 = Loaded
      WorkflowAccumulator4 = Hazardous
    assign  # SetWeight2
      Weight = WorkflowAccumulator2 + Lots.Current.Weight
      Loaded = WorkflowAccumulator3 + Lots.Current.LoadedWeight
      Hazardous = WorkflowAccumulator4 + If(Lots.Current.HazardClass > 0, 1, 0)
    next
  JSONSerialize = JSONSerialize(Lots)
  assign  # SetWeight3
    Weight = Weight
    Loaded = Loaded
    Hazardous = Hazardous
    Json = JSONSerialize.JSON
  end

/// ssam-rule-map:{"CheckGetUserId":"Rule_Authenticated_6ab694","CheckCheckPortOperatorRole":"Rule_AuthorizedRole_d1cdc5","CheckTenant":"Rule_AuthorizedScope0_29e52c","GetPortCargo":"Rule_QueryCandidates_query_968059","CheckGetPortCargoCount":"Rule_QueryCandidates_complete_e238ff","SetCandidates":"Rule_QueryCandidates_list_156ec1","ListFilter":"Rule_Filter_638e24","SetLots":"Rule_Result_6e7d50"}
server action PortFindHazardousUnreleased public
  in Tenant: Text
  in CallId: PortCall Identifier
  out Lots: PortCargo List
  out Count: Integer
  local Candidates: PortCargo List
  if not (GetUserId() <> NullIdentifier()):  # CheckGetUserId
    raise PortRuleViolation("Authentication required")
  if not (CheckPortOperatorRole(GetUserId())):  # CheckCheckPortOperatorRole
    raise PortRuleViolation("Role required")
  if not (Tenant <> ""):  # CheckTenant
    raise PortRuleViolation("Business context rejected")
  GetPortCargo = aggregate FROM PortCargo WHERE (PortCargo.Tenant = Tenant and PortCargo.CallId = CallId) MAX 1000
  if not (GetPortCargo.Count <= 1000):  # CheckGetPortCargoCount
    raise PortRuleViolation("Result exceeds declared limit")
  assign  # SetCandidates
    Candidates = GetPortCargo.List
  ListFilter = (System).ListFilter(SourceList=Candidates, Condition=HazardClass > 0 and not CustomsReleased)
  assign  # SetLots
    Lots = ListFilter.FilteredList
    Count = ListFilter.FilteredList.Length
  end

/// ssam-rule-map:{"CheckGetUserId":"Rule_Authenticated_6ab694","CheckCheckPortOperatorRole":"Rule_AuthorizedRole_d1cdc5","CheckTenant":"Rule_AuthorizedScope0_29e52c","GetPortCargo":"Rule_QueryCandidates_query_968059","CheckGetPortCargoCount":"Rule_QueryCandidates_complete_e238ff","SetCandidates":"Rule_QueryCandidates_list_156ec1","ListFilter":"Rule_Filter_638e24","SetLots":"Rule_Result_6e7d50"}
server action PortFindTemperatureExcursions public
  in Tenant: Text
  in CallId: PortCall Identifier
  out Lots: PortCargo List
  out Count: Integer
  local Candidates: PortCargo List
  if not (GetUserId() <> NullIdentifier()):  # CheckGetUserId
    raise PortRuleViolation("Authentication required")
  if not (CheckPortOperatorRole(GetUserId())):  # CheckCheckPortOperatorRole
    raise PortRuleViolation("Role required")
  if not (Tenant <> ""):  # CheckTenant
    raise PortRuleViolation("Business context rejected")
  GetPortCargo = aggregate FROM PortCargo WHERE (PortCargo.Tenant = Tenant and PortCargo.CallId = CallId) MAX 1000
  if not (GetPortCargo.Count <= 1000):  # CheckGetPortCargoCount
    raise PortRuleViolation("Result exceeds declared limit")
  assign  # SetCandidates
    Candidates = GetPortCargo.List
  ListFilter = (System).ListFilter(SourceList=Candidates, Condition=Reefer and (Temperature < MinTemp or Temperature > MaxTemp))
  assign  # SetLots
    Lots = ListFilter.FilteredList
    Count = ListFilter.FilteredList.Length
  end

/// ssam-rule-map:{"CheckGetUserId":"Rule_Authenticated_6ab694","CheckCheckPortOperatorRole":"Rule_AuthorizedRole_d1cdc5","CheckTenant":"Rule_AuthorizedScope0_29e52c","GetPortCall":"Rule_QueryOpenCalls_query_e1e9cb","CheckGetPortCallCount":"Rule_QueryOpenCalls_complete_ee15df","SetOpenCalls":"Rule_QueryOpenCalls_list_ffd2ec","SetCalls":"Rule_Counters_seed_78b3d4","ForEachOpenCalls":"Rule_Counters_each_ad2d0d","SetWorkflowAccumulator2":"Rule_Counters_each_Counters_prior_6d7cfe","SetCalls2":"Rule_Counters_each_Counters_step_477fb8"}
server action PortOperationalDashboard public
  in Tenant: Text
  out Calls: Integer
  out Waiting: Integer
  out Late: Integer
  out MaxDelay: Decimal
  local OpenCalls: PortCall List
  local WorkflowAccumulator2: Integer
  local WorkflowAccumulator3: Integer
  local WorkflowAccumulator4: Integer
  local WorkflowAccumulator5: Decimal
  if not (GetUserId() <> NullIdentifier()):  # CheckGetUserId
    raise PortRuleViolation("Authentication required")
  if not (CheckPortOperatorRole(GetUserId())):  # CheckCheckPortOperatorRole
    raise PortRuleViolation("Role required")
  if not (Tenant <> ""):  # CheckTenant
    raise PortRuleViolation("Business context rejected")
  GetPortCall = aggregate FROM PortCall WHERE (PortCall.Tenant = Tenant and PortCall.State <> "Departed" and PortCall.State <> "Cancelled") MAX 1000
  if not (GetPortCall.Count <= 1000):  # CheckGetPortCallCount
    raise PortRuleViolation("Result exceeds declared limit")
  assign  # SetOpenCalls
    OpenCalls = GetPortCall.List
  assign  # SetCalls
    Calls = 0
    Waiting = 0
    Late = 0
    MaxDelay = 0
  foreach OpenCalls:  # ForEachOpenCalls @ruleNew1
    assign  # SetWorkflowAccumulator2
      WorkflowAccumulator2 = Calls
      WorkflowAccumulator3 = Waiting
      WorkflowAccumulator4 = Late
      WorkflowAccumulator5 = MaxDelay
    assign  # SetCalls2
      Calls = WorkflowAccumulator2 + 1
      Waiting = WorkflowAccumulator3 + If(OpenCalls.Current.State = "Approved", 1, 0)
      Late = WorkflowAccumulator4 + If(OpenCalls.Current.PlannedStart < CurrDateTime(), 1, 0)
      MaxDelay = Max(WorkflowAccumulator5, OpenCalls.Current.DelayHours)
    next
  end

/// ssam-rule-map:{"CheckGetUserId":"Rule_Authenticated_6ab694","CheckCheckPortOperatorRole":"Rule_AuthorizedRole_d1cdc5","CheckTenant":"Rule_AuthorizedScope0_29e52c","GetPortEvent":"Rule_QueryEvents_query_db0461","CheckGetPortEventCount":"Rule_QueryEvents_complete_203a22","SetEvents":"Rule_QueryEvents_list_61e567","SetCritical":"Rule_Counters_seed_78b3d4","ForEachEvents":"Rule_Counters_each_ad2d0d","SetWorkflowAccumulator2":"Rule_Counters_each_Counters_prior_6d7cfe","SetCritical2":"Rule_Counters_each_Counters_step_477fb8"}
server action PortCriticalEventSummary public
  in Tenant: Text
  out Critical: Integer
  out Unacknowledged: Integer
  out Highest: Integer
  local Events: PortEvent List
  local WorkflowAccumulator2: Integer
  local WorkflowAccumulator3: Integer
  local WorkflowAccumulator4: Integer
  if not (GetUserId() <> NullIdentifier()):  # CheckGetUserId
    raise PortRuleViolation("Authentication required")
  if not (CheckPortOperatorRole(GetUserId())):  # CheckCheckPortOperatorRole
    raise PortRuleViolation("Role required")
  if not (Tenant <> ""):  # CheckTenant
    raise PortRuleViolation("Business context rejected")
  GetPortEvent = aggregate FROM PortEvent WHERE (PortEvent.Tenant = Tenant and not PortEvent.Acknowledged) MAX 1000
  if not (GetPortEvent.Count <= 1000):  # CheckGetPortEventCount
    raise PortRuleViolation("Result exceeds declared limit")
  assign  # SetEvents
    Events = GetPortEvent.List
  assign  # SetCritical
    Critical = 0
    Unacknowledged = 0
    Highest = 0
  foreach Events:  # ForEachEvents @ruleNew1
    assign  # SetWorkflowAccumulator2
      WorkflowAccumulator2 = Critical
      WorkflowAccumulator3 = Unacknowledged
      WorkflowAccumulator4 = Highest
    assign  # SetCritical2
      Critical = WorkflowAccumulator2 + If(Events.Current.Severity >= 4, 1, 0)
      Unacknowledged = WorkflowAccumulator3 + 1
      Highest = Max(WorkflowAccumulator4, Events.Current.Severity)
    next
  end

/// ssam-rule-map:{"CheckGetUserId":"Rule_Authenticated_6ab694","CheckCheckPortOperatorRole":"Rule_AuthorizedRole_d1cdc5","CheckTenant":"Rule_AuthorizedScope0_29e52c","GetPortCall":"Rule_LoadC_fetch_e1b659","SetC":"Rule_LoadC_record_8a1990","CheckCTenant":"Rule_LoadC_scope0_da3cb1","GetPortVessel":"Rule_LoadV_fetch_bf4397","SetV":"Rule_LoadV_record_dd84b9","CheckVTenant":"Rule_LoadV_scope0_b5ed85","GetPortCargo":"Rule_QueryLots_query_441c3f","CheckGetPortCargoCount":"Rule_QueryLots_complete_f08141","SetLots":"Rule_QueryLots_list_9762f6","CheckTolerance":"Rule_Tolerance_f71041","SetDeclared":"Rule_Totals_seed_898bc0","ForEachLots":"Rule_Totals_each_cdb98e","SetWorkflowAccumulator4":"Rule_Totals_each_Totals_prior_cdc798","SetDeclared2":"Rule_Totals_each_Totals_step_4a0819","SetDeclared3":"Rule_Result_6e7d50"}
server action PortReconcileCargoTonnage public
  in Tenant: Text
  in CallId: PortCall Identifier
  in Tolerance: Decimal
  out Declared: Decimal
  out Loaded: Decimal
  out Difference: Decimal
  out Balanced: Boolean
  local C: PortCall
  local V: PortVessel
  local Lots: PortCargo List
  local WorkflowAccumulator4: Decimal
  local WorkflowAccumulator5: Decimal
  if not (GetUserId() <> NullIdentifier()):  # CheckGetUserId
    raise PortRuleViolation("Authentication required")
  if not (CheckPortOperatorRole(GetUserId())):  # CheckCheckPortOperatorRole
    raise PortRuleViolation("Role required")
  if not (Tenant <> ""):  # CheckTenant
    raise PortRuleViolation("Business context rejected")
  GetPortCall = GetPortCall(Id=CallId)
  assign  # SetC
    C = GetPortCall.Record.PortCall
  if not (C.Tenant = Tenant):  # CheckCTenant
    raise PortRuleViolation("Record outside requested scope")
  GetPortVessel = GetPortVessel(Id=C.VesselId)
  assign  # SetV
    V = GetPortVessel.Record.PortVessel
  if not (V.Tenant = Tenant):  # CheckVTenant
    raise PortRuleViolation("Record outside requested scope")
  GetPortCargo = aggregate FROM PortCargo WHERE (PortCargo.Tenant = Tenant and PortCargo.CallId = CallId) MAX 1000
  if not (GetPortCargo.Count <= 1000):  # CheckGetPortCargoCount
    raise PortRuleViolation("Result exceeds declared limit")
  assign  # SetLots
    Lots = GetPortCargo.List
  if not (Tolerance >= 0):  # CheckTolerance
    raise PortRuleViolation("Tolerance")
  assign  # SetDeclared
    Declared = 0
    Loaded = 0
  foreach Lots:  # ForEachLots @ruleNew1
    assign  # SetWorkflowAccumulator4
      WorkflowAccumulator4 = Declared
      WorkflowAccumulator5 = Loaded
    assign  # SetDeclared2
      Declared = WorkflowAccumulator4 + Lots.Current.Weight
      Loaded = WorkflowAccumulator5 + Lots.Current.LoadedWeight
    next
  assign  # SetDeclared3
    Declared = Declared
    Loaded = Loaded
    Difference = Abs(V.UsedTonnage - Loaded)
    Balanced = Abs(V.UsedTonnage - Loaded) <= Tolerance and Loaded <= Declared
  end

/// ssam-rule-map:{"CheckGetUserId":"Rule_Authenticated_6ab694","CheckCheckPortOperatorRole":"Rule_AuthorizedRole_d1cdc5","CheckTenant":"Rule_AuthorizedScope0_29e52c","GetPortCall":"Rule_LoadC_fetch_e1b659","SetC":"Rule_LoadC_record_8a1990","CheckCTenant":"Rule_LoadC_scope0_da3cb1","GetPortEvent":"Rule_QueryCritical_query_7f5949","SetCritical":"Rule_QueryCritical_list_6a0791","CheckCState":"Rule_Closed_c21ead","SetEvent":"Rule_Archive_reset_d82725","SetEventTenant":"Rule_Archive_values_19895e","CreatePortEvent":"Rule_Archive_persist_777d96","SetEventId":"Rule_Archive_identity_ef836e"}
server action PortArchiveCallEvent public
  in Tenant: Text
  in Summary: Text
  in CId: PortCall Identifier
  local C: PortCall
  local Critical: Boolean
  local Event: PortEvent
  local WorkflowEmpty3: PortEvent
  if not (GetUserId() <> NullIdentifier()):  # CheckGetUserId
    raise PortRuleViolation("Authentication required")
  if not (CheckPortOperatorRole(GetUserId())):  # CheckCheckPortOperatorRole
    raise PortRuleViolation("Role required")
  if not (Tenant <> ""):  # CheckTenant
    raise PortRuleViolation("Business context rejected")
  GetPortCall = GetPortCall(Id=CId)
  assign  # SetC
    C = GetPortCall.Record.PortCall
  if not (C.Tenant = Tenant):  # CheckCTenant
    raise PortRuleViolation("Record outside requested scope")
  GetPortEvent = aggregate FROM PortEvent WHERE (PortEvent.Tenant = Tenant and PortEvent.CallId = C.Id and PortEvent.Severity >= 4 and not PortEvent.Acknowledged) MAX 1
  assign  # SetCritical
    Critical = not GetPortEvent.List.Empty
  if not (C.State = "Departed" and not Critical and Length(Summary) >= 15):  # CheckCState
    raise PortRuleViolation("Closed")
  assign  # SetEvent
    Event = WorkflowEmpty3
  assign  # SetEventTenant
    Event.Tenant = Tenant
    Event.CallId = C.Id
    Event.Kind = "CallArchive"
    Event.Body = Summary
    Event.Severity = 1
    Event.Acknowledged = True
    Event.CreatedBy = GetUserId()
    Event.UpdatedOn = CurrDateTime()
    Event.CreatedOn = CurrDateTime()
    Event.Version = 1
  CreatePortEvent = CreatePortEvent(Source=Event)
  assign  # SetEventId
    Event.Id = CreatePortEvent.Id
  end
