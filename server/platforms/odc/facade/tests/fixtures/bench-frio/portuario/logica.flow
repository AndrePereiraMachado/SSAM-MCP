/// ssam-rule-map:{"CheckGetUserId":"Rule_Authenticated_6ab694","CheckCheckPortOperatorRole":"Rule_AuthorizedRole_d1cdc5","CheckTenant":"Rule_AuthorizedScope0_29e52c","GetPortVessel":"Rule_LoadV_fetch_bf4397","SetV":"Rule_LoadV_record_dd84b9","CheckVTenant":"Rule_LoadV_scope0_b5ed85","GetPortCallForUpdate":"Rule_LoadC_fetch_e1b659","SetC":"Rule_LoadC_record_8a1990","CheckCTenant":"Rule_LoadC_scope0_da3cb1","CheckCVersion":"Rule_LoadC_version_0eeb8c","GetPortBerth":"Rule_LoadB_fetch_2fd733","SetB":"Rule_LoadB_record_057f8a","CheckBTenant":"Rule_LoadB_scope0_487087","CheckCVesselId":"Rule_Linked_bfda02","CheckVDraft":"Rule_Safe_4f9f0d","CheckCState":"Rule_Ready_5fa7aa","SetCState":"Rule_Approve_values_b86499","UpdatePortCall":"Rule_Approve_persist_b4a05b"}
server action PortApproveArrival public
  in Tenant: Text
  in VId: PortVessel Identifier
  in CId: PortCall Identifier
  in CVersion: Long Integer
  in BId: PortBerth Identifier
  local V: PortVessel
  local C: PortCall
  local B: PortBerth
  if not (GetUserId() <> NullIdentifier()):  # CheckGetUserId
    raise PortRuleViolation("Authentication required")
  if not (CheckPortOperatorRole(GetUserId())):  # CheckCheckPortOperatorRole
    raise PortRuleViolation("Role required")
  if not (Tenant <> ""):  # CheckTenant
    raise PortRuleViolation("Business context rejected")
  GetPortVessel = GetPortVessel(Id=VId)
  assign  # SetV
    V = GetPortVessel.Record.PortVessel
  if not (V.Tenant = Tenant):  # CheckVTenant
    raise PortRuleViolation("Record outside requested scope")
  GetPortCallForUpdate = GetPortCallForUpdate(Id=CId)
  assign  # SetC
    C = GetPortCallForUpdate.Record.PortCall
  if not (C.Tenant = Tenant):  # CheckCTenant
    raise PortRuleViolation("Record outside requested scope")
  if not (C.Version = CVersion):  # CheckCVersion
    raise PortRuleViolation("Record changed; reload before editing")
  GetPortBerth = GetPortBerth(Id=BId)
  assign  # SetB
    B = GetPortBerth.Record.PortBerth
  if not (B.Tenant = Tenant):  # CheckBTenant
    raise PortRuleViolation("Record outside requested scope")
  if not (C.VesselId = V.Id and C.BerthId = B.Id):  # CheckCVesselId
    raise PortRuleViolation("Linked")
  if not (V.Draft + 1 <= B.Depth and V.Length <= B.Length - B.ReservedLength and V.Beam <= B.MaxBeam):  # CheckVDraft
    raise PortRuleViolation("Safe")
  if not (C.State = "Requested" and C.DocsComplete and not B.Occupied):  # CheckCState
    raise PortRuleViolation("Ready")
  assign  # SetCState
    C.State = "Approved"
    C.TugsRequired = If(V.Length > 200, 2, 1)
    C.UpdatedOn = CurrDateTime()
    C.Version = C.Version + 1
  UpdatePortCall = UpdatePortCall(Source=C)
  end

/// ssam-rule-map:{"CheckGetUserId":"Rule_Authenticated_6ab694","CheckCheckPortOperatorRole":"Rule_AuthorizedRole_d1cdc5","CheckTenant":"Rule_AuthorizedScope0_29e52c","GetPortCallForUpdate":"Rule_LoadC_fetch_e1b659","SetC":"Rule_LoadC_record_8a1990","CheckCTenant":"Rule_LoadC_scope0_da3cb1","CheckCVersion":"Rule_LoadC_version_0eeb8c","GetPortBerthForUpdate":"Rule_LoadB_fetch_2fd733","SetB":"Rule_LoadB_record_057f8a","CheckBTenant":"Rule_LoadB_scope0_487087","CheckBVersion":"Rule_LoadB_version_da9e59","CheckCBerthId":"Rule_Assigned_819188","Checknot":"Rule_Weather_a0bba6","SetCState":"Rule_Call_values_7d7d06","UpdatePortCall":"Rule_Call_persist_d92e53","SetBOccupied":"Rule_Occupy_values_ff7ddc","UpdatePortBerth":"Rule_Occupy_persist_bcb5e1"}
server action PortBeginBerthing public
  in Tenant: Text
  in CId: PortCall Identifier
  in CVersion: Long Integer
  in BId: PortBerth Identifier
  in BVersion: Long Integer
  local C: PortCall
  local B: PortBerth
  if not (GetUserId() <> NullIdentifier()):  # CheckGetUserId
    raise PortRuleViolation("Authentication required")
  if not (CheckPortOperatorRole(GetUserId())):  # CheckCheckPortOperatorRole
    raise PortRuleViolation("Role required")
  if not (Tenant <> ""):  # CheckTenant
    raise PortRuleViolation("Business context rejected")
  GetPortCallForUpdate = GetPortCallForUpdate(Id=CId)
  assign  # SetC
    C = GetPortCallForUpdate.Record.PortCall
  if not (C.Tenant = Tenant):  # CheckCTenant
    raise PortRuleViolation("Record outside requested scope")
  if not (C.Version = CVersion):  # CheckCVersion
    raise PortRuleViolation("Record changed; reload before editing")
  GetPortBerthForUpdate = GetPortBerthForUpdate(Id=BId)
  assign  # SetB
    B = GetPortBerthForUpdate.Record.PortBerth
  if not (B.Tenant = Tenant):  # CheckBTenant
    raise PortRuleViolation("Record outside requested scope")
  if not (B.Version = BVersion):  # CheckBVersion
    raise PortRuleViolation("Record changed; reload before editing")
  if not (C.BerthId = B.Id and C.State = "Approved"):  # CheckCBerthId
    raise PortRuleViolation("Assigned")
  if not (not B.Occupied and B.CurrentWind <= B.ClosedWind):  # Checknot
    raise PortRuleViolation("Weather")
  assign  # SetCState
    C.State = "Berthed"
    C.ActualStart = CurrDateTime()
    C.UpdatedOn = CurrDateTime()
    C.Version = C.Version + 1
  UpdatePortCall = UpdatePortCall(Source=C)
  assign  # SetBOccupied
    B.Occupied = True
    B.UpdatedOn = CurrDateTime()
    B.Version = B.Version + 1
  UpdatePortBerth = UpdatePortBerth(Source=B)
  end

/// ssam-rule-map:{"CheckGetUserId":"Rule_Authenticated_6ab694","CheckCheckPortOperatorRole":"Rule_AuthorizedRole_d1cdc5","CheckTenant":"Rule_AuthorizedScope0_29e52c","GetPortCallForUpdate":"Rule_LoadC_fetch_e1b659","SetC":"Rule_LoadC_record_8a1990","CheckCTenant":"Rule_LoadC_scope0_da3cb1","CheckCVersion":"Rule_LoadC_version_0eeb8c","GetPortBerthForUpdate":"Rule_LoadB_fetch_2fd733","SetB":"Rule_LoadB_record_057f8a","CheckBTenant":"Rule_LoadB_scope0_487087","CheckBVersion":"Rule_LoadB_version_da9e59","CheckCBerthId":"Rule_Allowed_1bb201","SetCState":"Rule_Finish_values_63626d","UpdatePortCall":"Rule_Finish_persist_d572e0","SetBOccupied":"Rule_Free_values_54be0c","UpdatePortBerth":"Rule_Free_persist_291d15"}
server action PortCompleteDeparture public
  in Tenant: Text
  in CId: PortCall Identifier
  in CVersion: Long Integer
  in BId: PortBerth Identifier
  in BVersion: Long Integer
  local C: PortCall
  local B: PortBerth
  if not (GetUserId() <> NullIdentifier()):  # CheckGetUserId
    raise PortRuleViolation("Authentication required")
  if not (CheckPortOperatorRole(GetUserId())):  # CheckCheckPortOperatorRole
    raise PortRuleViolation("Role required")
  if not (Tenant <> ""):  # CheckTenant
    raise PortRuleViolation("Business context rejected")
  GetPortCallForUpdate = GetPortCallForUpdate(Id=CId)
  assign  # SetC
    C = GetPortCallForUpdate.Record.PortCall
  if not (C.Tenant = Tenant):  # CheckCTenant
    raise PortRuleViolation("Record outside requested scope")
  if not (C.Version = CVersion):  # CheckCVersion
    raise PortRuleViolation("Record changed; reload before editing")
  GetPortBerthForUpdate = GetPortBerthForUpdate(Id=BId)
  assign  # SetB
    B = GetPortBerthForUpdate.Record.PortBerth
  if not (B.Tenant = Tenant):  # CheckBTenant
    raise PortRuleViolation("Record outside requested scope")
  if not (B.Version = BVersion):  # CheckBVersion
    raise PortRuleViolation("Record changed; reload before editing")
  if not (C.BerthId = B.Id and C.State = "Berthed" and C.DepartureAuthorized):  # CheckCBerthId
    raise PortRuleViolation("Allowed")
  assign  # SetCState
    C.State = "Departed"
    C.ActualEnd = CurrDateTime()
    C.UpdatedOn = CurrDateTime()
    C.Version = C.Version + 1
  UpdatePortCall = UpdatePortCall(Source=C)
  assign  # SetBOccupied
    B.Occupied = False
    B.PowerUsed = 0
    B.UpdatedOn = CurrDateTime()
    B.Version = B.Version + 1
  UpdatePortBerth = UpdatePortBerth(Source=B)
  end

/// ssam-rule-map:{"CheckGetUserId":"Rule_Authenticated_6ab694","CheckCheckPortOperatorRole":"Rule_AuthorizedRole_d1cdc5","CheckTenant":"Rule_AuthorizedScope0_29e52c","GetPortCallForUpdate":"Rule_LoadC_fetch_e1b659","SetC":"Rule_LoadC_record_8a1990","CheckCTenant":"Rule_LoadC_scope0_da3cb1","CheckCVersion":"Rule_LoadC_version_0eeb8c","GetPortCall":"Rule_QueryConflicts_query_852d6d","SetConflicts":"Rule_QueryConflicts_list_02fa2a","CheckNewEnd":"Rule_Window_19734a","CheckCState":"Rule_Unstarted_f60ed5","Checknot":"Rule_NoConflict_95aec7","SetCPlannedStart":"Rule_Move_values_89649d","UpdatePortCall":"Rule_Move_persist_b250c5"}
server action PortShiftArrivalWindow public
  in Tenant: Text
  in NewStart: Date Time
  in NewEnd: Date Time
  in CId: PortCall Identifier
  in CVersion: Long Integer
  local C: PortCall
  local Conflicts: Boolean
  if not (GetUserId() <> NullIdentifier()):  # CheckGetUserId
    raise PortRuleViolation("Authentication required")
  if not (CheckPortOperatorRole(GetUserId())):  # CheckCheckPortOperatorRole
    raise PortRuleViolation("Role required")
  if not (Tenant <> ""):  # CheckTenant
    raise PortRuleViolation("Business context rejected")
  GetPortCallForUpdate = GetPortCallForUpdate(Id=CId)
  assign  # SetC
    C = GetPortCallForUpdate.Record.PortCall
  if not (C.Tenant = Tenant):  # CheckCTenant
    raise PortRuleViolation("Record outside requested scope")
  if not (C.Version = CVersion):  # CheckCVersion
    raise PortRuleViolation("Record changed; reload before editing")
  GetPortCall = aggregate FROM PortCall WHERE (PortCall.BerthId = C.BerthId and PortCall.Id <> C.Id and PortCall.State <> "Cancelled" and PortCall.PlannedStart < NewEnd and PortCall.PlannedEnd > NewStart) MAX 1
  assign  # SetConflicts
    Conflicts = not GetPortCall.List.Empty
  if not (NewEnd > NewStart and NewStart > CurrDateTime()):  # CheckNewEnd
    raise PortRuleViolation("Window")
  if not (C.State = "Requested" or C.State = "Approved"):  # CheckCState
    raise PortRuleViolation("Unstarted")
  if not (not Conflicts):  # Checknot
    raise PortRuleViolation("NoConflict")
  assign  # SetCPlannedStart
    C.PlannedStart = NewStart
    C.PlannedEnd = NewEnd
    C.UpdatedOn = CurrDateTime()
    C.Version = C.Version + 1
  UpdatePortCall = UpdatePortCall(Source=C)
  end

/// ssam-rule-map:{"CheckGetUserId":"Rule_Authenticated_6ab694","CheckCheckPortOperatorRole":"Rule_AuthorizedRole_d1cdc5","CheckTenant":"Rule_AuthorizedScope0_29e52c","GetPortCallForUpdate":"Rule_LoadC_fetch_e1b659","SetC":"Rule_LoadC_record_8a1990","CheckCTenant":"Rule_LoadC_scope0_da3cb1","CheckCVersion":"Rule_LoadC_version_0eeb8c","CheckCState":"Rule_Unstarted_f60ed5","CheckLength":"Rule_Reasoned_592d44","SetCState":"Rule_Cancel_values_bc24f6","UpdatePortCall":"Rule_Cancel_persist_dcc02e","SetEvent":"Rule_Audit_reset_f0a34c","SetEventTenant":"Rule_Audit_values_c5f614","CreatePortEvent":"Rule_Audit_persist_225f32","SetEventId":"Rule_Audit_identity_dd9ab7"}
server action PortCancelCall public
  in Tenant: Text
  in Reason: Text
  in CId: PortCall Identifier
  in CVersion: Long Integer
  local C: PortCall
  local Event: PortEvent
  local WorkflowEmpty2: PortEvent
  if not (GetUserId() <> NullIdentifier()):  # CheckGetUserId
    raise PortRuleViolation("Authentication required")
  if not (CheckPortOperatorRole(GetUserId())):  # CheckCheckPortOperatorRole
    raise PortRuleViolation("Role required")
  if not (Tenant <> ""):  # CheckTenant
    raise PortRuleViolation("Business context rejected")
  GetPortCallForUpdate = GetPortCallForUpdate(Id=CId)
  assign  # SetC
    C = GetPortCallForUpdate.Record.PortCall
  if not (C.Tenant = Tenant):  # CheckCTenant
    raise PortRuleViolation("Record outside requested scope")
  if not (C.Version = CVersion):  # CheckCVersion
    raise PortRuleViolation("Record changed; reload before editing")
  if not (C.State = "Requested" or C.State = "Approved"):  # CheckCState
    raise PortRuleViolation("Unstarted")
  if not (Length(Trim(Reason)) >= 10):  # CheckLength
    raise PortRuleViolation("Reasoned")
  assign  # SetCState
    C.State = "Cancelled"
    C.DepartureAuthorized = False
    C.UpdatedOn = CurrDateTime()
    C.Version = C.Version + 1
  UpdatePortCall = UpdatePortCall(Source=C)
  assign  # SetEvent
    Event = WorkflowEmpty2
  assign  # SetEventTenant
    Event.Tenant = Tenant
    Event.CallId = C.Id
    Event.Kind = "Cancellation"
    Event.Body = Reason
    Event.Severity = 2
    Event.CreatedBy = GetUserId()
    Event.UpdatedOn = CurrDateTime()
    Event.CreatedOn = CurrDateTime()
    Event.Version = 1
  CreatePortEvent = CreatePortEvent(Source=Event)
  assign  # SetEventId
    Event.Id = CreatePortEvent.Id
  end

/// ssam-rule-map:{"CheckGetUserId":"Rule_Authenticated_6ab694","CheckCheckPortOperatorRole":"Rule_AuthorizedRole_d1cdc5","CheckTenant":"Rule_AuthorizedScope0_29e52c","GetPortCallForUpdate":"Rule_LoadC_fetch_e1b659","SetC":"Rule_LoadC_record_8a1990","CheckCTenant":"Rule_LoadC_scope0_da3cb1","CheckCVersion":"Rule_LoadC_version_0eeb8c","CheckCState":"Rule_Pending_331551","SetWorkflowPrior2":"Rule_Priority_prior_84f352","SetCPriority":"Rule_Priority_values_28a174","UpdatePortCall":"Rule_Priority_persist_39703e"}
server action PortReprioritizeCall public
  in Tenant: Text
  in Medical: Boolean
  in Perishable: Boolean
  in CId: PortCall Identifier
  in CVersion: Long Integer
  local C: PortCall
  local WorkflowPrior2: PortCall
  if not (GetUserId() <> NullIdentifier()):  # CheckGetUserId
    raise PortRuleViolation("Authentication required")
  if not (CheckPortOperatorRole(GetUserId())):  # CheckCheckPortOperatorRole
    raise PortRuleViolation("Role required")
  if not (Tenant <> ""):  # CheckTenant
    raise PortRuleViolation("Business context rejected")
  GetPortCallForUpdate = GetPortCallForUpdate(Id=CId)
  assign  # SetC
    C = GetPortCallForUpdate.Record.PortCall
  if not (C.Tenant = Tenant):  # CheckCTenant
    raise PortRuleViolation("Record outside requested scope")
  if not (C.Version = CVersion):  # CheckCVersion
    raise PortRuleViolation("Record changed; reload before editing")
  if not (C.State = "Requested" or C.State = "Approved"):  # CheckCState
    raise PortRuleViolation("Pending")
  assign  # SetWorkflowPrior2
    WorkflowPrior2 = C
  assign  # SetCPriority
    C.Priority = If(Medical, 100, If(Perishable, 60, 20)) + Min(20, DecimalToInteger(WorkflowPrior2.DelayHours))
    C.UpdatedOn = CurrDateTime()
    C.Version = C.Version + 1
  UpdatePortCall = UpdatePortCall(Source=C)
  end

/// ssam-rule-map:{"CheckGetUserId":"Rule_Authenticated_6ab694","CheckCheckPortOperatorRole":"Rule_AuthorizedRole_d1cdc5","CheckTenant":"Rule_AuthorizedScope0_29e52c","GetPortCallForUpdate":"Rule_LoadC_fetch_e1b659","SetC":"Rule_LoadC_record_8a1990","CheckCTenant":"Rule_LoadC_scope0_da3cb1","CheckCVersion":"Rule_LoadC_version_0eeb8c","CheckHours":"Rule_Positive_14e9f4","CheckCState":"Rule_Open_ed077f","SetWorkflowPrior2":"Rule_Delay_prior_df150f","SetCDelayHours":"Rule_Delay_values_8704dd","UpdatePortCall":"Rule_Delay_persist_0d90f1"}
server action PortRecordDelay public
  in Tenant: Text
  in Hours: Decimal
  in Reason: Text
  in CId: PortCall Identifier
  in CVersion: Long Integer
  local C: PortCall
  local WorkflowPrior2: PortCall
  if not (GetUserId() <> NullIdentifier()):  # CheckGetUserId
    raise PortRuleViolation("Authentication required")
  if not (CheckPortOperatorRole(GetUserId())):  # CheckCheckPortOperatorRole
    raise PortRuleViolation("Role required")
  if not (Tenant <> ""):  # CheckTenant
    raise PortRuleViolation("Business context rejected")
  GetPortCallForUpdate = GetPortCallForUpdate(Id=CId)
  assign  # SetC
    C = GetPortCallForUpdate.Record.PortCall
  if not (C.Tenant = Tenant):  # CheckCTenant
    raise PortRuleViolation("Record outside requested scope")
  if not (C.Version = CVersion):  # CheckCVersion
    raise PortRuleViolation("Record changed; reload before editing")
  if not (Hours > 0 and Hours <= 72 and Length(Reason) >= 5):  # CheckHours
    raise PortRuleViolation("Positive")
  if not (C.State <> "Departed" and C.State <> "Cancelled"):  # CheckCState
    raise PortRuleViolation("Open")
  assign  # SetWorkflowPrior2
    WorkflowPrior2 = C
  assign  # SetCDelayHours
    C.DelayHours = WorkflowPrior2.DelayHours + Hours
    C.Priority = Min(100, WorkflowPrior2.Priority + DecimalToInteger(Hours))
    C.UpdatedOn = CurrDateTime()
    C.Version = C.Version + 1
  UpdatePortCall = UpdatePortCall(Source=C)
  end

/// ssam-rule-map:{"CheckGetUserId":"Rule_Authenticated_6ab694","CheckCheckPortOperatorRole":"Rule_AuthorizedRole_d1cdc5","CheckTenant":"Rule_AuthorizedScope0_29e52c","GetPortCallForUpdate":"Rule_LoadC_fetch_e1b659","SetC":"Rule_LoadC_record_8a1990","CheckCTenant":"Rule_LoadC_scope0_da3cb1","CheckCVersion":"Rule_LoadC_version_0eeb8c","GetPortInvoice":"Rule_QueryUnpaid_query_35f9f1","SetUnpaid":"Rule_QueryUnpaid_list_7c6a39","GetPortInspection":"Rule_QueryUnsafe_query_42b6bb","SetUnsafe":"Rule_QueryUnsafe_list_39c3b4","CheckCState":"Rule_Berthed_715796","Checknot":"Rule_Cleared_15f3a2","SetCDepartureAuthorized":"Rule_Authorize_values_bff2d7","UpdatePortCall":"Rule_Authorize_persist_16eb22"}
server action PortAuthorizeSailing public
  in Tenant: Text
  in CId: PortCall Identifier
  in CVersion: Long Integer
  local C: PortCall
  local Unpaid: Boolean
  local Unsafe: Boolean
  if not (GetUserId() <> NullIdentifier()):  # CheckGetUserId
    raise PortRuleViolation("Authentication required")
  if not (CheckPortOperatorRole(GetUserId())):  # CheckCheckPortOperatorRole
    raise PortRuleViolation("Role required")
  if not (Tenant <> ""):  # CheckTenant
    raise PortRuleViolation("Business context rejected")
  GetPortCallForUpdate = GetPortCallForUpdate(Id=CId)
  assign  # SetC
    C = GetPortCallForUpdate.Record.PortCall
  if not (C.Tenant = Tenant):  # CheckCTenant
    raise PortRuleViolation("Record outside requested scope")
  if not (C.Version = CVersion):  # CheckCVersion
    raise PortRuleViolation("Record changed; reload before editing")
  GetPortInvoice = aggregate FROM PortInvoice WHERE (PortInvoice.CallId = C.Id and PortInvoice.Tenant = Tenant and PortInvoice.Subtotal + PortInvoice.Tax - PortInvoice.Credit > PortInvoice.Paid) MAX 1
  assign  # SetUnpaid
    Unpaid = not GetPortInvoice.List.Empty
  GetPortInspection = aggregate FROM PortInspection WHERE (PortInspection.CallId = C.Id and PortInspection.Tenant = Tenant and PortInspection.MajorDefects > 0 and PortInspection.State <> "Closed") MAX 1
  assign  # SetUnsafe
    Unsafe = not GetPortInspection.List.Empty
  if not (C.State = "Berthed" and C.DocsComplete):  # CheckCState
    raise PortRuleViolation("Berthed")
  if not (not Unpaid and not Unsafe):  # Checknot
    raise PortRuleViolation("Cleared")
  assign  # SetCDepartureAuthorized
    C.DepartureAuthorized = True
    C.UpdatedOn = CurrDateTime()
    C.Version = C.Version + 1
  UpdatePortCall = UpdatePortCall(Source=C)
  end

/// ssam-rule-map:{"CheckGetUserId":"Rule_Authenticated_6ab694","CheckCheckPortOperatorRole":"Rule_AuthorizedRole_d1cdc5","CheckTenant":"Rule_AuthorizedScope0_29e52c","GetPortCallForUpdate":"Rule_LoadC_fetch_e1b659","SetC":"Rule_LoadC_record_8a1990","CheckCTenant":"Rule_LoadC_scope0_da3cb1","CheckCVersion":"Rule_LoadC_version_0eeb8c","CheckCState":"Rule_Active_923406","CheckLength":"Rule_Reasoned_592d44","SetCDepartureAuthorized":"Rule_Withdraw_values_c1f875","UpdatePortCall":"Rule_Withdraw_persist_d72691","SetEvent":"Rule_Audit_reset_f0a34c","SetEventTenant":"Rule_Audit_values_c5f614","CreatePortEvent":"Rule_Audit_persist_225f32","SetEventId":"Rule_Audit_identity_dd9ab7"}
server action PortWithdrawSailing public
  in Tenant: Text
  in Reason: Text
  in CId: PortCall Identifier
  in CVersion: Long Integer
  local C: PortCall
  local Event: PortEvent
  local WorkflowEmpty2: PortEvent
  if not (GetUserId() <> NullIdentifier()):  # CheckGetUserId
    raise PortRuleViolation("Authentication required")
  if not (CheckPortOperatorRole(GetUserId())):  # CheckCheckPortOperatorRole
    raise PortRuleViolation("Role required")
  if not (Tenant <> ""):  # CheckTenant
    raise PortRuleViolation("Business context rejected")
  GetPortCallForUpdate = GetPortCallForUpdate(Id=CId)
  assign  # SetC
    C = GetPortCallForUpdate.Record.PortCall
  if not (C.Tenant = Tenant):  # CheckCTenant
    raise PortRuleViolation("Record outside requested scope")
  if not (C.Version = CVersion):  # CheckCVersion
    raise PortRuleViolation("Record changed; reload before editing")
  if not (C.State = "Berthed" and C.DepartureAuthorized):  # CheckCState
    raise PortRuleViolation("Active")
  if not (Length(Reason) >= 10):  # CheckLength
    raise PortRuleViolation("Reasoned")
  assign  # SetCDepartureAuthorized
    C.DepartureAuthorized = False
    C.UpdatedOn = CurrDateTime()
    C.Version = C.Version + 1
  UpdatePortCall = UpdatePortCall(Source=C)
  assign  # SetEvent
    Event = WorkflowEmpty2
  assign  # SetEventTenant
    Event.Tenant = Tenant
    Event.CallId = C.Id
    Event.Kind = "SailingHold"
    Event.Body = Reason
    Event.Severity = 4
    Event.CreatedBy = GetUserId()
    Event.UpdatedOn = CurrDateTime()
    Event.CreatedOn = CurrDateTime()
    Event.Version = 1
  CreatePortEvent = CreatePortEvent(Source=Event)
  assign  # SetEventId
    Event.Id = CreatePortEvent.Id
  end

/// ssam-rule-map:{"CheckGetUserId":"Rule_Authenticated_6ab694","CheckCheckPortOperatorRole":"Rule_AuthorizedRole_d1cdc5","CheckTenant":"Rule_AuthorizedScope0_29e52c","GetPortCall":"Rule_LoadC_fetch_e1b659","SetC":"Rule_LoadC_record_8a1990","CheckCTenant":"Rule_LoadC_scope0_da3cb1","CheckCState":"Rule_Finished_7804f7","SetHours":"Rule_Result_6e7d50"}
server action PortAssessTurnaround public
  in Tenant: Text
  in CId: PortCall Identifier
  out Hours: Decimal
  out Late: Boolean
  local C: PortCall
  if not (GetUserId() <> NullIdentifier()):  # CheckGetUserId
    raise PortRuleViolation("Authentication required")
  if not (CheckPortOperatorRole(GetUserId())):  # CheckCheckPortOperatorRole
    raise PortRuleViolation("Role required")
  if not (Tenant <> ""):  # CheckTenant
    raise PortRuleViolation("Business context rejected")
  GetPortCall = GetPortCall(Id=CId)
  assign  # SetC
    C = GetPortCall.Record.PortCall
  if not (C.Tenant = Tenant):  # CheckCTenant
    raise PortRuleViolation("Record outside requested scope")
  if not (C.State = "Departed" and C.ActualEnd >= C.ActualStart):  # CheckCState
    raise PortRuleViolation("Finished")
  assign  # SetHours
    Hours = DiffSeconds(C.ActualStart, C.ActualEnd) / 3600
    Late = C.ActualEnd > C.PlannedEnd
  end

/// ssam-rule-map:{"CheckGetUserId":"Rule_Authenticated_6ab694","CheckCheckPortOperatorRole":"Rule_AuthorizedRole_d1cdc5","CheckTenant":"Rule_AuthorizedScope0_29e52c","GetPortCargoForUpdate":"Rule_LoadL_fetch_f4bb0c","SetL":"Rule_LoadL_record_2b541b","CheckLTenant":"Rule_LoadL_scope0_67dc87","CheckLVersion":"Rule_LoadL_version_ef3198","GetPortVesselForUpdate":"Rule_LoadV_fetch_bf4397","SetV":"Rule_LoadV_record_dd84b9","CheckVTenant":"Rule_LoadV_scope0_b5ed85","CheckVVersion":"Rule_LoadV_version_865612","GetPortCall":"Rule_LoadC_fetch_e1b659","SetC":"Rule_LoadC_record_8a1990","CheckCTenant":"Rule_LoadC_scope0_da3cb1","CheckLCallId":"Rule_Linked_bfda02","CheckLCustomsReleased":"Rule_Released_f33dee","CheckWeight":"Rule_Capacity_ae65d0","SetWorkflowPrior4":"Rule_Cargo_prior_725cc0","SetLLoadedWeight":"Rule_Cargo_values_237420","UpdatePortCargo":"Rule_Cargo_persist_236d91","SetWorkflowPrior5":"Rule_Vessel_prior_bd8e7e","SetVUsedTonnage":"Rule_Vessel_values_1e8c0a","UpdatePortVessel":"Rule_Vessel_persist_f640a2"}
server action PortLoadCargo public
  in Tenant: Text
  in Weight: Decimal
  in LId: PortCargo Identifier
  in LVersion: Long Integer
  in VId: PortVessel Identifier
  in VVersion: Long Integer
  in CId: PortCall Identifier
  local L: PortCargo
  local V: PortVessel
  local C: PortCall
  local WorkflowPrior4: PortCargo
  local WorkflowPrior5: PortVessel
  if not (GetUserId() <> NullIdentifier()):  # CheckGetUserId
    raise PortRuleViolation("Authentication required")
  if not (CheckPortOperatorRole(GetUserId())):  # CheckCheckPortOperatorRole
    raise PortRuleViolation("Role required")
  if not (Tenant <> ""):  # CheckTenant
    raise PortRuleViolation("Business context rejected")
  GetPortCargoForUpdate = GetPortCargoForUpdate(Id=LId)
  assign  # SetL
    L = GetPortCargoForUpdate.Record.PortCargo
  if not (L.Tenant = Tenant):  # CheckLTenant
    raise PortRuleViolation("Record outside requested scope")
  if not (L.Version = LVersion):  # CheckLVersion
    raise PortRuleViolation("Record changed; reload before editing")
  GetPortVesselForUpdate = GetPortVesselForUpdate(Id=VId)
  assign  # SetV
    V = GetPortVesselForUpdate.Record.PortVessel
  if not (V.Tenant = Tenant):  # CheckVTenant
    raise PortRuleViolation("Record outside requested scope")
  if not (V.Version = VVersion):  # CheckVVersion
    raise PortRuleViolation("Record changed; reload before editing")
  GetPortCall = GetPortCall(Id=CId)
  assign  # SetC
    C = GetPortCall.Record.PortCall
  if not (C.Tenant = Tenant):  # CheckCTenant
    raise PortRuleViolation("Record outside requested scope")
  if not (L.CallId = C.Id and C.VesselId = V.Id):  # CheckLCallId
    raise PortRuleViolation("Linked")
  if not (L.CustomsReleased and C.State = "Berthed" and L.State <> "Quarantine"):  # CheckLCustomsReleased
    raise PortRuleViolation("Released")
  if not (Weight > 0 and L.LoadedWeight + Weight <= L.Weight and V.UsedTonnage + Weight <= V.MaxTonnage):  # CheckWeight
    raise PortRuleViolation("Capacity")
  assign  # SetWorkflowPrior4
    WorkflowPrior4 = L
  assign  # SetLLoadedWeight
    L.LoadedWeight = WorkflowPrior4.LoadedWeight + Weight
    L.State = If(WorkflowPrior4.LoadedWeight + Weight = WorkflowPrior4.Weight, "Loaded", "Loading")
    L.UpdatedOn = CurrDateTime()
    L.Version = L.Version + 1
  UpdatePortCargo = UpdatePortCargo(Source=L)
  assign  # SetWorkflowPrior5
    WorkflowPrior5 = V
  assign  # SetVUsedTonnage
    V.UsedTonnage = WorkflowPrior5.UsedTonnage + Weight
    V.UpdatedOn = CurrDateTime()
    V.Version = V.Version + 1
  UpdatePortVessel = UpdatePortVessel(Source=V)
  end

/// ssam-rule-map:{"CheckGetUserId":"Rule_Authenticated_6ab694","CheckCheckPortOperatorRole":"Rule_AuthorizedRole_d1cdc5","CheckTenant":"Rule_AuthorizedScope0_29e52c","GetPortCargoForUpdate":"Rule_LoadL_fetch_f4bb0c","SetL":"Rule_LoadL_record_2b541b","CheckLTenant":"Rule_LoadL_scope0_67dc87","CheckLVersion":"Rule_LoadL_version_ef3198","GetPortVesselForUpdate":"Rule_LoadV_fetch_bf4397","SetV":"Rule_LoadV_record_dd84b9","CheckVTenant":"Rule_LoadV_scope0_b5ed85","CheckVVersion":"Rule_LoadV_version_865612","GetPortCall":"Rule_LoadC_fetch_e1b659","SetC":"Rule_LoadC_record_8a1990","CheckCTenant":"Rule_LoadC_scope0_da3cb1","CheckLCallId":"Rule_Linked_bfda02","CheckCState":"Rule_Berthed_715796","CheckWeight":"Rule_Quantity_822bab","SetWorkflowPrior4":"Rule_Cargo_prior_725cc0","SetLLoadedWeight":"Rule_Cargo_values_237420","UpdatePortCargo":"Rule_Cargo_persist_236d91","SetWorkflowPrior5":"Rule_Vessel_prior_bd8e7e","SetVUsedTonnage":"Rule_Vessel_values_1e8c0a","UpdatePortVessel":"Rule_Vessel_persist_f640a2"}
server action PortUnloadCargo public
  in Tenant: Text
  in Weight: Decimal
  in LId: PortCargo Identifier
  in LVersion: Long Integer
  in VId: PortVessel Identifier
  in VVersion: Long Integer
  in CId: PortCall Identifier
  local L: PortCargo
  local V: PortVessel
  local C: PortCall
  local WorkflowPrior4: PortCargo
  local WorkflowPrior5: PortVessel
  if not (GetUserId() <> NullIdentifier()):  # CheckGetUserId
    raise PortRuleViolation("Authentication required")
  if not (CheckPortOperatorRole(GetUserId())):  # CheckCheckPortOperatorRole
    raise PortRuleViolation("Role required")
  if not (Tenant <> ""):  # CheckTenant
    raise PortRuleViolation("Business context rejected")
  GetPortCargoForUpdate = GetPortCargoForUpdate(Id=LId)
  assign  # SetL
    L = GetPortCargoForUpdate.Record.PortCargo
  if not (L.Tenant = Tenant):  # CheckLTenant
    raise PortRuleViolation("Record outside requested scope")
  if not (L.Version = LVersion):  # CheckLVersion
    raise PortRuleViolation("Record changed; reload before editing")
  GetPortVesselForUpdate = GetPortVesselForUpdate(Id=VId)
  assign  # SetV
    V = GetPortVesselForUpdate.Record.PortVessel
  if not (V.Tenant = Tenant):  # CheckVTenant
    raise PortRuleViolation("Record outside requested scope")
  if not (V.Version = VVersion):  # CheckVVersion
    raise PortRuleViolation("Record changed; reload before editing")
  GetPortCall = GetPortCall(Id=CId)
  assign  # SetC
    C = GetPortCall.Record.PortCall
  if not (C.Tenant = Tenant):  # CheckCTenant
    raise PortRuleViolation("Record outside requested scope")
  if not (L.CallId = C.Id and C.VesselId = V.Id):  # CheckLCallId
    raise PortRuleViolation("Linked")
  if not (C.State = "Berthed"):  # CheckCState
    raise PortRuleViolation("Berthed")
  if not (Weight > 0 and Weight <= L.LoadedWeight and Weight <= V.UsedTonnage):  # CheckWeight
    raise PortRuleViolation("Quantity")
  assign  # SetWorkflowPrior4
    WorkflowPrior4 = L
  assign  # SetLLoadedWeight
    L.LoadedWeight = WorkflowPrior4.LoadedWeight - Weight
    L.State = If(WorkflowPrior4.LoadedWeight = Weight, "Unloaded", "Unloading")
    L.UpdatedOn = CurrDateTime()
    L.Version = L.Version + 1
  UpdatePortCargo = UpdatePortCargo(Source=L)
  assign  # SetWorkflowPrior5
    WorkflowPrior5 = V
  assign  # SetVUsedTonnage
    V.UsedTonnage = WorkflowPrior5.UsedTonnage - Weight
    V.UpdatedOn = CurrDateTime()
    V.Version = V.Version + 1
  UpdatePortVessel = UpdatePortVessel(Source=V)
  end

/// ssam-rule-map:{"CheckGetUserId":"Rule_Authenticated_6ab694","CheckCheckPortOperatorRole":"Rule_AuthorizedRole_d1cdc5","CheckTenant":"Rule_AuthorizedScope0_29e52c","GetPortCargoForUpdate":"Rule_LoadL_fetch_f4bb0c","SetL":"Rule_LoadL_record_2b541b","CheckLTenant":"Rule_LoadL_scope0_67dc87","CheckLVersion":"Rule_LoadL_version_ef3198","CheckLength":"Rule_Reasoned_592d44","CheckLState":"Rule_NotSailed_b07b1b","SetLState":"Rule_Hold_values_4924bb","UpdatePortCargo":"Rule_Hold_persist_92c195","SetEvent":"Rule_Audit_reset_f0a34c","SetEventTenant":"Rule_Audit_values_c5f614","CreatePortEvent":"Rule_Audit_persist_225f32","SetEventId":"Rule_Audit_identity_dd9ab7"}
server action PortQuarantineCargo public
  in Tenant: Text
  in Reason: Text
  in LId: PortCargo Identifier
  in LVersion: Long Integer
  local L: PortCargo
  local Event: PortEvent
  local WorkflowEmpty2: PortEvent
  if not (GetUserId() <> NullIdentifier()):  # CheckGetUserId
    raise PortRuleViolation("Authentication required")
  if not (CheckPortOperatorRole(GetUserId())):  # CheckCheckPortOperatorRole
    raise PortRuleViolation("Role required")
  if not (Tenant <> ""):  # CheckTenant
    raise PortRuleViolation("Business context rejected")
  GetPortCargoForUpdate = GetPortCargoForUpdate(Id=LId)
  assign  # SetL
    L = GetPortCargoForUpdate.Record.PortCargo
  if not (L.Tenant = Tenant):  # CheckLTenant
    raise PortRuleViolation("Record outside requested scope")
  if not (L.Version = LVersion):  # CheckLVersion
    raise PortRuleViolation("Record changed; reload before editing")
  if not (Length(Reason) >= 10):  # CheckLength
    raise PortRuleViolation("Reasoned")
  if not (L.State <> "Sailed"):  # CheckLState
    raise PortRuleViolation("NotSailed")
  assign  # SetLState
    L.State = "Quarantine"
    L.CustomsReleased = False
    L.UpdatedOn = CurrDateTime()
    L.Version = L.Version + 1
  UpdatePortCargo = UpdatePortCargo(Source=L)
  assign  # SetEvent
    Event = WorkflowEmpty2
  assign  # SetEventTenant
    Event.Tenant = Tenant
    Event.CallId = L.CallId
    Event.Kind = "Quarantine"
    Event.Body = Reason
    Event.Severity = 5
    Event.CreatedBy = GetUserId()
    Event.UpdatedOn = CurrDateTime()
    Event.CreatedOn = CurrDateTime()
    Event.Version = 1
  CreatePortEvent = CreatePortEvent(Source=Event)
  assign  # SetEventId
    Event.Id = CreatePortEvent.Id
  end

/// ssam-rule-map:{"CheckGetUserId":"Rule_Authenticated_6ab694","CheckCheckPortOperatorRole":"Rule_AuthorizedRole_d1cdc5","CheckTenant":"Rule_AuthorizedScope0_29e52c","GetPortCargoForUpdate":"Rule_LoadL_fetch_f4bb0c","SetL":"Rule_LoadL_record_2b541b","CheckLTenant":"Rule_LoadL_scope0_67dc87","CheckLVersion":"Rule_LoadL_version_ef3198","GetPortInspection":"Rule_LoadI_fetch_0a9d14","SetI":"Rule_LoadI_record_cde031","CheckITenant":"Rule_LoadI_scope0_29169e","CheckICargoId":"Rule_Inspected_f855b0","CheckIApproverId":"Rule_Separation_d71f32","CheckLState":"Rule_Held_85cd61","SetLState":"Rule_Release_values_58b72f","UpdatePortCargo":"Rule_Release_persist_c6b549"}
server action PortReleaseQuarantine public
  in Tenant: Text
  in LId: PortCargo Identifier
  in LVersion: Long Integer
  in IId: PortInspection Identifier
  local L: PortCargo
  local I: PortInspection
  if not (GetUserId() <> NullIdentifier()):  # CheckGetUserId
    raise PortRuleViolation("Authentication required")
  if not (CheckPortOperatorRole(GetUserId())):  # CheckCheckPortOperatorRole
    raise PortRuleViolation("Role required")
  if not (Tenant <> ""):  # CheckTenant
    raise PortRuleViolation("Business context rejected")
  GetPortCargoForUpdate = GetPortCargoForUpdate(Id=LId)
  assign  # SetL
    L = GetPortCargoForUpdate.Record.PortCargo
  if not (L.Tenant = Tenant):  # CheckLTenant
    raise PortRuleViolation("Record outside requested scope")
  if not (L.Version = LVersion):  # CheckLVersion
    raise PortRuleViolation("Record changed; reload before editing")
  GetPortInspection = GetPortInspection(Id=IId)
  assign  # SetI
    I = GetPortInspection.Record.PortInspection
  if not (I.Tenant = Tenant):  # CheckITenant
    raise PortRuleViolation("Record outside requested scope")
  if not (I.CargoId = L.Id and I.State = "Closed" and I.MajorDefects = 0):  # CheckICargoId
    raise PortRuleViolation("Inspected")
  if not (I.ApproverId <> GetUserId()):  # CheckIApproverId
    raise PortRuleViolation("Separation")
  if not (L.State = "Quarantine"):  # CheckLState
    raise PortRuleViolation("Held")
  assign  # SetLState
    L.State = "InspectionCleared"
    L.UpdatedOn = CurrDateTime()
    L.Version = L.Version + 1
  UpdatePortCargo = UpdatePortCargo(Source=L)
  end

/// ssam-rule-map:{"CheckGetUserId":"Rule_Authenticated_6ab694","CheckCheckPortOperatorRole":"Rule_AuthorizedRole_d1cdc5","CheckTenant":"Rule_AuthorizedScope0_29e52c","GetPortCargoForUpdate":"Rule_LoadL_fetch_f4bb0c","SetL":"Rule_LoadL_record_2b541b","CheckLTenant":"Rule_LoadL_scope0_67dc87","CheckLVersion":"Rule_LoadL_version_ef3198","CheckLength":"Rule_ReferencePresent_67a336","CheckLState":"Rule_NotQuarantined_050dff","SetLCustomsReleased":"Rule_Release_values_58b72f","UpdatePortCargo":"Rule_Release_persist_c6b549","SetEvent":"Rule_Audit_reset_f0a34c","SetEventTenant":"Rule_Audit_values_c5f614","CreatePortEvent":"Rule_Audit_persist_225f32","SetEventId":"Rule_Audit_identity_dd9ab7"}
server action PortApproveCustoms public
  in Tenant: Text
  in Reference: Text
  in LId: PortCargo Identifier
  in LVersion: Long Integer
  local L: PortCargo
  local Event: PortEvent
  local WorkflowEmpty2: PortEvent
  if not (GetUserId() <> NullIdentifier()):  # CheckGetUserId
    raise PortRuleViolation("Authentication required")
  if not (CheckPortOperatorRole(GetUserId())):  # CheckCheckPortOperatorRole
    raise PortRuleViolation("Role required")
  if not (Tenant <> ""):  # CheckTenant
    raise PortRuleViolation("Business context rejected")
  GetPortCargoForUpdate = GetPortCargoForUpdate(Id=LId)
  assign  # SetL
    L = GetPortCargoForUpdate.Record.PortCargo
  if not (L.Tenant = Tenant):  # CheckLTenant
    raise PortRuleViolation("Record outside requested scope")
  if not (L.Version = LVersion):  # CheckLVersion
    raise PortRuleViolation("Record changed; reload before editing")
  if not (Length(Trim(Reference)) >= 8):  # CheckLength
    raise PortRuleViolation("ReferencePresent")
  if not (L.State <> "Quarantine"):  # CheckLState
    raise PortRuleViolation("NotQuarantined")
  assign  # SetLCustomsReleased
    L.CustomsReleased = True
    L.UpdatedOn = CurrDateTime()
    L.Version = L.Version + 1
  UpdatePortCargo = UpdatePortCargo(Source=L)
  assign  # SetEvent
    Event = WorkflowEmpty2
  assign  # SetEventTenant
    Event.Tenant = Tenant
    Event.CallId = L.CallId
    Event.Kind = "Customs"
    Event.Body = Reference
    Event.Severity = 1
    Event.CreatedBy = GetUserId()
    Event.UpdatedOn = CurrDateTime()
    Event.CreatedOn = CurrDateTime()
    Event.Version = 1
  CreatePortEvent = CreatePortEvent(Source=Event)
  assign  # SetEventId
    Event.Id = CreatePortEvent.Id
  end

/// ssam-rule-map:{"CheckGetUserId":"Rule_Authenticated_6ab694","CheckCheckPortOperatorRole":"Rule_AuthorizedRole_d1cdc5","CheckTenant":"Rule_AuthorizedScope0_29e52c","GetPortCargoForUpdate":"Rule_LoadL_fetch_f4bb0c","SetL":"Rule_LoadL_record_2b541b","CheckLTenant":"Rule_LoadL_scope0_67dc87","CheckLVersion":"Rule_LoadL_version_ef3198","CheckLReefer":"Rule_Reefer_d38e36","CheckMeasured":"Rule_Physical_a89383","SetWorkflowPrior2":"Rule_Temperature_prior_5ba35a","SetLTemperature":"Rule_Temperature_values_fdcfa1","UpdatePortCargo":"Rule_Temperature_persist_936223"}
server action PortRecordTemperature public
  in Tenant: Text
  in Measured: Decimal
  in LId: PortCargo Identifier
  in LVersion: Long Integer
  local L: PortCargo
  local WorkflowPrior2: PortCargo
  if not (GetUserId() <> NullIdentifier()):  # CheckGetUserId
    raise PortRuleViolation("Authentication required")
  if not (CheckPortOperatorRole(GetUserId())):  # CheckCheckPortOperatorRole
    raise PortRuleViolation("Role required")
  if not (Tenant <> ""):  # CheckTenant
    raise PortRuleViolation("Business context rejected")
  GetPortCargoForUpdate = GetPortCargoForUpdate(Id=LId)
  assign  # SetL
    L = GetPortCargoForUpdate.Record.PortCargo
  if not (L.Tenant = Tenant):  # CheckLTenant
    raise PortRuleViolation("Record outside requested scope")
  if not (L.Version = LVersion):  # CheckLVersion
    raise PortRuleViolation("Record changed; reload before editing")
  if not (L.Reefer and L.MinTemp < L.MaxTemp):  # CheckLReefer
    raise PortRuleViolation("Reefer")
  if not (Measured >= -100 and Measured <= 100):  # CheckMeasured
    raise PortRuleViolation("Physical")
  assign  # SetWorkflowPrior2
    WorkflowPrior2 = L
  assign  # SetLTemperature
    L.Temperature = Measured
    L.State = If(Measured < WorkflowPrior2.MinTemp or Measured > WorkflowPrior2.MaxTemp, "TemperatureHold", WorkflowPrior2.State)
    L.UpdatedOn = CurrDateTime()
    L.Version = L.Version + 1
  UpdatePortCargo = UpdatePortCargo(Source=L)
  end

/// ssam-rule-map:{"CheckGetUserId":"Rule_Authenticated_6ab694","CheckCheckPortOperatorRole":"Rule_AuthorizedRole_d1cdc5","CheckTenant":"Rule_AuthorizedScope0_29e52c","GetPortCargoForUpdate":"Rule_LoadL_fetch_f4bb0c","SetL":"Rule_LoadL_record_2b541b","CheckLTenant":"Rule_LoadL_scope0_67dc87","CheckLVersion":"Rule_LoadL_version_ef3198","CheckLReefer":"Rule_Valid_f51622","CheckLLoadedWeight":"Rule_BeforeLoading_87271e","SetLMinTemp":"Rule_SetBand_values_680106","UpdatePortCargo":"Rule_SetBand_persist_693715"}
server action PortSetTemperatureBand public
  in Tenant: Text
  in Minimum: Decimal
  in Maximum: Decimal
  in LId: PortCargo Identifier
  in LVersion: Long Integer
  local L: PortCargo
  if not (GetUserId() <> NullIdentifier()):  # CheckGetUserId
    raise PortRuleViolation("Authentication required")
  if not (CheckPortOperatorRole(GetUserId())):  # CheckCheckPortOperatorRole
    raise PortRuleViolation("Role required")
  if not (Tenant <> ""):  # CheckTenant
    raise PortRuleViolation("Business context rejected")
  GetPortCargoForUpdate = GetPortCargoForUpdate(Id=LId)
  assign  # SetL
    L = GetPortCargoForUpdate.Record.PortCargo
  if not (L.Tenant = Tenant):  # CheckLTenant
    raise PortRuleViolation("Record outside requested scope")
  if not (L.Version = LVersion):  # CheckLVersion
    raise PortRuleViolation("Record changed; reload before editing")
  if not (L.Reefer and Minimum >= -80 and Maximum <= 40 and Maximum > Minimum):  # CheckLReefer
    raise PortRuleViolation("Valid")
  if not (L.LoadedWeight = 0):  # CheckLLoadedWeight
    raise PortRuleViolation("BeforeLoading")
  assign  # SetLMinTemp
    L.MinTemp = Minimum
    L.MaxTemp = Maximum
    L.UpdatedOn = CurrDateTime()
    L.Version = L.Version + 1
  UpdatePortCargo = UpdatePortCargo(Source=L)
  end

