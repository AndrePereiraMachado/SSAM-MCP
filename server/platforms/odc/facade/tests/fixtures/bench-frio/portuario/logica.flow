    raise PortRuleViolation("Record outside requested scope")
  if not (L.Version = LVersion):  # CheckLVersion
    raise PortRuleViolation("Record changed; reload before editing")
  if not (Class >= 0 and Class <= 9 and Length(Evidence) >= 10):  # CheckClass
    raise PortRuleViolation("Valid")
