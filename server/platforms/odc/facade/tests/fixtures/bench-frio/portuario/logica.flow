    Event.Kind = "InspectionRejected"
    Event.Body = Reason
    Event.Severity = 3
    Event.CreatedBy = GetUserId()
    Event.UpdatedOn = CurrDateTime()
    Event.CreatedOn = CurrDateTime()
    Event.Version = 1
  CreatePortEvent = CreatePortEvent(Source=Event)
  assign  # SetEventId
    Event.Id = CreatePortEvent.Id
  end

/// ssam-rule-map:{"CheckGetUserId":"Rule_Authenticated_6ab694","CheckCheckPortOperatorRole":"Rule_AuthorizedRole_d1cdc5","CheckTenant":"Rule_AuthorizedScope0_29e52c","GetPortInspectionForUpdate":"Rule_LoadI_fetch_0a9d14","SetI":"Rule_LoadI_record_cde031","CheckITenant":"Rule_LoadI_scope0_29169e","CheckIVersion":"Rule_LoadI_version_740330","CheckIState":"Rule_Required_4850b1","CheckAt":"Rule_Future_61636c","SetIReinspectionAt":"Rule_Schedule_values_7ddec9","UpdatePortInspection":"Rule_Schedule_persist_6b40af"}
server action PortScheduleReinspection public
  in Tenant: Text
  in At: Date Time
  in IId: PortInspection Identifier
  in IVersion: Long Integer
  local I: PortInspection
  if not (GetUserId() <> NullIdentifier()):  # CheckGetUserId
    raise PortRuleViolation("Authentication required")
  if not (CheckPortOperatorRole(GetUserId())):  # CheckCheckPortOperatorRole
    raise PortRuleViolation("Role required")
  if not (Tenant <> ""):  # CheckTenant
    raise PortRuleViolation("Business context rejected")
  GetPortInspectionForUpdate = GetPortInspectionForUpdate(Id=IId)
  assign  # SetI
    I = GetPortInspectionForUpdate.Record.PortInspection
  if not (I.Tenant = Tenant):  # CheckITenant
    raise PortRuleViolation("Record outside requested scope")
  if not (I.Version = IVersion):  # CheckIVersion
    raise PortRuleViolation("Record changed; reload before editing")
  if not (I.State = "Rejected" or I.MajorDefects > 0):  # CheckIState
    raise PortRuleViolation("Required")
  if not (At > CurrDateTime() and At <= AddDays(CurrDateTime(), 30)):  # CheckAt
    raise PortRuleViolation("Future")
  assign  # SetIReinspectionAt
    I.ReinspectionAt = At
    I.State = "ReinspectionScheduled"
    I.UpdatedOn = CurrDateTime()
    I.Version = I.Version + 1
  UpdatePortInspection = UpdatePortInspection(Source=I)
  end

/// ssam-rule-map:{"CheckGetUserId":"Rule_Authenticated_6ab694","CheckCheckPortOperatorRole":"Rule_AuthorizedRole_d1cdc5","CheckTenant":"Rule_AuthorizedScope0_29e52c","GetPortInspectionForUpdate":"Rule_LoadI_fetch_0a9d14","SetI":"Rule_LoadI_record_cde031","CheckITenant":"Rule_LoadI_scope0_29169e","CheckIVersion":"Rule_LoadI_version_740330","CheckIState":"Rule_Closed_c21ead","CheckLength":"Rule_Evidence_03867a","SetIState":"Rule_Reopen_values_31520e","UpdatePortInspection":"Rule_Reopen_persist_3f76ac"}
