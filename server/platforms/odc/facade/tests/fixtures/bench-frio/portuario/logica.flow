  assign  # SetL
    L = GetPortCargo.Record.PortCargo
  if not (L.Tenant = Tenant):  # CheckLTenant
    raise PortRuleViolation("Record outside requested scope")
  if not (L.Volume > 0 and L.Weight >= L.LoadedWeight and L.Weight > 0):  # CheckLVolume
    raise PortRuleViolation("Measures")
  assign  # SetDensity
    Density = L.Weight / L.Volume
    Remaining = L.Weight - L.LoadedWeight
    Full = L.Weight = L.LoadedWeight
  end

/// ssam-rule-map:{"CheckGetUserId":"Rule_Authenticated_6ab694","CheckCheckPortOperatorRole":"Rule_AuthorizedRole_d1cdc5","CheckTenant":"Rule_AuthorizedScope0_29e52c","GetPortVesselForUpdate":"Rule_LoadV_fetch_bf4397","SetV":"Rule_LoadV_record_dd84b9","CheckVTenant":"Rule_LoadV_scope0_b5ed85","CheckVVersion":"Rule_LoadV_version_865612","GetPortBerthForUpdate":"Rule_LoadB_fetch_2fd733","SetB":"Rule_LoadB_record_057f8a","CheckBTenant":"Rule_LoadB_scope0_487087","CheckBVersion":"Rule_LoadB_version_da9e59","GetPortCall":"Rule_LoadC_fetch_e1b659","SetC":"Rule_LoadC_record_8a1990","CheckCTenant":"Rule_LoadC_scope0_da3cb1","CheckCVesselId":"Rule_Linked_bfda02","CheckSlots":"Rule_Capacity_ae65d0","SetWorkflowPrior4":"Rule_Vessel_prior_bd8e7e","SetVReeferUsed":"Rule_Vessel_values_1e8c0a","UpdatePortVessel":"Rule_Vessel_persist_f640a2","SetWorkflowPrior5":"Rule_Berth_prior_a7dd1d","SetBPowerUsed":"Rule_Berth_values_ce14cd","UpdatePortBerth":"Rule_Berth_persist_41d8f7"}
server action PortReserveReeferPower public
  in Tenant: Text
  in Slots: Integer
  in VId: PortVessel Identifier
  in VVersion: Long Integer
  in BId: PortBerth Identifier
  in BVersion: Long Integer
  in CId: PortCall Identifier
  local V: PortVessel
  local B: PortBerth
  local C: PortCall
  local WorkflowPrior4: PortVessel
  local WorkflowPrior5: PortBerth
  if not (GetUserId() <> NullIdentifier()):  # CheckGetUserId
    raise PortRuleViolation("Authentication required")
  if not (CheckPortOperatorRole(GetUserId())):  # CheckCheckPortOperatorRole
    raise PortRuleViolation("Role required")
  if not (Tenant <> ""):  # CheckTenant
    raise PortRuleViolation("Business context rejected")
  GetPortVesselForUpdate = GetPortVesselForUpdate(Id=VId)
  assign  # SetV
    V = GetPortVesselForUpdate.Record.PortVessel
  if not (V.Tenant = Tenant):  # CheckVTenant
    raise PortRuleViolation("Record outside requested scope")
  if not (V.Version = VVersion):  # CheckVVersion
    raise PortRuleViolation("Record changed; reload before editing")
  GetPortBerthForUpdate = GetPortBerthForUpdate(Id=BId)
  assign  # SetB
    B = GetPortBerthForUpdate.Record.PortBerth
  if not (B.Tenant = Tenant):  # CheckBTenant
    raise PortRuleViolation("Record outside requested scope")
  if not (B.Version = BVersion):  # CheckBVersion
    raise PortRuleViolation("Record changed; reload before editing")
  GetPortCall = GetPortCall(Id=CId)
  assign  # SetC
    C = GetPortCall.Record.PortCall
  if not (C.Tenant = Tenant):  # CheckCTenant
    raise PortRuleViolation("Record outside requested scope")
  if not (C.VesselId = V.Id and C.BerthId = B.Id):  # CheckCVesselId
    raise PortRuleViolation("Linked")
  if not (Slots > 0 and V.ReeferUsed + Slots <= V.ReeferSlots and B.PowerUsed + Slots <= B.PowerSlots):  # CheckSlots
    raise PortRuleViolation("Capacity")
  assign  # SetWorkflowPrior4
    WorkflowPrior4 = V
  assign  # SetVReeferUsed
    V.ReeferUsed = WorkflowPrior4.ReeferUsed + Slots
    V.UpdatedOn = CurrDateTime()
    V.Version = V.Version + 1
  UpdatePortVessel = UpdatePortVessel(Source=V)
  assign  # SetWorkflowPrior5
    WorkflowPrior5 = B
  assign  # SetBPowerUsed
    B.PowerUsed = WorkflowPrior5.PowerUsed + Slots
    B.UpdatedOn = CurrDateTime()
    B.Version = B.Version + 1
  UpdatePortBerth = UpdatePortBerth(Source=B)
  end

/// ssam-rule-map:{"CheckGetUserId":"Rule_Authenticated_6ab694","CheckCheckPortOperatorRole":"Rule_AuthorizedRole_d1cdc5","CheckTenant":"Rule_AuthorizedScope0_29e52c","GetPortVesselForUpdate":"Rule_LoadV_fetch_bf4397","SetV":"Rule_LoadV_record_dd84b9","CheckVTenant":"Rule_LoadV_scope0_b5ed85","CheckVVersion":"Rule_LoadV_version_865612","GetPortBerthForUpdate":"Rule_LoadB_fetch_2fd733","SetB":"Rule_LoadB_record_057f8a","CheckBTenant":"Rule_LoadB_scope0_487087","CheckBVersion":"Rule_LoadB_version_da9e59","GetPortCall":"Rule_LoadC_fetch_e1b659","SetC":"Rule_LoadC_record_8a1990","CheckCTenant":"Rule_LoadC_scope0_da3cb1","CheckCVesselId":"Rule_Linked_bfda02","CheckSlots":"Rule_Quantity_822bab","SetWorkflowPrior4":"Rule_Vessel_prior_bd8e7e","SetVReeferUsed":"Rule_Vessel_values_1e8c0a","UpdatePortVessel":"Rule_Vessel_persist_f640a2","SetWorkflowPrior5":"Rule_Berth_prior_a7dd1d","SetBPowerUsed":"Rule_Berth_values_ce14cd","UpdatePortBerth":"Rule_Berth_persist_41d8f7"}
server action PortReleaseReeferPower public
  in Tenant: Text
  in Slots: Integer
  in VId: PortVessel Identifier
  in VVersion: Long Integer
  in BId: PortBerth Identifier
  in BVersion: Long Integer
  in CId: PortCall Identifier
  local V: PortVessel
  local B: PortBerth
  local C: PortCall
  local WorkflowPrior4: PortVessel
  local WorkflowPrior5: PortBerth
  if not (GetUserId() <> NullIdentifier()):  # CheckGetUserId
    raise PortRuleViolation("Authentication required")
  if not (CheckPortOperatorRole(GetUserId())):  # CheckCheckPortOperatorRole
    raise PortRuleViolation("Role required")
  if not (Tenant <> ""):  # CheckTenant
    raise PortRuleViolation("Business context rejected")
  GetPortVesselForUpdate = GetPortVesselForUpdate(Id=VId)
  assign  # SetV
    V = GetPortVesselForUpdate.Record.PortVessel
  if not (V.Tenant = Tenant):  # CheckVTenant
    raise PortRuleViolation("Record outside requested scope")
  if not (V.Version = VVersion):  # CheckVVersion
    raise PortRuleViolation("Record changed; reload before editing")
  GetPortBerthForUpdate = GetPortBerthForUpdate(Id=BId)
  assign  # SetB
    B = GetPortBerthForUpdate.Record.PortBerth
  if not (B.Tenant = Tenant):  # CheckBTenant
    raise PortRuleViolation("Record outside requested scope")
  if not (B.Version = BVersion):  # CheckBVersion
    raise PortRuleViolation("Record changed; reload before editing")
  GetPortCall = GetPortCall(Id=CId)
  assign  # SetC
    C = GetPortCall.Record.PortCall
  if not (C.Tenant = Tenant):  # CheckCTenant
    raise PortRuleViolation("Record outside requested scope")
  if not (C.VesselId = V.Id and C.BerthId = B.Id):  # CheckCVesselId
    raise PortRuleViolation("Linked")
  if not (Slots > 0 and Slots <= V.ReeferUsed and Slots <= B.PowerUsed):  # CheckSlots
    raise PortRuleViolation("Quantity")
  assign  # SetWorkflowPrior4
    WorkflowPrior4 = V
  assign  # SetVReeferUsed
    V.ReeferUsed = WorkflowPrior4.ReeferUsed - Slots
    V.UpdatedOn = CurrDateTime()
    V.Version = V.Version + 1
  UpdatePortVessel = UpdatePortVessel(Source=V)
  assign  # SetWorkflowPrior5
    WorkflowPrior5 = B
  assign  # SetBPowerUsed
    B.PowerUsed = WorkflowPrior5.PowerUsed - Slots
    B.UpdatedOn = CurrDateTime()
    B.Version = B.Version + 1
  UpdatePortBerth = UpdatePortBerth(Source=B)
  end

/// ssam-rule-map:{"CheckGetUserId":"Rule_Authenticated_6ab694","CheckCheckPortOperatorRole":"Rule_AuthorizedRole_d1cdc5","CheckTenant":"Rule_AuthorizedScope0_29e52c","GetPortVesselForUpdate":"Rule_LoadV_fetch_bf4397","SetV":"Rule_LoadV_record_dd84b9","CheckVTenant":"Rule_LoadV_scope0_b5ed85","CheckVVersion":"Rule_LoadV_version_865612","CheckLitres":"Rule_Capacity_ae65d0","CheckVState":"Rule_NotUnderway_bfefda","SetWorkflowPrior2":"Rule_Fuel_prior_8c161b","SetVFuelRemaining":"Rule_Fuel_values_38240f","UpdatePortVessel":"Rule_Fuel_persist_956d41"}
server action PortRecordFuelDelivery public
  in Tenant: Text
  in Litres: Decimal
  in VId: PortVessel Identifier
  in VVersion: Long Integer
  local V: PortVessel
  local WorkflowPrior2: PortVessel
  if not (GetUserId() <> NullIdentifier()):  # CheckGetUserId
    raise PortRuleViolation("Authentication required")
  if not (CheckPortOperatorRole(GetUserId())):  # CheckCheckPortOperatorRole
    raise PortRuleViolation("Role required")
  if not (Tenant <> ""):  # CheckTenant
    raise PortRuleViolation("Business context rejected")
  GetPortVesselForUpdate = GetPortVesselForUpdate(Id=VId)
  assign  # SetV
    V = GetPortVesselForUpdate.Record.PortVessel
  if not (V.Tenant = Tenant):  # CheckVTenant
    raise PortRuleViolation("Record outside requested scope")
  if not (V.Version = VVersion):  # CheckVVersion
    raise PortRuleViolation("Record changed; reload before editing")
  if not (Litres > 0 and V.FuelRemaining + Litres <= V.FuelCap):  # CheckLitres
    raise PortRuleViolation("Capacity")
  if not (V.State <> "Underway"):  # CheckVState
    raise PortRuleViolation("NotUnderway")
  assign  # SetWorkflowPrior2
    WorkflowPrior2 = V
  assign  # SetVFuelRemaining
    V.FuelRemaining = WorkflowPrior2.FuelRemaining + Litres
    V.UpdatedOn = CurrDateTime()
    V.Version = V.Version + 1
  UpdatePortVessel = UpdatePortVessel(Source=V)
  end

/// ssam-rule-map:{"CheckGetUserId":"Rule_Authenticated_6ab694","CheckCheckPortOperatorRole":"Rule_AuthorizedRole_d1cdc5","CheckTenant":"Rule_AuthorizedScope0_29e52c","GetPortVesselForUpdate":"Rule_LoadV_fetch_bf4397","SetV":"Rule_LoadV_record_dd84b9","CheckVTenant":"Rule_LoadV_scope0_b5ed85","CheckVVersion":"Rule_LoadV_version_865612","GetPortEmissionForUpdate":"Rule_LoadE_fetch_7a95d3","SetE":"Rule_LoadE_record_fec5e0","CheckETenant":"Rule_LoadE_scope0_71d44b","CheckEVersion":"Rule_LoadE_version_789572","GetPortCall":"Rule_LoadC_fetch_e1b659","SetC":"Rule_LoadC_record_8a1990","CheckCTenant":"Rule_LoadC_scope0_da3cb1","CheckCVesselId":"Rule_Linked_bfda02","CheckLitres":"Rule_Quantity_822bab","SetWorkflowPrior4":"Rule_Vessel_prior_bd8e7e","SetVFuelRemaining":"Rule_Vessel_values_1e8c0a","UpdatePortVessel":"Rule_Vessel_persist_f640a2","SetWorkflowPrior5":"Rule_Emission_prior_35c3d3","SetEFuelLitres":"Rule_Emission_values_c25da6","UpdatePortEmission":"Rule_Emission_persist_6a552d"}
server action PortRecordFuelConsumption public
  in Tenant: Text
  in Litres: Decimal
  in VId: PortVessel Identifier
  in VVersion: Long Integer
  in EId: PortEmission Identifier
  in EVersion: Long Integer
  in CId: PortCall Identifier
  local V: PortVessel
  local E: PortEmission
  local C: PortCall
  local WorkflowPrior4: PortVessel
  local WorkflowPrior5: PortEmission
  if not (GetUserId() <> NullIdentifier()):  # CheckGetUserId
    raise PortRuleViolation("Authentication required")
  if not (CheckPortOperatorRole(GetUserId())):  # CheckCheckPortOperatorRole
    raise PortRuleViolation("Role required")
  if not (Tenant <> ""):  # CheckTenant
    raise PortRuleViolation("Business context rejected")
  GetPortVesselForUpdate = GetPortVesselForUpdate(Id=VId)
  assign  # SetV
    V = GetPortVesselForUpdate.Record.PortVessel
  if not (V.Tenant = Tenant):  # CheckVTenant
    raise PortRuleViolation("Record outside requested scope")
  if not (V.Version = VVersion):  # CheckVVersion
    raise PortRuleViolation("Record changed; reload before editing")
  GetPortEmissionForUpdate = GetPortEmissionForUpdate(Id=EId)
  assign  # SetE
    E = GetPortEmissionForUpdate.Record.PortEmission
  if not (E.Tenant = Tenant):  # CheckETenant
    raise PortRuleViolation("Record outside requested scope")
  if not (E.Version = EVersion):  # CheckEVersion
    raise PortRuleViolation("Record changed; reload before editing")
  GetPortCall = GetPortCall(Id=CId)
  assign  # SetC
    C = GetPortCall.Record.PortCall
  if not (C.Tenant = Tenant):  # CheckCTenant
    raise PortRuleViolation("Record outside requested scope")
  if not (C.VesselId = V.Id and E.CallId = C.Id):  # CheckCVesselId
    raise PortRuleViolation("Linked")
  if not (Litres > 0 and Litres <= V.FuelRemaining and E.Factor > 0):  # CheckLitres
    raise PortRuleViolation("Quantity")
  assign  # SetWorkflowPrior4
    WorkflowPrior4 = V
  assign  # SetVFuelRemaining
    V.FuelRemaining = WorkflowPrior4.FuelRemaining - Litres
    V.UpdatedOn = CurrDateTime()
    V.Version = V.Version + 1
  UpdatePortVessel = UpdatePortVessel(Source=V)
  assign  # SetWorkflowPrior5
    WorkflowPrior5 = E
  assign  # SetEFuelLitres
    E.FuelLitres = WorkflowPrior5.FuelLitres + Litres
    E.Co2 = WorkflowPrior5.Co2 + Litres * WorkflowPrior5.Factor
    E.Verified = False
    E.UpdatedOn = CurrDateTime()
    E.Version = E.Version + 1
  UpdatePortEmission = UpdatePortEmission(Source=E)
  end

/// ssam-rule-map:{"CheckGetUserId":"Rule_Authenticated_6ab694","CheckCheckPortOperatorRole":"Rule_AuthorizedRole_d1cdc5","CheckTenant":"Rule_AuthorizedScope0_29e52c","GetPortVesselForUpdate":"Rule_LoadV_fetch_bf4397","SetV":"Rule_LoadV_record_dd84b9","CheckVTenant":"Rule_LoadV_scope0_b5ed85","CheckVVersion":"Rule_LoadV_version_865612","GetPortCall":"Rule_QueryActive_query_df1985","SetActive":"Rule_QueryActive_list_8f9309","CheckDraft":"Rule_Dimensions_914182","Checknot":"Rule_NoActive_e867bf","SetVDraft":"Rule_Update_values_240056","UpdatePortVessel":"Rule_Update_persist_8a1e95"}
server action PortUpdateVesselDimensions public
  in Tenant: Text
  in Draft: Decimal
  in Length: Decimal
  in Beam: Decimal
  in VId: PortVessel Identifier
  in VVersion: Long Integer
  local V: PortVessel
  local Active: Boolean
  if not (GetUserId() <> NullIdentifier()):  # CheckGetUserId
    raise PortRuleViolation("Authentication required")
  if not (CheckPortOperatorRole(GetUserId())):  # CheckCheckPortOperatorRole
    raise PortRuleViolation("Role required")
  if not (Tenant <> ""):  # CheckTenant
    raise PortRuleViolation("Business context rejected")
  GetPortVesselForUpdate = GetPortVesselForUpdate(Id=VId)
  assign  # SetV
    V = GetPortVesselForUpdate.Record.PortVessel
  if not (V.Tenant = Tenant):  # CheckVTenant
    raise PortRuleViolation("Record outside requested scope")
  if not (V.Version = VVersion):  # CheckVVersion
    raise PortRuleViolation("Record changed; reload before editing")
  GetPortCall = aggregate FROM PortCall WHERE (PortCall.VesselId = V.Id and PortCall.Tenant = Tenant and PortCall.State = "Berthed") MAX 1
  assign  # SetActive
    Active = not GetPortCall.List.Empty
  if not (Draft > 0 and Length > Beam and Beam > 0):  # CheckDraft
    raise PortRuleViolation("Dimensions")
  if not (not Active):  # Checknot
    raise PortRuleViolation("NoActive")
  assign  # SetVDraft
    V.Draft = Draft
    V.Length = Length
    V.Beam = Beam
    V.UpdatedOn = CurrDateTime()
    V.Version = V.Version + 1
  UpdatePortVessel = UpdatePortVessel(Source=V)
  end

/// ssam-rule-map:{"CheckGetUserId":"Rule_Authenticated_6ab694","CheckCheckPortOperatorRole":"Rule_AuthorizedRole_d1cdc5","CheckTenant":"Rule_AuthorizedScope0_29e52c","GetPortVesselForUpdate":"Rule_LoadV_fetch_bf4397","SetV":"Rule_LoadV_record_dd84b9","CheckVTenant":"Rule_LoadV_scope0_b5ed85","CheckVVersion":"Rule_LoadV_version_865612","CheckLimit":"Rule_Safe_4f9f0d","CheckLength":"Rule_Reasoned_592d44","SetVMaxTonnage":"Rule_Limit_values_7948e7","UpdatePortVessel":"Rule_Limit_persist_6c4183"}
server action PortReduceTonnageLimit public
  in Tenant: Text
  in Limit: Decimal
  in Reason: Text
  in VId: PortVessel Identifier
  in VVersion: Long Integer
  local V: PortVessel
  if not (GetUserId() <> NullIdentifier()):  # CheckGetUserId
    raise PortRuleViolation("Authentication required")
  if not (CheckPortOperatorRole(GetUserId())):  # CheckCheckPortOperatorRole
    raise PortRuleViolation("Role required")
  if not (Tenant <> ""):  # CheckTenant
    raise PortRuleViolation("Business context rejected")
  GetPortVesselForUpdate = GetPortVesselForUpdate(Id=VId)
  assign  # SetV
    V = GetPortVesselForUpdate.Record.PortVessel
  if not (V.Tenant = Tenant):  # CheckVTenant
    raise PortRuleViolation("Record outside requested scope")
  if not (V.Version = VVersion):  # CheckVVersion
    raise PortRuleViolation("Record changed; reload before editing")
  if not (Limit >= V.UsedTonnage and Limit > 0 and Limit < V.MaxTonnage):  # CheckLimit
    raise PortRuleViolation("Safe")
  if not (Length(Reason) >= 10):  # CheckLength
    raise PortRuleViolation("Reasoned")
  assign  # SetVMaxTonnage
    V.MaxTonnage = Limit
    V.UpdatedOn = CurrDateTime()
    V.Version = V.Version + 1
  UpdatePortVessel = UpdatePortVessel(Source=V)
  end

/// ssam-rule-map:{"CheckGetUserId":"Rule_Authenticated_6ab694","CheckCheckPortOperatorRole":"Rule_AuthorizedRole_d1cdc5","CheckTenant":"Rule_AuthorizedScope0_29e52c","GetPortVesselForUpdate":"Rule_LoadV_fetch_bf4397","SetV":"Rule_LoadV_record_dd84b9","CheckVTenant":"Rule_LoadV_scope0_b5ed85","CheckVVersion":"Rule_LoadV_version_865612","CheckLength":"Rule_Reasoned_592d44","CheckVState":"Rule_NotSailing_d2af9c","SetVState":"Rule_Suspend_values_8a0044","UpdatePortVessel":"Rule_Suspend_persist_13d560"}
server action PortSuspendVessel public
  in Tenant: Text
  in Reason: Text
  in VId: PortVessel Identifier
  in VVersion: Long Integer
  local V: PortVessel
  if not (GetUserId() <> NullIdentifier()):  # CheckGetUserId
    raise PortRuleViolation("Authentication required")
  if not (CheckPortOperatorRole(GetUserId())):  # CheckCheckPortOperatorRole
    raise PortRuleViolation("Role required")
  if not (Tenant <> ""):  # CheckTenant
    raise PortRuleViolation("Business context rejected")
  GetPortVesselForUpdate = GetPortVesselForUpdate(Id=VId)
  assign  # SetV
    V = GetPortVesselForUpdate.Record.PortVessel
  if not (V.Tenant = Tenant):  # CheckVTenant
    raise PortRuleViolation("Record outside requested scope")
  if not (V.Version = VVersion):  # CheckVVersion
    raise PortRuleViolation("Record changed; reload before editing")
  if not (Length(Reason) >= 10):  # CheckLength
    raise PortRuleViolation("Reasoned")
  if not (V.State <> "Underway"):  # CheckVState
    raise PortRuleViolation("NotSailing")
  assign  # SetVState
    V.State = "Suspended"
    V.UpdatedOn = CurrDateTime()
    V.Version = V.Version + 1
  UpdatePortVessel = UpdatePortVessel(Source=V)
  end

/// ssam-rule-map:{"CheckGetUserId":"Rule_Authenticated_6ab694","CheckCheckPortOperatorRole":"Rule_AuthorizedRole_d1cdc5","CheckTenant":"Rule_AuthorizedScope0_29e52c","GetPortVesselForUpdate":"Rule_LoadV_fetch_bf4397","SetV":"Rule_LoadV_record_dd84b9","CheckVTenant":"Rule_LoadV_scope0_b5ed85","CheckVVersion":"Rule_LoadV_version_865612","GetPortCall":"Rule_LoadC_fetch_e1b659","SetC":"Rule_LoadC_record_8a1990","CheckCTenant":"Rule_LoadC_scope0_da3cb1","GetPortInspection":"Rule_QueryDefects_query_b9319a","SetDefects":"Rule_QueryDefects_list_0a90d1","CheckCVesselId":"Rule_Linked_bfda02","CheckVState":"Rule_Suspended_e392a3","CheckDefects":"Rule_NoOpenDefects_43405f","SetVState":"Rule_Restore_values_650bcb","UpdatePortVessel":"Rule_Restore_persist_17c85e"}
server action PortRestoreVessel public
  in Tenant: Text
  in VId: PortVessel Identifier
  in VVersion: Long Integer
  in CId: PortCall Identifier
  local V: PortVessel
  local C: PortCall
  local Defects: Long Integer
  if not (GetUserId() <> NullIdentifier()):  # CheckGetUserId
    raise PortRuleViolation("Authentication required")
  if not (CheckPortOperatorRole(GetUserId())):  # CheckCheckPortOperatorRole
    raise PortRuleViolation("Role required")
  if not (Tenant <> ""):  # CheckTenant
    raise PortRuleViolation("Business context rejected")
  GetPortVesselForUpdate = GetPortVesselForUpdate(Id=VId)
  assign  # SetV
    V = GetPortVesselForUpdate.Record.PortVessel
  if not (V.Tenant = Tenant):  # CheckVTenant
    raise PortRuleViolation("Record outside requested scope")
  if not (V.Version = VVersion):  # CheckVVersion
    raise PortRuleViolation("Record changed; reload before editing")
  GetPortCall = GetPortCall(Id=CId)
  assign  # SetC
    C = GetPortCall.Record.PortCall
  if not (C.Tenant = Tenant):  # CheckCTenant
    raise PortRuleViolation("Record outside requested scope")
  GetPortInspection = aggregate FROM PortInspection WHERE (PortInspection.Tenant = Tenant and PortInspection.CallId = C.Id and PortInspection.State <> "Closed" and PortInspection.MajorDefects > 0) MAX 1
  assign  # SetDefects
    Defects = GetPortInspection.Count
  if not (C.VesselId = V.Id):  # CheckCVesselId
    raise PortRuleViolation("Linked")
  if not (V.State = "Suspended"):  # CheckVState
    raise PortRuleViolation("Suspended")
  if not (Defects = 0):  # CheckDefects
    raise PortRuleViolation("NoOpenDefects")
  assign  # SetVState
    V.State = "Available"
    V.UpdatedOn = CurrDateTime()
    V.Version = V.Version + 1
  UpdatePortVessel = UpdatePortVessel(Source=V)
  end

/// ssam-rule-map:{"CheckGetUserId":"Rule_Authenticated_6ab694","CheckCheckPortOperatorRole":"Rule_AuthorizedRole_d1cdc5","CheckTenant":"Rule_AuthorizedScope0_29e52c","GetPortVessel":"Rule_LoadV_fetch_bf4397","SetV":"Rule_LoadV_record_dd84b9","CheckVTenant":"Rule_LoadV_scope0_b5ed85","GetPortBerth":"Rule_LoadB_fetch_2fd733","SetB":"Rule_LoadB_record_057f8a","CheckBTenant":"Rule_LoadB_scope0_487087","CheckSquat":"Rule_Physical_a89383","SetClearance":"Rule_Result_6e7d50"}
server action PortCheckUnderKeel public
  in Tenant: Text
  in Tide: Decimal
  in Squat: Decimal
  in Minimum: Decimal
  in VId: PortVessel Identifier
  in BId: PortBerth Identifier
  out Clearance: Decimal
  out Safe: Boolean
  local V: PortVessel
  local B: PortBerth
  if not (GetUserId() <> NullIdentifier()):  # CheckGetUserId
    raise PortRuleViolation("Authentication required")
  if not (CheckPortOperatorRole(GetUserId())):  # CheckCheckPortOperatorRole
    raise PortRuleViolation("Role required")
  if not (Tenant <> ""):  # CheckTenant
    raise PortRuleViolation("Business context rejected")
  GetPortVessel = GetPortVessel(Id=VId)
  assign  # SetV
    V = GetPortVessel.Record.PortVessel
  if not (V.Tenant = Tenant):  # CheckVTenant
    raise PortRuleViolation("Record outside requested scope")
  GetPortBerth = GetPortBerth(Id=BId)
  assign  # SetB
    B = GetPortBerth.Record.PortBerth
  if not (B.Tenant = Tenant):  # CheckBTenant
    raise PortRuleViolation("Record outside requested scope")
  if not (Squat >= 0 and Minimum >= 0 and B.Depth > 0):  # CheckSquat
    raise PortRuleViolation("Physical")
  assign  # SetClearance
    Clearance = B.Depth + Tide - V.Draft - Squat
    Safe = B.Depth + Tide - V.Draft - Squat >= Minimum and V.Beam <= B.MaxBeam
  end

/// ssam-rule-map:{"CheckGetUserId":"Rule_Authenticated_6ab694","CheckCheckPortOperatorRole":"Rule_AuthorizedRole_d1cdc5","CheckTenant":"Rule_AuthorizedScope0_29e52c","GetPortVessel":"Rule_LoadV_fetch_bf4397","SetV":"Rule_LoadV_record_dd84b9","CheckVTenant":"Rule_LoadV_scope0_b5ed85","CheckBurnPerHour":"Rule_Parameters_e68b36","SetRequired":"Rule_Result_6e7d50"}
server action PortAssessFuelRange public
  in Tenant: Text
  in BurnPerHour: Decimal
  in TravelHours: Decimal
  in ReservePercent: Decimal
  in VId: PortVessel Identifier
  out Required: Decimal
  out Sufficient: Boolean
  local V: PortVessel
  if not (GetUserId() <> NullIdentifier()):  # CheckGetUserId
    raise PortRuleViolation("Authentication required")
  if not (CheckPortOperatorRole(GetUserId())):  # CheckCheckPortOperatorRole
    raise PortRuleViolation("Role required")
  if not (Tenant <> ""):  # CheckTenant
    raise PortRuleViolation("Business context rejected")
  GetPortVessel = GetPortVessel(Id=VId)
  assign  # SetV
    V = GetPortVessel.Record.PortVessel
  if not (V.Tenant = Tenant):  # CheckVTenant
    raise PortRuleViolation("Record outside requested scope")
  if not (BurnPerHour > 0 and TravelHours > 0 and ReservePercent >= 0 and ReservePercent <= 100):  # CheckBurnPerHour
    raise PortRuleViolation("Parameters")
  assign  # SetRequired
    Required = BurnPerHour * TravelHours * (1 + ReservePercent / 100)
    Sufficient = V.FuelRemaining >= BurnPerHour * TravelHours * (1 + ReservePercent / 100)
  end

/// ssam-rule-map:{"CheckGetUserId":"Rule_Authenticated_6ab694","CheckCheckPortOperatorRole":"Rule_AuthorizedRole_d1cdc5","CheckTenant":"Rule_AuthorizedScope0_29e52c","GetPortBerthForUpdate":"Rule_LoadB_fetch_2fd733","SetB":"Rule_LoadB_record_057f8a","CheckBTenant":"Rule_LoadB_scope0_487087","CheckBVersion":"Rule_LoadB_version_da9e59","CheckWind":"Rule_Valid_f51622","SetBCurrentWind":"Rule_Weather_values_fa54af","UpdatePortBerth":"Rule_Weather_persist_35124c","CheckWind2":"Rule_Alert_44a57b","SetEvent":"Rule_Alert_Report_reset_951ba6","SetEventTenant":"Rule_Alert_Report_values_3fa83c","CreatePortEvent":"Rule_Alert_Report_persist_29cf95","SetEventId":"Rule_Alert_Report_identity_ccb903"}
server action PortCloseBerthForWind public
  in Tenant: Text
  in Wind: Decimal
  in BId: PortBerth Identifier
  in BVersion: Long Integer
  local B: PortBerth
  local Event: PortEvent
  local WorkflowEmpty2: PortEvent
  if not (GetUserId() <> NullIdentifier()):  # CheckGetUserId
    raise PortRuleViolation("Authentication required")
  if not (CheckPortOperatorRole(GetUserId())):  # CheckCheckPortOperatorRole
    raise PortRuleViolation("Role required")
  if not (Tenant <> ""):  # CheckTenant
    raise PortRuleViolation("Business context rejected")
  GetPortBerthForUpdate = GetPortBerthForUpdate(Id=BId)
  assign  # SetB
    B = GetPortBerthForUpdate.Record.PortBerth
  if not (B.Tenant = Tenant):  # CheckBTenant
    raise PortRuleViolation("Record outside requested scope")
  if not (B.Version = BVersion):  # CheckBVersion
    raise PortRuleViolation("Record changed; reload before editing")
  if not (Wind >= 0 and B.ClosedWind > 0):  # CheckWind
    raise PortRuleViolation("Valid")
  assign  # SetBCurrentWind
    B.CurrentWind = Wind
    B.UpdatedOn = CurrDateTime()
    B.Version = B.Version + 1
  UpdatePortBerth = UpdatePortBerth(Source=B)
  if Wind > B.ClosedWind:  # CheckWind2
    assign  # SetEvent
      Event = WorkflowEmpty2
    assign  # SetEventTenant
      Event.Tenant = Tenant
      Event.Kind = "WindClosure"
      Event.Body = B.Code
      Event.Severity = 4
      Event.CreatedBy = GetUserId()
      Event.UpdatedOn = CurrDateTime()
      Event.CreatedOn = CurrDateTime()
      Event.Version = 1
    CreatePortEvent = CreatePortEvent(Source=Event)
    assign  # SetEventId
      Event.Id = CreatePortEvent.Id
    end
  end

/// ssam-rule-map:{"CheckGetUserId":"Rule_Authenticated_6ab694","CheckCheckPortOperatorRole":"Rule_AuthorizedRole_d1cdc5","CheckTenant":"Rule_AuthorizedScope0_29e52c","GetPortBerthForUpdate":"Rule_LoadB_fetch_2fd733","SetB":"Rule_LoadB_record_057f8a","CheckBTenant":"Rule_LoadB_scope0_487087","CheckBVersion":"Rule_LoadB_version_da9e59","Checknot":"Rule_Free_f411a1","CheckMetres":"Rule_Fit_9f872e","SetWorkflowPrior2":"Rule_Reserve_prior_583b99","SetBReservedLength":"Rule_Reserve_values_4d6eb1","UpdatePortBerth":"Rule_Reserve_persist_2f14e1"}
server action PortReserveBerthLength public
  in Tenant: Text
  in Metres: Decimal
  in BId: PortBerth Identifier
  in BVersion: Long Integer
  local B: PortBerth
  local WorkflowPrior2: PortBerth
  if not (GetUserId() <> NullIdentifier()):  # CheckGetUserId
    raise PortRuleViolation("Authentication required")
  if not (CheckPortOperatorRole(GetUserId())):  # CheckCheckPortOperatorRole
    raise PortRuleViolation("Role required")
  if not (Tenant <> ""):  # CheckTenant
    raise PortRuleViolation("Business context rejected")
  GetPortBerthForUpdate = GetPortBerthForUpdate(Id=BId)
  assign  # SetB
    B = GetPortBerthForUpdate.Record.PortBerth
  if not (B.Tenant = Tenant):  # CheckBTenant
    raise PortRuleViolation("Record outside requested scope")
  if not (B.Version = BVersion):  # CheckBVersion
    raise PortRuleViolation("Record changed; reload before editing")
  if not (not B.Occupied and B.CurrentWind <= B.ClosedWind):  # Checknot
    raise PortRuleViolation("Free")
  if not (Metres > 0 and B.ReservedLength + Metres <= B.Length):  # CheckMetres
    raise PortRuleViolation("Fit")
  assign  # SetWorkflowPrior2
    WorkflowPrior2 = B
  assign  # SetBReservedLength
    B.ReservedLength = WorkflowPrior2.ReservedLength + Metres
    B.UpdatedOn = CurrDateTime()
    B.Version = B.Version + 1
  UpdatePortBerth = UpdatePortBerth(Source=B)
  end

/// ssam-rule-map:{"CheckGetUserId":"Rule_Authenticated_6ab694","CheckCheckPortOperatorRole":"Rule_AuthorizedRole_d1cdc5","CheckTenant":"Rule_AuthorizedScope0_29e52c","GetPortBerthForUpdate":"Rule_LoadB_fetch_2fd733","SetB":"Rule_LoadB_record_057f8a","CheckBTenant":"Rule_LoadB_scope0_487087","CheckBVersion":"Rule_LoadB_version_da9e59","CheckMetres":"Rule_Quantity_822bab","SetWorkflowPrior2":"Rule_Release_prior_751753","SetBReservedLength":"Rule_Release_values_58b72f","UpdatePortBerth":"Rule_Release_persist_c6b549"}
server action PortReleaseBerthLength public
  in Tenant: Text
  in Metres: Decimal
  in BId: PortBerth Identifier
  in BVersion: Long Integer
  local B: PortBerth
  local WorkflowPrior2: PortBerth
  if not (GetUserId() <> NullIdentifier()):  # CheckGetUserId
    raise PortRuleViolation("Authentication required")
  if not (CheckPortOperatorRole(GetUserId())):  # CheckCheckPortOperatorRole
    raise PortRuleViolation("Role required")
  if not (Tenant <> ""):  # CheckTenant
    raise PortRuleViolation("Business context rejected")
  GetPortBerthForUpdate = GetPortBerthForUpdate(Id=BId)
  assign  # SetB
    B = GetPortBerthForUpdate.Record.PortBerth
  if not (B.Tenant = Tenant):  # CheckBTenant
    raise PortRuleViolation("Record outside requested scope")
  if not (B.Version = BVersion):  # CheckBVersion
    raise PortRuleViolation("Record changed; reload before editing")
  if not (Metres > 0 and Metres <= B.ReservedLength):  # CheckMetres
    raise PortRuleViolation("Quantity")
  assign  # SetWorkflowPrior2
    WorkflowPrior2 = B
  assign  # SetBReservedLength
    B.ReservedLength = WorkflowPrior2.ReservedLength - Metres
    B.UpdatedOn = CurrDateTime()
    B.Version = B.Version + 1
  UpdatePortBerth = UpdatePortBerth(Source=B)
  end

/// ssam-rule-map:{"CheckGetUserId":"Rule_Authenticated_6ab694","CheckCheckPortOperatorRole":"Rule_AuthorizedRole_d1cdc5","CheckTenant":"Rule_AuthorizedScope0_29e52c","GetPortBerthForUpdate":"Rule_LoadB_fetch_2fd733","SetB":"Rule_LoadB_record_057f8a","CheckBTenant":"Rule_LoadB_scope0_487087","CheckBVersion":"Rule_LoadB_version_da9e59","Checknot":"Rule_Empty_c6c094","CheckNewDepth":"Rule_Surveyed_4787fc","SetBDepth":"Rule_Depth_values_7ba70d","UpdatePortBerth":"Rule_Depth_persist_b057a9"}
server action PortDredgeBerth public
  in Tenant: Text
  in NewDepth: Decimal
  in Survey: Text
  in BId: PortBerth Identifier
  in BVersion: Long Integer
  local B: PortBerth
  if not (GetUserId() <> NullIdentifier()):  # CheckGetUserId
    raise PortRuleViolation("Authentication required")
  if not (CheckPortOperatorRole(GetUserId())):  # CheckCheckPortOperatorRole
    raise PortRuleViolation("Role required")
  if not (Tenant <> ""):  # CheckTenant
    raise PortRuleViolation("Business context rejected")
  GetPortBerthForUpdate = GetPortBerthForUpdate(Id=BId)
  assign  # SetB
    B = GetPortBerthForUpdate.Record.PortBerth
  if not (B.Tenant = Tenant):  # CheckBTenant
    raise PortRuleViolation("Record outside requested scope")
  if not (B.Version = BVersion):  # CheckBVersion
    raise PortRuleViolation("Record changed; reload before editing")
  if not (not B.Occupied and B.ReservedLength = 0):  # Checknot
    raise PortRuleViolation("Empty")
  if not (NewDepth > 0 and Length(Survey) >= 10):  # CheckNewDepth
    raise PortRuleViolation("Surveyed")
  assign  # SetBDepth
    B.Depth = NewDepth
    B.UpdatedOn = CurrDateTime()
    B.Version = B.Version + 1
  UpdatePortBerth = UpdatePortBerth(Source=B)
  end

/// ssam-rule-map:{"CheckGetUserId":"Rule_Authenticated_6ab694","CheckCheckPortOperatorRole":"Rule_AuthorizedRole_d1cdc5","CheckTenant":"Rule_AuthorizedScope0_29e52c","GetPortBerthForUpdate":"Rule_LoadB_fetch_2fd733","SetB":"Rule_LoadB_record_057f8a","CheckBTenant":"Rule_LoadB_scope0_487087","CheckBVersion":"Rule_LoadB_version_da9e59","CheckSlots":"Rule_Safe_4f9f0d","SetBPowerSlots":"Rule_Power_values_8e16f3","UpdatePortBerth":"Rule_Power_persist_805101"}
server action PortReduceBerthPower public
  in Tenant: Text
  in Slots: Integer
  in BId: PortBerth Identifier
  in BVersion: Long Integer
  local B: PortBerth
  if not (GetUserId() <> NullIdentifier()):  # CheckGetUserId
    raise PortRuleViolation("Authentication required")
  if not (CheckPortOperatorRole(GetUserId())):  # CheckCheckPortOperatorRole
    raise PortRuleViolation("Role required")
  if not (Tenant <> ""):  # CheckTenant
    raise PortRuleViolation("Business context rejected")
  GetPortBerthForUpdate = GetPortBerthForUpdate(Id=BId)
  assign  # SetB
    B = GetPortBerthForUpdate.Record.PortBerth
  if not (B.Tenant = Tenant):  # CheckBTenant
    raise PortRuleViolation("Record outside requested scope")
  if not (B.Version = BVersion):  # CheckBVersion
    raise PortRuleViolation("Record changed; reload before editing")
  if not (Slots >= B.PowerUsed and Slots >= 0 and Slots < B.PowerSlots):  # CheckSlots
    raise PortRuleViolation("Safe")
  assign  # SetBPowerSlots
    B.PowerSlots = Slots
    B.UpdatedOn = CurrDateTime()
    B.Version = B.Version + 1
  UpdatePortBerth = UpdatePortBerth(Source=B)
  end

/// ssam-rule-map:{"CheckGetUserId":"Rule_Authenticated_6ab694","CheckCheckPortOperatorRole":"Rule_AuthorizedRole_d1cdc5","CheckTenant":"Rule_AuthorizedScope0_29e52c","GetPortBerth":"Rule_LoadB_fetch_2fd733","SetB":"Rule_LoadB_record_057f8a","CheckBTenant":"Rule_LoadB_scope0_487087","CheckBLength":"Rule_Valid_f51622","SetLengthPercent":"Rule_Result_6e7d50"}
server action PortBerthUtilization public
  in Tenant: Text
  in BId: PortBerth Identifier
  out LengthPercent: Decimal
  out PowerPercent: Decimal
  out WeatherOpen: Boolean
  local B: PortBerth
  if not (GetUserId() <> NullIdentifier()):  # CheckGetUserId
    raise PortRuleViolation("Authentication required")
  if not (CheckPortOperatorRole(GetUserId())):  # CheckCheckPortOperatorRole
    raise PortRuleViolation("Role required")
  if not (Tenant <> ""):  # CheckTenant
    raise PortRuleViolation("Business context rejected")
  GetPortBerth = GetPortBerth(Id=BId)
  assign  # SetB
    B = GetPortBerth.Record.PortBerth
  if not (B.Tenant = Tenant):  # CheckBTenant
    raise PortRuleViolation("Record outside requested scope")
  if not (B.Length > 0 and B.PowerSlots > 0):  # CheckBLength
    raise PortRuleViolation("Valid")
  assign  # SetLengthPercent
    LengthPercent = B.ReservedLength * 100 / B.Length
    PowerPercent = B.PowerUsed * 100 / B.PowerSlots
    WeatherOpen = B.CurrentWind <= B.ClosedWind and not B.Occupied
  end

/// ssam-rule-map:{"CheckGetUserId":"Rule_Authenticated_6ab694","CheckCheckPortOperatorRole":"Rule_AuthorizedRole_d1cdc5","CheckTenant":"Rule_AuthorizedScope0_29e52c","GetPortCall":"Rule_QueryQueue_query_13b134","SetQueue":"Rule_QueryQueue_list_69f7de","CheckBerthId":"Rule_Valid_f51622","SetWaiting":"Rule_Result_6e7d50"}
server action PortCountBerthQueue public
  in Tenant: Text
  in BerthId: PortBerth Identifier
  out Waiting: Long Integer
  local Queue: Long Integer
  if not (GetUserId() <> NullIdentifier()):  # CheckGetUserId
    raise PortRuleViolation("Authentication required")
  if not (CheckPortOperatorRole(GetUserId())):  # CheckCheckPortOperatorRole
    raise PortRuleViolation("Role required")
  if not (Tenant <> ""):  # CheckTenant
    raise PortRuleViolation("Business context rejected")
  GetPortCall = aggregate FROM PortCall WHERE (PortCall.Tenant = Tenant and PortCall.BerthId = BerthId and (PortCall.State = "Approved" or PortCall.State = "Requested")) MAX 1
  assign  # SetQueue
    Queue = GetPortCall.Count
  if not (BerthId <> NullIdentifier()):  # CheckBerthId
    raise PortRuleViolation("Valid")
  assign  # SetWaiting
    Waiting = Queue
  end

/// ssam-rule-map:{"CheckGetUserId":"Rule_Authenticated_6ab694","CheckCheckPortOperatorRole":"Rule_AuthorizedRole_d1cdc5","CheckTenant":"Rule_AuthorizedScope0_29e52c","GetPortCall":"Rule_QueryQueue_query_13b134","SetQueue":"Rule_QueryQueue_list_69f7de","Checknot":"Rule_Next_1ff57a","SetFound":"Rule_Next_Assign_0a16a8"}
server action PortNextPriorityCall public
  in Tenant: Text
  in BerthId: PortBerth Identifier
  out Found: Boolean
  out CallId: PortCall Identifier
  local Queue: PortCall List
  if not (GetUserId() <> NullIdentifier()):  # CheckGetUserId
    raise PortRuleViolation("Authentication required")
  if not (CheckPortOperatorRole(GetUserId())):  # CheckCheckPortOperatorRole
    raise PortRuleViolation("Role required")
  if not (Tenant <> ""):  # CheckTenant
    raise PortRuleViolation("Business context rejected")
  GetPortCall = aggregate FROM PortCall WHERE (PortCall.Tenant = Tenant and PortCall.BerthId = BerthId and PortCall.State = "Approved") SORT PortCall.Priority desc, PortCall.PlannedStart, PortCall.Id MAX 1
  assign  # SetQueue
    Queue = GetPortCall.List
  if not Queue.Empty:  # Checknot
    assign  # SetFound
      Found = True
      CallId = Queue.Current.Id
    end
  end

/// ssam-rule-map:{"CheckGetUserId":"Rule_Authenticated_6ab694","CheckCheckPortOperatorRole":"Rule_AuthorizedRole_d1cdc5","CheckTenant":"Rule_AuthorizedScope0_29e52c","GetPortCall":"Rule_QueryQueue_query_13b134","CheckGetPortCallCount":"Rule_QueryQueue_complete_d5f25a","SetQueue":"Rule_QueryQueue_list_69f7de","SetHours":"Rule_Totals_seed_898bc0","ForEachQueue":"Rule_Totals_each_cdb98e","SetWorkflowAccumulator2":"Rule_Totals_each_Totals_prior_cdc798","SetHours2":"Rule_Totals_each_Totals_step_4a0819"}
server action PortEstimateBerthHours public
  in Tenant: Text
  in BerthId: PortBerth Identifier
  out Hours: Decimal
  out Calls: Integer
  out MaxDelay: Decimal
  local Queue: PortCall List
  local WorkflowAccumulator2: Decimal
  local WorkflowAccumulator3: Integer
  local WorkflowAccumulator4: Decimal
  if not (GetUserId() <> NullIdentifier()):  # CheckGetUserId
    raise PortRuleViolation("Authentication required")
  if not (CheckPortOperatorRole(GetUserId())):  # CheckCheckPortOperatorRole
    raise PortRuleViolation("Role required")
  if not (Tenant <> ""):  # CheckTenant
    raise PortRuleViolation("Business context rejected")
  GetPortCall = aggregate FROM PortCall WHERE (PortCall.Tenant = Tenant and PortCall.BerthId = BerthId and PortCall.State = "Approved") MAX 1000
  if not (GetPortCall.Count <= 1000):  # CheckGetPortCallCount
    raise PortRuleViolation("Result exceeds declared limit")
  assign  # SetQueue
    Queue = GetPortCall.List
  assign  # SetHours
    Hours = 0
    Calls = 0
    MaxDelay = 0
  foreach Queue:  # ForEachQueue @ruleNew1
    assign  # SetWorkflowAccumulator2
      WorkflowAccumulator2 = Hours
      WorkflowAccumulator3 = Calls
      WorkflowAccumulator4 = MaxDelay
    assign  # SetHours2
      Hours = WorkflowAccumulator2 + Max(0, DiffSeconds(Queue.Current.PlannedStart, Queue.Current.PlannedEnd) / 3600)
      Calls = WorkflowAccumulator3 + 1
      MaxDelay = Max(WorkflowAccumulator4, Queue.Current.DelayHours)
    next
  end

/// ssam-rule-map:{"CheckGetUserId":"Rule_Authenticated_6ab694","CheckCheckPortOperatorRole":"Rule_AuthorizedRole_d1cdc5","CheckTenant":"Rule_AuthorizedScope0_29e52c","GetPortBerth":"Rule_QueryCandidates_query_968059","CheckGetPortBerthCount":"Rule_QueryCandidates_complete_e238ff","SetCandidates":"Rule_QueryCandidates_list_156ec1","CheckDraft":"Rule_Physical_a89383","SetAvailable":"Rule_Result_6e7d50"}
server action PortFindFreeBerths public
  in Tenant: Text
  in Draft: Decimal
  in Length: Decimal
  in Beam: Decimal
  out Available: PortBerth List
  local Candidates: PortBerth List
  if not (GetUserId() <> NullIdentifier()):  # CheckGetUserId
    raise PortRuleViolation("Authentication required")
  if not (CheckPortOperatorRole(GetUserId())):  # CheckCheckPortOperatorRole
    raise PortRuleViolation("Role required")
  if not (Tenant <> ""):  # CheckTenant
    raise PortRuleViolation("Business context rejected")
  GetPortBerth = aggregate FROM PortBerth WHERE (PortBerth.Tenant = Tenant and not PortBerth.Occupied and PortBerth.Depth >= Draft + 1 and PortBerth.Length - PortBerth.ReservedLength >= Length and PortBerth.MaxBeam >= Beam and PortBerth.CurrentWind <= PortBerth.ClosedWind) SORT PortBerth.Depth, PortBerth.Id MAX 1000
  if not (GetPortBerth.Count <= 1000):  # CheckGetPortBerthCount
    raise PortRuleViolation("Result exceeds declared limit")
  assign  # SetCandidates
    Candidates = GetPortBerth.List
  if not (Draft > 0 and Length > 0 and Beam > 0):  # CheckDraft
    raise PortRuleViolation("Physical")
  assign  # SetAvailable
    Available = Candidates
  end

/// ssam-rule-map:{"CheckGetUserId":"Rule_Authenticated_6ab694","CheckCheckPortOperatorRole":"Rule_AuthorizedRole_d1cdc5","CheckTenant":"Rule_AuthorizedScope0_29e52c","GetPortCraneForUpdate":"Rule_LoadK_fetch_288592","SetK":"Rule_LoadK_record_957223","CheckKTenant":"Rule_LoadK_scope0_f05978","CheckKVersion":"Rule_LoadK_version_fac8ca","GetPortShiftForUpdate":"Rule_LoadS_fetch_1b918b","SetS":"Rule_LoadS_record_6ce382","CheckSTenant":"Rule_LoadS_scope0_753217","CheckSVersion":"Rule_LoadS_version_aa9303","Checknot":"Rule_Available_e67444","CheckWeight":"Rule_Safe_4f9f0d","CheckSQualified":"Rule_Crew_5d2853","SetWorkflowPrior3":"Rule_Crane_prior_76ffcf","SetKHours":"Rule_Crane_values_36bc13","UpdatePortCrane":"Rule_Crane_persist_e26a36","SetWorkflowPrior4":"Rule_Team_prior_58fb17","SetSAssigned":"Rule_Team_values_8e07ec","UpdatePortShift":"Rule_Team_persist_9f0300"}
server action PortAssignCraneLift public
  in Tenant: Text
  in Weight: Decimal
  in Wind: Decimal
  in Hours: Decimal
  in KId: PortCrane Identifier
  in KVersion: Long Integer
  in SId: PortShift Identifier
  in SVersion: Long Integer
  local K: PortCrane
  local S: PortShift
  local WorkflowPrior3: PortCrane
  local WorkflowPrior4: PortShift
  if not (GetUserId() <> NullIdentifier()):  # CheckGetUserId
    raise PortRuleViolation("Authentication required")
  if not (CheckPortOperatorRole(GetUserId())):  # CheckCheckPortOperatorRole
    raise PortRuleViolation("Role required")
  if not (Tenant <> ""):  # CheckTenant
    raise PortRuleViolation("Business context rejected")
  GetPortCraneForUpdate = GetPortCraneForUpdate(Id=KId)
  assign  # SetK
    K = GetPortCraneForUpdate.Record.PortCrane
  if not (K.Tenant = Tenant):  # CheckKTenant
    raise PortRuleViolation("Record outside requested scope")
  if not (K.Version = KVersion):  # CheckKVersion
    raise PortRuleViolation("Record changed; reload before editing")
  GetPortShiftForUpdate = GetPortShiftForUpdate(Id=SId)
  assign  # SetS
    S = GetPortShiftForUpdate.Record.PortShift
  if not (S.Tenant = Tenant):  # CheckSTenant
    raise PortRuleViolation("Record outside requested scope")
  if not (S.Version = SVersion):  # CheckSVersion
    raise PortRuleViolation("Record changed; reload before editing")
  if not (not K.Suspended and S.State = "Active"):  # Checknot
    raise PortRuleViolation("Available")
  if not (Weight > 0 and Weight <= K.Capacity and Wind <= K.WindLimit and K.Hours + Hours <= K.MaintenanceAt):  # CheckWeight
    raise PortRuleViolation("Safe")
  if not (S.Qualified - S.Assigned >= 2 and Hours > 0):  # CheckSQualified
    raise PortRuleViolation("Crew")
  assign  # SetWorkflowPrior3
    WorkflowPrior3 = K
  assign  # SetKHours
    K.Hours = WorkflowPrior3.Hours + Hours
    K.Loads = WorkflowPrior3.Loads + 1
    K.UpdatedOn = CurrDateTime()
    K.Version = K.Version + 1
  UpdatePortCrane = UpdatePortCrane(Source=K)
  assign  # SetWorkflowPrior4
    WorkflowPrior4 = S
  assign  # SetSAssigned
    S.Assigned = WorkflowPrior4.Assigned + 2
    S.UpdatedOn = CurrDateTime()
    S.Version = S.Version + 1
  UpdatePortShift = UpdatePortShift(Source=S)
  end

/// ssam-rule-map:{"CheckGetUserId":"Rule_Authenticated_6ab694","CheckCheckPortOperatorRole":"Rule_AuthorizedRole_d1cdc5","CheckTenant":"Rule_AuthorizedScope0_29e52c","GetPortCraneForUpdate":"Rule_LoadK_fetch_288592","SetK":"Rule_LoadK_record_957223","CheckKTenant":"Rule_LoadK_scope0_f05978","CheckKVersion":"Rule_LoadK_version_fac8ca","CheckLength":"Rule_Reasoned_592d44","SetKSuspended":"Rule_Suspend_values_8a0044","UpdatePortCrane":"Rule_Suspend_persist_13d560","SetEvent":"Rule_Audit_reset_f0a34c","SetEventTenant":"Rule_Audit_values_c5f614","CreatePortEvent":"Rule_Audit_persist_225f32","SetEventId":"Rule_Audit_identity_dd9ab7"}
server action PortSuspendCrane public
  in Tenant: Text
  in Reason: Text
  in KId: PortCrane Identifier
  in KVersion: Long Integer
  local K: PortCrane
  local Event: PortEvent
  local WorkflowEmpty2: PortEvent
  if not (GetUserId() <> NullIdentifier()):  # CheckGetUserId
    raise PortRuleViolation("Authentication required")
  if not (CheckPortOperatorRole(GetUserId())):  # CheckCheckPortOperatorRole
    raise PortRuleViolation("Role required")
  if not (Tenant <> ""):  # CheckTenant
    raise PortRuleViolation("Business context rejected")
  GetPortCraneForUpdate = GetPortCraneForUpdate(Id=KId)
  assign  # SetK
    K = GetPortCraneForUpdate.Record.PortCrane
  if not (K.Tenant = Tenant):  # CheckKTenant
    raise PortRuleViolation("Record outside requested scope")
  if not (K.Version = KVersion):  # CheckKVersion
    raise PortRuleViolation("Record changed; reload before editing")
  if not (Length(Reason) >= 10):  # CheckLength
    raise PortRuleViolation("Reasoned")
  assign  # SetKSuspended
    K.Suspended = True
    K.UpdatedOn = CurrDateTime()
    K.Version = K.Version + 1
  UpdatePortCrane = UpdatePortCrane(Source=K)
  assign  # SetEvent
    Event = WorkflowEmpty2
  assign  # SetEventTenant
    Event.Tenant = Tenant
    Event.Kind = "CraneSuspended"
    Event.Body = K.Code + Reason
    Event.Severity = 4
    Event.CreatedBy = GetUserId()
    Event.UpdatedOn = CurrDateTime()
    Event.CreatedOn = CurrDateTime()
    Event.Version = 1
  CreatePortEvent = CreatePortEvent(Source=Event)
  assign  # SetEventId
    Event.Id = CreatePortEvent.Id
  end

/// ssam-rule-map:{"CheckGetUserId":"Rule_Authenticated_6ab694","CheckCheckPortOperatorRole":"Rule_AuthorizedRole_d1cdc5","CheckTenant":"Rule_AuthorizedScope0_29e52c","GetPortCraneForUpdate":"Rule_LoadK_fetch_288592","SetK":"Rule_LoadK_record_957223","CheckKTenant":"Rule_LoadK_scope0_f05978","CheckKVersion":"Rule_LoadK_version_fac8ca","CheckInspectionPassed":"Rule_Inspected_f855b0","CheckKSuspended":"Rule_Serviced_78bf2a","SetKSuspended":"Rule_Release_values_58b72f","UpdatePortCrane":"Rule_Release_persist_c6b549"}
server action PortReleaseCrane public
  in Tenant: Text
  in InspectionPassed: Boolean
  in Evidence: Text
  in KId: PortCrane Identifier
  in KVersion: Long Integer
  local K: PortCrane
  if not (GetUserId() <> NullIdentifier()):  # CheckGetUserId
    raise PortRuleViolation("Authentication required")
  if not (CheckPortOperatorRole(GetUserId())):  # CheckCheckPortOperatorRole
    raise PortRuleViolation("Role required")
  if not (Tenant <> ""):  # CheckTenant
    raise PortRuleViolation("Business context rejected")
  GetPortCraneForUpdate = GetPortCraneForUpdate(Id=KId)
  assign  # SetK
    K = GetPortCraneForUpdate.Record.PortCrane
  if not (K.Tenant = Tenant):  # CheckKTenant
    raise PortRuleViolation("Record outside requested scope")
  if not (K.Version = KVersion):  # CheckKVersion
    raise PortRuleViolation("Record changed; reload before editing")
  if not (InspectionPassed and Length(Evidence) >= 8):  # CheckInspectionPassed
    raise PortRuleViolation("Inspected")
  if not (K.Suspended and K.Hours < K.MaintenanceAt):  # CheckKSuspended
    raise PortRuleViolation("Serviced")
  assign  # SetKSuspended
    K.Suspended = False
    K.UpdatedOn = CurrDateTime()
    K.Version = K.Version + 1
  UpdatePortCrane = UpdatePortCrane(Source=K)
  end

/// ssam-rule-map:{"CheckGetUserId":"Rule_Authenticated_6ab694","CheckCheckPortOperatorRole":"Rule_AuthorizedRole_d1cdc5","CheckTenant":"Rule_AuthorizedScope0_29e52c","GetPortCraneForUpdate":"Rule_LoadK_fetch_288592","SetK":"Rule_LoadK_record_957223","CheckKTenant":"Rule_LoadK_scope0_f05978","CheckKVersion":"Rule_LoadK_version_fac8ca","CheckKwh":"Rule_Physical_a89383","SetWorkflowPrior2":"Rule_Record_prior_693e77","SetKEnergyKwh":"Rule_Record_values_fd7b8a","UpdatePortCrane":"Rule_Record_persist_56ea16"}
server action PortRecordCraneEnergy public
  in Tenant: Text
  in Kwh: Decimal
  in Hours: Decimal
  in KId: PortCrane Identifier
  in KVersion: Long Integer
  local K: PortCrane
  local WorkflowPrior2: PortCrane
  if not (GetUserId() <> NullIdentifier()):  # CheckGetUserId
    raise PortRuleViolation("Authentication required")
  if not (CheckPortOperatorRole(GetUserId())):  # CheckCheckPortOperatorRole
    raise PortRuleViolation("Role required")
  if not (Tenant <> ""):  # CheckTenant
    raise PortRuleViolation("Business context rejected")
  GetPortCraneForUpdate = GetPortCraneForUpdate(Id=KId)
  assign  # SetK
    K = GetPortCraneForUpdate.Record.PortCrane
  if not (K.Tenant = Tenant):  # CheckKTenant
    raise PortRuleViolation("Record outside requested scope")
  if not (K.Version = KVersion):  # CheckKVersion
    raise PortRuleViolation("Record changed; reload before editing")
  if not (Kwh >= 0 and Hours > 0 and Hours <= 24):  # CheckKwh
    raise PortRuleViolation("Physical")
  assign  # SetWorkflowPrior2
    WorkflowPrior2 = K
  assign  # SetKEnergyKwh
    K.EnergyKwh = WorkflowPrior2.EnergyKwh + Kwh
    K.Hours = WorkflowPrior2.Hours + Hours
    K.Suspended = WorkflowPrior2.Suspended or WorkflowPrior2.Hours + Hours >= WorkflowPrior2.MaintenanceAt
    K.UpdatedOn = CurrDateTime()
    K.Version = K.Version + 1
  UpdatePortCrane = UpdatePortCrane(Source=K)
  end

/// ssam-rule-map:{"CheckGetUserId":"Rule_Authenticated_6ab694","CheckCheckPortOperatorRole":"Rule_AuthorizedRole_d1cdc5","CheckTenant":"Rule_AuthorizedScope0_29e52c","GetPortCraneForUpdate":"Rule_LoadK_fetch_288592","SetK":"Rule_LoadK_record_957223","CheckKTenant":"Rule_LoadK_scope0_f05978","CheckKVersion":"Rule_LoadK_version_fac8ca","CheckKSuspended":"Rule_Stopped_1a4f63","CheckInterval":"Rule_Certified_c9996e","SetWorkflowPrior2":"Rule_Service_prior_21e286","SetKMaintenanceAt":"Rule_Service_values_068fe2","UpdatePortCrane":"Rule_Service_persist_806e67"}
server action PortServiceCrane public
  in Tenant: Text
  in Interval: Decimal
  in Certificate: Text
  in KId: PortCrane Identifier
  in KVersion: Long Integer
  local K: PortCrane
  local WorkflowPrior2: PortCrane
  if not (GetUserId() <> NullIdentifier()):  # CheckGetUserId
    raise PortRuleViolation("Authentication required")
  if not (CheckPortOperatorRole(GetUserId())):  # CheckCheckPortOperatorRole
    raise PortRuleViolation("Role required")
  if not (Tenant <> ""):  # CheckTenant
    raise PortRuleViolation("Business context rejected")
  GetPortCraneForUpdate = GetPortCraneForUpdate(Id=KId)
  assign  # SetK
    K = GetPortCraneForUpdate.Record.PortCrane
  if not (K.Tenant = Tenant):  # CheckKTenant
    raise PortRuleViolation("Record outside requested scope")
  if not (K.Version = KVersion):  # CheckKVersion
    raise PortRuleViolation("Record changed; reload before editing")
  if not (K.Suspended):  # CheckKSuspended
    raise PortRuleViolation("Stopped")
  if not (Interval > 0 and Interval <= 2000 and Length(Certificate) >= 10):  # CheckInterval
    raise PortRuleViolation("Certified")
  assign  # SetWorkflowPrior2
    WorkflowPrior2 = K
  assign  # SetKMaintenanceAt
    K.MaintenanceAt = WorkflowPrior2.Hours + Interval
    K.Suspended = False
    K.UpdatedOn = CurrDateTime()
    K.Version = K.Version + 1
  UpdatePortCrane = UpdatePortCrane(Source=K)
  end

/// ssam-rule-map:{"CheckGetUserId":"Rule_Authenticated_6ab694","CheckCheckPortOperatorRole":"Rule_AuthorizedRole_d1cdc5","CheckTenant":"Rule_AuthorizedScope0_29e52c","GetPortCraneForUpdate":"Rule_LoadK_fetch_288592","SetK":"Rule_LoadK_record_957223","CheckKTenant":"Rule_LoadK_scope0_f05978","CheckKVersion":"Rule_LoadK_version_fac8ca","CheckKSuspended":"Rule_Stopped_1a4f63","CheckNewCapacity":"Rule_Safe_4f9f0d","SetKCapacity":"Rule_Derate_values_d61c81","UpdatePortCrane":"Rule_Derate_persist_e5bf80"}
server action PortDerateCrane public
  in Tenant: Text
  in NewCapacity: Decimal
  in WindLimit: Decimal
  in KId: PortCrane Identifier
  in KVersion: Long Integer
  local K: PortCrane
  if not (GetUserId() <> NullIdentifier()):  # CheckGetUserId
    raise PortRuleViolation("Authentication required")
  if not (CheckPortOperatorRole(GetUserId())):  # CheckCheckPortOperatorRole
    raise PortRuleViolation("Role required")
  if not (Tenant <> ""):  # CheckTenant
    raise PortRuleViolation("Business context rejected")
  GetPortCraneForUpdate = GetPortCraneForUpdate(Id=KId)
  assign  # SetK
    K = GetPortCraneForUpdate.Record.PortCrane
  if not (K.Tenant = Tenant):  # CheckKTenant
    raise PortRuleViolation("Record outside requested scope")
  if not (K.Version = KVersion):  # CheckKVersion
    raise PortRuleViolation("Record changed; reload before editing")
  if not (K.Suspended):  # CheckKSuspended
    raise PortRuleViolation("Stopped")
  if not (NewCapacity > 0 and NewCapacity <= K.Capacity and WindLimit > 0 and WindLimit <= K.WindLimit):  # CheckNewCapacity
    raise PortRuleViolation("Safe")
  assign  # SetKCapacity
    K.Capacity = NewCapacity
    K.WindLimit = WindLimit
    K.UpdatedOn = CurrDateTime()
    K.Version = K.Version + 1
  UpdatePortCrane = UpdatePortCrane(Source=K)
  end

/// ssam-rule-map:{"CheckGetUserId":"Rule_Authenticated_6ab694","CheckCheckPortOperatorRole":"Rule_AuthorizedRole_d1cdc5","CheckTenant":"Rule_AuthorizedScope0_29e52c","GetPortCrane":"Rule_LoadK_fetch_288592","SetK":"Rule_LoadK_record_957223","CheckKTenant":"Rule_LoadK_scope0_f05978","CheckKLoads":"Rule_Measured_9298c8","SetEnergyPerLift":"Rule_Result_6e7d50"}
server action PortCraneEfficiency public
  in Tenant: Text
  in KId: PortCrane Identifier
  out EnergyPerLift: Decimal
  out LiftsPerHour: Decimal
  out HoursLeft: Decimal
  local K: PortCrane
  if not (GetUserId() <> NullIdentifier()):  # CheckGetUserId
    raise PortRuleViolation("Authentication required")
  if not (CheckPortOperatorRole(GetUserId())):  # CheckCheckPortOperatorRole
    raise PortRuleViolation("Role required")
  if not (Tenant <> ""):  # CheckTenant
    raise PortRuleViolation("Business context rejected")
  GetPortCrane = GetPortCrane(Id=KId)
  assign  # SetK
    K = GetPortCrane.Record.PortCrane
  if not (K.Tenant = Tenant):  # CheckKTenant
    raise PortRuleViolation("Record outside requested scope")
  if not (K.Loads > 0 and K.Hours > 0):  # CheckKLoads
    raise PortRuleViolation("Measured")
  assign  # SetEnergyPerLift
    EnergyPerLift = K.EnergyKwh / K.Loads
    LiftsPerHour = K.Loads / K.Hours
    HoursLeft = Max(0, K.MaintenanceAt - K.Hours)
  end

/// ssam-rule-map:{"CheckGetUserId":"Rule_Authenticated_6ab694","CheckCheckPortOperatorRole":"Rule_AuthorizedRole_d1cdc5","CheckTenant":"Rule_AuthorizedScope0_29e52c","GetPortCrane":"Rule_QueryCandidates_query_968059","SetCandidates":"Rule_QueryCandidates_list_156ec1","CheckWeight":"Rule_Valid_f51622","Checknot":"Rule_Choose_c7f937","SetFound":"Rule_Choose_Result_4e3820"}
server action PortChooseCrane public
  in Tenant: Text
  in Weight: Decimal
  in Wind: Decimal
  out CraneId: PortCrane Identifier
  out Found: Boolean
  local Candidates: PortCrane List
  if not (GetUserId() <> NullIdentifier()):  # CheckGetUserId
    raise PortRuleViolation("Authentication required")
  if not (CheckPortOperatorRole(GetUserId())):  # CheckCheckPortOperatorRole
    raise PortRuleViolation("Role required")
  if not (Tenant <> ""):  # CheckTenant
    raise PortRuleViolation("Business context rejected")
  GetPortCrane = aggregate FROM PortCrane WHERE (PortCrane.Tenant = Tenant and not PortCrane.Suspended and PortCrane.Capacity >= Weight and PortCrane.WindLimit >= Wind and PortCrane.Hours < PortCrane.MaintenanceAt) SORT PortCrane.Capacity, PortCrane.Hours, PortCrane.Id MAX 1
  assign  # SetCandidates
    Candidates = GetPortCrane.List
  if not (Weight > 0 and Wind >= 0):  # CheckWeight
    raise PortRuleViolation("Valid")
  if not Candidates.Empty:  # Checknot
    assign  # SetFound
      Found = True
      CraneId = Candidates.Current.Id
    end
  end

/// ssam-rule-map:{"CheckGetUserId":"Rule_Authenticated_6ab694","CheckCheckPortOperatorRole":"Rule_AuthorizedRole_d1cdc5","CheckTenant":"Rule_AuthorizedScope0_29e52c","GetPortCrane":"Rule_QueryFleet_query_282306","CheckGetPortCraneCount":"Rule_QueryFleet_complete_5f58fd","SetFleet":"Rule_QueryFleet_list_34c912","SetDue":"Rule_Scan_seed_ef386d","ForEachFleet":"Rule_Scan_each_0094ef","SetWorkflowAccumulator2":"Rule_Scan_each_Scan_prior_78bba3","SetDue2":"Rule_Scan_each_Scan_step_cc9e7d"}
server action PortCraneFleetRisk public
  in Tenant: Text
  out Due: Integer
  out Suspended: Integer
  out TotalCapacity: Decimal
  local Fleet: PortCrane List
  local WorkflowAccumulator2: Integer
  local WorkflowAccumulator3: Integer
  local WorkflowAccumulator4: Decimal
  if not (GetUserId() <> NullIdentifier()):  # CheckGetUserId
    raise PortRuleViolation("Authentication required")
  if not (CheckPortOperatorRole(GetUserId())):  # CheckCheckPortOperatorRole
    raise PortRuleViolation("Role required")
  if not (Tenant <> ""):  # CheckTenant
    raise PortRuleViolation("Business context rejected")
  GetPortCrane = aggregate FROM PortCrane WHERE (PortCrane.Tenant = Tenant) MAX 1000
  if not (GetPortCrane.Count <= 1000):  # CheckGetPortCraneCount
    raise PortRuleViolation("Result exceeds declared limit")
  assign  # SetFleet
    Fleet = GetPortCrane.List
  assign  # SetDue
    Due = 0
    Suspended = 0
    TotalCapacity = 0
  foreach Fleet:  # ForEachFleet @ruleNew1
    assign  # SetWorkflowAccumulator2
      WorkflowAccumulator2 = Due
      WorkflowAccumulator3 = Suspended
      WorkflowAccumulator4 = TotalCapacity
    assign  # SetDue2
      Due = WorkflowAccumulator2 + If(Fleet.Current.MaintenanceAt - Fleet.Current.Hours <= 24, 1, 0)
      Suspended = WorkflowAccumulator3 + If(Fleet.Current.Suspended, 1, 0)
      TotalCapacity = WorkflowAccumulator4 + If(Fleet.Current.Suspended, 0, Fleet.Current.Capacity)
    next
  end

/// ssam-rule-map:{"CheckGetUserId":"Rule_Authenticated_6ab694","CheckCheckPortOperatorRole":"Rule_AuthorizedRole_d1cdc5","CheckTenant":"Rule_AuthorizedScope0_29e52c","GetPortCrane":"Rule_LoadK_fetch_288592","SetK":"Rule_LoadK_record_957223","CheckKTenant":"Rule_LoadK_scope0_f05978","CheckWeight":"Rule_Physical_a89383","SetMinutes":"Rule_Result_6e7d50"}
server action PortPlanLiftTime public
  in Tenant: Text
  in Weight: Decimal
  in Distance: Decimal
  in Speed: Decimal
  in RigMinutes: Decimal
  in KId: PortCrane Identifier
  out Minutes: Decimal
  out Safe: Boolean
  local K: PortCrane
  if not (GetUserId() <> NullIdentifier()):  # CheckGetUserId
    raise PortRuleViolation("Authentication required")
  if not (CheckPortOperatorRole(GetUserId())):  # CheckCheckPortOperatorRole
    raise PortRuleViolation("Role required")
  if not (Tenant <> ""):  # CheckTenant
    raise PortRuleViolation("Business context rejected")
  GetPortCrane = GetPortCrane(Id=KId)
  assign  # SetK
    K = GetPortCrane.Record.PortCrane
  if not (K.Tenant = Tenant):  # CheckKTenant
    raise PortRuleViolation("Record outside requested scope")
  if not (Weight > 0 and Distance >= 0 and Speed > 0 and RigMinutes >= 0):  # CheckWeight
    raise PortRuleViolation("Physical")
  assign  # SetMinutes
    Minutes = Distance / Speed + RigMinutes
    Safe = Weight <= K.Capacity and not K.Suspended and K.Hours + (Distance / Speed + RigMinutes) / 60 < K.MaintenanceAt
  end

/// ssam-rule-map:{"CheckGetUserId":"Rule_Authenticated_6ab694","CheckCheckPortOperatorRole":"Rule_AuthorizedRole_d1cdc5","CheckTenant":"Rule_AuthorizedScope0_29e52c","GetPortShiftForUpdate":"Rule_LoadS_fetch_1b918b","SetS":"Rule_LoadS_record_6ce382","CheckSTenant":"Rule_LoadS_scope0_753217","CheckSVersion":"Rule_LoadS_version_aa9303","CheckSState":"Rule_Scheduled_4724f3","CheckSRestHours":"Rule_Rested_5ac76e","SetSState":"Rule_Start_values_b46321","UpdatePortShift":"Rule_Start_persist_8f4851"}
server action PortStartShift public
  in Tenant: Text
  in SId: PortShift Identifier
  in SVersion: Long Integer
  local S: PortShift
  if not (GetUserId() <> NullIdentifier()):  # CheckGetUserId
    raise PortRuleViolation("Authentication required")
  if not (CheckPortOperatorRole(GetUserId())):  # CheckCheckPortOperatorRole
    raise PortRuleViolation("Role required")
  if not (Tenant <> ""):  # CheckTenant
    raise PortRuleViolation("Business context rejected")
  GetPortShiftForUpdate = GetPortShiftForUpdate(Id=SId)
  assign  # SetS
    S = GetPortShiftForUpdate.Record.PortShift
  if not (S.Tenant = Tenant):  # CheckSTenant
    raise PortRuleViolation("Record outside requested scope")
  if not (S.Version = SVersion):  # CheckSVersion
    raise PortRuleViolation("Record changed; reload before editing")
  if not (S.State = "Scheduled" and S.StartsAt <= CurrDateTime() and S.EndsAt > CurrDateTime()):  # CheckSState
    raise PortRuleViolation("Scheduled")
  if not (S.RestHours >= 11 and S.Qualified <= S.Workers and S.Workers > 0):  # CheckSRestHours
    raise PortRuleViolation("Rested")
  assign  # SetSState
    S.State = "Active"
    S.Assigned = 0
    S.UpdatedOn = CurrDateTime()
    S.Version = S.Version + 1
  UpdatePortShift = UpdatePortShift(Source=S)
  end

/// ssam-rule-map:{"CheckGetUserId":"Rule_Authenticated_6ab694","CheckCheckPortOperatorRole":"Rule_AuthorizedRole_d1cdc5","CheckTenant":"Rule_AuthorizedScope0_29e52c","GetPortShiftForUpdate":"Rule_LoadS_fetch_1b918b","SetS":"Rule_LoadS_record_6ce382","CheckSTenant":"Rule_LoadS_scope0_753217","CheckSVersion":"Rule_LoadS_version_aa9303","CheckSState":"Rule_Active_923406","CheckSAssigned":"Rule_Released_f33dee","SetSState":"Rule_End_values_a4af45","UpdatePortShift":"Rule_End_persist_9d8395"}
server action PortEndShift public
  in Tenant: Text
  in SId: PortShift Identifier
  in SVersion: Long Integer
  local S: PortShift
  if not (GetUserId() <> NullIdentifier()):  # CheckGetUserId
    raise PortRuleViolation("Authentication required")
  if not (CheckPortOperatorRole(GetUserId())):  # CheckCheckPortOperatorRole
    raise PortRuleViolation("Role required")
  if not (Tenant <> ""):  # CheckTenant
    raise PortRuleViolation("Business context rejected")
  GetPortShiftForUpdate = GetPortShiftForUpdate(Id=SId)
  assign  # SetS
    S = GetPortShiftForUpdate.Record.PortShift
  if not (S.Tenant = Tenant):  # CheckSTenant
    raise PortRuleViolation("Record outside requested scope")
  if not (S.Version = SVersion):  # CheckSVersion
    raise PortRuleViolation("Record changed; reload before editing")
  if not (S.State = "Active"):  # CheckSState
    raise PortRuleViolation("Active")
  if not (S.Assigned = 0):  # CheckSAssigned
    raise PortRuleViolation("Released")
  assign  # SetSState
    S.State = "Completed"
    S.EndsAt = CurrDateTime()
    S.UpdatedOn = CurrDateTime()
    S.Version = S.Version + 1
  UpdatePortShift = UpdatePortShift(Source=S)
  end

/// ssam-rule-map:{"CheckGetUserId":"Rule_Authenticated_6ab694","CheckCheckPortOperatorRole":"Rule_AuthorizedRole_d1cdc5","CheckTenant":"Rule_AuthorizedScope0_29e52c","GetPortShiftForUpdate":"Rule_LoadS_fetch_1b918b","SetS":"Rule_LoadS_record_6ce382","CheckSTenant":"Rule_LoadS_scope0_753217","CheckSVersion":"Rule_LoadS_version_aa9303","CheckSState":"Rule_Active_923406","CheckHours":"Rule_WithinLimit_4c9746","SetWorkflowPrior2":"Rule_Extend_prior_ea76b9","SetSOvertime":"Rule_Extend_values_f2718e","UpdatePortShift":"Rule_Extend_persist_790534"}
server action PortExtendShift public
  in Tenant: Text
  in Hours: Decimal
  in SId: PortShift Identifier
  in SVersion: Long Integer
  local S: PortShift
  local WorkflowPrior2: PortShift
  if not (GetUserId() <> NullIdentifier()):  # CheckGetUserId
    raise PortRuleViolation("Authentication required")
  if not (CheckPortOperatorRole(GetUserId())):  # CheckCheckPortOperatorRole
    raise PortRuleViolation("Role required")
  if not (Tenant <> ""):  # CheckTenant
    raise PortRuleViolation("Business context rejected")
  GetPortShiftForUpdate = GetPortShiftForUpdate(Id=SId)
  assign  # SetS
    S = GetPortShiftForUpdate.Record.PortShift
  if not (S.Tenant = Tenant):  # CheckSTenant
    raise PortRuleViolation("Record outside requested scope")
  if not (S.Version = SVersion):  # CheckSVersion
    raise PortRuleViolation("Record changed; reload before editing")
  if not (S.State = "Active"):  # CheckSState
    raise PortRuleViolation("Active")
  if not (Hours > 0 and Hours <= 4 and S.Overtime + Hours <= S.MaxOvertime):  # CheckHours
    raise PortRuleViolation("WithinLimit")
  assign  # SetWorkflowPrior2
    WorkflowPrior2 = S
  assign  # SetSOvertime
    S.Overtime = WorkflowPrior2.Overtime + Hours
    S.EndsAt = AddSeconds(WorkflowPrior2.EndsAt, DecimalToInteger(Hours * 3600))
    S.UpdatedOn = CurrDateTime()
    S.Version = S.Version + 1
  UpdatePortShift = UpdatePortShift(Source=S)
  end

/// ssam-rule-map:{"CheckGetUserId":"Rule_Authenticated_6ab694","CheckCheckPortOperatorRole":"Rule_AuthorizedRole_d1cdc5","CheckTenant":"Rule_AuthorizedScope0_29e52c","GetPortShiftForUpdate":"Rule_LoadS_fetch_1b918b","SetS":"Rule_LoadS_record_6ce382","CheckSTenant":"Rule_LoadS_scope0_753217","CheckSVersion":"Rule_LoadS_version_aa9303","CheckSState":"Rule_Active_923406","CheckWorkers":"Rule_Available_e67444","SetWorkflowPrior2":"Rule_Allocate_prior_d64c76","SetSAssigned":"Rule_Allocate_values_567bc9","UpdatePortShift":"Rule_Allocate_persist_acbc35"}
server action PortAllocateWorkers public
  in Tenant: Text
  in Workers: Integer
  in NeedQualified: Boolean
  in SId: PortShift Identifier
  in SVersion: Long Integer
  local S: PortShift
  local WorkflowPrior2: PortShift
  if not (GetUserId() <> NullIdentifier()):  # CheckGetUserId
    raise PortRuleViolation("Authentication required")
  if not (CheckPortOperatorRole(GetUserId())):  # CheckCheckPortOperatorRole
    raise PortRuleViolation("Role required")
  if not (Tenant <> ""):  # CheckTenant
    raise PortRuleViolation("Business context rejected")
  GetPortShiftForUpdate = GetPortShiftForUpdate(Id=SId)
  assign  # SetS
    S = GetPortShiftForUpdate.Record.PortShift
  if not (S.Tenant = Tenant):  # CheckSTenant
    raise PortRuleViolation("Record outside requested scope")
  if not (S.Version = SVersion):  # CheckSVersion
    raise PortRuleViolation("Record changed; reload before editing")
  if not (S.State = "Active" and S.EndsAt > CurrDateTime()):  # CheckSState
    raise PortRuleViolation("Active")
  if not (Workers > 0 and S.Assigned + Workers <= If(NeedQualified, S.Qualified, S.Workers)):  # CheckWorkers
    raise PortRuleViolation("Available")
  assign  # SetWorkflowPrior2
    WorkflowPrior2 = S
  assign  # SetSAssigned
    S.Assigned = WorkflowPrior2.Assigned + Workers
    S.UpdatedOn = CurrDateTime()
    S.Version = S.Version + 1
  UpdatePortShift = UpdatePortShift(Source=S)
  end

/// ssam-rule-map:{"CheckGetUserId":"Rule_Authenticated_6ab694","CheckCheckPortOperatorRole":"Rule_AuthorizedRole_d1cdc5","CheckTenant":"Rule_AuthorizedScope0_29e52c","GetPortShiftForUpdate":"Rule_LoadS_fetch_1b918b","SetS":"Rule_LoadS_record_6ce382","CheckSTenant":"Rule_LoadS_scope0_753217","CheckSVersion":"Rule_LoadS_version_aa9303","CheckSState":"Rule_Active_923406","CheckWorkers":"Rule_Assigned_819188","SetWorkflowPrior2":"Rule_Release_prior_751753","SetSAssigned":"Rule_Release_values_58b72f","UpdatePortShift":"Rule_Release_persist_c6b549"}
server action PortReleaseWorkers public
  in Tenant: Text
  in Workers: Integer
  in SId: PortShift Identifier
  in SVersion: Long Integer
  local S: PortShift
  local WorkflowPrior2: PortShift
  if not (GetUserId() <> NullIdentifier()):  # CheckGetUserId
    raise PortRuleViolation("Authentication required")
  if not (CheckPortOperatorRole(GetUserId())):  # CheckCheckPortOperatorRole
    raise PortRuleViolation("Role required")
  if not (Tenant <> ""):  # CheckTenant
    raise PortRuleViolation("Business context rejected")
  GetPortShiftForUpdate = GetPortShiftForUpdate(Id=SId)
  assign  # SetS
    S = GetPortShiftForUpdate.Record.PortShift
  if not (S.Tenant = Tenant):  # CheckSTenant
    raise PortRuleViolation("Record outside requested scope")
  if not (S.Version = SVersion):  # CheckSVersion
    raise PortRuleViolation("Record changed; reload before editing")
  if not (S.State = "Active"):  # CheckSState
    raise PortRuleViolation("Active")
  if not (Workers > 0 and Workers <= S.Assigned):  # CheckWorkers
    raise PortRuleViolation("Assigned")
  assign  # SetWorkflowPrior2
    WorkflowPrior2 = S
  assign  # SetSAssigned
    S.Assigned = WorkflowPrior2.Assigned - Workers
    S.UpdatedOn = CurrDateTime()
    S.Version = S.Version + 1
  UpdatePortShift = UpdatePortShift(Source=S)
  end

/// ssam-rule-map:{"CheckGetUserId":"Rule_Authenticated_6ab694","CheckCheckPortOperatorRole":"Rule_AuthorizedRole_d1cdc5","CheckTenant":"Rule_AuthorizedScope0_29e52c","GetPortShiftForUpdate":"Rule_LoadA_fetch_82b9d4","SetA":"Rule_LoadA_record_1b477a","CheckATenant":"Rule_LoadA_scope0_bb502b","CheckAVersion":"Rule_LoadA_version_f1370d","GetPortShiftForUpdate2":"Rule_LoadB_fetch_2fd733","SetB":"Rule_LoadB_record_057f8a","CheckBTenant":"Rule_LoadB_scope0_487087","CheckBVersion":"Rule_LoadB_version_da9e59","CheckAId":"Rule_Distinct_b4bfe6","CheckWorkers":"Rule_Feasible_cbd147","SetWorkflowPrior3":"Rule_Release_prior_751753","SetAAssigned":"Rule_Release_values_58b72f","UpdatePortShift":"Rule_Release_persist_c6b549","SetWorkflowPrior4":"Rule_Receive_prior_eedb11","SetBAssigned":"Rule_Receive_values_567309","UpdatePortShift2":"Rule_Receive_persist_77a8c8"}
server action PortTransferTeam public
  in Tenant: Text
  in Workers: Integer
  in AId: PortShift Identifier
  in AVersion: Long Integer
  in BId: PortShift Identifier
  in BVersion: Long Integer
  local A: PortShift
  local B: PortShift
  local WorkflowPrior3: PortShift
  local WorkflowPrior4: PortShift
  if not (GetUserId() <> NullIdentifier()):  # CheckGetUserId
    raise PortRuleViolation("Authentication required")
  if not (CheckPortOperatorRole(GetUserId())):  # CheckCheckPortOperatorRole
    raise PortRuleViolation("Role required")
  if not (Tenant <> ""):  # CheckTenant
    raise PortRuleViolation("Business context rejected")
  GetPortShiftForUpdate = GetPortShiftForUpdate(Id=AId)
  assign  # SetA
    A = GetPortShiftForUpdate.Record.PortShift
  if not (A.Tenant = Tenant):  # CheckATenant
    raise PortRuleViolation("Record outside requested scope")
  if not (A.Version = AVersion):  # CheckAVersion
    raise PortRuleViolation("Record changed; reload before editing")
  GetPortShiftForUpdate2 = GetPortShiftForUpdate(Id=BId)
  assign  # SetB
    B = GetPortShiftForUpdate2.Record.PortShift
  if not (B.Tenant = Tenant):  # CheckBTenant
    raise PortRuleViolation("Record outside requested scope")
  if not (B.Version = BVersion):  # CheckBVersion
    raise PortRuleViolation("Record changed; reload before editing")
  if not (A.Id <> B.Id and A.State = "Active" and B.State = "Active"):  # CheckAId
    raise PortRuleViolation("Distinct")
  if not (Workers > 0 and Workers <= A.Assigned and B.Assigned + Workers <= B.Qualified):  # CheckWorkers
    raise PortRuleViolation("Feasible")
  assign  # SetWorkflowPrior3
    WorkflowPrior3 = A
  assign  # SetAAssigned
    A.Assigned = WorkflowPrior3.Assigned - Workers
    A.UpdatedOn = CurrDateTime()
    A.Version = A.Version + 1
  UpdatePortShift = UpdatePortShift(Source=A)
  assign  # SetWorkflowPrior4
    WorkflowPrior4 = B
  assign  # SetBAssigned
    B.Assigned = WorkflowPrior4.Assigned + Workers
    B.UpdatedOn = CurrDateTime()
    B.Version = B.Version + 1
  UpdatePortShift2 = UpdatePortShift(Source=B)
  end

/// ssam-rule-map:{"CheckGetUserId":"Rule_Authenticated_6ab694","CheckCheckPortOperatorRole":"Rule_AuthorizedRole_d1cdc5","CheckTenant":"Rule_AuthorizedScope0_29e52c","GetPortShiftForUpdate":"Rule_LoadS_fetch_1b918b","SetS":"Rule_LoadS_record_6ce382","CheckSTenant":"Rule_LoadS_scope0_753217","CheckSVersion":"Rule_LoadS_version_aa9303","CheckSState":"Rule_Unused_231aed","CheckLength":"Rule_Reasoned_592d44","SetSState":"Rule_Cancel_values_bc24f6","UpdatePortShift":"Rule_Cancel_persist_dcc02e","SetEvent":"Rule_Audit_reset_f0a34c","SetEventTenant":"Rule_Audit_values_c5f614","CreatePortEvent":"Rule_Audit_persist_225f32","SetEventId":"Rule_Audit_identity_dd9ab7"}
server action PortCancelShift public
  in Tenant: Text
  in Reason: Text
  in SId: PortShift Identifier
  in SVersion: Long Integer
  local S: PortShift
  local Event: PortEvent
  local WorkflowEmpty2: PortEvent
  if not (GetUserId() <> NullIdentifier()):  # CheckGetUserId
    raise PortRuleViolation("Authentication required")
  if not (CheckPortOperatorRole(GetUserId())):  # CheckCheckPortOperatorRole
    raise PortRuleViolation("Role required")
  if not (Tenant <> ""):  # CheckTenant
    raise PortRuleViolation("Business context rejected")
  GetPortShiftForUpdate = GetPortShiftForUpdate(Id=SId)
  assign  # SetS
    S = GetPortShiftForUpdate.Record.PortShift
  if not (S.Tenant = Tenant):  # CheckSTenant
    raise PortRuleViolation("Record outside requested scope")
  if not (S.Version = SVersion):  # CheckSVersion
    raise PortRuleViolation("Record changed; reload before editing")
  if not (S.State = "Scheduled" and S.Assigned = 0):  # CheckSState
    raise PortRuleViolation("Unused")
  if not (Length(Reason) >= 10):  # CheckLength
    raise PortRuleViolation("Reasoned")
  assign  # SetSState
    S.State = "Cancelled"
    S.UpdatedOn = CurrDateTime()
    S.Version = S.Version + 1
  UpdatePortShift = UpdatePortShift(Source=S)
  assign  # SetEvent
    Event = WorkflowEmpty2
  assign  # SetEventTenant
    Event.Tenant = Tenant
    Event.Kind = "ShiftCancelled"
    Event.Body = S.Code + Reason
    Event.Severity = 2
    Event.CreatedBy = GetUserId()
    Event.UpdatedOn = CurrDateTime()
    Event.CreatedOn = CurrDateTime()
    Event.Version = 1
  CreatePortEvent = CreatePortEvent(Source=Event)
  assign  # SetEventId
    Event.Id = CreatePortEvent.Id
  end

/// ssam-rule-map:{"CheckGetUserId":"Rule_Authenticated_6ab694","CheckCheckPortOperatorRole":"Rule_AuthorizedRole_d1cdc5","CheckTenant":"Rule_AuthorizedScope0_29e52c","GetPortShift":"Rule_QueryShifts_query_6b1472","CheckGetPortShiftCount":"Rule_QueryShifts_complete_f77ceb","SetShifts":"Rule_QueryShifts_list_c5666e","CheckUntil":"Rule_Window_19734a","SetWorkers":"Rule_Count_seed_98fb5e","ForEachShifts":"Rule_Count_each_7cdbc1","SetWorkflowAccumulator2":"Rule_Count_each_Count_prior_59318b","SetWorkers2":"Rule_Count_each_Count_step_05a733"}
server action PortShiftCoverage public
  in Tenant: Text
  in From: Date Time
  in Until: Date Time
  out Workers: Integer
  out Qualified: Integer
  out Free: Integer
  local Shifts: PortShift List
  local WorkflowAccumulator2: Integer
  local WorkflowAccumulator3: Integer
  local WorkflowAccumulator4: Integer
  if not (GetUserId() <> NullIdentifier()):  # CheckGetUserId
    raise PortRuleViolation("Authentication required")
  if not (CheckPortOperatorRole(GetUserId())):  # CheckCheckPortOperatorRole
    raise PortRuleViolation("Role required")
  if not (Tenant <> ""):  # CheckTenant
    raise PortRuleViolation("Business context rejected")
  GetPortShift = aggregate FROM PortShift WHERE (PortShift.Tenant = Tenant and PortShift.State = "Active" and PortShift.StartsAt <= From and PortShift.EndsAt >= Until) MAX 1000
  if not (GetPortShift.Count <= 1000):  # CheckGetPortShiftCount
    raise PortRuleViolation("Result exceeds declared limit")
  assign  # SetShifts
    Shifts = GetPortShift.List
  if not (Until > From):  # CheckUntil
    raise PortRuleViolation("Window")
  assign  # SetWorkers
    Workers = 0
    Qualified = 0
    Free = 0
  foreach Shifts:  # ForEachShifts @ruleNew1
    assign  # SetWorkflowAccumulator2
      WorkflowAccumulator2 = Workers
      WorkflowAccumulator3 = Qualified
      WorkflowAccumulator4 = Free
    assign  # SetWorkers2
      Workers = WorkflowAccumulator2 + Shifts.Current.Workers
      Qualified = WorkflowAccumulator3 + Shifts.Current.Qualified
      Free = WorkflowAccumulator4 + Max(0, Shifts.Current.Qualified - Shifts.Current.Assigned)
    next
  end

/// ssam-rule-map:{"CheckGetUserId":"Rule_Authenticated_6ab694","CheckCheckPortOperatorRole":"Rule_AuthorizedRole_d1cdc5","CheckTenant":"Rule_AuthorizedScope0_29e52c","GetPortShift":"Rule_LoadS_fetch_1b918b","SetS":"Rule_LoadS_record_6ce382","CheckSTenant":"Rule_LoadS_scope0_753217","CheckSWorkers":"Rule_Measured_9298c8","ChooseOutcome":"Rule_Result_6e7d50","SetRisk":"Rule_Result_case0_903428","SetRisk2":"Rule_Result_case1_f66f80","SetRisk3":"Rule_Result_otherwise_0c31b1"}
server action PortEvaluateFatigue public
  in Tenant: Text
  in SId: PortShift Identifier
  out Risk: Text
  out Utilization: Decimal
  local S: PortShift
  if not (GetUserId() <> NullIdentifier()):  # CheckGetUserId
    raise PortRuleViolation("Authentication required")
  if not (CheckPortOperatorRole(GetUserId())):  # CheckCheckPortOperatorRole
    raise PortRuleViolation("Role required")
  if not (Tenant <> ""):  # CheckTenant
    raise PortRuleViolation("Business context rejected")
  GetPortShift = GetPortShift(Id=SId)
  assign  # SetS
    S = GetPortShift.Record.PortShift
  if not (S.Tenant = Tenant):  # CheckSTenant
    raise PortRuleViolation("Record outside requested scope")
  if not (S.Workers > 0):  # CheckSWorkers
    raise PortRuleViolation("Measured")
  switch:  # ChooseOutcome
    case S.RestHours < 11 or S.Overtime > S.MaxOvertime:
      assign  # SetRisk
        Risk = "Stop"
        Utilization = S.Assigned * 100 / S.Workers
      end
    case S.Overtime > S.MaxOvertime * 0.8:
      assign  # SetRisk2
        Risk = "Warning"
        Utilization = S.Assigned * 100 / S.Workers
      end
    otherwise:
      assign  # SetRisk3
        Risk = "Normal"
        Utilization = S.Assigned * 100 / S.Workers
      end

/// ssam-rule-map:{"CheckGetUserId":"Rule_Authenticated_6ab694","CheckCheckPortOperatorRole":"Rule_AuthorizedRole_d1cdc5","CheckTenant":"Rule_AuthorizedScope0_29e52c","GetPortShiftForUpdate":"Rule_LoadS_fetch_1b918b","SetS":"Rule_LoadS_record_6ce382","CheckSTenant":"Rule_LoadS_scope0_753217","CheckSVersion":"Rule_LoadS_version_aa9303","CheckLength":"Rule_Evidence_03867a","CheckQualified":"Rule_WithinTeam_0978fb","SetSQualified":"Rule_Set_values_d014af","UpdatePortShift":"Rule_Set_persist_0167ba"}
server action PortRecordQualification public
  in Tenant: Text
  in Qualified: Integer
  in Evidence: Text
  in SId: PortShift Identifier
  in SVersion: Long Integer
  local S: PortShift
  if not (GetUserId() <> NullIdentifier()):  # CheckGetUserId
    raise PortRuleViolation("Authentication required")
  if not (CheckPortOperatorRole(GetUserId())):  # CheckCheckPortOperatorRole
    raise PortRuleViolation("Role required")
  if not (Tenant <> ""):  # CheckTenant
    raise PortRuleViolation("Business context rejected")
  GetPortShiftForUpdate = GetPortShiftForUpdate(Id=SId)
  assign  # SetS
    S = GetPortShiftForUpdate.Record.PortShift
  if not (S.Tenant = Tenant):  # CheckSTenant
    raise PortRuleViolation("Record outside requested scope")
  if not (S.Version = SVersion):  # CheckSVersion
    raise PortRuleViolation("Record changed; reload before editing")
  if not (Length(Evidence) >= 8):  # CheckLength
    raise PortRuleViolation("Evidence")
  if not (Qualified >= S.Assigned and Qualified <= S.Workers and Qualified >= 0):  # CheckQualified
    raise PortRuleViolation("WithinTeam")
  assign  # SetSQualified
    S.Qualified = Qualified
    S.UpdatedOn = CurrDateTime()
    S.Version = S.Version + 1
  UpdatePortShift = UpdatePortShift(Source=S)
  end

/// ssam-rule-map:{"CheckGetUserId":"Rule_Authenticated_6ab694","CheckCheckPortOperatorRole":"Rule_AuthorizedRole_d1cdc5","CheckTenant":"Rule_AuthorizedScope0_29e52c","GetPortInspectionForUpdate":"Rule_LoadI_fetch_0a9d14","SetI":"Rule_LoadI_record_cde031","CheckITenant":"Rule_LoadI_scope0_29169e","CheckIVersion":"Rule_LoadI_version_740330","CheckIInspectorId":"Rule_Owner_4b1b8a","CheckIState":"Rule_Draft_ebf12e","CheckMajor":"Rule_Valid_f51622","SetIMajorDefects":"Rule_Submit_values_624b3d","UpdatePortInspection":"Rule_Submit_persist_0612b1"}
server action PortSubmitInspection public
  in Tenant: Text
  in Major: Integer
  in Minor: Integer
  in Evidence: Text
  in IId: PortInspection Identifier
  in IVersion: Long Integer
  local I: PortInspection
  if not (GetUserId() <> NullIdentifier()):  # CheckGetUserId
    raise PortRuleViolation("Authentication required")
  if not (CheckPortOperatorRole(GetUserId())):  # CheckCheckPortOperatorRole
    raise PortRuleViolation("Role required")
  if not (Tenant <> ""):  # CheckTenant
    raise PortRuleViolation("Business context rejected")
  GetPortInspectionForUpdate = GetPortInspectionForUpdate(Id=IId)
  assign  # SetI
    I = GetPortInspectionForUpdate.Record.PortInspection
  if not (I.Tenant = Tenant):  # CheckITenant
    raise PortRuleViolation("Record outside requested scope")
  if not (I.Version = IVersion):  # CheckIVersion
    raise PortRuleViolation("Record changed; reload before editing")
  if not (I.InspectorId = GetUserId()):  # CheckIInspectorId
    raise PortRuleViolation("Owner")
  if not (I.State = "Draft"):  # CheckIState
    raise PortRuleViolation("Draft")
  if not (Major >= 0 and Minor >= 0 and Length(Evidence) >= 10):  # CheckMajor
    raise PortRuleViolation("Valid")
  assign  # SetIMajorDefects
    I.MajorDefects = Major
    I.MinorDefects = Minor
    I.Score = Max(0, 100 - Major * 20 - Minor * 3)
    I.Evidence = Evidence
    I.State = "Submitted"
    I.UpdatedOn = CurrDateTime()
    I.Version = I.Version + 1
  UpdatePortInspection = UpdatePortInspection(Source=I)
  end

/// ssam-rule-map:{"CheckGetUserId":"Rule_Authenticated_6ab694","CheckCheckPortOperatorRole":"Rule_AuthorizedRole_d1cdc5","CheckTenant":"Rule_AuthorizedScope0_29e52c","GetPortInspectionForUpdate":"Rule_LoadI_fetch_0a9d14","SetI":"Rule_LoadI_record_cde031","CheckITenant":"Rule_LoadI_scope0_29169e","CheckIVersion":"Rule_LoadI_version_740330","CheckIState":"Rule_Submitted_649004","CheckIInspectorId":"Rule_Independent_6cbf06","SetIState":"Rule_Approve_values_b86499","UpdatePortInspection":"Rule_Approve_persist_b4a05b"}
server action PortApproveInspection public
  in Tenant: Text
  in IId: PortInspection Identifier
  in IVersion: Long Integer
