  end

/// ssam-rule-map:{"CheckGetUserId":"Rule_Authenticated_6ab694","CheckCheckPortOperatorRole":"Rule_AuthorizedRole_d1cdc5","CheckTenant":"Rule_AuthorizedScope0_29e52c","GetPortInspectionForUpdate":"Rule_LoadI_fetch_0a9d14","SetI":"Rule_LoadI_record_cde031","CheckITenant":"Rule_LoadI_scope0_29169e","CheckIVersion":"Rule_LoadI_version_740330","CheckIInspectorId":"Rule_Independent_6cbf06","CheckIState":"Rule_Submitted_649004","SetIState":"Rule_Reject_values_d69523","UpdatePortInspection":"Rule_Reject_persist_c05ce5","SetEvent":"Rule_Audit_reset_f0a34c","SetEventTenant":"Rule_Audit_values_c5f614","CreatePortEvent":"Rule_Audit_persist_225f32","SetEventId":"Rule_Audit_identity_dd9ab7"}
server action PortRejectInspection public
  in Tenant: Text
  in Reason: Text
