  TransitionReleaseChangeStatePersist = UpdateNvSpare(Source=Sp)
  end

/// ssam-rule-map:{"CheckGetUserId":"Rule_Authenticated_6ab694","ValidateAmount":"Rule_ValidateParameterAmount_7570ef","GetNvSpareForUpdate":"Rule_LoadSp_fetch_063496","SetSp":"Rule_LoadSp_record_59e09c","CheckSpCreatedBy":"Rule_LoadSp_scope0_a93267","CheckSpVersion":"Rule_LoadSp_version_007b44","CheckAmount":"Rule_checkVendorPrice_48b772","SetSpUnitCost":"Rule_updatePrice_values_e52bd5","UpdateNvSpare":"Rule_updatePrice_persist_240fe9","SetValuation":"Rule_createValuation_reset_4117cd","SetValuationParentId":"Rule_createValuation_values_952028","CreateNvSpareValuation":"Rule_createValuation_persist_b713eb","SetValuationId":"Rule_createValuation_identity_d903dc"}
server action RevalueNvSpare
