  GetNvShiftAssessment = aggregate FROM NvShiftAssessment WHERE (NvShiftAssessment.ParentId = Sh.Id) MAX 300
  if not (GetNvShiftAssessment.Count <= 300):  # CheckGetNvShiftAssessmentCount
    raise NvRuleViolation("Result exceeds declared limit")
  assign  # SetResultsRows
    ResultsRows = GetNvShiftAssessment.List
  assign  # SetPoints
    Points = 0
    Failures = 0
  foreach ResultsRows:  # ForEachResultsRows @ruleNew1
    assign  # SetPoints2
