/// ssam-rule-map:{"CheckGetUserId":"Rule_Authenticated_6ab694","GetNvTraining":"Rule_LoadTr_fetch_26d9ec","SetTr":"Rule_LoadTr_record_0456e6","CheckTrCreatedBy":"Rule_LoadTr_scope0_414f28","GetNvTrainingSession":"Rule_QuerySeatsRows_query_c27141","CheckGetNvTrainingSessionCount":"Rule_QuerySeatsRows_complete_8cf88b","SetSeatsRows":"Rule_QuerySeatsRows_list_880721","SetCapacity":"Rule_SummarizeSeats_seed_aab426","ForEachSeatsRows":"Rule_SummarizeSeats_each_2b2db3","SetCapacity2":"Rule_SummarizeSeats_each_SummarizeSeats_75fd21","SetCapacity3":"Rule_ReturnSeats_ada0d7"}
server action ForecastNvTrainingSeats
  in TrId: NvTraining Identifier
  out Capacity: Decimal
  out Sessions: Long Integer
  local Tr: NvTraining
  local SeatsRows: NvTrainingSession List
  if not (GetUserId() <> NullIdentifier()):  # CheckGetUserId
    raise NvRuleViolation("Authentication required")
  GetNvTraining = GetNvTraining(Id=TrId)
  assign  # SetTr
    Tr = GetNvTraining.Record.NvTraining
  if not (Tr.CreatedBy = GetUserId()):  # CheckTrCreatedBy
    raise NvRuleViolation("Record outside requested scope")
  GetNvTrainingSession = aggregate FROM NvTrainingSession WHERE (NvTrainingSession.ParentId = Tr.Id) MAX 300
  if not (GetNvTrainingSession.Count <= 300):  # CheckGetNvTrainingSessionCount
    raise NvRuleViolation("Result exceeds declared limit")
  assign  # SetSeatsRows
    SeatsRows = GetNvTrainingSession.List
  assign  # SetCapacity
    Capacity = 0
    Sessions = 0
  foreach SeatsRows:  # ForEachSeatsRows @ruleNew1
    assign  # SetCapacity2
      Capacity = Capacity + (SeatsRows.Current.Capacity)
      Sessions = Sessions + 1
    next
  assign  # SetCapacity3
    Capacity = Capacity
    Sessions = Sessions
  end

/// ssam-rule-map:{"CheckGetUserId":"Rule_Authenticated_6ab694","GetNvTraining":"Rule_LoadTr_fetch_26d9ec","SetTr":"Rule_LoadTr_record_0456e6","CheckTrCreatedBy":"Rule_LoadTr_scope0_414f28","GetNvTrainingAssessment":"Rule_QueryOutcomesRows_query_36dd52","CheckGetNvTrainingAssessmentCount":"Rule_QueryOutcomesRows_complete_5c6352","SetOutcomesRows":"Rule_QueryOutcomesRows_list_b408bb","SetPoints":"Rule_SummarizeOutcomes_seed_fbd459","ForEachOutcomesRows":"Rule_SummarizeOutcomes_each_70c3ec","SetPoints2":"Rule_SummarizeOutcomes_each_SummarizeOu_677278","SetPoints3":"Rule_ReturnOutcomes_9c8f65"}
server action ReviewNvTrainingOutcomes
  in TrId: NvTraining Identifier
  out Points: Decimal
  out Passing: Long Integer
  local Tr: NvTraining
  local OutcomesRows: NvTrainingAssessment List
  if not (GetUserId() <> NullIdentifier()):  # CheckGetUserId
    raise NvRuleViolation("Authentication required")
  GetNvTraining = GetNvTraining(Id=TrId)
  assign  # SetTr
    Tr = GetNvTraining.Record.NvTraining
  if not (Tr.CreatedBy = GetUserId()):  # CheckTrCreatedBy
    raise NvRuleViolation("Record outside requested scope")
  GetNvTrainingAssessment = aggregate FROM NvTrainingAssessment WHERE (NvTrainingAssessment.ParentId = Tr.Id) MAX 400
  if not (GetNvTrainingAssessment.Count <= 400):  # CheckGetNvTrainingAssessmentCount
    raise NvRuleViolation("Result exceeds declared limit")
  assign  # SetOutcomesRows
    OutcomesRows = GetNvTrainingAssessment.List
  assign  # SetPoints
    Points = 0
    Passing = 0
  foreach OutcomesRows:  # ForEachOutcomesRows @ruleNew1
    assign  # SetPoints2
      Points = Points + (OutcomesRows.Current.Points)
      Passing = Passing + If(OutcomesRows.Current.Passed, 1, 0)
    next
  assign  # SetPoints3
    Points = Points
    Passing = Passing
  end

