  in Note: Text
  in CaId: NvCargo Identifier
  in CaVersion: Long Integer
  local Ca: NvCargo
  local Movement: NvCargoMovement
  local WorkflowEmpty2: NvCargoMovement
  if not (GetUserId() <> NullIdentifier()):  # CheckGetUserId
    raise NvRuleViolation("Authentication required")
  if not ((Qty <= 10000) and (Qty > 0)):  # ValidateQty
