/// ssam-rule-map:{"CheckGetUserId":"Rule_Authenticated_6ab694","GetNvLeave":"Rule_LoadLe_fetch_b616d8","SetLe":"Rule_LoadLe_record_83101e","CheckLeCreatedBy":"Rule_LoadLe_scope0_bf1c7d","GetNvLeaveParticipant":"Rule_QueryApprovalsRows_query_3131ca","CheckGetNvLeaveParticipantCount":"Rule_QueryApprovalsRows_complete_0f5a34","SetApprovalsRows":"Rule_QueryApprovalsRows_list_7ef373","SetApproved":"Rule_SummarizeApprovals_seed_e5b4de","ForEachApprovalsRows":"Rule_SummarizeApprovals_each_c546f5","SetApproved2":"Rule_SummarizeApprovals_each_SummarizeA_33a280","SetApproved3":"Rule_ReturnApprovals_a6c7de"}
server action ForecastNvLeaveApprovals
  in LeId: NvLeave Identifier
  out Approved: Long Integer
  out Awaiting: Long Integer
  local Le: NvLeave
  local ApprovalsRows: NvLeaveParticipant List
  if not (GetUserId() <> NullIdentifier()):  # CheckGetUserId
    raise NvRuleViolation("Authentication required")
  GetNvLeave = GetNvLeave(Id=LeId)
  assign  # SetLe
    Le = GetNvLeave.Record.NvLeave
  if not (Le.CreatedBy = GetUserId()):  # CheckLeCreatedBy
    raise NvRuleViolation("Record outside requested scope")
  GetNvLeaveParticipant = aggregate FROM NvLeaveParticipant WHERE (NvLeaveParticipant.ParentId = Le.Id) MAX 300
  if not (GetNvLeaveParticipant.Count <= 300):  # CheckGetNvLeaveParticipantCount
    raise NvRuleViolation("Result exceeds declared limit")
  assign  # SetApprovalsRows
    ApprovalsRows = GetNvLeaveParticipant.List
  assign  # SetApproved
    Approved = 0
    Awaiting = 0
  foreach ApprovalsRows:  # ForEachApprovalsRows @ruleNew1
    assign  # SetApproved2
      Approved = Approved + If(ApprovalsRows.Current.Confirmed, 1, 0)
      Awaiting = Awaiting + If(not ApprovalsRows.Current.Confirmed, 1, 0)
    next
  assign  # SetApproved3
    Approved = Approved
    Awaiting = Awaiting
  end

/// ssam-rule-map:{"CheckGetUserId":"Rule_Authenticated_6ab694","GetNvLeave":"Rule_LoadLe_fetch_b616d8","SetLe":"Rule_LoadLe_record_83101e","CheckLeCreatedBy":"Rule_LoadLe_scope0_bf1c7d","GetNvLeaveAttendance":"Rule_QueryAbsenceRows_query_168397","CheckGetNvLeaveAttendanceCount":"Rule_QueryAbsenceRows_complete_c9422f","SetAbsenceRows":"Rule_QueryAbsenceRows_list_fe56db","SetExcusedMinutes":"Rule_SummarizeAbsence_seed_9b956c","ForEachAbsenceRows":"Rule_SummarizeAbsence_each_86a0e5","SetExcusedMinutes2":"Rule_SummarizeAbsence_each_SummarizeAbs_b448b2","SetExcusedMinutes3":"Rule_ReturnAbsence_c76705"}
server action ReviewNvLeaveAttendance
