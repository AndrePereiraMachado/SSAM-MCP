  GetNvAuditAssignment = aggregate FROM NvAuditAssignment WHERE (NvAuditAssignment.ParentId = A.Id) MAX 300
  if not (GetNvAuditAssignment.Count <= 300):  # CheckGetNvAuditAssignmentCount
