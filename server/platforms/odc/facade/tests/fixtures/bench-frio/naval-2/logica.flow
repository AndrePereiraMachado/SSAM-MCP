/// ssam-rule-map:{"CheckGetUserId":"Rule_Authenticated_6ab694","ValidateNote":"Rule_ValidateParameterNote_55075f","GetNvSurveyForUpdate":"Rule_LoadS_fetch_1b918b","SetS":"Rule_LoadS_record_6ce382","CheckSCreatedBy":"Rule_LoadS_scope0_753217","CheckSVersion":"Rule_LoadS_version_aa9303","CheckSScore":"Rule_checkCoverage_a7e6f2","TransitionArchiveAllowedState":"Rule_transitionArchive_allowed_1b8dc3","TransitionArchiveChangeStateValues":"Rule_transitionArchive_change_values_639569","TransitionArchiveChangeStatePersist":"Rule_transitionArchive_change_persist_5f5518","SetDecision":"Rule_createDecision_reset_caa0de","SetDecisionParentId":"Rule_createDecision_values_0b035a","CreateNvSurveyDecision":"Rule_createDecision_persist_72b848","SetDecisionId":"Rule_createDecision_identity_5aff2d"}
server action ArchiveNvSurvey
  in Note: Text
  in SId: NvSurvey Identifier
  in SVersion: Long Integer
  local S: NvSurvey
  local Decision: NvSurveyDecision
  local WorkflowEmpty2: NvSurveyDecision
  if not (GetUserId() <> NullIdentifier()):  # CheckGetUserId
    raise NvRuleViolation("Authentication required")
  if not ((Trim(Note) <> "") and (Length(Note) >= 5) and (Length(Note) <= 500)):  # ValidateNote
    raise NvRuleViolation("Invalid Note")
  GetNvSurveyForUpdate = GetNvSurveyForUpdate(Id=SId)
  assign  # SetS
    S = GetNvSurveyForUpdate.Record.NvSurvey
  if not (S.CreatedBy = GetUserId()):  # CheckSCreatedBy
    raise NvRuleViolation("Record outside requested scope")
  if not (S.Version = SVersion):  # CheckSVersion
    raise NvRuleViolation("Record changed; reload before editing")
  if not (S.Score >= S.Limit*0.9):  # CheckSScore
    raise NvRuleViolation("checkCoverage")
  if not ((S.StateId = Entities.NvSurveyState.Reviewed)):  # TransitionArchiveAllowedState
    raise NvRuleViolation("transitionArchive: state transition not allowed")
  assign  # TransitionArchiveChangeStateValues
    S.Closed = True
    S.StateId = Entities.NvSurveyState.Closed
    S.UpdatedOn = CurrDateTime()
    S.Version = S.Version + 1
  TransitionArchiveChangeStatePersist = UpdateNvSurvey(Source=S)
  assign  # SetDecision
    Decision = WorkflowEmpty2
  assign  # SetDecisionParentId
    Decision.ParentId = S.Id
    Decision.Reason = Note
    Decision.Approved = True
    Decision.DecidedOn = CurrDateTime()
    Decision.UpdatedOn = CurrDateTime()
    Decision.CreatedOn = CurrDateTime()
    Decision.Version = 1
  CreateNvSurveyDecision = CreateNvSurveyDecision(Source=Decision)
  assign  # SetDecisionId
    Decision.Id = CreateNvSurveyDecision.Id
  end

/// ssam-rule-map:{"CheckGetUserId":"Rule_Authenticated_6ab694","GetNvSurvey":"Rule_LoadS_fetch_1b918b","SetS":"Rule_LoadS_record_6ce382","CheckSCreatedBy":"Rule_LoadS_scope0_753217","GetNvSurveyAssignment":"Rule_QueryEffortRows_query_5e39f6","CheckGetNvSurveyAssignmentCount":"Rule_QueryEffortRows_complete_cb3d47","SetEffortRows":"Rule_QueryEffortRows_list_977060","SetFutureHours":"Rule_SummarizeEffort_seed_8e749c","ForEachEffortRows":"Rule_SummarizeEffort_each_4a97c2","SetFutureHours2":"Rule_SummarizeEffort_each_SummarizeEffo_72caf6","SetFutureHours3":"Rule_ReturnEffort_dc629b"}
server action EstimateNvSurveyEffort
  in SId: NvSurvey Identifier
  out FutureHours: Decimal
  out Assignments: Long Integer
  local S: NvSurvey
  local EffortRows: NvSurveyAssignment List
  if not (GetUserId() <> NullIdentifier()):  # CheckGetUserId
    raise NvRuleViolation("Authentication required")
  GetNvSurvey = GetNvSurvey(Id=SId)
  assign  # SetS
    S = GetNvSurvey.Record.NvSurvey
  if not (S.CreatedBy = GetUserId()):  # CheckSCreatedBy
    raise NvRuleViolation("Record outside requested scope")
  GetNvSurveyAssignment = aggregate FROM NvSurveyAssignment WHERE (NvSurveyAssignment.ParentId = S.Id) MAX 200
  if not (GetNvSurveyAssignment.Count <= 200):  # CheckGetNvSurveyAssignmentCount
    raise NvRuleViolation("Result exceeds declared limit")
  assign  # SetEffortRows
    EffortRows = GetNvSurveyAssignment.List
  assign  # SetFutureHours
    FutureHours = 0
    Assignments = 0
  foreach EffortRows:  # ForEachEffortRows @ruleNew1
    assign  # SetFutureHours2
      FutureHours = FutureHours + (If(EffortRows.Current.DueOn >= CurrDate(),EffortRows.Current.Hours,0))
      Assignments = Assignments + 1
    next
  assign  # SetFutureHours3
    FutureHours = FutureHours
    Assignments = Assignments
  end

/// ssam-rule-map:{"CheckGetUserId":"Rule_Authenticated_6ab694","GetNvSurvey":"Rule_LoadS_fetch_1b918b","SetS":"Rule_LoadS_record_6ce382","CheckSCreatedBy":"Rule_LoadS_scope0_753217","GetNvSurveyDecision":"Rule_QueryDecisionsRows_query_c9ef9f","CheckGetNvSurveyDecisionCount":"Rule_QueryDecisionsRows_complete_d25b33","SetDecisionsRows":"Rule_QueryDecisionsRows_list_3858aa","SetApproved":"Rule_SummarizeDecisions_seed_1b0be7","ForEachDecisionsRows":"Rule_SummarizeDecisions_each_673983","SetApproved2":"Rule_SummarizeDecisions_each_SummarizeD_001011","SetApproved3":"Rule_ReturnDecisions_d988d5"}
server action ReviewNvSurveyDecisions
  in SId: NvSurvey Identifier
  out Approved: Long Integer
  out Rejected: Long Integer
  local S: NvSurvey
  local DecisionsRows: NvSurveyDecision List
  if not (GetUserId() <> NullIdentifier()):  # CheckGetUserId
    raise NvRuleViolation("Authentication required")
  GetNvSurvey = GetNvSurvey(Id=SId)
  assign  # SetS
    S = GetNvSurvey.Record.NvSurvey
  if not (S.CreatedBy = GetUserId()):  # CheckSCreatedBy
    raise NvRuleViolation("Record outside requested scope")
  GetNvSurveyDecision = aggregate FROM NvSurveyDecision WHERE (NvSurveyDecision.ParentId = S.Id) MAX 100
  if not (GetNvSurveyDecision.Count <= 100):  # CheckGetNvSurveyDecisionCount
    raise NvRuleViolation("Result exceeds declared limit")
  assign  # SetDecisionsRows
    DecisionsRows = GetNvSurveyDecision.List
  assign  # SetApproved
    Approved = 0
    Rejected = 0
  foreach DecisionsRows:  # ForEachDecisionsRows @ruleNew1
    assign  # SetApproved2
      Approved = Approved + If(DecisionsRows.Current.Approved, 1, 0)
      Rejected = Rejected + If(not DecisionsRows.Current.Approved, 1, 0)
    next
  assign  # SetApproved3
    Approved = Approved
    Rejected = Rejected
  end

/// ssam-rule-map:{"CheckGetUserId":"Rule_Authenticated_6ab694","GetNvCertificationForUpdate":"Rule_LoadC_fetch_e1b659","SetC":"Rule_LoadC_record_8a1990","CheckCCreatedBy":"Rule_LoadC_scope0_da3cb1","CheckCVersion":"Rule_LoadC_version_0eeb8c","CheckCDueOn":"Rule_checkEligible_e94b49","TransitionStartAllowedState":"Rule_transitionStart_allowed_f925e6","TransitionStartChangeStateValues":"Rule_transitionStart_change_values_c8305d","TransitionStartChangeStatePersist":"Rule_transitionStart_change_persist_824312"}
server action StartNvCertificationReview
  in CId: NvCertification Identifier
  in CVersion: Long Integer
  local C: NvCertification
  if not (GetUserId() <> NullIdentifier()):  # CheckGetUserId
    raise NvRuleViolation("Authentication required")
  GetNvCertificationForUpdate = GetNvCertificationForUpdate(Id=CId)
  assign  # SetC
    C = GetNvCertificationForUpdate.Record.NvCertification
  if not (C.CreatedBy = GetUserId()):  # CheckCCreatedBy
    raise NvRuleViolation("Record outside requested scope")
  if not (C.Version = CVersion):  # CheckCVersion
    raise NvRuleViolation("Record changed; reload before editing")
  if not (C.DueOn >= CurrDate() and not C.Closed):  # CheckCDueOn
    raise NvRuleViolation("checkEligible")
  if not ((C.StateId = Entities.NvCertificationState.Draft) or (C.StateId = Entities.NvCertificationState.Scheduled)):  # TransitionStartAllowedState
    raise NvRuleViolation("transitionStart: state transition not allowed")
  assign  # TransitionStartChangeStateValues
    C.StateId = Entities.NvCertificationState.Reviewed
    C.UpdatedOn = CurrDateTime()
    C.Version = C.Version + 1
  TransitionStartChangeStatePersist = UpdateNvCertification(Source=C)
  end

/// ssam-rule-map:{"CheckGetUserId":"Rule_Authenticated_6ab694","ValidateNote":"Rule_ValidateParameterNote_55075f","GetNvCertificationForUpdate":"Rule_LoadC_fetch_e1b659","SetC":"Rule_LoadC_record_8a1990","CheckCCreatedBy":"Rule_LoadC_scope0_da3cb1","CheckCVersion":"Rule_LoadC_version_0eeb8c","CheckCScore":"Rule_checkMissing_6a7e61","TransitionRejectAllowedState":"Rule_transitionReject_allowed_8011a2","TransitionRejectChangeStateValues":"Rule_transitionReject_change_values_64bfda","TransitionRejectChangeStatePersist":"Rule_transitionReject_change_persist_5271c2","SetDecision":"Rule_createDecision_reset_caa0de","SetDecisionParentId":"Rule_createDecision_values_0b035a","CreateNvCertificationDecision":"Rule_createDecision_persist_72b848","SetDecisionId":"Rule_createDecision_identity_5aff2d"}
server action RejectNvCertificationReview
  in Note: Text
  in CId: NvCertification Identifier
  in CVersion: Long Integer
  local C: NvCertification
  local Decision: NvCertificationDecision
  local WorkflowEmpty2: NvCertificationDecision
  if not (GetUserId() <> NullIdentifier()):  # CheckGetUserId
    raise NvRuleViolation("Authentication required")
  if not ((Trim(Note) <> "") and (Length(Note) >= 5) and (Length(Note) <= 500)):  # ValidateNote
    raise NvRuleViolation("Invalid Note")
  GetNvCertificationForUpdate = GetNvCertificationForUpdate(Id=CId)
  assign  # SetC
    C = GetNvCertificationForUpdate.Record.NvCertification
  if not (C.CreatedBy = GetUserId()):  # CheckCCreatedBy
    raise NvRuleViolation("Record outside requested scope")
  if not (C.Version = CVersion):  # CheckCVersion
    raise NvRuleViolation("Record changed; reload before editing")
  if not (C.Score < 90):  # CheckCScore
    raise NvRuleViolation("checkMissing")
  if not ((C.StateId = Entities.NvCertificationState.Reviewed)):  # TransitionRejectAllowedState
    raise NvRuleViolation("transitionReject: state transition not allowed")
  assign  # TransitionRejectChangeStateValues
    C.Closed = False
    C.StateId = Entities.NvCertificationState.Scheduled
    C.UpdatedOn = CurrDateTime()
    C.Version = C.Version + 1
  TransitionRejectChangeStatePersist = UpdateNvCertification(Source=C)
  assign  # SetDecision
    Decision = WorkflowEmpty2
  assign  # SetDecisionParentId
    Decision.ParentId = C.Id
    Decision.Reason = Note
    Decision.Approved = False
    Decision.DecidedOn = CurrDateTime()
    Decision.UpdatedOn = CurrDateTime()
    Decision.CreatedOn = CurrDateTime()
    Decision.Version = 1
  CreateNvCertificationDecision = CreateNvCertificationDecision(Source=Decision)
  assign  # SetDecisionId
    Decision.Id = CreateNvCertificationDecision.Id
  end

/// ssam-rule-map:{"CheckGetUserId":"Rule_Authenticated_6ab694","ValidateNote":"Rule_ValidateParameterNote_55075f","GetNvCertificationForUpdate":"Rule_LoadC_fetch_e1b659","SetC":"Rule_LoadC_record_8a1990","CheckCCreatedBy":"Rule_LoadC_scope0_da3cb1","CheckCVersion":"Rule_LoadC_version_0eeb8c","CheckCScore":"Rule_checkPassing_58fb50","TransitionSealAllowedState":"Rule_transitionSeal_allowed_aa64e3","TransitionSealChangeStateValues":"Rule_transitionSeal_change_values_21d0d5","TransitionSealChangeStatePersist":"Rule_transitionSeal_change_persist_166a75","SetDecision":"Rule_createDecision_reset_caa0de","SetDecisionParentId":"Rule_createDecision_values_0b035a","CreateNvCertificationDecision":"Rule_createDecision_persist_72b848","SetDecisionId":"Rule_createDecision_identity_5aff2d"}
server action SealNvCertification
  in Note: Text
  in CId: NvCertification Identifier
  in CVersion: Long Integer
  local C: NvCertification
  local Decision: NvCertificationDecision
  local WorkflowEmpty2: NvCertificationDecision
  if not (GetUserId() <> NullIdentifier()):  # CheckGetUserId
    raise NvRuleViolation("Authentication required")
  if not ((Trim(Note) <> "") and (Length(Note) >= 5) and (Length(Note) <= 500)):  # ValidateNote
    raise NvRuleViolation("Invalid Note")
  GetNvCertificationForUpdate = GetNvCertificationForUpdate(Id=CId)
  assign  # SetC
    C = GetNvCertificationForUpdate.Record.NvCertification
  if not (C.CreatedBy = GetUserId()):  # CheckCCreatedBy
    raise NvRuleViolation("Record outside requested scope")
  if not (C.Version = CVersion):  # CheckCVersion
    raise NvRuleViolation("Record changed; reload before editing")
  if not (C.Score >= 95 and C.DueOn >= CurrDate()):  # CheckCScore
    raise NvRuleViolation("checkPassing")
  if not ((C.StateId = Entities.NvCertificationState.Reviewed)):  # TransitionSealAllowedState
    raise NvRuleViolation("transitionSeal: state transition not allowed")
  assign  # TransitionSealChangeStateValues
    C.Closed = True
    C.StateId = Entities.NvCertificationState.Closed
    C.UpdatedOn = CurrDateTime()
    C.Version = C.Version + 1
  TransitionSealChangeStatePersist = UpdateNvCertification(Source=C)
  assign  # SetDecision
    Decision = WorkflowEmpty2
  assign  # SetDecisionParentId
    Decision.ParentId = C.Id
    Decision.Reason = Note
    Decision.Approved = True
    Decision.DecidedOn = CurrDateTime()
    Decision.UpdatedOn = CurrDateTime()
    Decision.CreatedOn = CurrDateTime()
    Decision.Version = 1
  CreateNvCertificationDecision = CreateNvCertificationDecision(Source=Decision)
  assign  # SetDecisionId
    Decision.Id = CreateNvCertificationDecision.Id
  end

/// ssam-rule-map:{"CheckGetUserId":"Rule_Authenticated_6ab694","GetNvCertification":"Rule_LoadC_fetch_e1b659","SetC":"Rule_LoadC_record_8a1990","CheckCCreatedBy":"Rule_LoadC_scope0_da3cb1","GetNvCertificationAssignment":"Rule_QueryBudgetRows_query_938015","CheckGetNvCertificationAssignmentCount":"Rule_QueryBudgetRows_complete_528d73","SetBudgetRows":"Rule_QueryBudgetRows_list_91a983","SetCost":"Rule_SummarizeBudget_seed_a1c33b","ForEachBudgetRows":"Rule_SummarizeBudget_each_90bc02","SetCost2":"Rule_SummarizeBudget_each_SummarizeBudg_f227a2","SetCost3":"Rule_ReturnBudget_26a1e1"}
server action BudgetNvCertificationEffort
  in CId: NvCertification Identifier
  out Cost: Decimal
  out People: Long Integer
  local C: NvCertification
  local BudgetRows: NvCertificationAssignment List
  if not (GetUserId() <> NullIdentifier()):  # CheckGetUserId
    raise NvRuleViolation("Authentication required")
  GetNvCertification = GetNvCertification(Id=CId)
  assign  # SetC
    C = GetNvCertification.Record.NvCertification
  if not (C.CreatedBy = GetUserId()):  # CheckCCreatedBy
    raise NvRuleViolation("Record outside requested scope")
  GetNvCertificationAssignment = aggregate FROM NvCertificationAssignment WHERE (NvCertificationAssignment.ParentId = C.Id) MAX 120
  if not (GetNvCertificationAssignment.Count <= 120):  # CheckGetNvCertificationAssignmentCount
    raise NvRuleViolation("Result exceeds declared limit")
  assign  # SetBudgetRows
    BudgetRows = GetNvCertificationAssignment.List
  assign  # SetCost
    Cost = 0
    People = 0
  foreach BudgetRows:  # ForEachBudgetRows @ruleNew1
    assign  # SetCost2
      Cost = Cost + (BudgetRows.Current.Hours*120)
      People = People + 1
    next
  assign  # SetCost3
    Cost = Cost
    People = People
  end

/// ssam-rule-map:{"CheckGetUserId":"Rule_Authenticated_6ab694","GetNvCertification":"Rule_LoadC_fetch_e1b659","SetC":"Rule_LoadC_record_8a1990","CheckCCreatedBy":"Rule_LoadC_scope0_da3cb1","GetNvCertificationEvidence":"Rule_QueryFilesRows_query_0e3908","CheckGetNvCertificationEvidenceCount":"Rule_QueryFilesRows_complete_9a0239","SetFilesRows":"Rule_QueryFilesRows_list_c4b673","SetComplete":"Rule_SummarizeFiles_seed_fecbe5","ForEachFilesRows":"Rule_SummarizeFiles_each_fbe041","SetComplete2":"Rule_SummarizeFiles_each_SummarizeFiles_e37b57","SetComplete3":"Rule_ReturnFiles_47d965"}
server action InspectNvCertificationFiles
  in CId: NvCertification Identifier
  out Complete: Long Integer
  out Count: Long Integer
  local C: NvCertification
  local FilesRows: NvCertificationEvidence List
  if not (GetUserId() <> NullIdentifier()):  # CheckGetUserId
    raise NvRuleViolation("Authentication required")
  GetNvCertification = GetNvCertification(Id=CId)
  assign  # SetC
    C = GetNvCertification.Record.NvCertification
  if not (C.CreatedBy = GetUserId()):  # CheckCCreatedBy
    raise NvRuleViolation("Record outside requested scope")
  GetNvCertificationEvidence = aggregate FROM NvCertificationEvidence WHERE (NvCertificationEvidence.ParentId = C.Id) MAX 200
  if not (GetNvCertificationEvidence.Count <= 200):  # CheckGetNvCertificationEvidenceCount
    raise NvRuleViolation("Result exceeds declared limit")
  assign  # SetFilesRows
    FilesRows = GetNvCertificationEvidence.List
  assign  # SetComplete
    Complete = 0
    Count = 0
  foreach FilesRows:  # ForEachFilesRows @ruleNew1
    assign  # SetComplete2
      Complete = Complete + If(Length(Trim(FilesRows.Current.Digest)) > 0, 1, 0)
      Count = Count + 1
    next
  assign  # SetComplete3
    Complete = Complete
    Count = Count
  end

