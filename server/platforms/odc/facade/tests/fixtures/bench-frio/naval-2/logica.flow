/// ssam-rule-map:{"CheckGetUserId":"Rule_Authenticated_6ab694","GetNvInspectionForUpdate":"Rule_LoadI_fetch_0a9d14","SetI":"Rule_LoadI_record_cde031","CheckICreatedBy":"Rule_LoadI_scope0_29169e","CheckIVersion":"Rule_LoadI_version_740330","Checknot":"Rule_checkReady_298383","TransitionApproveAllowedState":"Rule_transitionApprove_allowed_7ff178","TransitionApproveChangeStateValues":"Rule_transitionApprove_change_values_b657e1","TransitionApproveChangeStatePersist":"Rule_transitionApprove_change_persist_87265c"}
server action ApproveNvInspectionPlan
  in IId: NvInspection Identifier
  in IVersion: Long Integer
  local I: NvInspection
  if not (GetUserId() <> NullIdentifier()):  # CheckGetUserId
    raise NvRuleViolation("Authentication required")
  GetNvInspectionForUpdate = GetNvInspectionForUpdate(Id=IId)
  assign  # SetI
    I = GetNvInspectionForUpdate.Record.NvInspection
  if not (I.CreatedBy = GetUserId()):  # CheckICreatedBy
    raise NvRuleViolation("Record outside requested scope")
  if not (I.Version = IVersion):  # CheckIVersion
    raise NvRuleViolation("Record changed; reload before editing")
  if not (not I.Closed and I.Limit > 0 and I.DueOn >= CurrDate()):  # Checknot
    raise NvRuleViolation("checkReady")
  if not ((I.StateId = Entities.NvInspectionState.Draft)):  # TransitionApproveAllowedState
    raise NvRuleViolation("transitionApprove: state transition not allowed")
  assign  # TransitionApproveChangeStateValues
    I.StateId = Entities.NvInspectionState.Scheduled
    I.UpdatedOn = CurrDateTime()
    I.Version = I.Version + 1
  TransitionApproveChangeStatePersist = UpdateNvInspection(Source=I)
  end

/// ssam-rule-map:{"CheckGetUserId":"Rule_Authenticated_6ab694","ValidateScoreValue":"Rule_ValidateParameterScoreValue_4664b3","GetNvInspectionForUpdate":"Rule_LoadI_fetch_0a9d14","SetI":"Rule_LoadI_record_cde031","CheckICreatedBy":"Rule_LoadI_scope0_29169e","CheckIVersion":"Rule_LoadI_version_740330","CheckScoreValue":"Rule_checkScore_b88519","TransitionReviewAllowedState":"Rule_transitionReview_allowed_afd6f4","TransitionReviewChangeStateValues":"Rule_transitionReview_change_values_eede97","TransitionReviewChangeStatePersist":"Rule_transitionReview_change_persist_9a92a5"}
server action ReviewNvInspection
  in ScoreValue: Decimal
  in IId: NvInspection Identifier
  in IVersion: Long Integer
  local I: NvInspection
  if not (GetUserId() <> NullIdentifier()):  # CheckGetUserId
    raise NvRuleViolation("Authentication required")
  if not ((ScoreValue >= 0) and (ScoreValue <= 1000)):  # ValidateScoreValue
    raise NvRuleViolation("Invalid ScoreValue")
  GetNvInspectionForUpdate = GetNvInspectionForUpdate(Id=IId)
  assign  # SetI
    I = GetNvInspectionForUpdate.Record.NvInspection
  if not (I.CreatedBy = GetUserId()):  # CheckICreatedBy
    raise NvRuleViolation("Record outside requested scope")
  if not (I.Version = IVersion):  # CheckIVersion
    raise NvRuleViolation("Record changed; reload before editing")
  if not (ScoreValue <= I.Limit):  # CheckScoreValue
    raise NvRuleViolation("checkScore")
  if not ((I.StateId = Entities.NvInspectionState.Scheduled)):  # TransitionReviewAllowedState
    raise NvRuleViolation("transitionReview: state transition not allowed")
  assign  # TransitionReviewChangeStateValues
    I.Score = ScoreValue
    I.StateId = Entities.NvInspectionState.Reviewed
    I.UpdatedOn = CurrDateTime()
    I.Version = I.Version + 1
  TransitionReviewChangeStatePersist = UpdateNvInspection(Source=I)
  end

/// ssam-rule-map:{"CheckGetUserId":"Rule_Authenticated_6ab694","ValidateNote":"Rule_ValidateParameterNote_55075f","GetNvInspectionForUpdate":"Rule_LoadI_fetch_0a9d14","SetI":"Rule_LoadI_record_cde031","CheckICreatedBy":"Rule_LoadI_scope0_29169e","CheckIVersion":"Rule_LoadI_version_740330","CheckIScore":"Rule_checkPassed_b8d6f5","TransitionArchiveAllowedState":"Rule_transitionArchive_allowed_1b8dc3","TransitionArchiveChangeStateValues":"Rule_transitionArchive_change_values_639569","TransitionArchiveChangeStatePersist":"Rule_transitionArchive_change_persist_5f5518","SetDecision":"Rule_createDecision_reset_caa0de","SetDecisionParentId":"Rule_createDecision_values_0b035a","CreateNvInspectionDecision":"Rule_createDecision_persist_72b848","SetDecisionId":"Rule_createDecision_identity_5aff2d"}
server action ArchiveNvInspection
  in Note: Text
  in IId: NvInspection Identifier
  in IVersion: Long Integer
  local I: NvInspection
  local Decision: NvInspectionDecision
  local WorkflowEmpty2: NvInspectionDecision
  if not (GetUserId() <> NullIdentifier()):  # CheckGetUserId
    raise NvRuleViolation("Authentication required")
  if not ((Trim(Note) <> "") and (Length(Note) >= 5) and (Length(Note) <= 500)):  # ValidateNote
    raise NvRuleViolation("Invalid Note")
  GetNvInspectionForUpdate = GetNvInspectionForUpdate(Id=IId)
  assign  # SetI
    I = GetNvInspectionForUpdate.Record.NvInspection
  if not (I.CreatedBy = GetUserId()):  # CheckICreatedBy
    raise NvRuleViolation("Record outside requested scope")
  if not (I.Version = IVersion):  # CheckIVersion
    raise NvRuleViolation("Record changed; reload before editing")
  if not (I.Score >= I.Limit):  # CheckIScore
    raise NvRuleViolation("checkPassed")
  if not ((I.StateId = Entities.NvInspectionState.Reviewed)):  # TransitionArchiveAllowedState
    raise NvRuleViolation("transitionArchive: state transition not allowed")
  assign  # TransitionArchiveChangeStateValues
    I.Closed = True
    I.StateId = Entities.NvInspectionState.Closed
    I.UpdatedOn = CurrDateTime()
    I.Version = I.Version + 1
  TransitionArchiveChangeStatePersist = UpdateNvInspection(Source=I)
  assign  # SetDecision
    Decision = WorkflowEmpty2
  assign  # SetDecisionParentId
    Decision.ParentId = I.Id
    Decision.Reason = Note
    Decision.Approved = True
    Decision.DecidedOn = CurrDateTime()
    Decision.UpdatedOn = CurrDateTime()
    Decision.CreatedOn = CurrDateTime()
    Decision.Version = 1
  CreateNvInspectionDecision = CreateNvInspectionDecision(Source=Decision)
  assign  # SetDecisionId
    Decision.Id = CreateNvInspectionDecision.Id
  end

/// ssam-rule-map:{"CheckGetUserId":"Rule_Authenticated_6ab694","GetNvInspection":"Rule_LoadI_fetch_0a9d14","SetI":"Rule_LoadI_record_cde031","CheckICreatedBy":"Rule_LoadI_scope0_29169e","GetNvInspectionAssignment":"Rule_QueryEffortRows_query_5e39f6","CheckGetNvInspectionAssignmentCount":"Rule_QueryEffortRows_complete_cb3d47","SetEffortRows":"Rule_QueryEffortRows_list_977060","SetHours":"Rule_SummarizeEffort_seed_8e749c","ForEachEffortRows":"Rule_SummarizeEffort_each_4a97c2","SetHours2":"Rule_SummarizeEffort_each_SummarizeEffo_72caf6","SetHours3":"Rule_ReturnEffort_dc629b"}
server action EstimateNvInspectionEffort
  in IId: NvInspection Identifier
  out Hours: Decimal
  out Overdue: Long Integer
  local I: NvInspection
  local EffortRows: NvInspectionAssignment List
  if not (GetUserId() <> NullIdentifier()):  # CheckGetUserId
    raise NvRuleViolation("Authentication required")
  GetNvInspection = GetNvInspection(Id=IId)
  assign  # SetI
    I = GetNvInspection.Record.NvInspection
  if not (I.CreatedBy = GetUserId()):  # CheckICreatedBy
    raise NvRuleViolation("Record outside requested scope")
  GetNvInspectionAssignment = aggregate FROM NvInspectionAssignment WHERE (NvInspectionAssignment.ParentId = I.Id) MAX 200
  if not (GetNvInspectionAssignment.Count <= 200):  # CheckGetNvInspectionAssignmentCount
    raise NvRuleViolation("Result exceeds declared limit")
  assign  # SetEffortRows
    EffortRows = GetNvInspectionAssignment.List
  assign  # SetHours
    Hours = 0
    Overdue = 0
  foreach EffortRows:  # ForEachEffortRows @ruleNew1
    assign  # SetHours2
      Hours = Hours + (EffortRows.Current.Hours)
      Overdue = Overdue + If(EffortRows.Current.DueOn < CurrDate(), 1, 0)
    next
  assign  # SetHours3
    Hours = Hours
    Overdue = Overdue
  end

/// ssam-rule-map:{"CheckGetUserId":"Rule_Authenticated_6ab694","GetNvInspection":"Rule_LoadI_fetch_0a9d14","SetI":"Rule_LoadI_record_cde031","CheckICreatedBy":"Rule_LoadI_scope0_29169e","GetNvInspectionEvidence":"Rule_QueryEvidenceRows_query_9e7298","CheckGetNvInspectionEvidenceCount":"Rule_QueryEvidenceRows_complete_4ec8f5","SetEvidenceRows":"Rule_QueryEvidenceRows_list_6da22b","SetFiles":"Rule_SummarizeEvidence_seed_e35c64","ForEachEvidenceRows":"Rule_SummarizeEvidence_each_5bb0fb","SetFiles2":"Rule_SummarizeEvidence_each_SummarizeEv_5feaf6","SetFiles3":"Rule_ReturnEvidence_4b8e6f"}
server action ReviewNvInspectionEvidence
  in IId: NvInspection Identifier
  out Files: Long Integer
  out Named: Long Integer
  local I: NvInspection
  local EvidenceRows: NvInspectionEvidence List
  if not (GetUserId() <> NullIdentifier()):  # CheckGetUserId
    raise NvRuleViolation("Authentication required")
  GetNvInspection = GetNvInspection(Id=IId)
  assign  # SetI
    I = GetNvInspection.Record.NvInspection
  if not (I.CreatedBy = GetUserId()):  # CheckICreatedBy
    raise NvRuleViolation("Record outside requested scope")
  GetNvInspectionEvidence = aggregate FROM NvInspectionEvidence WHERE (NvInspectionEvidence.ParentId = I.Id) MAX 200
  if not (GetNvInspectionEvidence.Count <= 200):  # CheckGetNvInspectionEvidenceCount
    raise NvRuleViolation("Result exceeds declared limit")
  assign  # SetEvidenceRows
    EvidenceRows = GetNvInspectionEvidence.List
  assign  # SetFiles
    Files = 0
    Named = 0
  foreach EvidenceRows:  # ForEachEvidenceRows @ruleNew1
    assign  # SetFiles2
      Files = Files + 1
      Named = Named + If(Length(Trim(EvidenceRows.Current.FileName)) > 0, 1, 0)
    next
  assign  # SetFiles3
    Files = Files
    Named = Named
  end

/// ssam-rule-map:{"CheckGetUserId":"Rule_Authenticated_6ab694","GetNvSurveyForUpdate":"Rule_LoadS_fetch_1b918b","SetS":"Rule_LoadS_record_6ce382","CheckSCreatedBy":"Rule_LoadS_scope0_753217","CheckSVersion":"Rule_LoadS_version_aa9303","CheckSDueOn":"Rule_checkLead_858e14","TransitionApproveAllowedState":"Rule_transitionApprove_allowed_7ff178","TransitionApproveChangeStateValues":"Rule_transitionApprove_change_values_b657e1","TransitionApproveChangeStatePersist":"Rule_transitionApprove_change_persist_87265c"}
server action ApproveNvSurveyPlan
  in SId: NvSurvey Identifier
  in SVersion: Long Integer
  local S: NvSurvey
  if not (GetUserId() <> NullIdentifier()):  # CheckGetUserId
    raise NvRuleViolation("Authentication required")
  GetNvSurveyForUpdate = GetNvSurveyForUpdate(Id=SId)
  assign  # SetS
    S = GetNvSurveyForUpdate.Record.NvSurvey
  if not (S.CreatedBy = GetUserId()):  # CheckSCreatedBy
    raise NvRuleViolation("Record outside requested scope")
  if not (S.Version = SVersion):  # CheckSVersion
    raise NvRuleViolation("Record changed; reload before editing")
  if not (S.DueOn >= DateTimeToDate(AddDays(CurrDate(),3))):  # CheckSDueOn
    raise NvRuleViolation("checkLead")
  if not ((S.StateId = Entities.NvSurveyState.Draft)):  # TransitionApproveAllowedState
    raise NvRuleViolation("transitionApprove: state transition not allowed")
  assign  # TransitionApproveChangeStateValues
    S.StateId = Entities.NvSurveyState.Scheduled
    S.UpdatedOn = CurrDateTime()
    S.Version = S.Version + 1
  TransitionApproveChangeStatePersist = UpdateNvSurvey(Source=S)
  end

/// ssam-rule-map:{"CheckGetUserId":"Rule_Authenticated_6ab694","ValidateScoreValue":"Rule_ValidateParameterScoreValue_4664b3","GetNvSurveyForUpdate":"Rule_LoadS_fetch_1b918b","SetS":"Rule_LoadS_record_6ce382","CheckSCreatedBy":"Rule_LoadS_scope0_753217","CheckSVersion":"Rule_LoadS_version_aa9303","CheckSLimit":"Rule_checkSampling_bbf1ad","TransitionReviewAllowedState":"Rule_transitionReview_allowed_afd6f4","TransitionReviewChangeStateValues":"Rule_transitionReview_change_values_eede97","TransitionReviewChangeStatePersist":"Rule_transitionReview_change_persist_9a92a5"}
server action ReviewNvSurvey
