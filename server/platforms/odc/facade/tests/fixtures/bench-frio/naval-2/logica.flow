server action ForecastNvCredentialAttendance
  in CrId: NvCredential Identifier
  out Hours: Decimal
  out Excused: Long Integer
  local Cr: NvCredential
  local AttendanceRows: NvCredentialAttendance List
  if not (GetUserId() <> NullIdentifier()):  # CheckGetUserId
    raise NvRuleViolation("Authentication required")
  GetNvCredential = GetNvCredential(Id=CrId)
  assign  # SetCr
    Cr = GetNvCredential.Record.NvCredential
  if not (Cr.CreatedBy = GetUserId()):  # CheckCrCreatedBy
    raise NvRuleViolation("Record outside requested scope")
  GetNvCredentialAttendance = aggregate FROM NvCredentialAttendance WHERE (NvCredentialAttendance.ParentId = Cr.Id) MAX 400
  if not (GetNvCredentialAttendance.Count <= 400):  # CheckGetNvCredentialAttendanceCount
    raise NvRuleViolation("Result exceeds declared limit")
  assign  # SetAttendanceRows
    AttendanceRows = GetNvCredentialAttendance.List
  assign  # SetHours
    Hours = 0
    Excused = 0
  foreach AttendanceRows:  # ForEachAttendanceRows @ruleNew1
    assign  # SetHours2
      Hours = Hours + (AttendanceRows.Current.Minutes/60)
      Excused = Excused + If(AttendanceRows.Current.Excused, 1, 0)
    next
  assign  # SetHours3
    Hours = Hours
    Excused = Excused
  end

