/// ssam-rule-map:{"CheckGetUserId":"Rule_Authenticated_6ab694","GetNvShift":"Rule_LoadSh_fetch_a450dc","SetSh":"Rule_LoadSh_record_89f072","CheckShCreatedBy":"Rule_LoadSh_scope0_7d2206","GetNvShiftParticipant":"Rule_QueryCoverageRows_query_f69fe2","CheckGetNvShiftParticipantCount":"Rule_QueryCoverageRows_complete_2e6e04","SetCoverageRows":"Rule_QueryCoverageRows_list_33a275","SetConfirmed":"Rule_SummarizeCoverage_seed_d194ec","ForEachCoverageRows":"Rule_SummarizeCoverage_each_9297ab","SetConfirmed2":"Rule_SummarizeCoverage_each_SummarizeCo_fb2beb","SetConfirmed3":"Rule_ReturnCoverage_bfdf91"}
server action ForecastNvShiftCoverage
  in ShId: NvShift Identifier
  out Confirmed: Long Integer
  out Pending: Long Integer
  local Sh: NvShift
  local CoverageRows: NvShiftParticipant List
  if not (GetUserId() <> NullIdentifier()):  # CheckGetUserId
    raise NvRuleViolation("Authentication required")
  GetNvShift = GetNvShift(Id=ShId)
  assign  # SetSh
    Sh = GetNvShift.Record.NvShift
  if not (Sh.CreatedBy = GetUserId()):  # CheckShCreatedBy
    raise NvRuleViolation("Record outside requested scope")
  GetNvShiftParticipant = aggregate FROM NvShiftParticipant WHERE (NvShiftParticipant.ParentId = Sh.Id) MAX 500
  if not (GetNvShiftParticipant.Count <= 500):  # CheckGetNvShiftParticipantCount
    raise NvRuleViolation("Result exceeds declared limit")
  assign  # SetCoverageRows
    CoverageRows = GetNvShiftParticipant.List
  assign  # SetConfirmed
    Confirmed = 0
    Pending = 0
  foreach CoverageRows:  # ForEachCoverageRows @ruleNew1
    assign  # SetConfirmed2
      Confirmed = Confirmed + If(CoverageRows.Current.Confirmed, 1, 0)
      Pending = Pending + If(not CoverageRows.Current.Confirmed, 1, 0)
    next
  assign  # SetConfirmed3
    Confirmed = Confirmed
    Pending = Pending
  end

