  out ExcusedMinutes: Decimal
  out UnexcusedMinutes: Decimal
  local Le: NvLeave
  local AbsenceRows: NvLeaveAttendance List
  if not (GetUserId() <> NullIdentifier()):  # CheckGetUserId
    raise NvRuleViolation("Authentication required")
  GetNvLeave = GetNvLeave(Id=LeId)
  assign  # SetLe
    Le = GetNvLeave.Record.NvLeave
  if not (Le.CreatedBy = GetUserId()):  # CheckLeCreatedBy
    raise NvRuleViolation("Record outside requested scope")
  GetNvLeaveAttendance = aggregate FROM NvLeaveAttendance WHERE (NvLeaveAttendance.ParentId = Le.Id) MAX 300
  if not (GetNvLeaveAttendance.Count <= 300):  # CheckGetNvLeaveAttendanceCount
    raise NvRuleViolation("Result exceeds declared limit")
  assign  # SetAbsenceRows
    AbsenceRows = GetNvLeaveAttendance.List
  assign  # SetExcusedMinutes
    ExcusedMinutes = 0
    UnexcusedMinutes = 0
  foreach AbsenceRows:  # ForEachAbsenceRows @ruleNew1
    assign  # SetExcusedMinutes2
      ExcusedMinutes = ExcusedMinutes + (If(AbsenceRows.Current.Excused,AbsenceRows.Current.Minutes,0))
      UnexcusedMinutes = UnexcusedMinutes + (If(AbsenceRows.Current.Excused,0,AbsenceRows.Current.Minutes))
    next
  assign  # SetExcusedMinutes3
    ExcusedMinutes = ExcusedMinutes
    UnexcusedMinutes = UnexcusedMinutes
  end

