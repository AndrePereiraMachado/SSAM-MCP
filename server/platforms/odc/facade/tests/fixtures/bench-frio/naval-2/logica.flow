/// ssam-rule-map:{"CheckGetUserId":"Rule_Authenticated_6ab694","ValidateQty":"Rule_ValidateParameterQty_89cddf","ValidateNote":"Rule_ValidateParameterNote_55075f","GetNvCargoForUpdate":"Rule_LoadCa_fetch_50aae3","SetCa":"Rule_LoadCa_record_25b37b","CheckCaCreatedBy":"Rule_LoadCa_scope0_d09dfa","CheckCaVersion":"Rule_LoadCa_version_b06794","CheckQty":"Rule_checkDamage_65ee7b","SetCaQuantity":"Rule_updateDamage_values_5fc854","UpdateNvCargo":"Rule_updateDamage_persist_a04123","SetMovement":"Rule_createMovement_reset_f5aa15","SetMovementParentId":"Rule_createMovement_values_c88bef","CreateNvCargoMovement":"Rule_createMovement_persist_479191","SetMovementId":"Rule_createMovement_identity_35626f"}
server action RepackNvCargo
