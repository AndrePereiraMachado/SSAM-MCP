/// ssam-rule-map:{"CheckGetUserId":"Rule_Authenticated_6ab694","ValidateAmount":"Rule_ValidateParameterAmount_7570ef","GetNvClaimForUpdate":"Rule_LoadCl_fetch_4bfdec","SetCl":"Rule_LoadCl_record_ac048c","CheckClCreatedBy":"Rule_LoadCl_scope0_9984e5","CheckClVersion":"Rule_LoadCl_version_228c25","CheckAmount":"Rule_checkAssessment_769788","TransitionAssessAllowedState":"Rule_transitionAssess_allowed_31a423","TransitionAssessChangeStateValues":"Rule_transitionAssess_change_values_791707","TransitionAssessChangeStatePersist":"Rule_transitionAssess_change_persist_c07d94"}
server action AssessNvClaim
  in Amount: Decimal
  in ClId: NvClaim Identifier
  in ClVersion: Long Integer
  local Cl: NvClaim
  if not (GetUserId() <> NullIdentifier()):  # CheckGetUserId
    raise NvRuleViolation("Authentication required")
  if not ((Amount <= 1000000) and (Amount > 0)):  # ValidateAmount
    raise NvRuleViolation("Invalid Amount")
  GetNvClaimForUpdate = GetNvClaimForUpdate(Id=ClId)
  assign  # SetCl
    Cl = GetNvClaimForUpdate.Record.NvClaim
  if not (Cl.CreatedBy = GetUserId()):  # CheckClCreatedBy
    raise NvRuleViolation("Record outside requested scope")
  if not (Cl.Version = ClVersion):  # CheckClVersion
    raise NvRuleViolation("Record changed; reload before editing")
  if not (Amount >= Cl.Paid and Amount <= Cl.Ceiling):  # CheckAmount
    raise NvRuleViolation("checkAssessment")
  if not ((Cl.StateId = Entities.NvClaimState.Open)):  # TransitionAssessAllowedState
    raise NvRuleViolation("transitionAssess: state transition not allowed")
  assign  # TransitionAssessChangeStateValues
    Cl.Amount = Amount
    Cl.StateId = Entities.NvClaimState.Assessed
    Cl.UpdatedOn = CurrDateTime()
    Cl.Version = Cl.Version + 1
  TransitionAssessChangeStatePersist = UpdateNvClaim(Source=Cl)
  end

/// ssam-rule-map:{"CheckGetUserId":"Rule_Authenticated_6ab694","GetNvClaimForUpdate":"Rule_LoadCl_fetch_4bfdec","SetCl":"Rule_LoadCl_record_ac048c","CheckClCreatedBy":"Rule_LoadCl_scope0_9984e5","CheckClVersion":"Rule_LoadCl_version_228c25","Checknot":"Rule_checkUncontested_ef8c70","TransitionApproveAllowedState":"Rule_transitionApprove_allowed_7ff178","TransitionApproveChangeStateValues":"Rule_transitionApprove_change_values_b657e1","TransitionApproveChangeStatePersist":"Rule_transitionApprove_change_persist_87265c"}
server action ApproveNvClaim
  in ClId: NvClaim Identifier
  in ClVersion: Long Integer
  local Cl: NvClaim
  if not (GetUserId() <> NullIdentifier()):  # CheckGetUserId
    raise NvRuleViolation("Authentication required")
  GetNvClaimForUpdate = GetNvClaimForUpdate(Id=ClId)
  assign  # SetCl
    Cl = GetNvClaimForUpdate.Record.NvClaim
  if not (Cl.CreatedBy = GetUserId()):  # CheckClCreatedBy
    raise NvRuleViolation("Record outside requested scope")
  if not (Cl.Version = ClVersion):  # CheckClVersion
    raise NvRuleViolation("Record changed; reload before editing")
  if not (not Cl.Disputed and Cl.Amount <= Cl.Ceiling):  # Checknot
    raise NvRuleViolation("checkUncontested")
  if not ((Cl.StateId = Entities.NvClaimState.Assessed)):  # TransitionApproveAllowedState
    raise NvRuleViolation("transitionApprove: state transition not allowed")
  assign  # TransitionApproveChangeStateValues
    Cl.StateId = Entities.NvClaimState.Approved
    Cl.UpdatedOn = CurrDateTime()
    Cl.Version = Cl.Version + 1
  TransitionApproveChangeStatePersist = UpdateNvClaim(Source=Cl)
  end

/// ssam-rule-map:{"CheckGetUserId":"Rule_Authenticated_6ab694","GetNvClaimForUpdate":"Rule_LoadCl_fetch_4bfdec","SetCl":"Rule_LoadCl_record_ac048c","CheckClCreatedBy":"Rule_LoadCl_scope0_9984e5","CheckClVersion":"Rule_LoadCl_version_228c25","Checknot":"Rule_checkPaid_a76064","TransitionCloseAllowedState":"Rule_transitionClose_allowed_269b23","TransitionCloseChangeStateValues":"Rule_transitionClose_change_values_3bff3b","TransitionCloseChangeStatePersist":"Rule_transitionClose_change_persist_42dc7f","SetHistory":"Rule_createHistory_reset_c7ffd8","SetHistoryParentId":"Rule_createHistory_values_778e70","CreateNvClaimHistory":"Rule_createHistory_persist_c2d9c5","SetHistoryId":"Rule_createHistory_identity_f92501"}
server action CloseNvClaim
  in ClId: NvClaim Identifier
  in ClVersion: Long Integer
  local Cl: NvClaim
  local History: NvClaimHistory
  local WorkflowEmpty2: NvClaimHistory
  if not (GetUserId() <> NullIdentifier()):  # CheckGetUserId
    raise NvRuleViolation("Authentication required")
  GetNvClaimForUpdate = GetNvClaimForUpdate(Id=ClId)
  assign  # SetCl
    Cl = GetNvClaimForUpdate.Record.NvClaim
  if not (Cl.CreatedBy = GetUserId()):  # CheckClCreatedBy
    raise NvRuleViolation("Record outside requested scope")
  if not (Cl.Version = ClVersion):  # CheckClVersion
    raise NvRuleViolation("Record changed; reload before editing")
  if not (not Cl.Disputed and Cl.Paid=Cl.Amount):  # Checknot
    raise NvRuleViolation("checkPaid")
  if not ((Cl.StateId = Entities.NvClaimState.Approved)):  # TransitionCloseAllowedState
    raise NvRuleViolation("transitionClose: state transition not allowed")
  assign  # TransitionCloseChangeStateValues
    Cl.StateId = Entities.NvClaimState.Settled
    Cl.UpdatedOn = CurrDateTime()
    Cl.Version = Cl.Version + 1
  TransitionCloseChangeStatePersist = UpdateNvClaim(Source=Cl)
  assign  # SetHistory
    History = WorkflowEmpty2
  assign  # SetHistoryParentId
    History.ParentId = Cl.Id
    History.Previous = 3
    History.Next = 4
    History.ChangedOn = CurrDateTime()
    History.UpdatedOn = CurrDateTime()
    History.CreatedOn = CurrDateTime()
    History.Version = 1
  CreateNvClaimHistory = CreateNvClaimHistory(Source=History)
  assign  # SetHistoryId
    History.Id = CreateNvClaimHistory.Id
  end

/// ssam-rule-map:{"CheckGetUserId":"Rule_Authenticated_6ab694","GetNvClaim":"Rule_LoadCl_fetch_4bfdec","SetCl":"Rule_LoadCl_record_ac048c","CheckClCreatedBy":"Rule_LoadCl_scope0_9984e5","GetNvClaimCharge":"Rule_QueryTaxRows_query_e85b8d","CheckGetNvClaimChargeCount":"Rule_QueryTaxRows_complete_82f927","SetTaxRows":"Rule_QueryTaxRows_list_db214b","SetTax":"Rule_SummarizeTax_seed_623e87","ForEachTaxRows":"Rule_SummarizeTax_each_9548ec","SetTax2":"Rule_SummarizeTax_each_SummarizeTax_ste_7cbfee","SetTax3":"Rule_ReturnTax_785c65"}
server action ForecastNvClaimTax
  in ClId: NvClaim Identifier
  out Tax: Decimal
  out Upcoming: Decimal
  local Cl: NvClaim
  local TaxRows: NvClaimCharge List
  if not (GetUserId() <> NullIdentifier()):  # CheckGetUserId
    raise NvRuleViolation("Authentication required")
  GetNvClaim = GetNvClaim(Id=ClId)
  assign  # SetCl
    Cl = GetNvClaim.Record.NvClaim
  if not (Cl.CreatedBy = GetUserId()):  # CheckClCreatedBy
    raise NvRuleViolation("Record outside requested scope")
  GetNvClaimCharge = aggregate FROM NvClaimCharge WHERE (NvClaimCharge.ParentId = Cl.Id) MAX 300
  if not (GetNvClaimCharge.Count <= 300):  # CheckGetNvClaimChargeCount
    raise NvRuleViolation("Result exceeds declared limit")
  assign  # SetTaxRows
    TaxRows = GetNvClaimCharge.List
  assign  # SetTax
    Tax = 0
    Upcoming = 0
  foreach TaxRows:  # ForEachTaxRows @ruleNew1
    assign  # SetTax2
      Tax = Tax + (TaxRows.Current.Tax)
      Upcoming = Upcoming + (If(TaxRows.Current.DueOn >= CurrDate(),TaxRows.Current.Net+TaxRows.Current.Tax,0))
    next
