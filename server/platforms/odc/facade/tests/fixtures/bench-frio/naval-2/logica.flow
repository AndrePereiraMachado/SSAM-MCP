  GetNvDockingLeg = aggregate FROM NvDockingLeg WHERE (NvDockingLeg.ParentId = D.Id) MAX 200
  if not (GetNvDockingLeg.Count <= 200):  # CheckGetNvDockingLegCount
    raise NvRuleViolation("Result exceeds declared limit")
  assign  # SetRouteRows
    RouteRows = GetNvDockingLeg.List
  assign  # SetDistance
    Distance = 0
    Legs = 0
  foreach RouteRows:  # ForEachRouteRows @ruleNew1
    assign  # SetDistance2
      Distance = Distance + (RouteRows.Current.Distance)
      Legs = Legs + 1
    next
  assign  # SetDistance3
    Distance = Distance
    Legs = Legs
  end

/// ssam-rule-map:{"CheckGetUserId":"Rule_Authenticated_6ab694","GetNvDocking":"Rule_LoadD_fetch_33c3ba","SetD":"Rule_LoadD_record_0df18c","CheckDCreatedBy":"Rule_LoadD_scope0_505f36","GetNvDockingIncident":"Rule_QuerySafetyRows_query_90ae8c","CheckGetNvDockingIncidentCount":"Rule_QuerySafetyRows_complete_361ba0","SetSafetyRows":"Rule_QuerySafetyRows_list_3e7c25","SetCritical":"Rule_SummarizeSafety_seed_c85834","ForEachSafetyRows":"Rule_SummarizeSafety_each_1f9294","SetCritical2":"Rule_SummarizeSafety_each_SummarizeSafe_2f4e45","SetCritical3":"Rule_ReturnSafety_b266d9"}
server action ReviewNvDockingIncidents
  in DId: NvDocking Identifier
  out Critical: Long Integer
  out Closed: Long Integer
  local D: NvDocking
  local SafetyRows: NvDockingIncident List
  if not (GetUserId() <> NullIdentifier()):  # CheckGetUserId
    raise NvRuleViolation("Authentication required")
  GetNvDocking = GetNvDocking(Id=DId)
  assign  # SetD
    D = GetNvDocking.Record.NvDocking
  if not (D.CreatedBy = GetUserId()):  # CheckDCreatedBy
    raise NvRuleViolation("Record outside requested scope")
  GetNvDockingIncident = aggregate FROM NvDockingIncident WHERE (NvDockingIncident.ParentId = D.Id) MAX 300
  if not (GetNvDockingIncident.Count <= 300):  # CheckGetNvDockingIncidentCount
    raise NvRuleViolation("Result exceeds declared limit")
  assign  # SetSafetyRows
    SafetyRows = GetNvDockingIncident.List
  assign  # SetCritical
    Critical = 0
    Closed = 0
  foreach SafetyRows:  # ForEachSafetyRows @ruleNew1
    assign  # SetCritical2
      Critical = Critical + If(not SafetyRows.Current.IsClosed and SafetyRows.Current.Severity >= 4, 1, 0)
      Closed = Closed + If(SafetyRows.Current.IsClosed, 1, 0)
    next
  assign  # SetCritical3
    Critical = Critical
    Closed = Closed
  end

/// ssam-rule-map:{"CheckGetUserId":"Rule_Authenticated_6ab694","GetNvTowForUpdate":"Rule_LoadT_fetch_a4663a","SetT":"Rule_LoadT_record_dbd58a","CheckTCreatedBy":"Rule_LoadT_scope0_5440d0","CheckTVersion":"Rule_LoadT_version_1e5520","CheckTCurrentLoad":"Rule_checkAttachment_f8d2e9","TransitionReadyAllowedState":"Rule_transitionReady_allowed_47f7c2","TransitionReadyChangeStateValues":"Rule_transitionReady_change_values_24b1a1","TransitionReadyChangeStatePersist":"Rule_transitionReady_change_persist_13d646"}
server action ReadyNvTow
  in TId: NvTow Identifier
  in TVersion: Long Integer
  local T: NvTow
  if not (GetUserId() <> NullIdentifier()):  # CheckGetUserId
    raise NvRuleViolation("Authentication required")
  GetNvTowForUpdate = GetNvTowForUpdate(Id=TId)
  assign  # SetT
    T = GetNvTowForUpdate.Record.NvTow
  if not (T.CreatedBy = GetUserId()):  # CheckTCreatedBy
    raise NvRuleViolation("Record outside requested scope")
  if not (T.Version = TVersion):  # CheckTVersion
    raise NvRuleViolation("Record changed; reload before editing")
  if not (T.CurrentLoad > 0 and T.CurrentLoad <= T.MaxLoad):  # CheckTCurrentLoad
    raise NvRuleViolation("checkAttachment")
  if not ((T.StateId = Entities.NvTowState.Planned)):  # TransitionReadyAllowedState
    raise NvRuleViolation("transitionReady: state transition not allowed")
  assign  # TransitionReadyChangeStateValues
    T.StateId = Entities.NvTowState.Ready
    T.UpdatedOn = CurrDateTime()
    T.Version = T.Version + 1
  TransitionReadyChangeStatePersist = UpdateNvTow(Source=T)
  end

/// ssam-rule-map:{"CheckGetUserId":"Rule_Authenticated_6ab694","GetNvTowForUpdate":"Rule_LoadT_fetch_a4663a","SetT":"Rule_LoadT_record_dbd58a","CheckTCreatedBy":"Rule_LoadT_scope0_5440d0","CheckTVersion":"Rule_LoadT_version_1e5520","CheckTDeparture":"Rule_checkSchedule_501859","TransitionBeginAllowedState":"Rule_transitionBegin_allowed_aa5972","TransitionBeginChangeStateValues":"Rule_transitionBegin_change_values_7915bc","TransitionBeginChangeStatePersist":"Rule_transitionBegin_change_persist_a70dab"}
server action BeginNvTow
  in TId: NvTow Identifier
  in TVersion: Long Integer
  local T: NvTow
  if not (GetUserId() <> NullIdentifier()):  # CheckGetUserId
    raise NvRuleViolation("Authentication required")
  GetNvTowForUpdate = GetNvTowForUpdate(Id=TId)
  assign  # SetT
    T = GetNvTowForUpdate.Record.NvTow
  if not (T.CreatedBy = GetUserId()):  # CheckTCreatedBy
    raise NvRuleViolation("Record outside requested scope")
  if not (T.Version = TVersion):  # CheckTVersion
    raise NvRuleViolation("Record changed; reload before editing")
  if not (T.Departure <= CurrDate() and T.Distance > 0):  # CheckTDeparture
    raise NvRuleViolation("checkSchedule")
  if not ((T.StateId = Entities.NvTowState.Ready)):  # TransitionBeginAllowedState
    raise NvRuleViolation("transitionBegin: state transition not allowed")
  assign  # TransitionBeginChangeStateValues
    T.StateId = Entities.NvTowState.Underway
    T.UpdatedOn = CurrDateTime()
    T.Version = T.Version + 1
  TransitionBeginChangeStatePersist = UpdateNvTow(Source=T)
  end

/// ssam-rule-map:{"CheckGetUserId":"Rule_Authenticated_6ab694","GetNvTowForUpdate":"Rule_LoadT_fetch_a4663a","SetT":"Rule_LoadT_record_dbd58a","CheckTCreatedBy":"Rule_LoadT_scope0_5440d0","CheckTVersion":"Rule_LoadT_version_1e5520","CheckTCompleted":"Rule_checkReleased_b62ff6","TransitionCompleteAllowedState":"Rule_transitionComplete_allowed_9d101f","TransitionCompleteChangeStateValues":"Rule_transitionComplete_change_values_19e218","TransitionCompleteChangeStatePersist":"Rule_transitionComplete__c6feaffd88ce_73762b"}
server action CompleteNvTow
