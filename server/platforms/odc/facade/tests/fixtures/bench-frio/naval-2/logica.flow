  in SpVersion: Long Integer
  local Sp: NvSpare
  local Valuation: NvSpareValuation
  local WorkflowEmpty2: NvSpareValuation
  if not (GetUserId() <> NullIdentifier()):  # CheckGetUserId
    raise NvRuleViolation("Authentication required")
  if not ((Amount <= 1000000) and (Amount > 0)):  # ValidateAmount
    raise NvRuleViolation("Invalid Amount")
  GetNvSpareForUpdate = GetNvSpareForUpdate(Id=SpId)
  assign  # SetSp
    Sp = GetNvSpareForUpdate.Record.NvSpare
  if not (Sp.CreatedBy = GetUserId()):  # CheckSpCreatedBy
    raise NvRuleViolation("Record outside requested scope")
  if not (Sp.Version = SpVersion):  # CheckSpVersion
    raise NvRuleViolation("Record changed; reload before editing")
  if not (Amount <= Sp.UnitCost*1.2 and Sp.Quantity > 0):  # CheckAmount
    raise NvRuleViolation("checkVendorPrice")
  assign  # SetSpUnitCost
    Sp.UnitCost = Amount
    Sp.UpdatedOn = CurrDateTime()
    Sp.Version = Sp.Version + 1
  UpdateNvSpare = UpdateNvSpare(Source=Sp)
  assign  # SetValuation
    Valuation = WorkflowEmpty2
  assign  # SetValuationParentId
