/// ssam-rule-map:{"CheckGetUserId":"Rule_Authenticated_6ab694","GetNvTransfer":"Rule_LoadX_fetch_66e6ec","SetX":"Rule_LoadX_record_4f07a4","CheckXCreatedBy":"Rule_LoadX_scope0_deecf1","GetNvTransferIncident":"Rule_QuerySafetyRows_query_90ae8c","CheckGetNvTransferIncidentCount":"Rule_QuerySafetyRows_complete_361ba0","SetSafetyRows":"Rule_QuerySafetyRows_list_3e7c25","SetOpen":"Rule_SummarizeSafety_seed_c85834","ForEachSafetyRows":"Rule_SummarizeSafety_each_1f9294","SetOpen2":"Rule_SummarizeSafety_each_SummarizeSafe_2f4e45","SetOpen3":"Rule_ReturnSafety_b266d9"}
server action ReviewNvTransferSafety
  in XId: NvTransfer Identifier
  out Open: Long Integer
  out Severity: Decimal
  local X: NvTransfer
  local SafetyRows: NvTransferIncident List
  if not (GetUserId() <> NullIdentifier()):  # CheckGetUserId
    raise NvRuleViolation("Authentication required")
  GetNvTransfer = GetNvTransfer(Id=XId)
  assign  # SetX
    X = GetNvTransfer.Record.NvTransfer
  if not (X.CreatedBy = GetUserId()):  # CheckXCreatedBy
    raise NvRuleViolation("Record outside requested scope")
  GetNvTransferIncident = aggregate FROM NvTransferIncident WHERE (NvTransferIncident.ParentId = X.Id) MAX 300
  if not (GetNvTransferIncident.Count <= 300):  # CheckGetNvTransferIncidentCount
    raise NvRuleViolation("Result exceeds declared limit")
  assign  # SetSafetyRows
    SafetyRows = GetNvTransferIncident.List
  assign  # SetOpen
    Open = 0
    Severity = 0
  foreach SafetyRows:  # ForEachSafetyRows @ruleNew1
    assign  # SetOpen2
      Open = Open + If(not SafetyRows.Current.IsClosed, 1, 0)
      Severity = Severity + (If(SafetyRows.Current.IsClosed,0,SafetyRows.Current.Severity*2))
    next
  assign  # SetOpen3
    Open = Open
    Severity = Severity
  end
