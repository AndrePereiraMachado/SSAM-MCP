  if not (Qty <= Ca.Quantity-Ca.Reserved and Qty <= Ca.Quantity*0.05):  # CheckQty
    raise NvRuleViolation("checkDamage")
  assign  # SetCaQuantity
    Ca.Quantity = Ca.Quantity-Qty
    Ca.UpdatedOn = CurrDateTime()
    Ca.Version = Ca.Version + 1
