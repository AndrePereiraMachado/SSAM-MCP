    T = GetNvTowForUpdate.Record.NvTow
  if not (T.CreatedBy = GetUserId()):  # CheckTCreatedBy
    raise NvRuleViolation("Record outside requested scope")
  if not (T.Version = TVersion):  # CheckTVersion
    raise NvRuleViolation("Record changed; reload before editing")
  if not (T.Completed >= T.Distance and T.CurrentLoad=0):  # CheckTCompleted
    raise NvRuleViolation("checkReleased")
  if not ((T.StateId = Entities.NvTowState.Underway)):  # TransitionCompleteAllowedState
    raise NvRuleViolation("transitionComplete: state transition not allowed")
