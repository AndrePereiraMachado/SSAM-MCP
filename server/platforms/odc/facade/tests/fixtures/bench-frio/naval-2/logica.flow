  if not (S.Limit > 0 and ScoreValue <= S.Limit):  # CheckSLimit
    raise NvRuleViolation("checkSampling")
  if not ((S.StateId = Entities.NvSurveyState.Scheduled)):  # TransitionReviewAllowedState
    raise NvRuleViolation("transitionReview: state transition not allowed")
