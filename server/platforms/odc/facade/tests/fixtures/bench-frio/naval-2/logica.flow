    Movement.Delta = 0-Qty
    Movement.Reason = Note
    Movement.OccurredOn = CurrDateTime()
    Movement.UpdatedOn = CurrDateTime()
    Movement.CreatedOn = CurrDateTime()
    Movement.Version = 1
  CreateNvCargoMovement = CreateNvCargoMovement(Source=Movement)
  assign  # SetMovementId
    Movement.Id = CreateNvCargoMovement.Id
  end

