/// ssam-rule-map:{"CheckGetUserId":"Rule_Authenticated_6ab694","GetNvClaim":"Rule_LoadCl_fetch_4bfdec","SetCl":"Rule_LoadCl_record_ac048c","CheckClCreatedBy":"Rule_LoadCl_scope0_9984e5","GetNvClaimReview":"Rule_QueryConsensusRows_query_17437e","CheckGetNvClaimReviewCount":"Rule_QueryConsensusRows_complete_797c1a","SetConsensusRows":"Rule_QueryConsensusRows_list_19ac67","SetApprovals":"Rule_SummarizeConsensus_seed_c699d5","ForEachConsensusRows":"Rule_SummarizeConsensus_each_7b2487","SetApprovals2":"Rule_SummarizeConsensus_each_SummarizeC_edaabe","SetApprovals3":"Rule_ReturnConsensus_ecd14f"}
server action ReviewNvClaimConsensus
  in ClId: NvClaim Identifier
  out Approvals: Long Integer
  out Refusals: Long Integer
  local Cl: NvClaim
  local ConsensusRows: NvClaimReview List
  if not (GetUserId() <> NullIdentifier()):  # CheckGetUserId
    raise NvRuleViolation("Authentication required")
  GetNvClaim = GetNvClaim(Id=ClId)
  assign  # SetCl
    Cl = GetNvClaim.Record.NvClaim
  if not (Cl.CreatedBy = GetUserId()):  # CheckClCreatedBy
    raise NvRuleViolation("Record outside requested scope")
  GetNvClaimReview = aggregate FROM NvClaimReview WHERE (NvClaimReview.ParentId = Cl.Id) MAX 100
  if not (GetNvClaimReview.Count <= 100):  # CheckGetNvClaimReviewCount
    raise NvRuleViolation("Result exceeds declared limit")
  assign  # SetConsensusRows
    ConsensusRows = GetNvClaimReview.List
  assign  # SetApprovals
    Approvals = 0
    Refusals = 0
  foreach ConsensusRows:  # ForEachConsensusRows @ruleNew1
    assign  # SetApprovals2
      Approvals = Approvals + If(ConsensusRows.Current.Accepted, 1, 0)
      Refusals = Refusals + If(not ConsensusRows.Current.Accepted, 1, 0)
    next
  assign  # SetApprovals3
    Approvals = Approvals
    Refusals = Refusals
  end

