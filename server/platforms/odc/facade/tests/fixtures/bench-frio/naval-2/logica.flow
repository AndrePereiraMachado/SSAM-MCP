  assign  # SetApplicantsRows
    ApplicantsRows = GetNvCredentialParticipant.List
  assign  # SetConfirmed
    Confirmed = 0
    Candidates = 0
  foreach ApplicantsRows:  # ForEachApplicantsRows @ruleNew1
    assign  # SetConfirmed2
      Confirmed = Confirmed + If(ApplicantsRows.Current.Confirmed, 1, 0)
      Candidates = Candidates + 1
    next
  assign  # SetConfirmed3
    Confirmed = Confirmed
    Candidates = Candidates
  end

