/// ssam-rule-map:{"CheckGetUserId":"Rule_Authenticated_6ab694","GetNvTow":"Rule_LoadT_fetch_a4663a","SetT":"Rule_LoadT_record_dbd58a","CheckTCreatedBy":"Rule_LoadT_scope0_5440d0","GetNvTowCheckpoint":"Rule_QueryCheckpointsRows_query_30a74e","CheckGetNvTowCheckpointCount":"Rule_QueryCheckpointsRows_complete_7b6273","SetCheckpointsRows":"Rule_QueryCheckpointsRows_list_8d7a63","SetConfirmed":"Rule_SummarizeCheckpoints_seed_16f1e9","ForEachCheckpointsRows":"Rule_SummarizeCheckpoints_each_4b49e6","SetConfirmed2":"Rule_SummarizeCheckpoints_each_Summariz_6ea159","SetConfirmed3":"Rule_ReturnCheckpoints_b32ece"}
server action ReviewNvTowCheckpoints
  in TId: NvTow Identifier
  out Confirmed: Long Integer
  out Pending: Long Integer
  local T: NvTow
  local CheckpointsRows: NvTowCheckpoint List
  if not (GetUserId() <> NullIdentifier()):  # CheckGetUserId
    raise NvRuleViolation("Authentication required")
  GetNvTow = GetNvTow(Id=TId)
  assign  # SetT
    T = GetNvTow.Record.NvTow
  if not (T.CreatedBy = GetUserId()):  # CheckTCreatedBy
    raise NvRuleViolation("Record outside requested scope")
  GetNvTowCheckpoint = aggregate FROM NvTowCheckpoint WHERE (NvTowCheckpoint.ParentId = T.Id) MAX 300
  if not (GetNvTowCheckpoint.Count <= 300):  # CheckGetNvTowCheckpointCount
    raise NvRuleViolation("Result exceeds declared limit")
  assign  # SetCheckpointsRows
    CheckpointsRows = GetNvTowCheckpoint.List
  assign  # SetConfirmed
    Confirmed = 0
    Pending = 0
  foreach CheckpointsRows:  # ForEachCheckpointsRows @ruleNew1
    assign  # SetConfirmed2
      Confirmed = Confirmed + If(CheckpointsRows.Current.Confirmed, 1, 0)
      Pending = Pending + If(not CheckpointsRows.Current.Confirmed, 1, 0)
    next
  assign  # SetConfirmed3
    Confirmed = Confirmed
    Pending = Pending
  end

