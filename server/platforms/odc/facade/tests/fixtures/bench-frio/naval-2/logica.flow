  TransitionHoldChangeStatePersist = UpdateNvSpare(Source=Sp)
  end

/// ssam-rule-map:{"CheckGetUserId":"Rule_Authenticated_6ab694","GetNvSpareForUpdate":"Rule_LoadSp_fetch_063496","SetSp":"Rule_LoadSp_record_59e09c","CheckSpCreatedBy":"Rule_LoadSp_scope0_a93267","CheckSpVersion":"Rule_LoadSp_version_007b44","CheckSpReserved":"Rule_checkNoHolds_0ceada","TransitionReleaseAllowedState":"Rule_transitionRelease_allowed_90646a","TransitionReleaseChangeStateValues":"Rule_transitionRelease_change_values_79b715","TransitionReleaseChangeStatePersist":"Rule_transitionRelease_change_persist_57420e"}
server action UnholdNvSpareStock
  in SpId: NvSpare Identifier
  in SpVersion: Long Integer
