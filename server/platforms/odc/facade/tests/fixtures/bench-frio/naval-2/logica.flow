  if not (GetUserId() <> NullIdentifier()):  # CheckGetUserId
    raise NvRuleViolation("Authentication required")
  GetNvRebateForUpdate = GetNvRebateForUpdate(Id=RbId)
  assign  # SetRb
    Rb = GetNvRebateForUpdate.Record.NvRebate
  if not (Rb.CreatedBy = GetUserId()):  # CheckRbCreatedBy
    raise NvRuleViolation("Record outside requested scope")
  if not (Rb.Version = RbVersion):  # CheckRbVersion
    raise NvRuleViolation("Record changed; reload before editing")
  if not (not Rb.Disputed and Rb.Amount > 0):  # Checknot
    raise NvRuleViolation("checkEligibility")
  if not ((Rb.StateId = Entities.NvRebateState.Assessed)):  # TransitionApproveAllowedState
    raise NvRuleViolation("transitionApprove: state transition not allowed")
  assign  # TransitionApproveChangeStateValues
    Rb.StateId = Entities.NvRebateState.Approved
    Rb.UpdatedOn = CurrDateTime()
    Rb.Version = Rb.Version + 1
  TransitionApproveChangeStatePersist = UpdateNvRebate(Source=Rb)
  end

/// ssam-rule-map:{"CheckGetUserId":"Rule_Authenticated_6ab694","GetNvRebateForUpdate":"Rule_LoadRb_fetch_548c35","SetRb":"Rule_LoadRb_record_7d6fea","CheckRbCreatedBy":"Rule_LoadRb_scope0_c6baf8","CheckRbVersion":"Rule_LoadRb_version_518597","CheckRbPaid":"Rule_checkCredited_95dc90","TransitionCloseAllowedState":"Rule_transitionClose_allowed_269b23","TransitionCloseChangeStateValues":"Rule_transitionClose_change_values_3bff3b","TransitionCloseChangeStatePersist":"Rule_transitionClose_change_persist_42dc7f","SetHistory":"Rule_createHistory_reset_c7ffd8","SetHistoryParentId":"Rule_createHistory_values_778e70","CreateNvRebateHistory":"Rule_createHistory_persist_c2d9c5","SetHistoryId":"Rule_createHistory_identity_f92501"}
server action CloseNvRebate
  in RbId: NvRebate Identifier
  in RbVersion: Long Integer
  local Rb: NvRebate
  local History: NvRebateHistory
  local WorkflowEmpty2: NvRebateHistory
  if not (GetUserId() <> NullIdentifier()):  # CheckGetUserId
    raise NvRuleViolation("Authentication required")
  GetNvRebateForUpdate = GetNvRebateForUpdate(Id=RbId)
  assign  # SetRb
    Rb = GetNvRebateForUpdate.Record.NvRebate
  if not (Rb.CreatedBy = GetUserId()):  # CheckRbCreatedBy
    raise NvRuleViolation("Record outside requested scope")
  if not (Rb.Version = RbVersion):  # CheckRbVersion
    raise NvRuleViolation("Record changed; reload before editing")
  if not (Rb.Paid=Rb.Amount and not Rb.Disputed):  # CheckRbPaid
    raise NvRuleViolation("checkCredited")
  if not ((Rb.StateId = Entities.NvRebateState.Approved)):  # TransitionCloseAllowedState
    raise NvRuleViolation("transitionClose: state transition not allowed")
  assign  # TransitionCloseChangeStateValues
    Rb.StateId = Entities.NvRebateState.Settled
    Rb.UpdatedOn = CurrDateTime()
    Rb.Version = Rb.Version + 1
  TransitionCloseChangeStatePersist = UpdateNvRebate(Source=Rb)
  assign  # SetHistory
    History = WorkflowEmpty2
  assign  # SetHistoryParentId
    History.ParentId = Rb.Id
    History.Previous = 3
    History.Next = 4
    History.ChangedOn = CurrDateTime()
    History.UpdatedOn = CurrDateTime()
    History.CreatedOn = CurrDateTime()
    History.Version = 1
  CreateNvRebateHistory = CreateNvRebateHistory(Source=History)
  assign  # SetHistoryId
    History.Id = CreateNvRebateHistory.Id
  end

/// ssam-rule-map:{"CheckGetUserId":"Rule_Authenticated_6ab694","GetNvRebate":"Rule_LoadRb_fetch_548c35","SetRb":"Rule_LoadRb_record_7d6fea","CheckRbCreatedBy":"Rule_LoadRb_scope0_c6baf8","GetNvRebateCharge":"Rule_QueryCreditsRows_query_53e203","CheckGetNvRebateChargeCount":"Rule_QueryCreditsRows_complete_5aebb4","SetCreditsRows":"Rule_QueryCreditsRows_list_451319","SetNet":"Rule_SummarizeCredits_seed_c02853","ForEachCreditsRows":"Rule_SummarizeCredits_each_aa89d1","SetNet2":"Rule_SummarizeCredits_each_SummarizeCre_e08cdc","SetNet3":"Rule_ReturnCredits_5c6088"}
server action ForecastNvRebateCredits
  in RbId: NvRebate Identifier
  out Net: Decimal
  out AfterTax: Decimal
  local Rb: NvRebate
  local CreditsRows: NvRebateCharge List
  if not (GetUserId() <> NullIdentifier()):  # CheckGetUserId
    raise NvRuleViolation("Authentication required")
  GetNvRebate = GetNvRebate(Id=RbId)
  assign  # SetRb
    Rb = GetNvRebate.Record.NvRebate
  if not (Rb.CreatedBy = GetUserId()):  # CheckRbCreatedBy
    raise NvRuleViolation("Record outside requested scope")
  GetNvRebateCharge = aggregate FROM NvRebateCharge WHERE (NvRebateCharge.ParentId = Rb.Id) MAX 200
  if not (GetNvRebateCharge.Count <= 200):  # CheckGetNvRebateChargeCount
    raise NvRuleViolation("Result exceeds declared limit")
  assign  # SetCreditsRows
    CreditsRows = GetNvRebateCharge.List
  assign  # SetNet
    Net = 0
    AfterTax = 0
  foreach CreditsRows:  # ForEachCreditsRows @ruleNew1
    assign  # SetNet2
      Net = Net + (CreditsRows.Current.Net)
      AfterTax = AfterTax + (CreditsRows.Current.Net-CreditsRows.Current.Tax)
    next
  assign  # SetNet3
    Net = Net
    AfterTax = AfterTax
  end

/// ssam-rule-map:{"CheckGetUserId":"Rule_Authenticated_6ab694","GetNvRebate":"Rule_LoadRb_fetch_548c35","SetRb":"Rule_LoadRb_record_7d6fea","CheckRbCreatedBy":"Rule_LoadRb_scope0_c6baf8","GetNvRebateReview":"Rule_QueryDecisionsRows_query_c9ef9f","CheckGetNvRebateReviewCount":"Rule_QueryDecisionsRows_complete_d25b33","SetDecisionsRows":"Rule_QueryDecisionsRows_list_3858aa","SetAccepted":"Rule_SummarizeDecisions_seed_1b0be7","ForEachDecisionsRows":"Rule_SummarizeDecisions_each_673983","SetAccepted2":"Rule_SummarizeDecisions_each_SummarizeD_001011","SetAccepted3":"Rule_ReturnDecisions_d988d5"}
server action ReviewNvRebateDecisions
  in RbId: NvRebate Identifier
  out Accepted: Long Integer
  out NeedsNotes: Long Integer
  local Rb: NvRebate
  local DecisionsRows: NvRebateReview List
  if not (GetUserId() <> NullIdentifier()):  # CheckGetUserId
    raise NvRuleViolation("Authentication required")
  GetNvRebate = GetNvRebate(Id=RbId)
  assign  # SetRb
    Rb = GetNvRebate.Record.NvRebate
  if not (Rb.CreatedBy = GetUserId()):  # CheckRbCreatedBy
    raise NvRuleViolation("Record outside requested scope")
  GetNvRebateReview = aggregate FROM NvRebateReview WHERE (NvRebateReview.ParentId = Rb.Id) MAX 100
  if not (GetNvRebateReview.Count <= 100):  # CheckGetNvRebateReviewCount
    raise NvRuleViolation("Result exceeds declared limit")
  assign  # SetDecisionsRows
    DecisionsRows = GetNvRebateReview.List
  assign  # SetAccepted
    Accepted = 0
    NeedsNotes = 0
  foreach DecisionsRows:  # ForEachDecisionsRows @ruleNew1
    assign  # SetAccepted2
      Accepted = Accepted + If(DecisionsRows.Current.Accepted, 1, 0)
      NeedsNotes = NeedsNotes + If(not DecisionsRows.Current.Accepted and Length(Trim(DecisionsRows.Current.Notes)) < 10, 1, 0)
    next
  assign  # SetAccepted3
    Accepted = Accepted
    NeedsNotes = NeedsNotes
  end

/// ssam-rule-map:{"CheckGetUserId":"Rule_Authenticated_6ab694","GetNvProvisionForUpdate":"Rule_LoadPr_fetch_1bb977","SetPr":"Rule_LoadPr_record_218021","CheckPrCreatedBy":"Rule_LoadPr_scope0_140f2d","CheckPrVersion":"Rule_LoadPr_version_b891b0","CheckPrValidUntil":"Rule_checkExpired_412d6d","TransitionQuarantineAllowedState":"Rule_transitionQuarantine_allowed_62e445","TransitionQuarantineChangeStateValues":"Rule_transitionQuarantin_0feb7d958ed9_e2d33c","TransitionQuarantineChangeStatePersist":"Rule_transitionQuarantin_d372c77b54d2_5873bd"}
server action QuarantineNvProvision
  in PrId: NvProvision Identifier
  in PrVersion: Long Integer
  local Pr: NvProvision
  if not (GetUserId() <> NullIdentifier()):  # CheckGetUserId
    raise NvRuleViolation("Authentication required")
  GetNvProvisionForUpdate = GetNvProvisionForUpdate(Id=PrId)
  assign  # SetPr
    Pr = GetNvProvisionForUpdate.Record.NvProvision
  if not (Pr.CreatedBy = GetUserId()):  # CheckPrCreatedBy
    raise NvRuleViolation("Record outside requested scope")
  if not (Pr.Version = PrVersion):  # CheckPrVersion
    raise NvRuleViolation("Record changed; reload before editing")
  if not (Pr.ValidUntil < CurrDate() and Pr.Reserved=0):  # CheckPrValidUntil
    raise NvRuleViolation("checkExpired")
  if not ((Pr.StateId = Entities.NvProvisionState.Available)):  # TransitionQuarantineAllowedState
    raise NvRuleViolation("transitionQuarantine: state transition not allowed")
  assign  # TransitionQuarantineChangeStateValues
    Pr.StateId = Entities.NvProvisionState.Expired
    Pr.UpdatedOn = CurrDateTime()
    Pr.Version = Pr.Version + 1
  TransitionQuarantineChangeStatePersist = UpdateNvProvision(Source=Pr)
  end

/// ssam-rule-map:{"CheckGetUserId":"Rule_Authenticated_6ab694","ValidateQty":"Rule_ValidateParameterQty_89cddf","ValidateNote":"Rule_ValidateParameterNote_55075f","GetNvProvisionForUpdate":"Rule_LoadPr_fetch_1bb977","SetPr":"Rule_LoadPr_record_218021","CheckPrCreatedBy":"Rule_LoadPr_scope0_140f2d","CheckPrVersion":"Rule_LoadPr_version_b891b0","CheckPrStateId":"Rule_checkQuarantine_14f464","SetPrQuantity":"Rule_updateWriteOff_values_7e54db","UpdateNvProvision":"Rule_updateWriteOff_persist_ea91d3","SetMovement":"Rule_createMovement_reset_f5aa15","SetMovementParentId":"Rule_createMovement_values_c88bef","CreateNvProvisionMovement":"Rule_createMovement_persist_479191","SetMovementId":"Rule_createMovement_identity_35626f"}
server action WriteOffNvProvision
  in Qty: Decimal
  in Note: Text
  in PrId: NvProvision Identifier
  in PrVersion: Long Integer
  local Pr: NvProvision
  local Movement: NvProvisionMovement
  local WorkflowEmpty2: NvProvisionMovement
  if not (GetUserId() <> NullIdentifier()):  # CheckGetUserId
    raise NvRuleViolation("Authentication required")
  if not ((Qty <= 10000) and (Qty > 0)):  # ValidateQty
    raise NvRuleViolation("Invalid Qty")
  if not ((Trim(Note) <> "") and (Length(Note) >= 5) and (Length(Note) <= 500)):  # ValidateNote
    raise NvRuleViolation("Invalid Note")
  GetNvProvisionForUpdate = GetNvProvisionForUpdate(Id=PrId)
  assign  # SetPr
    Pr = GetNvProvisionForUpdate.Record.NvProvision
  if not (Pr.CreatedBy = GetUserId()):  # CheckPrCreatedBy
    raise NvRuleViolation("Record outside requested scope")
  if not (Pr.Version = PrVersion):  # CheckPrVersion
    raise NvRuleViolation("Record changed; reload before editing")
  if not (Pr.StateId=Entities.NvProvisionState.Expired and Pr.Reserved=0 and Qty <= Pr.Quantity):  # CheckPrStateId
    raise NvRuleViolation("checkQuarantine")
  assign  # SetPrQuantity
    Pr.Quantity = Pr.Quantity-Qty
    Pr.UpdatedOn = CurrDateTime()
    Pr.Version = Pr.Version + 1
  UpdateNvProvision = UpdateNvProvision(Source=Pr)
  assign  # SetMovement
    Movement = WorkflowEmpty2
  assign  # SetMovementParentId
    Movement.ParentId = Pr.Id
    Movement.Delta = 0-Qty
    Movement.Reason = Note
    Movement.OccurredOn = CurrDateTime()
    Movement.UpdatedOn = CurrDateTime()
    Movement.CreatedOn = CurrDateTime()
    Movement.Version = 1
  CreateNvProvisionMovement = CreateNvProvisionMovement(Source=Movement)
  assign  # SetMovementId
    Movement.Id = CreateNvProvisionMovement.Id
  end

/// ssam-rule-map:{"CheckGetUserId":"Rule_Authenticated_6ab694","ValidateAmount":"Rule_ValidateParameterAmount_7570ef","GetNvProvisionForUpdate":"Rule_LoadPr_fetch_1bb977","SetPr":"Rule_LoadPr_record_218021","CheckPrCreatedBy":"Rule_LoadPr_scope0_140f2d","CheckPrVersion":"Rule_LoadPr_version_b891b0","CheckPrQuantity":"Rule_checkPositiveStock_4074e3","SetPrUnitCost":"Rule_updateRevalue_values_e30012","UpdateNvProvision":"Rule_updateRevalue_persist_405262","SetValuation":"Rule_createValuation_reset_4117cd","SetValuationParentId":"Rule_createValuation_values_952028","CreateNvProvisionValuation":"Rule_createValuation_persist_b713eb","SetValuationId":"Rule_createValuation_identity_d903dc"}
server action RevalueNvProvision
  in Amount: Decimal
  in PrId: NvProvision Identifier
  in PrVersion: Long Integer
  local Pr: NvProvision
  local Valuation: NvProvisionValuation
  local WorkflowEmpty2: NvProvisionValuation
  if not (GetUserId() <> NullIdentifier()):  # CheckGetUserId
    raise NvRuleViolation("Authentication required")
  if not ((Amount <= 1000000) and (Amount > 0)):  # ValidateAmount
    raise NvRuleViolation("Invalid Amount")
  GetNvProvisionForUpdate = GetNvProvisionForUpdate(Id=PrId)
  assign  # SetPr
    Pr = GetNvProvisionForUpdate.Record.NvProvision
  if not (Pr.CreatedBy = GetUserId()):  # CheckPrCreatedBy
    raise NvRuleViolation("Record outside requested scope")
  if not (Pr.Version = PrVersion):  # CheckPrVersion
    raise NvRuleViolation("Record changed; reload before editing")
  if not (Pr.Quantity > 0 and Amount <= Pr.UnitCost*2):  # CheckPrQuantity
    raise NvRuleViolation("checkPositiveStock")
  assign  # SetPrUnitCost
    Pr.UnitCost = Amount
    Pr.UpdatedOn = CurrDateTime()
    Pr.Version = Pr.Version + 1
  UpdateNvProvision = UpdateNvProvision(Source=Pr)
  assign  # SetValuation
    Valuation = WorkflowEmpty2
  assign  # SetValuationParentId
    Valuation.ParentId = Pr.Id
    Valuation.UnitPrice = Amount
    Valuation.Currency = "BRL"
    Valuation.EffectiveOn = CurrDate()
    Valuation.UpdatedOn = CurrDateTime()
    Valuation.CreatedOn = CurrDateTime()
    Valuation.Version = 1
  CreateNvProvisionValuation = CreateNvProvisionValuation(Source=Valuation)
  assign  # SetValuationId
    Valuation.Id = CreateNvProvisionValuation.Id
  end

/// ssam-rule-map:{"CheckGetUserId":"Rule_Authenticated_6ab694","GetNvProvision":"Rule_LoadPr_fetch_1bb977","SetPr":"Rule_LoadPr_record_218021","CheckPrCreatedBy":"Rule_LoadPr_scope0_140f2d","GetNvProvisionLot":"Rule_QueryExpiryRows_query_ce79c1","CheckGetNvProvisionLotCount":"Rule_QueryExpiryRows_complete_ae6e81","SetExpiryRows":"Rule_QueryExpiryRows_list_fd66a3","SetExpiredUnits":"Rule_SummarizeExpiry_seed_8af23d","ForEachExpiryRows":"Rule_SummarizeExpiry_each_0f39bf","SetExpiredUnits2":"Rule_SummarizeExpiry_each_SummarizeExpi_c01389","SetExpiredUnits3":"Rule_ReturnExpiry_1f724e"}
server action ForecastNvProvisionLoss
  in PrId: NvProvision Identifier
  out ExpiredUnits: Decimal
  out ValidLots: Long Integer
  local Pr: NvProvision
  local ExpiryRows: NvProvisionLot List
  if not (GetUserId() <> NullIdentifier()):  # CheckGetUserId
    raise NvRuleViolation("Authentication required")
  GetNvProvision = GetNvProvision(Id=PrId)
  assign  # SetPr
    Pr = GetNvProvision.Record.NvProvision
  if not (Pr.CreatedBy = GetUserId()):  # CheckPrCreatedBy
    raise NvRuleViolation("Record outside requested scope")
  GetNvProvisionLot = aggregate FROM NvProvisionLot WHERE (NvProvisionLot.ParentId = Pr.Id) MAX 500
  if not (GetNvProvisionLot.Count <= 500):  # CheckGetNvProvisionLotCount
    raise NvRuleViolation("Result exceeds declared limit")
  assign  # SetExpiryRows
    ExpiryRows = GetNvProvisionLot.List
  assign  # SetExpiredUnits
    ExpiredUnits = 0
    ValidLots = 0
  foreach ExpiryRows:  # ForEachExpiryRows @ruleNew1
    assign  # SetExpiredUnits2
      ExpiredUnits = ExpiredUnits + (If(ExpiryRows.Current.Expiry < CurrDate(),ExpiryRows.Current.Units,0))
      ValidLots = ValidLots + If(ExpiryRows.Current.Expiry >= CurrDate(), 1, 0)
    next
  assign  # SetExpiredUnits3
    ExpiredUnits = ExpiredUnits
    ValidLots = ValidLots
  end

/// ssam-rule-map:{"CheckGetUserId":"Rule_Authenticated_6ab694","GetNvProvision":"Rule_LoadPr_fetch_1bb977","SetPr":"Rule_LoadPr_record_218021","CheckPrCreatedBy":"Rule_LoadPr_scope0_140f2d","GetNvProvisionReservation":"Rule_QueryHoldsRows_query_a57c2c","CheckGetNvProvisionReservationCount":"Rule_QueryHoldsRows_complete_b42ae9","SetHoldsRows":"Rule_QueryHoldsRows_list_8a4925","SetOverdue":"Rule_SummarizeHolds_seed_fe6063","ForEachHoldsRows":"Rule_SummarizeHolds_each_140908","SetOverdue2":"Rule_SummarizeHolds_each_SummarizeHolds_07260a","SetOverdue3":"Rule_ReturnHolds_cf5dee"}
server action ReviewNvProvisionReservations
  in PrId: NvProvision Identifier
  out Overdue: Decimal
  out Released: Long Integer
  local Pr: NvProvision
  local HoldsRows: NvProvisionReservation List
  if not (GetUserId() <> NullIdentifier()):  # CheckGetUserId
    raise NvRuleViolation("Authentication required")
  GetNvProvision = GetNvProvision(Id=PrId)
  assign  # SetPr
    Pr = GetNvProvision.Record.NvProvision
  if not (Pr.CreatedBy = GetUserId()):  # CheckPrCreatedBy
    raise NvRuleViolation("Record outside requested scope")
  GetNvProvisionReservation = aggregate FROM NvProvisionReservation WHERE (NvProvisionReservation.ParentId = Pr.Id) MAX 500
  if not (GetNvProvisionReservation.Count <= 500):  # CheckGetNvProvisionReservationCount
    raise NvRuleViolation("Result exceeds declared limit")
  assign  # SetHoldsRows
    HoldsRows = GetNvProvisionReservation.List
  assign  # SetOverdue
    Overdue = 0
    Released = 0
  foreach HoldsRows:  # ForEachHoldsRows @ruleNew1
    assign  # SetOverdue2
      Overdue = Overdue + (If(not HoldsRows.Current.Released and HoldsRows.Current.ReleaseOn < CurrDate(),HoldsRows.Current.Units,0))
      Released = Released + If(HoldsRows.Current.Released, 1, 0)
    next
  assign  # SetOverdue3
    Overdue = Overdue
    Released = Released
  end

/// ssam-rule-map:{"CheckGetUserId":"Rule_Authenticated_6ab694","GetNvSpareForUpdate":"Rule_LoadSp_fetch_063496","SetSp":"Rule_LoadSp_record_59e09c","CheckSpCreatedBy":"Rule_LoadSp_scope0_a93267","CheckSpVersion":"Rule_LoadSp_version_007b44","CheckSpQuantity":"Rule_checkInventory_129c96","TransitionHoldAllowedState":"Rule_transitionHold_allowed_b964e6","TransitionHoldChangeStateValues":"Rule_transitionHold_change_values_d8bee2","TransitionHoldChangeStatePersist":"Rule_transitionHold_change_persist_ea5568"}
server action HoldNvSpareStock
  in SpId: NvSpare Identifier
  in SpVersion: Long Integer
  local Sp: NvSpare
  if not (GetUserId() <> NullIdentifier()):  # CheckGetUserId
    raise NvRuleViolation("Authentication required")
  GetNvSpareForUpdate = GetNvSpareForUpdate(Id=SpId)
  assign  # SetSp
    Sp = GetNvSpareForUpdate.Record.NvSpare
  if not (Sp.CreatedBy = GetUserId()):  # CheckSpCreatedBy
    raise NvRuleViolation("Record outside requested scope")
  if not (Sp.Version = SpVersion):  # CheckSpVersion
    raise NvRuleViolation("Record changed; reload before editing")
  if not (Sp.Quantity > 0 and Sp.Reserved > 0):  # CheckSpQuantity
    raise NvRuleViolation("checkInventory")
  if not ((Sp.StateId = Entities.NvSpareState.Available)):  # TransitionHoldAllowedState
    raise NvRuleViolation("transitionHold: state transition not allowed")
