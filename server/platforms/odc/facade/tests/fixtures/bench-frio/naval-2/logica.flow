server action ReviewNvVoyageIncidents
  in VId: NvVoyage Identifier
  out Open: Long Integer
  out Severity: Decimal
  local V: NvVoyage
  local IncidentsRows: NvVoyageIncident List
  if not (GetUserId() <> NullIdentifier()):  # CheckGetUserId
    raise NvRuleViolation("Authentication required")
  GetNvVoyage = GetNvVoyage(Id=VId)
  assign  # SetV
    V = GetNvVoyage.Record.NvVoyage
  if not (V.CreatedBy = GetUserId()):  # CheckVCreatedBy
    raise NvRuleViolation("Record outside requested scope")
  GetNvVoyageIncident = aggregate FROM NvVoyageIncident WHERE (NvVoyageIncident.ParentId = V.Id) MAX 300
  if not (GetNvVoyageIncident.Count <= 300):  # CheckGetNvVoyageIncidentCount
    raise NvRuleViolation("Result exceeds declared limit")
  assign  # SetIncidentsRows
    IncidentsRows = GetNvVoyageIncident.List
  assign  # SetOpen
    Open = 0
    Severity = 0
  foreach IncidentsRows:  # ForEachIncidentsRows @ruleNew1
    assign  # SetOpen2
      Open = Open + If(not IncidentsRows.Current.IsClosed, 1, 0)
      Severity = Severity + (If(IncidentsRows.Current.IsClosed,0,IncidentsRows.Current.Severity))
    next
  assign  # SetOpen3
    Open = Open
    Severity = Severity
  end

