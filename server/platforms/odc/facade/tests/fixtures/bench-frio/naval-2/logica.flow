  if not (GetUserId() <> NullIdentifier()):  # CheckGetUserId
    raise NvRuleViolation("Authentication required")
  GetNvSpareForUpdate = GetNvSpareForUpdate(Id=SpId)
  assign  # SetSp
    Sp = GetNvSpareForUpdate.Record.NvSpare
  if not (Sp.CreatedBy = GetUserId()):  # CheckSpCreatedBy
    raise NvRuleViolation("Record outside requested scope")
  if not (Sp.Version = SpVersion):  # CheckSpVersion
    raise NvRuleViolation("Record changed; reload before editing")
  if not (Sp.Reserved=0 and Sp.ValidUntil >= CurrDate()):  # CheckSpReserved
    raise NvRuleViolation("checkNoHolds")
  if not ((Sp.StateId = Entities.NvSpareState.Held)):  # TransitionReleaseAllowedState
    raise NvRuleViolation("transitionRelease: state transition not allowed")
  assign  # TransitionReleaseChangeStateValues
    Sp.StateId = Entities.NvSpareState.Available
    Sp.UpdatedOn = CurrDateTime()
