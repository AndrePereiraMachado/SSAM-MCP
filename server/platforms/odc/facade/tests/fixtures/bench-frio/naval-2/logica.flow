    Valuation.UnitPrice = Amount
    Valuation.Currency = "BRL"
    Valuation.EffectiveOn = CurrDate()
    Valuation.UpdatedOn = CurrDateTime()
    Valuation.CreatedOn = CurrDateTime()
    Valuation.Version = 1
  CreateNvSpareValuation = CreateNvSpareValuation(Source=Valuation)
  assign  # SetValuationId
    Valuation.Id = CreateNvSpareValuation.Id
  end

/// ssam-rule-map:{"CheckGetUserId":"Rule_Authenticated_6ab694","GetNvSpare":"Rule_LoadSp_fetch_063496","SetSp":"Rule_LoadSp_record_59e09c","CheckSpCreatedBy":"Rule_LoadSp_scope0_a93267","GetNvSpareReservation":"Rule_QueryReserveRows_query_347a10","CheckGetNvSpareReservationCount":"Rule_QueryReserveRows_complete_4a98a9","SetReserveRows":"Rule_QueryReserveRows_list_48a980","SetCurrent":"Rule_SummarizeReserve_seed_a91e4d","ForEachReserveRows":"Rule_SummarizeReserve_each_5aa09a","SetCurrent2":"Rule_SummarizeReserve_each_SummarizeRes_6ff67e","SetCurrent3":"Rule_ReturnReserve_a2f30c"}
server action ForecastNvSpareReserve
  in SpId: NvSpare Identifier
  out Current: Decimal
  out Expired: Long Integer
  local Sp: NvSpare
  local ReserveRows: NvSpareReservation List
  if not (GetUserId() <> NullIdentifier()):  # CheckGetUserId
    raise NvRuleViolation("Authentication required")
  GetNvSpare = GetNvSpare(Id=SpId)
  assign  # SetSp
    Sp = GetNvSpare.Record.NvSpare
  if not (Sp.CreatedBy = GetUserId()):  # CheckSpCreatedBy
    raise NvRuleViolation("Record outside requested scope")
  GetNvSpareReservation = aggregate FROM NvSpareReservation WHERE (NvSpareReservation.ParentId = Sp.Id) MAX 400
  if not (GetNvSpareReservation.Count <= 400):  # CheckGetNvSpareReservationCount
    raise NvRuleViolation("Result exceeds declared limit")
  assign  # SetReserveRows
    ReserveRows = GetNvSpareReservation.List
  assign  # SetCurrent
    Current = 0
    Expired = 0
  foreach ReserveRows:  # ForEachReserveRows @ruleNew1
    assign  # SetCurrent2
      Current = Current + (If(ReserveRows.Current.Released,0,ReserveRows.Current.Units))
      Expired = Expired + If(not ReserveRows.Current.Released and ReserveRows.Current.ReleaseOn < CurrDate(), 1, 0)
    next
  assign  # SetCurrent3
    Current = Current
    Expired = Expired
  end

/// ssam-rule-map:{"CheckGetUserId":"Rule_Authenticated_6ab694","GetNvSpare":"Rule_LoadSp_fetch_063496","SetSp":"Rule_LoadSp_record_59e09c","CheckSpCreatedBy":"Rule_LoadSp_scope0_a93267","GetNvSpareMovement":"Rule_QueryFlowRows_query_fa5ca1","CheckGetNvSpareMovementCount":"Rule_QueryFlowRows_complete_839098","SetFlowRows":"Rule_QueryFlowRows_list_9d0d1e","SetReceipts":"Rule_SummarizeFlow_seed_ab39f2","ForEachFlowRows":"Rule_SummarizeFlow_each_87c66c","SetReceipts2":"Rule_SummarizeFlow_each_SummarizeFlow_s_1f9c62","SetReceipts3":"Rule_ReturnFlow_6974eb"}
server action ReviewNvSpareMovements
  in SpId: NvSpare Identifier
  out Receipts: Decimal
  out Issues: Decimal
  local Sp: NvSpare
  local FlowRows: NvSpareMovement List
  if not (GetUserId() <> NullIdentifier()):  # CheckGetUserId
    raise NvRuleViolation("Authentication required")
  GetNvSpare = GetNvSpare(Id=SpId)
  assign  # SetSp
    Sp = GetNvSpare.Record.NvSpare
  if not (Sp.CreatedBy = GetUserId()):  # CheckSpCreatedBy
    raise NvRuleViolation("Record outside requested scope")
  GetNvSpareMovement = aggregate FROM NvSpareMovement WHERE (NvSpareMovement.ParentId = Sp.Id) MAX 500
  if not (GetNvSpareMovement.Count <= 500):  # CheckGetNvSpareMovementCount
    raise NvRuleViolation("Result exceeds declared limit")
  assign  # SetFlowRows
    FlowRows = GetNvSpareMovement.List
  assign  # SetReceipts
    Receipts = 0
    Issues = 0
  foreach FlowRows:  # ForEachFlowRows @ruleNew1
    assign  # SetReceipts2
      Receipts = Receipts + (If(FlowRows.Current.Delta > 0,FlowRows.Current.Delta,0))
      Issues = Issues + (If(FlowRows.Current.Delta < 0,0-FlowRows.Current.Delta,0))
    next
  assign  # SetReceipts3
    Receipts = Receipts
    Issues = Issues
  end

/// ssam-rule-map:{"CheckGetUserId":"Rule_Authenticated_6ab694","GetNvFuelForUpdate":"Rule_LoadFu_fetch_57c546","SetFu":"Rule_LoadFu_record_00b863","CheckFuCreatedBy":"Rule_LoadFu_scope0_07301d","CheckFuVersion":"Rule_LoadFu_version_f9a005","CheckFuQuantity":"Rule_checkEmpty_faaef4","TransitionExhaustAllowedState":"Rule_transitionExhaust_allowed_24cb75","TransitionExhaustChangeStateValues":"Rule_transitionExhaust_change_values_71f287","TransitionExhaustChangeStatePersist":"Rule_transitionExhaust_change_persist_2e4444"}
server action MarkNvFuelExhausted
  in FuId: NvFuel Identifier
  in FuVersion: Long Integer
  local Fu: NvFuel
  if not (GetUserId() <> NullIdentifier()):  # CheckGetUserId
    raise NvRuleViolation("Authentication required")
  GetNvFuelForUpdate = GetNvFuelForUpdate(Id=FuId)
  assign  # SetFu
    Fu = GetNvFuelForUpdate.Record.NvFuel
  if not (Fu.CreatedBy = GetUserId()):  # CheckFuCreatedBy
    raise NvRuleViolation("Record outside requested scope")
  if not (Fu.Version = FuVersion):  # CheckFuVersion
    raise NvRuleViolation("Record changed; reload before editing")
  if not (Fu.Quantity=0 and Fu.Reserved=0):  # CheckFuQuantity
    raise NvRuleViolation("checkEmpty")
  if not ((Fu.StateId = Entities.NvFuelState.Available) or (Fu.StateId = Entities.NvFuelState.Held)):  # TransitionExhaustAllowedState
    raise NvRuleViolation("transitionExhaust: state transition not allowed")
  assign  # TransitionExhaustChangeStateValues
    Fu.StateId = Entities.NvFuelState.Exhausted
    Fu.UpdatedOn = CurrDateTime()
    Fu.Version = Fu.Version + 1
  TransitionExhaustChangeStatePersist = UpdateNvFuel(Source=Fu)
  end

/// ssam-rule-map:{"CheckGetUserId":"Rule_Authenticated_6ab694","GetNvFuelForUpdate":"Rule_LoadFu_fetch_57c546","SetFu":"Rule_LoadFu_record_00b863","CheckFuCreatedBy":"Rule_LoadFu_scope0_07301d","CheckFuVersion":"Rule_LoadFu_version_f9a005","CheckFuQuantity":"Rule_checkReplenished_f7e9b7","TransitionReactivateAllowedState":"Rule_transitionReactivate_allowed_2cbd00","TransitionReactivateChangeStateValues":"Rule_transitionReactivat_03d9f491c85c_09275a","TransitionReactivateChangeStatePersist":"Rule_transitionReactivat_44107d066643_3555af"}
server action ReactivateNvFuel
  in FuId: NvFuel Identifier
  in FuVersion: Long Integer
  local Fu: NvFuel
  if not (GetUserId() <> NullIdentifier()):  # CheckGetUserId
    raise NvRuleViolation("Authentication required")
  GetNvFuelForUpdate = GetNvFuelForUpdate(Id=FuId)
  assign  # SetFu
    Fu = GetNvFuelForUpdate.Record.NvFuel
  if not (Fu.CreatedBy = GetUserId()):  # CheckFuCreatedBy
    raise NvRuleViolation("Record outside requested scope")
  if not (Fu.Version = FuVersion):  # CheckFuVersion
    raise NvRuleViolation("Record changed; reload before editing")
  if not (Fu.Quantity >= Fu.Capacity*0.2 and Fu.ValidUntil >= CurrDate()):  # CheckFuQuantity
    raise NvRuleViolation("checkReplenished")
  if not ((Fu.StateId = Entities.NvFuelState.Exhausted)):  # TransitionReactivateAllowedState
    raise NvRuleViolation("transitionReactivate: state transition not allowed")
  assign  # TransitionReactivateChangeStateValues
    Fu.StateId = Entities.NvFuelState.Available
    Fu.UpdatedOn = CurrDateTime()
    Fu.Version = Fu.Version + 1
  TransitionReactivateChangeStatePersist = UpdateNvFuel(Source=Fu)
  end

/// ssam-rule-map:{"CheckGetUserId":"Rule_Authenticated_6ab694","ValidateQty":"Rule_ValidateParameterQty_89cddf","ValidateNote":"Rule_ValidateParameterNote_55075f","GetNvFuelForUpdate":"Rule_LoadFu_fetch_57c546","SetFu":"Rule_LoadFu_record_00b863","CheckFuCreatedBy":"Rule_LoadFu_scope0_07301d","CheckFuVersion":"Rule_LoadFu_version_f9a005","CheckQty":"Rule_checkLoss_84360b","SetFuQuantity":"Rule_updateLoss_values_e41a5d","UpdateNvFuel":"Rule_updateLoss_persist_df7aba","SetMovement":"Rule_createMovement_reset_f5aa15","SetMovementParentId":"Rule_createMovement_values_c88bef","CreateNvFuelMovement":"Rule_createMovement_persist_479191","SetMovementId":"Rule_createMovement_identity_35626f"}
server action AdjustNvFuelLoss
  in Qty: Decimal
  in Note: Text
  in FuId: NvFuel Identifier
  in FuVersion: Long Integer
  local Fu: NvFuel
  local Movement: NvFuelMovement
  local WorkflowEmpty2: NvFuelMovement
  if not (GetUserId() <> NullIdentifier()):  # CheckGetUserId
    raise NvRuleViolation("Authentication required")
  if not ((Qty <= 10000) and (Qty > 0)):  # ValidateQty
    raise NvRuleViolation("Invalid Qty")
  if not ((Trim(Note) <> "") and (Length(Note) >= 5) and (Length(Note) <= 500)):  # ValidateNote
    raise NvRuleViolation("Invalid Note")
  GetNvFuelForUpdate = GetNvFuelForUpdate(Id=FuId)
  assign  # SetFu
    Fu = GetNvFuelForUpdate.Record.NvFuel
  if not (Fu.CreatedBy = GetUserId()):  # CheckFuCreatedBy
    raise NvRuleViolation("Record outside requested scope")
  if not (Fu.Version = FuVersion):  # CheckFuVersion
    raise NvRuleViolation("Record changed; reload before editing")
  if not (Qty <= Fu.Quantity-Fu.Reserved and Qty <= Fu.Quantity*0.01):  # CheckQty
    raise NvRuleViolation("checkLoss")
  assign  # SetFuQuantity
    Fu.Quantity = Fu.Quantity-Qty
    Fu.UpdatedOn = CurrDateTime()
    Fu.Version = Fu.Version + 1
  UpdateNvFuel = UpdateNvFuel(Source=Fu)
  assign  # SetMovement
    Movement = WorkflowEmpty2
  assign  # SetMovementParentId
    Movement.ParentId = Fu.Id
    Movement.Delta = 0-Qty
    Movement.Reason = Note
    Movement.OccurredOn = CurrDateTime()
    Movement.UpdatedOn = CurrDateTime()
    Movement.CreatedOn = CurrDateTime()
    Movement.Version = 1
  CreateNvFuelMovement = CreateNvFuelMovement(Source=Movement)
  assign  # SetMovementId
    Movement.Id = CreateNvFuelMovement.Id
  end

/// ssam-rule-map:{"CheckGetUserId":"Rule_Authenticated_6ab694","GetNvFuel":"Rule_LoadFu_fetch_57c546","SetFu":"Rule_LoadFu_record_00b863","CheckFuCreatedBy":"Rule_LoadFu_scope0_07301d","GetNvFuelLot":"Rule_QueryLotsRows_query_4dc699","CheckGetNvFuelLotCount":"Rule_QueryLotsRows_complete_acd1ac","SetLotsRows":"Rule_QueryLotsRows_list_7faa0d","SetExpiring":"Rule_SummarizeLots_seed_bf4647","ForEachLotsRows":"Rule_SummarizeLots_each_23f9f0","SetExpiring2":"Rule_SummarizeLots_each_SummarizeLots_s_ccc6a7","SetExpiring3":"Rule_ReturnLots_922bf9"}
server action ForecastNvFuelExpiry
  in FuId: NvFuel Identifier
  out Expiring: Decimal
  out Batches: Long Integer
  local Fu: NvFuel
  local LotsRows: NvFuelLot List
  if not (GetUserId() <> NullIdentifier()):  # CheckGetUserId
    raise NvRuleViolation("Authentication required")
  GetNvFuel = GetNvFuel(Id=FuId)
  assign  # SetFu
    Fu = GetNvFuel.Record.NvFuel
  if not (Fu.CreatedBy = GetUserId()):  # CheckFuCreatedBy
    raise NvRuleViolation("Record outside requested scope")
  GetNvFuelLot = aggregate FROM NvFuelLot WHERE (NvFuelLot.ParentId = Fu.Id) MAX 300
  if not (GetNvFuelLot.Count <= 300):  # CheckGetNvFuelLotCount
    raise NvRuleViolation("Result exceeds declared limit")
  assign  # SetLotsRows
    LotsRows = GetNvFuelLot.List
  assign  # SetExpiring
    Expiring = 0
    Batches = 0
  foreach LotsRows:  # ForEachLotsRows @ruleNew1
    assign  # SetExpiring2
      Expiring = Expiring + (If(LotsRows.Current.Expiry <= DateTimeToDate(AddDays(CurrDate(),7)),LotsRows.Current.Units,0))
      Batches = Batches + 1
    next
  assign  # SetExpiring3
    Expiring = Expiring
    Batches = Batches
  end

/// ssam-rule-map:{"CheckGetUserId":"Rule_Authenticated_6ab694","GetNvFuel":"Rule_LoadFu_fetch_57c546","SetFu":"Rule_LoadFu_record_00b863","CheckFuCreatedBy":"Rule_LoadFu_scope0_07301d","GetNvFuelValuation":"Rule_QueryPricesRows_query_218ec3","CheckGetNvFuelValuationCount":"Rule_QueryPricesRows_complete_7cf759","SetPricesRows":"Rule_QueryPricesRows_list_35224c","SetPriceSum":"Rule_SummarizePrices_seed_fc6493","ForEachPricesRows":"Rule_SummarizePrices_each_fbb143","SetPriceSum2":"Rule_SummarizePrices_each_SummarizePric_3ecd95","SetPriceSum3":"Rule_ReturnPrices_4c8fd3"}
server action ReviewNvFuelValuations
  in FuId: NvFuel Identifier
  out PriceSum: Decimal
  out CurrentPrices: Long Integer
  local Fu: NvFuel
  local PricesRows: NvFuelValuation List
  if not (GetUserId() <> NullIdentifier()):  # CheckGetUserId
    raise NvRuleViolation("Authentication required")
  GetNvFuel = GetNvFuel(Id=FuId)
  assign  # SetFu
    Fu = GetNvFuel.Record.NvFuel
  if not (Fu.CreatedBy = GetUserId()):  # CheckFuCreatedBy
    raise NvRuleViolation("Record outside requested scope")
  GetNvFuelValuation = aggregate FROM NvFuelValuation WHERE (NvFuelValuation.ParentId = Fu.Id) MAX 200
  if not (GetNvFuelValuation.Count <= 200):  # CheckGetNvFuelValuationCount
    raise NvRuleViolation("Result exceeds declared limit")
  assign  # SetPricesRows
    PricesRows = GetNvFuelValuation.List
  assign  # SetPriceSum
    PriceSum = 0
    CurrentPrices = 0
  foreach PricesRows:  # ForEachPricesRows @ruleNew1
    assign  # SetPriceSum2
      PriceSum = PriceSum + (PricesRows.Current.UnitPrice)
      CurrentPrices = CurrentPrices + If(PricesRows.Current.EffectiveOn <= CurrDate(), 1, 0)
    next
  assign  # SetPriceSum3
    PriceSum = PriceSum
    CurrentPrices = CurrentPrices
  end

