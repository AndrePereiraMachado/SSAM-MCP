/// ssam-rule-map:{"CheckGetUserId":"Rule_Authenticated_6ab694","GetNvCargo":"Rule_LoadCa_fetch_50aae3","SetCa":"Rule_LoadCa_record_25b37b","CheckCaCreatedBy":"Rule_LoadCa_scope0_d09dfa","GetNvCargoReservation":"Rule_QueryCommitmentsRows_query_b60d23","CheckGetNvCargoReservationCount":"Rule_QueryCommitmentsRows_complete_cb8e81","SetCommitmentsRows":"Rule_QueryCommitmentsRows_list_2e9635","SetFuture":"Rule_SummarizeCommitments_seed_50ee0e","ForEachCommitmentsRows":"Rule_SummarizeCommitments_each_4d2b45","SetFuture2":"Rule_SummarizeCommitments_each_Summariz_de36f9","SetFuture3":"Rule_ReturnCommitments_e58fd4"}
server action ReviewNvCargoReservations
  in CaId: NvCargo Identifier
  out Future: Decimal
  out ReleasedUnits: Decimal
  local Ca: NvCargo
  local CommitmentsRows: NvCargoReservation List
  if not (GetUserId() <> NullIdentifier()):  # CheckGetUserId
    raise NvRuleViolation("Authentication required")
  GetNvCargo = GetNvCargo(Id=CaId)
  assign  # SetCa
    Ca = GetNvCargo.Record.NvCargo
  if not (Ca.CreatedBy = GetUserId()):  # CheckCaCreatedBy
    raise NvRuleViolation("Record outside requested scope")
  GetNvCargoReservation = aggregate FROM NvCargoReservation WHERE (NvCargoReservation.ParentId = Ca.Id) MAX 400
  if not (GetNvCargoReservation.Count <= 400):  # CheckGetNvCargoReservationCount
    raise NvRuleViolation("Result exceeds declared limit")
  assign  # SetCommitmentsRows
    CommitmentsRows = GetNvCargoReservation.List
  assign  # SetFuture
    Future = 0
    ReleasedUnits = 0
  foreach CommitmentsRows:  # ForEachCommitmentsRows @ruleNew1
    assign  # SetFuture2
      Future = Future + (If(not CommitmentsRows.Current.Released and CommitmentsRows.Current.ReleaseOn >= CurrDate(),CommitmentsRows.Current.Units,0))
      ReleasedUnits = ReleasedUnits + (If(CommitmentsRows.Current.Released,CommitmentsRows.Current.Units,0))
    next
  assign  # SetFuture3
    Future = Future
    ReleasedUnits = ReleasedUnits
  end

