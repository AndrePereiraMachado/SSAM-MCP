      "oneOf": [
       {
        "type": "string"
       },
       {
        "type": "object",
        "properties": {
         "entry": {
          "type": "string"
         },
         "files": {
          "type": "object",
          "additionalProperties": {
           "type": "string"
          }
         }
        },
        "required": [
         "entry",
         "files"
        ],
        "additionalProperties": false
       }
      ],
      "description": "HTML/CSS/JS source, or a bundle of authored files with an entry path. Relative component imports are resolved and frozen by the Hybrid; no binding manifest."
     },
     "data": {
      "type": "object"
     },
     "logic": {
      "type": "object"
     },
     "roles": {
