# Copy to .env (never commit .env; it never enters the image either). Paths use forward slashes, also on Windows.

# The reserved ngrok domain and the ngrok authtoken (secret).
NGROK_DOMAIN=subtract-print-overbid.ngrok-free.dev
NGROK_AUTHTOKEN=

# The Studios, read at build time from docker/installers (docker/installers/README.md), in one of two ways per Studio:
#  a) the official installer (preferred when present);
#  b) a studio bundle packed from an INSTALLED Studio on any machine (docker/ssam-server/studio-bundle.ps1 or .sh); it
#     carries OutSystems binaries like the image: keep it private.
# Defaults shown; change them with the Studio versions of the customers (Service Studio, and ODC Studio 1.7.28 since 2026-10-12).
# STUDIO_INSTALLERS_DIR=./docker/installers
# SERVICE_STUDIO_INSTALLER=ServiceStudio-11.55.91.65258.exe
# SERVICE_STUDIO_SHA256=10047d31a03adbbe6bd3a07c9de0506eeba3420e7031e51846607ee3fcde136c
# ODC_STUDIO_INSTALLER=ODCStudio-1.7.28.10850.exe
# ODC_STUDIO_SHA256=
# Download at build time instead of the folder (the SHA256 of the same lane is then required):
# SERVICE_STUDIO_URL=
# ODC_STUDIO_URL=
# Studio bundles, used when the installer is absent; pin the sha256 the bundle script printed (its .sha256 file).
# SERVICE_STUDIO_BUNDLE=o11-studio-11.55.91.65258.tar.gz
# SERVICE_STUDIO_BUNDLE_SHA256=
# ODC_STUDIO_BUNDLE=odc-studio-1.7.28.10850.tar.gz
# ODC_STUDIO_BUNDLE_SHA256=
# Reader of the installers: nsis (default, Python standard library) or 7z.
# STUDIO_EXTRACTOR=nsis

# Optional
SSAM_IMAGE_TAG=local
SSAM_HOST_PORT=7310
NGROK_INSPECT_PORT=4040
NGROK_IMAGE_TAG=latest
