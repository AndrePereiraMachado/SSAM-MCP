# Test PDFs are generated with LF-only text streams; line-ending conversion on checkout would break their xref offsets.
*.pdf binary
# Batch files run in cmd.exe, which needs CRLF whatever core.autocrlf the clone uses.
*.cmd text eol=crlf
*.bat text eol=crlf

docker-compose.yml text eol=lf
.env.example text eol=lf

# Production image of the server box (SSAM-MCP's own): read by BuildKit, LF on every checkout. server/deploy has its own
# .gitattributes (LF for everything there).
server/Dockerfile text eol=lf
